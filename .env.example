# ========================================================
# Google Gemini API Key (100% Free at aistudio.google.com)
# ========================================================
GEMINI_API_KEY=your_gemini_api_key_here

# Model name (default: gemini-3.8-flash for fast, high-quality reasoning)
GEMINI_MODEL=gemini-3.8-flash

# ========================================================
# PartnerStack Autonomous Sync (Optional)
# ========================================================
PARTNERSTACK_API_KEY=
PARTNERSTACK_PARTNER_KEY=

# ========================================================
# Impact.com (Impact Radius) Publisher API (B2B SaaS #1)
# Find in: Impact Dashboard -> Settings -> Technical -> API Access
# ========================================================
IMPACT_ACCOUNT_SID=
IMPACT_AUTH_TOKEN=

# ========================================================
# CJ Affiliate (Commission Junction) REST/GraphQL API
# Find in: CJ Dashboard -> Account -> Administrative Settings -> Personal Access Tokens
# ========================================================
CJ_PERSONAL_ACCESS_TOKEN=
CJ_COMPANY_ID=

# ========================================================
# Founder Instant Push Notifications (Optional - Telegram / Discord)
# Get a free bot token from @BotFather and your ChatID from @userinfobot
# Or paste a Discord Channel Webhook URL
# ========================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ========================================================
# X (Twitter) API v2 Autonomous Distribution (Optional - Free tier)
# ========================================================
TWITTER_BROADCAST_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_REFRESH_TOKEN=
TWITTER_ACCESS_SECRET=

# ========================================================
# LinkedIn API v2 Autonomous Distribution (Optional)
# ========================================================
LINKEDIN_BROADCAST_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
