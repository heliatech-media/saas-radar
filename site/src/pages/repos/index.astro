---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const repos = await getCollection('repos');
const sortedRepos = repos.sort((a, b) => b.data.stars - a.data.stars);

// Unique categories
const categories = ['ALL', ...new Set(repos.map(r => r.data.category))];

const totalStars = repos.reduce((acc, r) => acc + r.data.stars, 0);
---

<Layout 
  title="Open-Source SaaS Radar & GitHub Forensic Audits (2026) | HeliaTech"
  description="Verified technical audits, license trap analysis, and production-readiness benchmarks of top open-source SaaS software and boilerplates on GitHub."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900 border border-cyan-500/30 text-cyan-300 text-xs font-mono mb-6 shadow-glow-cyan">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>HELIATECH GITHUB RADAR • {repos.length} AUDITED REPOSITORIES • {totalStars.toLocaleString()} TOTAL STARS</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight mb-6 leading-tight">
        Open-Source SaaS <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-emerald-400">
          Forensic Code Radar.
        </span>
      </h1>

      <p class="text-slate-400 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto">
        We scan and audit the world's most critical open-source SaaS engines on GitHub. Zero PR fluff, verified license risk checks, and unvarnished architectural teardowns.
      </p>
    </div>

    <!-- Category Filters -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      {categories.map((cat, idx) => (
        <button 
          class={`filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all ${
            idx === 0 
              ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 shadow-glow-cyan' 
              : 'bg-slate-900/80 text-slate-400 border border-slate-800 hover:border-slate-700 hover:text-slate-200'
          }`}
          data-category={cat}
        >
          {cat === 'ALL' ? '🌟 All Repositories' : cat}
        </button>
      ))}
    </div>

    <!-- Repos Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="repos-grid">
      {sortedRepos.map((repo) => {
        const riskColors = {
          Low: 'bg-emerald-950/80 text-emerald-400 border-emerald-500/40',
          Medium: 'bg-amber-950/80 text-amber-400 border-amber-500/40',
          High: 'bg-rose-950/80 text-rose-400 border-rose-500/40',
        };
        const riskClass = riskColors[repo.data.license_risk] || riskColors.Low;

        return (
          <div 
            class="repo-card flex flex-col justify-between rounded-2xl bg-[#090e1a] border border-slate-800 hover:border-cyan-500/40 p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-cyan-950/40"
            data-category={repo.data.category}
          >
            <div>
              <!-- Top Row: Category + Health Score -->
              <div class="flex items-center justify-between mb-4">
                <span class="text-[11px] font-mono uppercase tracking-wider text-cyan-400 font-semibold bg-cyan-950/60 px-2.5 py-1 rounded-md border border-cyan-800/40">
                  {repo.data.category}
                </span>
                <span class="text-xs font-mono font-bold px-2.5 py-1 rounded-md bg-emerald-950/80 text-emerald-300 border border-emerald-500/30">
                  {repo.data.health_score}/100 Score
                </span>
              </div>

              <!-- Title & Repo Name -->
              <h2 class="text-xl font-bold text-white mb-1.5 group-hover:text-cyan-300 transition-colors">
                <a href={`/repos/${repo.slug}/`} class="hover:text-cyan-400">
                  {repo.data.name}
                </a>
              </h2>
              <div class="text-xs font-mono text-slate-400 mb-3 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
                <span>{repo.data.repo_name}</span>
              </div>

              <!-- Tagline -->
              <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-4 line-clamp-2">
                {repo.data.tagline}
              </p>

              <!-- Hard Metrics Row -->
              <div class="grid grid-cols-3 gap-2 py-3 px-3.5 rounded-xl bg-slate-900/90 border border-slate-800 text-center mb-4">
                <div>
                  <div class="text-[10px] font-mono text-slate-400 uppercase">Stars</div>
                  <div class="text-sm font-bold text-amber-300 font-mono">⭐ {repo.data.stars.toLocaleString()}</div>
                </div>
                <div>
                  <div class="text-[10px] font-mono text-slate-400 uppercase">Forks</div>
                  <div class="text-sm font-bold text-slate-200 font-mono">🍴 {repo.data.forks.toLocaleString()}</div>
                </div>
                <div>
                  <div class="text-[10px] font-mono text-slate-400 uppercase">Commit</div>
                  <div class="text-xs font-semibold text-cyan-300 truncate">{repo.data.last_commit}</div>
                </div>
              </div>

              <!-- Tech Stack Badges -->
              <div class="flex flex-wrap gap-1.5 mb-4">
                {repo.data.stack.map(tech => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60">
                    {tech}
                  </span>
                ))}
              </div>
            </div>

            <!-- Bottom Row: License Pill + Action Button -->
            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
              <span class={`text-[10px] font-mono px-2.5 py-1 rounded-md border font-semibold ${riskClass}`}>
                {repo.data.license_risk} Risk: {repo.data.license}
              </span>
              <a 
                href={`/repos/${repo.slug}/`}
                class="inline-flex items-center gap-1 text-xs font-mono font-bold text-cyan-400 hover:text-cyan-300 group"
              >
                <span>Audit</span>
                <span class="group-hover:translate-x-1 transition-transform">➔</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>

  <script is:inline>
    const filterButtons = document.querySelectorAll('.filter-btn');
    const repoCards = document.querySelectorAll('.repo-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Toggle active button styles
        filterButtons.forEach(b => {
          b.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'shadow-glow-cyan');
          b.classList.add('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
        });
        btn.classList.remove('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
        btn.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'shadow-glow-cyan');

        const selectedCat = btn.getAttribute('data-category');
        repoCards.forEach(card => {
          if (selectedCat === 'ALL' || card.getAttribute('data-category') === selectedCat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
