              </thead>
              <tbody class="divide-y divide-slate-800/60">
                {catalog.tools.map(tool => (
                  <tr class="hover:bg-slate-900/40 transition-all">
                    <td class="p-4 font-bold text-white flex items-center gap-2">
                      <span>{tool.name}</span>
