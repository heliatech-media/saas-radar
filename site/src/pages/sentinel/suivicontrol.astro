      <footer class="border-t border-slate-800/80 bg-slate-950/80 px-6 py-4 text-center font-mono text-[11px] text-slate-500">
        <span>HELIA SENTINEL COCKPIT // SUPERVISION OFFICIELLE • ACCÈS STRICTEMENT PRIVÉ</span>
      </footer>

    </div>

    <!-- SCRIPT DE SÉCURITÉ & ONGLETS -->
    <script is:inline>
      (function() {
        const AUTHORIZED_DIGEST = "1b761a519101a5896b97077561b9140f6c31c7b3d864478a563d131cc46e2b1e";
        const SESSION_KEY = "_helia_sentinel_auth_token";

        const authGate = document.getElementById('auth-gate');
        const dashboard = document.getElementById('dashboard-content');
        const authForm = document.getElementById('auth-form');
        const keyInput = document.getElementById('clearance-key');
        const authError = document.getElementById('auth-error');
        const logoutBtn = document.getElementById('logout-btn');
        const refreshBtn = document.getElementById('refresh-btn');

        async function sha256(str) {
          const buffer = new TextEncoder().encode(str);
          const hashBuffer = await crypto.subtle.digest('SHA-256', buffer);
          const hashArray = Array.from(new Uint8Array(hashBuffer));
          return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        }

        async function verifyClearance(input) {
          const digest = await sha256(input.trim());
          return digest === AUTHORIZED_DIGEST;
        }

        function unlock() {
          authGate.classList.add('hidden');
          dashboard.classList.remove('hidden');
        }

        function lock() {
          sessionStorage.removeItem(SESSION_KEY);
          dashboard.classList.add('hidden');
          authGate.classList.remove('hidden');
          if (keyInput) keyInput.value = '';
        }

        // Check active session
        if (sessionStorage.getItem(SESSION_KEY) === AUTHORIZED_DIGEST) {
          unlock();
        }

        if (authForm) {
          authForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            authError.classList.add('hidden');
            const isValid = await verifyClearance(keyInput.value);
            if (isValid) {
              sessionStorage.setItem(SESSION_KEY, AUTHORIZED_DIGEST);
              unlock();
            } else {
              authError.classList.remove('hidden');
              keyInput.value = '';
              keyInput.focus();
            }
          });
        }

        if (logoutBtn) logoutBtn.addEventListener('click', lock);
        if (refreshBtn) refreshBtn.addEventListener('click', () => window.location.reload());

        // Tab Switching Logic
        const tabBtns = document.querySelectorAll('.tab-btn');
        const tabContents = document.querySelectorAll('.tab-content');

        tabBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('data-tab');
            
            tabBtns.forEach(b => {
              b.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'font-bold');
              b.classList.add('bg-slate-900', 'text-slate-400', 'border-slate-800');
            });

            btn.classList.remove('bg-slate-900', 'text-slate-400', 'border-slate-800');
            btn.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/40', 'font-bold');

            tabContents.forEach(c => c.classList.add('hidden'));
            const targetContent = document.getElementById(targetId);
            if (targetContent) targetContent.classList.remove('hidden');
          });
        });
      })();
    </script>
  </body>
</html>
