            <span class="text-xs font-mono text-slate-400">Redirections Cloudflare Edge instantanées</span>
          </div>

          <div class="overflow-x-auto rounded-2xl border border-slate-800 bg-slate-950/60">
            <table class="w-full text-left text-xs font-mono">
              <thead class="bg-slate-900/80 text-slate-400 border-b border-slate-800">
                <tr>
                  <th class="p-4">Logiciel</th>
                  <th class="p-4">Statut Monétisation</th>
                  <th class="p-4">Lien Redirection Site</th>
                  <th class="p-4">Destination Partenaire</th>
                  <th class="p-4 text-right">Action</th>
