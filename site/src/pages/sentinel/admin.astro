            {executiveReportText || "Rapport en cours de rédaction par Helia-Reporter..."}
          </div>
        </div>

        <!-- TAB 6: CONSOLE DE CONTRÔLE PATRON -->
        <div id="tab-controls" class="tab-content hidden space-y-6">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-black text-white flex items-center gap-2">
              <span>🎛️</span> Console de Pilotage Direct & Actions Patron
            </h2>
            <span class="text-xs font-mono text-emerald-400">Accès Administrateur Déverrouillé</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col justify-between">
              <div>
                <div class="text-base font-bold text-white mb-2 flex items-center gap-2">
                  <span>⚡</span> Déclencher le Daemon Helia
                </div>
                <p class="text-xs text-slate-400 mb-4">
                  Simule ou force le lancement du cycle autonome (audit des programmes d'affiliation, vérification de monétisation, synchronisation du calendrier).
                </p>
              </div>
              <button 
                id="btn-trigger-daemon"
                class="w-full py-2.5 px-4 rounded-xl bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/40 text-cyan-300 font-mono text-xs font-bold transition-all"
              >
                Lancer un cycle de vérification
              </button>
            </div>

            <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col justify-between">
              <div>
                <div class="text-base font-bold text-white mb-2 flex items-center gap-2">
                  <span>💾</span> Exporter les Métriques (JSON)
                </div>
                <p class="text-xs text-slate-400 mb-4">
                  Télécharge un instantané complet de la configuration du catalogue, des 23 redirections `/go/` et du statut des agents autonomes.
                </p>
              </div>
              <button 
                id="btn-export-config"
                class="w-full py-2.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-mono text-xs font-bold transition-all"
              >
                Télécharger l'instantané JSON
              </button>
            </div>

            <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col justify-between">
              <div>
                <div class="text-base font-bold text-white mb-2 flex items-center gap-2">
                  <span>🧹</span> Purger le Cache Télémétrique
                </div>
                <p class="text-xs text-slate-400 mb-4">
                  Réinitialise le compteur local de télémétrie si des sessions de test ou d'administration ont été enregistrées localement.
                </p>
              </div>
              <button 
                id="btn-purge-telemetry"
                class="w-full py-2.5 px-4 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-300 font-mono text-xs font-bold transition-all"
              >
                Purger le cache local
