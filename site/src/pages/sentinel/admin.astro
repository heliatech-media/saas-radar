    // 3.2 Certification de l'Offre Commerciale par l'Owner (Ouvre la modale de preuve sans achat)
    function verifyDealOffer(slug, btn) {
      document.getElementById('verify-offer-slug').value = slug;
      document.getElementById('verify-offer-proof-url').value = `https://heliatech.online/go/${slug}`;
      document.getElementById('verify-offer-notes').value = '';
      document.getElementById('verify-offer-conditions-check').checked = false;
      document.getElementById('verify-offer-coupon-check').checked = false;
      document.getElementById('verify-offer-no-purchase-check').checked = false;
      openModal('modal-verify-offer');
    }

    async function submitVerifyOffer() {
      const slug = document.getElementById('verify-offer-slug').value;
      const proofUrl = document.getElementById('verify-offer-proof-url').value.trim();
      const notes = document.getElementById('verify-offer-notes').value.trim();
      const conditionsAudited = document.getElementById('verify-offer-conditions-check').checked;
      const couponCodeTested = document.getElementById('verify-offer-coupon-check').checked;
      const noPurchase = document.getElementById('verify-offer-no-purchase-check').checked;

      if (!proofUrl || !proofUrl.startsWith('https://')) {
        alert('URL de preuve obligatoire : Veuillez renseigner une URL HTTPS valide (https://...).');
        return;
      }
      if (!notes || notes.length < 10) {
        alert("Notes d'audit obligatoires : Veuillez décrire les conditions vérifiées (au moins 10 caractères).");
        return;
      }
      if (!conditionsAudited) {
        alert("Conditions non auditées : Veuillez cocher la case certifiant que les conditions publiques et tarifs ont été inspectés visuellement.");
        return;
      }
      if (!couponCodeTested) {
        alert("Code non testé : Veuillez cocher la case certifiant que le code promotionnel ou l'accès gratuit a été testé sur le formulaire.");
        return;
      }
      if (!noPurchase) {
        alert("Protocole éthique : Vous devez cocher la case certifiant qu'aucun paiement ni carte bancaire n'a été utilisé.");
        return;
      }

      const btn = document.getElementById('btn-submit-verify-offer');
      btn.innerText = 'Certification en cours...';
      btn.disabled = true;

      try {
        const res = await fetch('/api/sentinel/deals', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'verify_offer',
            deal_slug: slug,
            proof_url: proofUrl,
            terms_notes: notes,
            owner_confirmation: true,
            conditions_audited: true,
            coupon_code_tested: true,
            no_purchase_tested: true,
            manual_owner_action: true,
            no_account_no_personal_data: true,
            is_automated_agent: false
          })
        });
        const data = await res.json();
        closeModal('modal-verify-offer');
        if (res.ok && data.success) {
          alert(`[OFFRE CERTIFIÉE PAR L'OWNER]\n${data.message}`);
        } else {
          alert(`[ERREUR VALIDATION]\n${data.error || 'Impossible de valider.'}`);
        }
        fetchDeals();
      } catch (e) {
        alert('Erreur réseau : ' + e.message);
      } finally {
        btn.innerText = 'Certifier et Réarmer 48h';
        btn.disabled = false;
      }
    }

