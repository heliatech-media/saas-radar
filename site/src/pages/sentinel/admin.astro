    // 6. Abonnés
    async function fetchSubscribers(reveal) {
      const tbody = document.getElementById('subscribers-tbody');
      try {
        const data = await safeFetchJson(`/api/sentinel/subscribers?limit=50&reveal=${reveal ? 'true' : 'false'}`);
        if (!data || !data.subscribers) {
          if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="p-6 text-center text-amber-400 font-mono text-xs">⚠️ Synchronisation des abonnés...</td></tr>';
          return;
        }
        if (tbody) tbody.innerHTML = '';

        data.subscribers.forEach(s => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-900/40';
          tr.innerHTML = `
            <td class="p-3 font-bold text-slate-300 whitespace-nowrap">
              <span class="text-cyan-400">${s.id}</span>
              <span class="ml-1.5 px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-300 text-[10px] font-bold">${s.status}</span>
            </td>
            <td class="p-3 text-white font-mono whitespace-nowrap">${s.email}</td>
            <td class="p-3 text-slate-300">${s.role || 'Décisionnaire SaaS'}</td>
            <td class="p-3 text-slate-400 whitespace-nowrap">${s.country || 'International'}</td>
            <td class="p-3 text-slate-500 whitespace-nowrap">${new Date(s.signup_date).toLocaleDateString('fr-FR')}</td>
            <td class="p-3 text-right text-cyan-400 font-mono text-[11px]">${s.source_path || '/calculator'}</td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        console.warn('Erreur abonnés:', e);
      }
    }

    // 7. Approbations
    async function decideApproval(id, decision) {
      const notes = prompt(`Motif ou note de décision patron pour cette action (${decision}) :`, 'Validé sous autorité patron');
      if (notes === null) return;

      try {
        const res = await fetch('/api/sentinel/approvals', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ approval_id: id, decision, decision_notes: notes })
        });
        const data = await res.json();
        alert(`[JOURNALISÉ & SIGNÉ] ${data.message}`);
        loadCockpit();
        showSection('view-general');
      } catch (e) {
        alert('Erreur: ' + e.message);
      }
    }

    // 8. Journal d'Audit
    async function fetchAuditLogs() {
      try {
        const data = await safeFetchJson('/api/sentinel/audit');
        if (!data || !data.audit_logs) return;
        const tbody = document.getElementById('audit-tbody');
        tbody.innerHTML = '';

        data.logs.forEach(l => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-900/40 text-[11px]';
          tr.innerHTML = `
            <td class="p-3 text-slate-400 whitespace-nowrap font-mono">${new Date(l.timestamp).toLocaleString('fr-FR')}</td>
            <td class="p-3 text-emerald-300 font-bold whitespace-nowrap">${l.actor_email}</td>
            <td class="p-3 text-white font-bold whitespace-nowrap">${l.action}</td>
            <td class="p-3 text-cyan-300 whitespace-nowrap font-mono">${l.target}</td>
            <td class="p-3 text-slate-400 whitespace-nowrap font-mono">${l.previous_state || '—'} → <strong class="text-white">${l.new_state || '—'}</strong></td>
            <td class="p-3 text-right text-slate-500 font-mono text-[9px]">${l.signature.substring(0, 16)}...</td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        console.warn('Erreur audit:', e);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadCockpit();
    });
  
    // =========================================================================
    // 9. PHASE 4 : SUPPORT, CENTRE D'AIDE & MATRICE DE SANTÉ (FONCTIONS DÉDIÉES)
    // =========================================================================
    function switchHelpTab(tabId) {
      document.querySelectorAll('.help-tab-panel').forEach(p => p.classList.add('hidden'));
      document.querySelectorAll('.help-tab-btn').forEach(b => {
        b.classList.remove('bg-purple-500/20', 'text-purple-200', 'border-purple-500/40', 'font-bold');
        b.classList.add('text-slate-400', 'border-transparent');
      });

      const target = document.getElementById('panel-' + tabId);
      const btn = document.getElementById('btn-' + tabId);
      if (target) target.classList.remove('hidden');
      if (btn) {
        btn.classList.add('bg-purple-500/20', 'text-purple-200', 'border-purple-500/40', 'font-bold');
        btn.classList.remove('text-slate-400', 'border-transparent');
      }
    }

    async function fetchHealth() {
      try {
        const data = await safeFetchJson('/api/sentinel/health');
        if (!data) return;

        const scoreBadge = document.getElementById('help-health-score');
        if (scoreBadge) {
          scoreBadge.innerText = `${data.score}/100 (${data.status})`;
          if (data.status === 'NOMINAL') {
            scoreBadge.className = 'px-3 py-1 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-bold font-mono';
          } else {
            scoreBadge.className = 'px-3 py-1 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-bold font-mono';
          }
        }

        if (data.components?.d1_database) {
          const d1 = data.components.d1_database;
          const b = document.getElementById('health-d1-badge');
          if (b) b.innerText = d1.badge;
          const det = document.getElementById('health-d1-details');
          if (det) det.innerText = d1.details;
          const lat = document.getElementById('health-d1-latency');
          if (lat) lat.innerText = `${d1.latency_ms}ms`;
          const blk = document.getElementById('health-d1-blocks');
          if (blk) blk.innerText = `${d1.audit_blocks_count} blocs`;
          const chk = document.getElementById('health-d1-checkpoint');
          if (chk) chk.innerText = d1.latest_checkpoint;
        }

        if (data.components?.r2_storage) {
          const r2 = data.components.r2_storage;
          const b = document.getElementById('health-r2-badge');
          if (b) b.innerText = r2.badge;
          const det = document.getElementById('health-r2-details');
          if (det) det.innerText = r2.details;
        }

        if (data.components?.fleet_agents) {
          const ag = data.components.fleet_agents;
          const b = document.getElementById('health-agents-badge');
          if (b) b.innerText = ag.badge;
          const det = document.getElementById('health-agents-details');
          if (det) det.innerText = ag.details;
        }

        if (data.components?.newsletter_system) {
          const nl = data.components.newsletter_system;
          const b = document.getElementById('health-nl-badge');
          if (b) b.innerText = nl.badge;
          const det = document.getElementById('health-nl-details');
          if (det) det.innerText = nl.details;
        }

        if (data.components?.partner_deals) {
          const dl = data.components.partner_deals;
          const b = document.getElementById('health-deals-badge');
          if (b) b.innerText = dl.badge;
          const det = document.getElementById('health-deals-details');
          if (det) det.innerText = dl.details;
        }

        if (data.components?.edge_zero_trust) {
          const ed = data.components.edge_zero_trust;
          const b = document.getElementById('health-edge-badge');
          if (b) b.innerText = ed.badge;
          const det = document.getElementById('health-edge-details');
          if (det) det.innerText = ed.details;
        }

        const logBox = document.getElementById('help-diagnostic-logs');
        if (logBox && data.diagnostic_log) {
          logBox.innerHTML = '';
          data.diagnostic_log.forEach(log => {
            const p = document.createElement('p');
            p.className = 'text-slate-300';
            p.innerHTML = `<span class="text-emerald-400">✓</span> ${log}`;
            logBox.appendChild(p);
          });
        }
      } catch (e) {
        console.warn('Erreur santé:', e);
      }
    }

    function filterGlossary() {
      const input = document.getElementById('help-glossary-search');
      if (!input) return;
      const q = input.value.toLowerCase().trim();
      document.querySelectorAll('.glossary-card').forEach(el => {
        const keywords = el.getAttribute('data-keywords') || '';
        const text = el.innerText.toLowerCase();
        if (!q || keywords.includes(q) || text.includes(q)) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    }

    function filterHelpAgents() {
      const select = document.getElementById('help-agent-filter');
      if (!select) return;
      const cat = select.value;
      document.querySelectorAll('.help-agent-card').forEach(el => {
        const agentCat = el.getAttribute('data-category');
        if (cat === 'all' || agentCat === cat) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });
    }
</script>
</body>
</html>
