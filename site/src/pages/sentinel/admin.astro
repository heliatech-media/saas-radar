  <!-- ===================================================================== -->
  <!-- SCRIPTS CLIENT DYNAMIQUES : APPEL DES APIS PROTÉGÉES -->
  <!-- ===================================================================== -->
  <script is:inline>
    let isFleetPaused = false;
    let isNewsletterStopped = false;

    // Navigation entre vues
    function showSection(sectionId) {
      document.querySelectorAll('.content-view').forEach(el => el.classList.add('hidden'));
      const target = document.getElementById(sectionId);
      if (target) target.classList.remove('hidden');

      document.querySelectorAll('.nav-btn').forEach(btn => {
        if (btn.getAttribute('data-section') === sectionId) {
          btn.classList.add('bg-cyan-500/15', 'text-cyan-300', 'font-bold', 'border', 'border-cyan-500/30');
          btn.classList.remove('text-slate-400');
        } else {
          btn.classList.remove('bg-cyan-500/15', 'text-cyan-300', 'font-bold', 'border', 'border-cyan-500/30');
          btn.classList.add('text-slate-400');
        }
      });

      if (sectionId === 'view-agents') fetchAgents();
      if (sectionId === 'view-newsletter') fetchSubscribers(false);
      if (sectionId === 'view-audit') fetchAuditLogs();
      if (sectionId === 'view-approvals') fetchApprovals();
    }

    function openModal(modalId) {
      const m = document.getElementById(modalId);
      if (m) m.classList.remove('hidden');
    }

    function closeModal(modalId) {
      const m = document.getElementById(modalId);
      if (m) m.classList.add('hidden');
    }

    // Chargement initial du cockpit
    async function loadCockpit() {
      try {
        const res = await fetch('/api/sentinel/cockpit');
        if (!res.ok) return;
        const data = await res.json();

        isFleetPaused = data.fleet?.status === 'PAUSED';
        isNewsletterStopped = !!data.newsletter?.emergency_stop_active;

        updateButtonsUI();

        if (data.approvals?.pending_count !== undefined) {
          document.getElementById('header-pending-count').innerText = data.approvals.pending_count;
          document.getElementById('sidebar-pending-badge').innerText = data.approvals.pending_count;
          document.getElementById('kpi-approvals-count').innerText = `${data.approvals.pending_count} En Attente`;
        }

        if (data.subscribers_summary?.total) {
          document.getElementById('sidebar-subs-badge').innerText = data.subscribers_summary.total;
          document.getElementById('kpi-subscribers-count').innerText = `${data.subscribers_summary.total} Abonnés Qualifiés`;
        }

        if (data.fleet) {
          document.getElementById('kpi-agents-count').innerText = `${data.fleet.active_agents} / ${data.fleet.total_agents} Agents`;
        }
      } catch (e) {
        console.warn('Erreur chargement cockpit API:', e);
      }
    }

    function updateButtonsUI() {
      const pauseLabel = document.getElementById('pause-btn-label');
      const pauseBtn = document.getElementById('btn-pause-agents');
      if (isFleetPaused) {
        pauseLabel.innerText = 'RESUME AGENTS (SUSPENDU)';
        pauseBtn.className = 'px-3.5 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs transition-all flex items-center gap-2 shadow-lg';
      } else {
        pauseLabel.innerText = 'PAUSE ALL AGENTS';
        pauseBtn.className = 'px-3.5 py-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/40 text-rose-300 font-bold text-xs transition-all flex items-center gap-2';
      }

      const stopLabel = document.getElementById('stop-newsletter-label');
      const stopBtn = document.getElementById('btn-stop-newsletter');
      if (isNewsletterStopped) {
        stopLabel.innerText = 'REPRENDRE NEWSLETTER (GELÉE)';
        stopBtn.className = 'px-3.5 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs transition-all flex items-center gap-2 shadow-lg';
      } else {
        stopLabel.innerText = 'STOP NEWSLETTER';
        stopBtn.className = 'px-3.5 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/40 text-amber-300 font-bold text-xs transition-all flex items-center gap-2';
      }
    }

    // Actions Kill-Switch
    async function confirmPauseAgents() {
      closeModal('modal-pause-agents');
      const action = isFleetPaused ? 'resume' : 'pause';
      try {
        const res = await fetch('/api/sentinel/fleet', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action })
        });
        const data = await res.json();
        isFleetPaused = data.fleet_status === 'PAUSED';
        updateButtonsUI();
        alert(`[JOURNALISÉ] ${data.message}`);
        loadCockpit();
      } catch (e) {
        alert('Erreur communication API: ' + e.message);
      }
    }

    async function confirmStopNewsletter() {
      closeModal('modal-stop-newsletter');
      const action = isNewsletterStopped ? 'resume' : 'emergency-stop';
      try {
        const res = await fetch('/api/sentinel/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action })
        });
        const data = await res.json();
        isNewsletterStopped = !!data.emergency_stop_active;
        updateButtonsUI();
        alert(`[JOURNALISÉ] ${data.message}`);
        loadCockpit();
      } catch (e) {
        alert('Erreur communication API: ' + e.message);
      }
    }

    function confirmTriggerCycle() {
      closeModal('modal-trigger-cycle');
      alert('⚡ [JOURNALISÉ] Cycle d\'audit manuel déclenché sous autorité du propriétaire.');
    }

    // Chargement des 24 agents
    async function fetchAgents() {
      try {
        const res = await fetch('/api/sentinel/agents');
        if (!res.ok) return;
        const data = await res.json();
        const tbody = document.getElementById('agents-tbody');
        tbody.innerHTML = '';

        data.agents.forEach(a => {
          const tr = document.createElement('tr');
          tr.className = a.is_exempt ? 'bg-rose-950/10 hover:bg-rose-950/20' : 'hover:bg-slate-900/40';

          const btnHtml = a.is_exempt
            ? `<span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 text-[10px] font-bold">Protégé (Non-suspensible)</span>`
            : `<button onclick="toggleAgent('${a.name}', this)" class="px-2.5 py-1 rounded ${a.is_suspended ? 'bg-amber-500/20 text-amber-300' : 'bg-slate-800 text-slate-300'} hover:bg-slate-700 font-bold">${a.is_suspended ? 'Réactiver' : 'Suspendre'}</button>`;

          tr.innerHTML = `
            <td class="p-3 font-bold text-white whitespace-nowrap flex items-center gap-1.5">
              ${a.is_exempt ? '<span>🔒</span>' : ''} ${a.name}
            </td>
            <td class="p-3 text-slate-300 min-w-[220px]">${a.role_simple}</td>
            <td class="p-3 text-slate-400 whitespace-nowrap">${a.trigger}</td>
            <td class="p-3 text-emerald-400 whitespace-nowrap">${a.last_run}</td>
            <td class="p-3 text-slate-400 whitespace-nowrap">${a.unit_cost}</td>
            <td class="p-3 text-right whitespace-nowrap">${btnHtml}</td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        console.warn('Erreur chargement agents:', e);
      }
    }

    async function toggleAgent(agentName, btn) {
      try {
        const res = await fetch('/api/sentinel/fleet', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'toggle-agent', agent_name: agentName })
        });
        const data = await res.json();
        if (!res.ok) {
          alert(data.error || 'Erreur');
          return;
        }
        alert(`[JOURNALISÉ] ${data.message}`);
        fetchAgents();
      } catch (e) {
        alert('Erreur: ' + e.message);
      }
    }

    // Chargement des abonnés avec masquage
    async function fetchSubscribers(reveal) {
      try {
        const res = await fetch(`/api/sentinel/subscribers?limit=50&reveal=${reveal ? 'true' : 'false'}`);
        if (!res.ok) return;
        const data = await res.json();
        const tbody = document.getElementById('subscribers-tbody');
        tbody.innerHTML = '';

        data.subscribers.forEach(s => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-900/40';
          tr.innerHTML = `
            <td class="p-3 font-bold text-slate-300 whitespace-nowrap">
              <span class="text-cyan-400">${s.id}</span>
              <span class="ml-1.5 px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-300 text-[10px] font-bold">${s.status}</span>
            </td>
            <td class="p-3 text-white font-mono whitespace-nowrap">${s.email}</td>
            <td class="p-3 text-slate-300">${s.role || 'Décisionnaire SaaS'}</td>
            <td class="p-3 text-slate-400 whitespace-nowrap">${s.country || 'International'}</td>
            <td class="p-3 text-slate-500 whitespace-nowrap">${new Date(s.signup_date).toLocaleDateString('fr-FR')}</td>
            <td class="p-3 text-right text-cyan-400 font-mono text-[11px]">${s.source_path || '/calculator'}</td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        console.warn('Erreur chargement abonnés:', e);
      }
    }

    // Décision sur une approbation
    async function decideApproval(id, decision) {
      const notes = prompt(`Motif ou note de décision patron pour cette action (${decision}) :`, 'Validé sous autorité patron');
      if (notes === null) return;

      try {
        const res = await fetch('/api/sentinel/approvals', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ approval_id: id, decision, decision_notes: notes })
        });
        const data = await res.json();
        alert(`[JOURNALISÉ & SIGNÉ] ${data.message}`);
        loadCockpit();
        showSection('view-general');
      } catch (e) {
        alert('Erreur: ' + e.message);
      }
    }

    // Chargement du journal d'audit
    async function fetchAuditLogs() {
      try {
        const res = await fetch('/api/sentinel/audit');
        if (!res.ok) return;
        const data = await res.json();
        const tbody = document.getElementById('audit-tbody');
        tbody.innerHTML = '';

        data.logs.forEach(l => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-900/40 text-[11px]';
          tr.innerHTML = `
            <td class="p-3 text-slate-400 whitespace-nowrap font-mono">${new Date(l.timestamp).toLocaleString('fr-FR')}</td>
            <td class="p-3 text-emerald-300 font-bold whitespace-nowrap">${l.actor_email}</td>
            <td class="p-3 text-white font-bold whitespace-nowrap">${l.action}</td>
            <td class="p-3 text-cyan-300 whitespace-nowrap font-mono">${l.target}</td>
            <td class="p-3 text-slate-400 whitespace-nowrap font-mono">${l.previous_state || '—'} → <strong class="text-white">${l.new_state || '—'}</strong></td>
            <td class="p-3 text-right text-slate-500 font-mono text-[9px]">${l.signature.substring(0, 16)}...</td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        console.warn('Erreur chargement audit:', e);
      }
    }

    // Initialisation au chargement
    document.addEventListener('DOMContentLoaded', () => {
      loadCockpit();
    });
  </script>
</body>
</html>
