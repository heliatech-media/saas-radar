---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

// Exclude strictly from search engine indexing
const metaRobots = "noindex, nofollow, noarchive, nosnippet";

const reviews = await getCollection('reviews');
const blogPosts = await getCollection('blog');

// Determine path to project root
const isSiteCwd = fs.existsSync('public/_redirects');
const rootDir = isSiteCwd ? path.resolve('..') : path.resolve('.');
const redirectsPath = path.resolve(rootDir, 'site/public/_redirects');
const reportsDir = path.resolve(rootDir, 'reports');

// Read edge redirects
let redirectsList: { path: string; target: string; isMonetized: boolean }[] = [];
try {
  if (fs.existsSync(redirectsPath)) {
    const raw = fs.readFileSync(redirectsPath, 'utf-8');
    redirectsList = raw.split('\n')
      .filter(l => l.startsWith('/go/'))
      .map(l => {
        const parts = l.trim().split(/\s+/);
        const p = parts[0] || '';
        const target = parts[1] || '';
        const isMonetized = (
          target.includes('?') || 
          target.includes('partner') || 
          target.includes('affiliate') || 
          target.includes('try.') || 
          target.includes('.grsm.io') || 
          target.includes('via=') || 
          target.includes('fpr') || 
          target.includes('ref=')
        );
        return { path: p, target, isMonetized };
      });
  }
} catch (e) {}

// Read latest executive report
let executiveReportText = "";
try {
  const reportFile = path.resolve(reportsDir, 'executive_report_2026-10-23.md');
  if (fs.existsSync(reportFile)) {
    executiveReportText = fs.readFileSync(reportFile, 'utf-8');
  }
} catch (e) {}

// Read latest social calendar
let socialCalendarText = "";
try {
  const calFile = path.resolve(reportsDir, 'social_schedule_calendar.md');
  if (fs.existsSync(calFile)) {
    socialCalendarText = fs.readFileSync(calFile, 'utf-8');
  }
} catch (e) {}

// Read live business intelligence telemetry (Helia-DataVisualizer)
let liveTelemetry: any = null;
try {
  const telFile = path.resolve(rootDir, 'site/src/data/live_telemetry.json');
  if (fs.existsSync(telFile)) {
    liveTelemetry = JSON.parse(fs.readFileSync(telFile, 'utf-8'));
  }
} catch (e) {}

// Read CRO telemetry (Helia-CRO)
let croTelemetry: any = null;
try {
  const croFile = path.resolve(reportsDir, 'cro_telemetry.json');
  if (fs.existsSync(croFile)) {
    croTelemetry = JSON.parse(fs.readFileSync(croFile, 'utf-8'));
  }
} catch (e) {}

// Read Auto-Evolution Telemetry (Helia-AutoEvolution)
let evolutionTelemetry: any = null;
try {
  const evoFile = path.resolve(rootDir, 'site/src/data/evolution_telemetry.json');
  if (fs.existsSync(evoFile)) {
    evolutionTelemetry = JSON.parse(fs.readFileSync(evoFile, 'utf-8'));
  }
} catch (e) {}

// Compile catalog
const catalog = {
  articlesCount: blogPosts.length,
  reviewsCount: reviews.length,
  monetizedCount: redirectsList.filter(r => r.isMonetized).length,
  totalRedirects: redirectsList.length,
  tools: reviews.map(r => {
    const red = redirectsList.find(x => x.path === `/go/${r.slug}`);
    return {
      slug: r.slug,
      name: r.data.name,
      category: r.data.category,
      rating: r.data.rating,
      pricing: r.data.pricing_tier,
      affiliateUrl: red ? red.target : (r.data.affiliate_url || r.data.website_url),
      isMonetized: red ? red.isMonetized : false
    };
  }),
  articles: blogPosts.map(b => ({
    slug: b.slug,
    title: b.data.title,
    category: b.data.category,
    readingTime: b.data.reading_time || '8 min read',
    publishDate: b.data.publish_date
  }))
};
---

