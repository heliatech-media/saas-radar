---
// HeliaTech Sentinel Admin V2.0 — Console de Pilotage Patron
// ============================================================================
// Architecture : Zero Static Leakage (SPA dynamique servie par Astro)
// Aucune donnée personnelle (PII) ni état opérationnel n'est compilé en dur.
// Toute la donnée est consommée à l'exécution via les APIs protégées /api/sentinel/*
// Phase 1 + Phase 2 Déployées : Pilotage + Production Éditoriale & Commerciale

const metaRobots = "noindex, nofollow, noarchive, nosnippet";
---

<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>HeliaTech Sentinel // Console Patron V2</title>
  <meta name="robots" content={metaRobots} />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            obsidian: '#030508',
            surface: '#090d15',
            card: '#0f1724',
            border: '#1a2436',
            cyanAccent: '#06b6d4',
            emeraldAccent: '#10b981',
            roseAccent: '#f43f5e',
            amberAccent: '#f59e0b'
          }
        }
      }
    }
  </script>
  <style>
    body { background-color: #030508; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #090d15; }
    ::-webkit-scrollbar-thumb { background: #1a2436; border-radius: 3px; }
  </style>
</head>
<body class="text-slate-200 min-h-screen flex flex-col antialiased selection:bg-cyan-500/30 selection:text-cyan-200">

  <!-- ===================================================================== -->
  <!-- BARRE SUPRÊME : STATUT OWNER, MFA ET BOUTONS D'URGENCE RENFORCÉS -->
  <!-- ===================================================================== -->
  <header class="sticky top-0 z-50 bg-[#060a12]/95 backdrop-blur-xl border-b border-slate-800/90 px-6 py-3 flex flex-wrap items-center justify-between gap-4 shadow-2xl">
    <div class="flex items-center gap-3.5">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-500/20 to-emerald-500/20 border border-cyan-500/40 flex items-center justify-center text-cyan-400 font-black shadow-inner">
        🛡️
      </div>
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="text-xs font-black tracking-widest text-white uppercase font-sans">HeliaTech Sentinel Admin</h1>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 flex items-center gap-1">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            OWNER : Validé Cloudflare Access (MFA)
          </span>
        </div>
        <div class="text-[10px] text-slate-400 font-mono">Stockage Transactionnel ACID • Cadence 48h • Approbation Patron Souveraine</div>
      </div>
    </div>

    <!-- BOUTONS D'URGENCE DU PROPRIÉTAIRE -->
    <div class="flex flex-wrap items-center gap-2.5">
      <!-- KILL-SWITCH 1 : PAUSE AGENTS -->
      <button onclick="openModal('modal-pause-agents')" id="btn-pause-agents" class="px-3.5 py-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/40 text-rose-300 font-bold text-xs transition-all flex items-center gap-2 active:scale-95 shadow-lg shadow-rose-950/20">
        <span>🛑</span> <span id="pause-btn-label">PAUSE ALL AGENTS</span>
      </button>

      <!-- KILL-SWITCH 2 : STOP NEWSLETTER -->
      <button onclick="openModal('modal-stop-newsletter')" id="btn-stop-newsletter" class="px-3.5 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/40 text-amber-300 font-bold text-xs transition-all flex items-center gap-2 active:scale-95 shadow-lg shadow-amber-950/20">
        <span>✋</span> <span id="stop-newsletter-label">STOP NEWSLETTER</span>
      </button>

      <!-- DÉCLENCHEMENT MANUEL -->
      <button onclick="openModal('modal-trigger-cycle')" class="px-3.5 py-1.5 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 border border-cyan-500/40 text-cyan-300 font-bold text-xs transition-all flex items-center gap-2 active:scale-95 shadow-lg shadow-cyan-950/20">
        <span>⚡</span> Déclencher Cycle Manuel
      </button>

      <div class="h-6 w-px bg-slate-800 hidden sm:block"></div>

      <!-- COMPTEUR APPROBATIONS EN ATTENTE -->
      <button onclick="showSection('view-approvals')" class="px-3 py-1.5 rounded-xl bg-indigo-500/15 hover:bg-indigo-500/25 border border-indigo-500/40 text-indigo-300 text-xs font-bold transition-all flex items-center gap-1.5">
        <span>⏳</span> Approbations : <strong id="header-pending-count" class="text-white bg-indigo-500/40 px-1.5 py-0.2 rounded">1</strong>
      </button>
    </div>
  </header>

  <!-- ===================================================================== -->
  <!-- CORPS DU DASHBOARD : NAVIGATION 4 CATÉGORIES -->
  <!-- ===================================================================== -->
  <div class="flex-1 flex overflow-hidden">
    
    <!-- SIDEBAR DE NAVIGATION -->
    <aside class="w-64 bg-[#05080f] border-r border-slate-800/80 p-3.5 flex flex-col justify-between shrink-0 overflow-y-auto">
      <div class="space-y-4 text-xs font-mono">
        
        <!-- CATÉGORIE 1 : PILOTAGE -->
        <div>
          <div class="text-[10px] font-bold text-cyan-400 uppercase tracking-widest px-2.5 py-1 flex items-center justify-between">
            <span>1. Pilotage</span>
            <span class="text-[9px] text-slate-500 font-normal">Commandement</span>
          </div>
          <div class="space-y-0.5 mt-1">
            <button onclick="showSection('view-general')" class="nav-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left bg-cyan-500/15 text-cyan-300 font-bold border border-cyan-500/30" data-section="view-general">
              <span>📊</span> Vue Générale (Cockpit)
            </button>
            <button onclick="showSection('view-agents')" class="nav-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-agents">
              <span>🤖</span> Les 24 Agents IA <span class="ml-auto text-[10px] px-1.5 py-0.2 rounded bg-slate-800 text-cyan-400 font-bold">24</span>
            </button>
            <button onclick="showSection('view-crons')" class="nav-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-crons">
              <span>⏰</span> Automatisations & Crons
            </button>
            <button onclick="showSection('view-deploys')" class="nav-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-deploys">
              <span>🚀</span> Déploiements & Santé Edge
            </button>
          </div>
        </div>

        <!-- CATÉGORIE 2 : PRODUCTION (PHASE 2 COMPLÈTE) -->
        <div class="p-1.5 rounded-xl bg-indigo-950/20 border border-indigo-500/30">
          <div class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest px-2 py-1 flex items-center justify-between">
            <span>2. Production</span>
            <span class="text-[8px] bg-indigo-500/30 text-indigo-200 px-1.5 rounded font-black">PHASE 2</span>
          </div>
          <div class="space-y-0.5 mt-1">
            <button onclick="showSection('view-approvals')" class="nav-btn w-full flex items-center gap-2 px-2.5 py-2 rounded-lg text-left text-indigo-300 hover:bg-slate-900 transition-all font-bold" data-section="view-approvals">
              <span>⚖️</span> File d'Approbation <span id="sidebar-pending-badge" class="ml-auto text-[10px] px-1.5 py-0.2 rounded bg-indigo-500/30 text-indigo-200">1</span>
            </button>
            <button onclick="showSection('view-content')" class="nav-btn w-full flex items-center gap-2 px-2.5 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-content">
              <span>📝</span> Contenus (Articles & Fiches) <span id="sidebar-content-badge" class="ml-auto text-[10px] text-slate-500">167</span>
            </button>
            <button onclick="showSection('view-deals')" class="nav-btn w-full flex items-center gap-2 px-2.5 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-deals">
              <span>🏷️</span> Deals & Promos (48h) <span id="sidebar-deals-badge" class="ml-auto text-[10px] text-emerald-400 font-bold">12</span>
            </button>
            <button onclick="showSection('view-radar')" class="nav-btn w-full flex items-center gap-2 px-2.5 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-radar">
              <span>📡</span> Radar de Veille (Trends) <span class="ml-auto text-[10px] text-cyan-400 font-bold">6</span>
            </button>
            <button onclick="showSection('view-versus')" class="nav-btn w-full flex items-center gap-2 px-2.5 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-versus">
              <span>⚔️</span> Duels Versus <span class="ml-auto text-[10px] text-slate-500">19</span>
            </button>
            <button onclick="showSection('view-newsletter')" class="nav-btn w-full flex items-center gap-2 px-2.5 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-newsletter">
              <span>📬</span> Newsletter & Abonnés <span id="sidebar-subs-badge" class="ml-auto text-[10px] text-fuchsia-400 font-bold">141</span>
            </button>
            <button onclick="showSection('view-revenue')" class="nav-btn w-full flex items-center gap-2 px-2.5 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-revenue">
              <span>💰</span> Revenus & Partenariats <span class="ml-auto text-[10px] text-emerald-400">96 liens</span>
            </button>
          </div>
        </div>

        <!-- CATÉGORIE 3 : GOUVERNANCE -->
        <div>
          <div class="text-[10px] font-bold text-amber-400 uppercase tracking-widest px-2.5 py-1 flex items-center justify-between">
            <span>3. Gouvernance</span>
            <span class="text-[9px] text-slate-500 font-normal">Sécurité & Données</span>
          </div>
          <div class="space-y-0.5 mt-1">
            <button onclick="showSection('view-data')" class="nav-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-data">
              <span>💾</span> Base Transactionnelle D1/WAL
            </button>
            <button onclick="showSection('view-security')" class="nav-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-security">
              <span>🔒</span> Sécurité & Cloudflare Access
            </button>
            <button onclick="showSection('view-audit')" class="nav-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-audit">
              <span>📋</span> Journal d'Audit des Actions
            </button>
            <button onclick="showSection('view-settings')" class="nav-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-settings">
              <span>⚙️</span> Paramètres & Secrets Masqués
            </button>
          </div>
        </div>

        <!-- CATÉGORIE 4 : SUPPORT -->
        <div>
          <div class="text-[10px] font-bold text-purple-400 uppercase tracking-widest px-2.5 py-1 flex items-center justify-between">
            <span>4. Support</span>
            <span class="text-[9px] text-slate-500 font-normal">Compréhension</span>
          </div>
          <div class="space-y-0.5 mt-1">
            <button onclick="showSection('view-help')" class="nav-btn w-full flex items-center gap-2 px-3 py-2 rounded-lg text-left text-slate-400 hover:text-white hover:bg-slate-900 transition-all" data-section="view-help">
              <span>💡</span> Centre d'Aide Patron
            </button>
          </div>
        </div>

      </div>

      <div class="pt-3 border-t border-slate-800/80 text-[11px] font-mono text-slate-500 space-y-1">
        <div class="flex justify-between"><span>Rôle Actif :</span> <strong class="text-emerald-300">owner (patron)</strong></div>
        <div class="flex justify-between"><span>Cadence Deals :</span> <strong class="text-cyan-400">48h (Méthodo v2.4)</strong></div>
        <div class="flex justify-between"><span>Edge Cloudflare :</span> <strong class="text-emerald-400">Zero Trust OK</strong></div>
      </div>
    </aside>

    <!-- ZONE DE CONTENU PRINCIPAL -->
    <main class="flex-1 bg-[#030508] p-6 overflow-y-auto space-y-6">

      <!-- =================================================================== -->
      <!-- VUE 1 : VUE GÉNÉRALE (COCKPIT EXÉCUTIF) -->
      <!-- =================================================================== -->
      <section id="view-general" class="content-view space-y-6">
        <div class="p-6 rounded-2xl bg-gradient-to-r from-slate-900 via-[#0a101d] to-slate-950 border border-slate-800 relative shadow-xl">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2 text-xs font-mono text-emerald-400 mb-1">
                <span>●</span> <span id="fleet-live-badge">SYSTÈME EN FONCTIONNEMENT OPTIMAL • PROTOCOLE SENTINEL ACTIF</span>
              </div>
              <h2 class="text-lg font-black text-white font-sans">
                Bonjour Patron. Voici la situation en direct de votre plateforme HeliaTech.
              </h2>
              <p class="text-xs text-slate-400 mt-1 max-w-2xl leading-relaxed">
                Vos 24 agents automatisés surveillent l'actualité logicielle, rédigent les analyses et préparent la prochaine newsletter. Aucune publication ni envoi ne peut partir sans votre accord explicite ci-dessous.
              </p>
            </div>
            
            <div class="flex flex-col items-end gap-1.5 shrink-0">
              <span class="px-3 py-1.5 rounded-xl bg-slate-800/80 border border-slate-700 text-xs font-mono text-slate-300">
                Stockage Privé : <span class="text-emerald-400 font-bold">sentinel_governance.db</span>
              </span>
              <span class="text-[11px] font-mono text-slate-500">
                Zero Static PII Leakage Garanti
              </span>
            </div>
          </div>
        </div>

        <!-- LES 4 BLOCS D'ÉTAT FONDAMENTAUX -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-xs font-mono">
          <div class="p-5 rounded-2xl bg-[#080d16] border border-emerald-500/30 shadow-lg shadow-emerald-950/10">
            <div class="flex justify-between items-start">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">1. Fonctionne Actuellement</span>
              <span class="text-emerald-400 text-sm">✓</span>
            </div>
            <div id="kpi-agents-count" class="text-2xl font-black text-white mt-2">24 / 24 Agents</div>
            <div class="text-[11px] text-emerald-400 mt-1">Veille, analyses, SEO et sécurité actifs</div>
            <div class="mt-3 pt-3 border-t border-slate-800 text-[10px] text-slate-500">Coût moyen : $0.00116 / article</div>
          </div>

          <div class="p-5 rounded-2xl bg-[#080d16] border border-amber-500/30 shadow-lg shadow-amber-950/10">
            <div class="flex justify-between items-start">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">2. En Attente d'Envoi</span>
              <span class="text-amber-400 text-sm">⏳</span>
            </div>
            <div id="kpi-newsletter-date" class="text-2xl font-black text-amber-300 mt-2">Jeudi 12 Nov.</div>
            <div class="text-[11px] text-slate-300 mt-1">Fenêtre 09:00 America/New_York</div>
            <div class="mt-3 pt-3 border-t border-slate-800 text-[10px] text-amber-400 font-bold">Brouillon #055 verrouillé (ACID)</div>
          </div>

          <div class="p-5 rounded-2xl bg-[#080d16] border border-emerald-500/30 shadow-lg shadow-emerald-950/10">
            <div class="flex justify-between items-start">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 font-bold">3. Cadence Deals (48h)</span>
              <span class="text-emerald-400 text-sm">🛡️</span>
            </div>
            <div id="kpi-deals-status" class="text-2xl font-black text-emerald-400 mt-2">12 / 12 Actifs</div>
            <div class="text-[11px] text-slate-400 mt-1">Conforme Méthodologie v2.4</div>
            <div class="mt-3 pt-3 border-t border-slate-800 text-[10px] text-slate-500">Scan automatique HTTP 200</div>
          </div>

          <div class="p-5 rounded-2xl bg-[#080d16] border border-indigo-500/40 shadow-lg shadow-indigo-950/20">
            <div class="flex justify-between items-start">
              <span class="text-[10px] uppercase tracking-wider text-indigo-300 font-bold">4. Approbation Patron</span>
              <span class="px-1.5 py-0.2 rounded bg-indigo-500/30 text-indigo-200 text-[10px] font-bold">Action</span>
            </div>
            <div id="kpi-approvals-count" class="text-2xl font-black text-white mt-2">1 En Attente</div>
            <div class="text-[11px] text-indigo-300 mt-1">Newsletter #055 (Focus : Cursor)</div>
            <div class="mt-3 pt-3 border-t border-slate-800 flex justify-between items-center">
              <span class="text-[10px] text-slate-500">Exige votre clic</span>
              <button onclick="showSection('view-approvals')" class="text-[10px] text-indigo-400 hover:text-indigo-200 font-bold underline">Examiner Diff →</button>
            </div>
          </div>
        </div>

        <!-- SYNTHÈSE DES CONTENUS & DEALS -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono">
          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 flex flex-col justify-between space-y-3">
            <div>
              <div class="text-cyan-300 font-bold flex items-center gap-1.5 mb-1">
                <span>📬</span> Newsletter #055 prête
              </div>
              <p class="text-slate-400 text-[11px] leading-relaxed">
                Édition du 12 nov. avec visualisateur de diff actif. Le contenu est vérifié sans redite (SHA-256).
              </p>
            </div>
            <button onclick="showSection('view-approvals')" class="w-full py-2 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-300 border border-cyan-500/40 font-bold text-[11px] transition-all">
              Voir Diff & Valider
            </button>
          </div>

          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 flex flex-col justify-between space-y-3">
            <div>
              <div class="text-emerald-300 font-bold flex items-center gap-1.5 mb-1">
                <span>🏷️</span> 12 Deals Partenaires
              </div>
              <p class="text-slate-400 text-[11px] leading-relaxed">
                Revérification stricte toutes les 48 heures. Codes promo et termes vérifiés sans coupon périmé.
              </p>
            </div>
            <button onclick="showSection('view-deals')" class="w-full py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-[11px] transition-all">
              Superviser les Deals (48h)
            </button>
          </div>

          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 flex flex-col justify-between space-y-3">
            <div>
              <div class="text-amber-300 font-bold flex items-center gap-1.5 mb-1">
                <span>📝</span> 167 Contenus & Preuves
              </div>
              <p class="text-slate-400 text-[11px] leading-relaxed">
                Guides, fiches outils et benchmarks chiffrés sous protocole de vérification TCO continue (±15%).
              </p>
            </div>
            <button onclick="showSection('view-content')" class="w-full py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-bold text-[11px] transition-all">
              Gérer les Contenus
            </button>
          </div>
        </div>
      </section>

      <!-- =================================================================== -->
      <!-- VUE 2 : CARTE DES 24 AGENTS IA -->
      <!-- =================================================================== -->
      <section id="view-agents" class="content-view hidden space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-800">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-lg">🤖</span>
              <h2 class="text-base font-black text-white font-sans uppercase">
                Carte de Contrôle des 24 Agents Autonomes
              </h2>
            </div>
            <p class="text-xs text-slate-400 font-mono mt-0.5">
              Chaque agent est dédié à une tâche précise. Vous pouvez suspendre individuellement n'importe quel agent non critique.
            </p>
          </div>
          <span id="agents-status-pill" class="px-2.5 py-1 rounded-lg bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 text-xs font-mono font-bold">
            24/24 Opérationnels
          </span>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-[#070b13]">
          <table class="w-full text-left text-xs font-mono">
            <thead class="bg-slate-900/80 border-b border-slate-800 text-slate-400 text-[10px] uppercase">
              <tr>
                <th class="p-3">Agent</th>
                <th class="p-3">Rôle en Langage Simple</th>
                <th class="p-3">Déclencheur</th>
                <th class="p-3">Dernier Run & Résultat</th>
                <th class="p-3">Coût Unitaire</th>
                <th class="p-3 text-right">Contrôle Patron</th>
              </tr>
            </thead>
            <tbody id="agents-tbody" class="divide-y divide-slate-800/60">
              <tr><td colspan="6" class="p-6 text-center text-slate-500">Chargement sécurisé de la flotte d'agents...</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- =================================================================== -->
      <!-- VUE 3 : FILE D'APPROBATION ENRICHIE (DIFF VIEWER) -->
      <!-- =================================================================== -->
      <section id="view-approvals" class="content-view hidden space-y-6">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-lg">⚖️</span>
              <h2 class="text-base font-black text-white font-sans uppercase">
                File d'Approbation Patron avec Visualisateur de Diff
              </h2>
            </div>
            <p class="text-xs text-slate-400 font-mono mt-0.5">
              Inspectez ligne par ligne les différences éditoriales avant toute validation publique.
            </p>
          </div>
          <span class="px-2.5 py-1 rounded-lg bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 text-xs font-mono font-bold">
            Rôle Requis : owner
