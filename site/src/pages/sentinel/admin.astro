          alert(`[SONDAGE TECHNIQUE RÉUSSI]\n${data.message}`);
        } else {
          alert(`[ALERTE LIEN TECHNIQUE]\n${data.error || 'Erreur lors du sondage HTTP.'}`);
        }
        fetchDeals();
      } catch (e) {
        alert('Erreur réseau : ' + e.message);
      } finally {
