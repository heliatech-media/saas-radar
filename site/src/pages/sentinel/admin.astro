        <!-- TAB 4: CALENDRIER SOCIAL -->
        <div id="tab-social" class="tab-content hidden space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-lg font-black text-white flex items-center gap-2">
              <span>📅</span> Calendrier & Campagnes Sociales de Helia
            </h2>
            <span class="text-xs font-mono text-cyan-400">Diffusion X/Twitter, LinkedIn & Reddit</span>
          </div>

          <div class="p-6 rounded-2xl bg-slate-950 border border-slate-800 font-mono text-xs text-slate-300 overflow-x-auto whitespace-pre-wrap leading-relaxed max-h-[600px] overflow-y-auto custom-scrollbar">
            {socialCalendarText || "Calendrier en cours de synchronisation par Helia-SocialScheduler..."}
          </div>
        </div>

        <!-- TAB 5: RAPPORT EXÉCUTIF -->
        <div id="tab-report" class="tab-content hidden space-y-4">
          <div class="flex items-center justify-between">
