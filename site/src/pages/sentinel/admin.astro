  <script is:inline>
    let isFleetPaused = false;
    let isNewsletterStopped = false;

    function showSection(sectionId) {
      document.querySelectorAll('.content-view').forEach(el => el.classList.add('hidden'));
      const target = document.getElementById(sectionId);
      if (target) target.classList.remove('hidden');

      document.querySelectorAll('.nav-btn').forEach(btn => {
        if (btn.getAttribute('data-section') === sectionId) {
          btn.classList.add('bg-cyan-500/15', 'text-cyan-300', 'font-bold', 'border', 'border-cyan-500/30');
          btn.classList.remove('text-slate-400');
        } else {
          btn.classList.remove('bg-cyan-500/15', 'text-cyan-300', 'font-bold', 'border', 'border-cyan-500/30');
          btn.classList.add('text-slate-400');
        }
      });

      if (sectionId === 'view-agents') fetchAgents();
      if (sectionId === 'view-content') fetchContent();
      if (sectionId === 'view-deals') fetchDeals();
      if (sectionId === 'view-radar') fetchRadar();
      if (sectionId === 'view-versus') fetchVersus();
      if (sectionId === 'view-newsletter') fetchSubscribers(false);
      if (sectionId === 'view-audit') fetchAuditLogs();
      if (sectionId === 'view-approvals') fetchApprovals();
    }

    function openModal(modalId) {
      const m = document.getElementById(modalId);
      if (m) m.classList.remove('hidden');
    }

    function closeModal(modalId) {
      const m = document.getElementById(modalId);
      if (m) m.classList.add('hidden');
    }

    async function loadCockpit() {
      try {
        const res = await fetch('/api/sentinel/cockpit');
        if (!res.ok) return;
        const data = await res.json();

        isFleetPaused = data.fleet?.status === 'PAUSED';
        isNewsletterStopped = !!data.newsletter?.emergency_stop_active;
        updateButtonsUI();

        if (data.approvals?.pending_count !== undefined) {
          document.getElementById('header-pending-count').innerText = data.approvals.pending_count;
          document.getElementById('sidebar-pending-badge').innerText = data.approvals.pending_count;
          document.getElementById('kpi-approvals-count').innerText = `${data.approvals.pending_count} En Attente`;
        }

        if (data.subscribers_summary?.total) {
          document.getElementById('sidebar-subs-badge').innerText = data.subscribers_summary.total;
        }

        if (data.fleet) {
          document.getElementById('kpi-agents-count').innerText = `${data.fleet.active_agents} / ${data.fleet.total_agents} Agents`;
        }
      } catch (e) {
        console.warn('Erreur cockpit:', e);
      }
    }

    function updateButtonsUI() {
      const pauseLabel = document.getElementById('pause-btn-label');
      const pauseBtn = document.getElementById('btn-pause-agents');
      if (isFleetPaused) {
        pauseLabel.innerText = 'RESUME AGENTS (SUSPENDU)';
        pauseBtn.className = 'px-3.5 py-1.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs transition-all flex items-center gap-2 shadow-lg';
      } else {
        pauseLabel.innerText = 'PAUSE ALL AGENTS';
        pauseBtn.className = 'px-3.5 py-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/40 text-rose-300 font-bold text-xs transition-all flex items-center gap-2';
      }

      const stopLabel = document.getElementById('stop-newsletter-label');
      const stopBtn = document.getElementById('btn-stop-newsletter');
      if (isNewsletterStopped) {
        stopLabel.innerText = 'REPRENDRE NEWSLETTER (GELÉE)';
        stopBtn.className = 'px-3.5 py-1.5 rounded-xl bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs transition-all flex items-center gap-2 shadow-lg';
      } else {
        stopLabel.innerText = 'STOP NEWSLETTER';
        stopBtn.className = 'px-3.5 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/40 text-amber-300 font-bold text-xs transition-all flex items-center gap-2';
      }
    }

    async function confirmPauseAgents() {
      closeModal('modal-pause-agents');
      const action = isFleetPaused ? 'resume' : 'pause';
      try {
        const res = await fetch('/api/sentinel/fleet', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action })
        });
        const data = await res.json();
        isFleetPaused = data.fleet_status === 'PAUSED';
        updateButtonsUI();
        alert(`[JOURNALISÉ] ${data.message}`);
        loadCockpit();
      } catch (e) {
        alert('Erreur: ' + e.message);
      }
    }

    async function confirmStopNewsletter() {
      closeModal('modal-stop-newsletter');
      const action = isNewsletterStopped ? 'resume' : 'emergency-stop';
      try {
        const res = await fetch('/api/sentinel/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action })
        });
        const data = await res.json();
        isNewsletterStopped = !!data.emergency_stop_active;
        updateButtonsUI();
        alert(`[JOURNALISÉ] ${data.message}`);
        loadCockpit();
      } catch (e) {
        alert('Erreur: ' + e.message);
      }
    }

    function confirmTriggerCycle() {
      closeModal('modal-trigger-cycle');
      alert('⚡ [JOURNALISÉ] Cycle d\'audit manuel déclenché sous autorité du propriétaire.');
    }

    // 1. Chargement des 24 agents
    async function fetchAgents() {
      try {
        const res = await fetch('/api/sentinel/agents');
        if (!res.ok) return;
        const data = await res.json();
        const tbody = document.getElementById('agents-tbody');
        tbody.innerHTML = '';

        data.agents.forEach(a => {
          const tr = document.createElement('tr');
          tr.className = a.is_exempt ? 'bg-rose-950/10 hover:bg-rose-950/20' : 'hover:bg-slate-900/40';

          const btnHtml = a.is_exempt
            ? `<span class="px-2 py-0.5 rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 text-[10px] font-bold">Protégé (Non-suspensible)</span>`
            : `<button onclick="toggleAgent('${a.name}')" class="px-2.5 py-1 rounded ${a.is_suspended ? 'bg-amber-500/20 text-amber-300' : 'bg-slate-800 text-slate-300'} hover:bg-slate-700 font-bold">${a.is_suspended ? 'Réactiver' : 'Suspendre'}</button>`;

          tr.innerHTML = `
            <td class="p-3 font-bold text-white whitespace-nowrap flex items-center gap-1.5">
              ${a.is_exempt ? '<span>🔒</span>' : ''} ${a.name}
            </td>
            <td class="p-3 text-slate-300 min-w-[220px]">${a.role_simple}</td>
            <td class="p-3 text-slate-400 whitespace-nowrap">${a.trigger}</td>
            <td class="p-3 text-emerald-400 whitespace-nowrap">${a.last_run}</td>
            <td class="p-3 text-slate-400 whitespace-nowrap">${a.unit_cost}</td>
            <td class="p-3 text-right whitespace-nowrap">${btnHtml}</td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        console.warn('Erreur agents:', e);
      }
    }

    async function toggleAgent(agentName) {
      try {
        const res = await fetch('/api/sentinel/fleet', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'toggle-agent', agent_name: agentName })
        });
        const data = await res.json();
        if (!res.ok) { alert(data.error || 'Erreur'); return; }
        alert(`[JOURNALISÉ] ${data.message}`);
        fetchAgents();
      } catch (e) {
        alert('Erreur: ' + e.message);
      }
    }

    // 2. Phase 2 : Chargement des 167 Contenus & Réaudit
    async function fetchContent() {
      try {
        const res = await fetch('/api/sentinel/content?limit=50');
        if (!res.ok) return;
        const data = await res.json();
        const tbody = document.getElementById('content-tbody');
        tbody.innerHTML = '';

        if (data.total) {
          document.getElementById('sidebar-content-badge').innerText = data.total;
        }

        data.content.forEach(item => {
          const tr = document.createElement('tr');
          tr.className = item.audit_status === 'NEEDS_REAUDIT' ? 'bg-amber-950/10 hover:bg-amber-950/20' : 'hover:bg-slate-900/40';
          
          tr.innerHTML = `
            <td class="p-3 font-bold text-white">
              <div>${item.title}</div>
              <div class="text-[10px] text-slate-500">/${item.type === 'review' ? 'reviews' : 'blog'}/${item.slug}/</div>
            </td>
            <td class="p-3">
              <span class="px-2 py-0.5 rounded text-[10px] font-bold ${item.type === 'review' ? 'bg-emerald-500/20 text-emerald-300' : 'bg-cyan-500/20 text-cyan-300'}">${item.type.toUpperCase()}</span>
            </td>
            <td class="p-3 text-emerald-400 font-bold">${item.evidence_count} sources vérifiées</td>
            <td class="p-3 text-white">${item.tco_accuracy_score}/10 <span class="text-slate-500 text-[10px]">(±15%)</span></td>
            <td class="p-3 text-slate-400">${new Date(item.last_audited_at).toLocaleDateString('fr-FR')}</td>
            <td class="p-3 text-right">
              <button onclick="reAuditContent('${item.slug}')" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold">Réauditer</button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        console.warn('Erreur contenus:', e);
      }
    }

    async function reAuditContent(slug) {
      try {
        const res = await fetch('/api/sentinel/content', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 're-audit', slug })
        });
        const data = await res.json();
        alert(`[JOURNALISÉ] ${data.message}`);
        fetchContent();
      } catch (e) {
        alert('Erreur: ' + e.message);
      }
    }

    // 3. Phase 2 : Chargement des 12 Deals & Cadence 48h
    async function fetchDeals() {
      try {
        const res = await fetch('/api/sentinel/deals');
        if (!res.ok) return;
        const data = await res.json();
        const grid = document.getElementById('deals-grid');
        grid.innerHTML = '';

        if (data.total) {
          document.getElementById('sidebar-deals-badge').innerText = data.total;
          document.getElementById('kpi-deals-status').innerText = `${data.total} / ${data.total} Actifs`;
        }

        data.deals.forEach(d => {
          const card = document.createElement('div');
          const isWarning = d.cadence_status !== 'VERIFIED_OK';
          card.className = `p-5 rounded-2xl bg-[#080d16] border ${isWarning ? 'border-amber-500/40 bg-amber-950/10' : 'border-slate-800'} flex flex-col justify-between space-y-4`;

          card.innerHTML = `
            <div>
              <div class="flex justify-between items-start">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300">${d.tool_name}</span>
                <span class="text-[10px] font-bold ${isWarning ? 'text-amber-400' : 'text-emerald-400'}">
                  ${isWarning ? `Vérification Requise (${d.elapsed_hours}h écoulées)` : `Vérifié il y a ${d.elapsed_hours}h`}
                </span>
              </div>
              <h3 class="text-sm font-bold text-white mt-2">${d.perk_title}</h3>
              <p class="text-slate-400 text-[11px] mt-1">${d.partner_code ? `Code promo : <code class="text-cyan-300 font-bold">${d.partner_code}</code>` : `Lien affilié : <code class="text-cyan-300">${d.affiliate_url}</code>`}</p>
              <div class="text-[10px] text-slate-500 mt-2">${d.savings_estimate}</div>
            </div>

            <div class="pt-3 border-t border-slate-800 flex justify-between items-center">
              <span class="text-[10px] text-slate-400">Reste : <strong class="${isWarning ? 'text-amber-400' : 'text-emerald-400'}">${d.remaining_hours}h sur 48h</strong></span>
              <button onclick="verifyDeal('${d.tool_slug}', this)" class="px-2.5 py-1 rounded ${isWarning ? 'bg-amber-500/20 text-amber-300 border border-amber-500/40' : 'bg-slate-800 text-slate-300'} hover:bg-slate-700 font-bold text-[11px]">
                Lancer Audit Réel (48h)
              </button>
            </div>
          `;
          grid.appendChild(card);
        });
      } catch (e) {
        console.warn('Erreur deals:', e);
      }
    }

    async function verifyDeal(slug, btn) {
      if (btn) {
        btn.innerText = 'Audit HTTP...';
        btn.disabled = true;
      }
      try {
        const res = await fetch('/api/sentinel/deals', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'audit', deal_slug: slug })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          alert(`[AUDIT RÉEL RÉUSSI]\n${data.message}`);
        } else {
          alert(`[ALERTE AUDIT ÉCHOUÉ]\n${data.error || 'Erreur lors du sondage HTTP.'}`);
        }
        fetchDeals();
      } catch (e) {
        alert('Erreur réseau lors du sondage : ' + e.message);
      } finally {
        if (btn) {
          btn.innerText = 'Lancer Audit Réel (48h)';
          btn.disabled = false;
        }
      }
    }

    // 4. Phase 2 : Chargement du Radar de Veille
    async function fetchRadar() {
      try {
        const res = await fetch('/api/sentinel/radar');
        if (!res.ok) return;
        const data = await res.json();
        const container = document.getElementById('radar-container');
        container.innerHTML = '';

        data.radar_trends.forEach(t => {
          const item = document.createElement('div');
          item.className = 'p-4 rounded-xl bg-[#070b13] border border-slate-800 flex justify-between items-center';
          item.innerHTML = `
            <div>
              <div class="text-white font-bold flex items-center gap-2">
                <span>${t.tool_name}</span>
                <span class="px-1.5 py-0.2 rounded bg-cyan-500/20 text-cyan-300 text-[10px]">${t.velocity_score} Vélocité</span>
              </div>
              <div class="text-slate-400 text-[11px] mt-1">Recherches : ${t.monthly_searches} • Catégorie : ${t.category}</div>
            </div>
            <div>
              ${t.teardown_url 
                ? `<span class="text-emerald-400 font-bold text-[11px]">Couvert ✓</span>`
                : `<button onclick="alert('Ordre de rédaction d\'un guide complet transmis à ContentWriter.')" class="px-2.5 py-1 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 font-bold text-[10px]">Créer Fiche</button>`
              }
            </div>
          `;
          container.appendChild(item);
        });
      } catch (e) {
        console.warn('Erreur radar:', e);
      }
    }

    // 5. Phase 2 : Chargement des 19 Duels Versus
    async function fetchVersus() {
      try {
        const res = await fetch('/api/sentinel/versus');
        if (!res.ok) return;
        const data = await res.json();
        const tbody = document.getElementById('versus-tbody');
        tbody.innerHTML = '';

        data.duels.forEach(d => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-900/40';
          tr.innerHTML = `
            <td class="p-3 font-bold text-white">/versus/${d.duel_slug}/</td>
            <td class="p-3 text-cyan-300">${d.tool_a}</td>
            <td class="p-3 text-indigo-300">${d.tool_b}</td>
            <td class="p-3 text-emerald-400 font-bold">${d.winner_tool || 'Arbitrage Équilibré'}</td>
            <td class="p-3 text-slate-300">${d.tco_delta}</td>
            <td class="p-3 text-right">
              <button onclick="alert('Duel ${d.duel_slug} vérifié et conforme aux critères méthodologiques.')" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold">Inspecter</button>
            </td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        console.warn('Erreur versus:', e);
      }
    }

    // 6. Abonnés
    async function fetchSubscribers(reveal) {
      try {
        const res = await fetch(`/api/sentinel/subscribers?limit=50&reveal=${reveal ? 'true' : 'false'}`);
        if (!res.ok) return;
        const data = await res.json();
        const tbody = document.getElementById('subscribers-tbody');
        tbody.innerHTML = '';

        data.subscribers.forEach(s => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-900/40';
          tr.innerHTML = `
            <td class="p-3 font-bold text-slate-300 whitespace-nowrap">
              <span class="text-cyan-400">${s.id}</span>
              <span class="ml-1.5 px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-300 text-[10px] font-bold">${s.status}</span>
            </td>
            <td class="p-3 text-white font-mono whitespace-nowrap">${s.email}</td>
            <td class="p-3 text-slate-300">${s.role || 'Décisionnaire SaaS'}</td>
            <td class="p-3 text-slate-400 whitespace-nowrap">${s.country || 'International'}</td>
            <td class="p-3 text-slate-500 whitespace-nowrap">${new Date(s.signup_date).toLocaleDateString('fr-FR')}</td>
            <td class="p-3 text-right text-cyan-400 font-mono text-[11px]">${s.source_path || '/calculator'}</td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        console.warn('Erreur abonnés:', e);
      }
    }

    // 7. Approbations
    async function decideApproval(id, decision) {
      const notes = prompt(`Motif ou note de décision patron pour cette action (${decision}) :`, 'Validé sous autorité patron');
      if (notes === null) return;

      try {
        const res = await fetch('/api/sentinel/approvals', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ approval_id: id, decision, decision_notes: notes })
        });
        const data = await res.json();
        alert(`[JOURNALISÉ & SIGNÉ] ${data.message}`);
        loadCockpit();
        showSection('view-general');
      } catch (e) {
        alert('Erreur: ' + e.message);
      }
    }

    // 8. Journal d'Audit
    async function fetchAuditLogs() {
      try {
        const res = await fetch('/api/sentinel/audit');
        if (!res.ok) return;
        const data = await res.json();
        const tbody = document.getElementById('audit-tbody');
        tbody.innerHTML = '';

        data.logs.forEach(l => {
          const tr = document.createElement('tr');
          tr.className = 'hover:bg-slate-900/40 text-[11px]';
          tr.innerHTML = `
            <td class="p-3 text-slate-400 whitespace-nowrap font-mono">${new Date(l.timestamp).toLocaleString('fr-FR')}</td>
            <td class="p-3 text-emerald-300 font-bold whitespace-nowrap">${l.actor_email}</td>
            <td class="p-3 text-white font-bold whitespace-nowrap">${l.action}</td>
            <td class="p-3 text-cyan-300 whitespace-nowrap font-mono">${l.target}</td>
            <td class="p-3 text-slate-400 whitespace-nowrap font-mono">${l.previous_state || '—'} → <strong class="text-white">${l.new_state || '—'}</strong></td>
            <td class="p-3 text-right text-slate-500 font-mono text-[9px]">${l.signature.substring(0, 16)}...</td>
          `;
          tbody.appendChild(tr);
        });
      } catch (e) {
        console.warn('Erreur audit:', e);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadCockpit();
    });
  </script>
</body>
</html>
