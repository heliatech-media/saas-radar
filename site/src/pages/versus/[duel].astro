---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import duelsData from '../../data/versus-duels.json';

export async function getStaticPaths() {
  return duelsData.map((d) => ({
    params: { duel: d.slug },
    props: { duel: d },
  }));
}

interface Props {
  duel: (typeof duelsData)[number];
}

const { duel } = Astro.props;
const toolA = duel.toolA;
const toolB = duel.toolB;

// Find related duels in the same category (or fallback to top duels)
const relatedDuels = duelsData
  .filter((d) => d.slug !== duel.slug)
  .sort((a, b) => (a.category === duel.category ? -1 : 1))
  .slice(0, 4);

const pageTitle = `${toolA.name} vs ${toolB.name} (2026): Empirical Benchmark & TCO Teardown`;
const pageDescription = `Exhaustive side-by-side technical and financial showdown between ${toolA.name} and ${toolB.name}. Compare architecture, 100k scale pricing, and the final executive verdict.`;

const canonicalUrl = `https://heliatech.online/versus/${duel.slug}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": duel.headline,
      "description": pageDescription,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      },
      "author": {
        "@type": "Organization",
        "name": "HeliaTech Autonomous Intelligence Lab",
        "url": "https://heliatech.online"
      },
      "publisher": {
        "@type": "Organization",
        "name": "HeliaTech",
        "url": "https://heliatech.online",
        "logo": {
          "@type": "ImageObject",
          "url": "https://heliatech.online/favicon.svg"
        }
      },
      "datePublished": "2026-10-20T08:00:00Z",
      "dateModified": new Date().toISOString()
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://heliatech.online"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Versus Arena",
          "item": "https://heliatech.online/versus/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `${toolA.name} vs ${toolB.name}`,
          "item": canonicalUrl
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": duel.faqs.map((faq) => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};

// Compute average overall score
const avgA = Math.round(
  (toolA.scores.performance + toolA.scores.pricing + toolA.scores.easeOfUse + toolA.scores.enterprise + toolA.scores.ecosystem) / 5
);
const avgB = Math.round(
  (toolB.scores.performance + toolB.scores.pricing + toolB.scores.easeOfUse + toolB.scores.enterprise + toolB.scores.ecosystem) / 5
);
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-12 sm:py-16">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs font-mono text-slate-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-cyan-400 transition-colors">Home</a>
      <span>/</span>
      <a href="/versus" class="hover:text-cyan-400 transition-colors">Versus Arena</a>
      <span>/</span>
      <span class="text-slate-300 font-bold truncate">{toolA.name} vs {toolB.name}</span>
    </nav>

    <!-- Duel Header Badge -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/20 text-xs font-mono font-bold uppercase tracking-wider">
        <span>⚔️</span>
        <span>{duel.category}</span>
        <span class="text-slate-500">•</span>
        <span class="text-slate-400">2026 EDITION</span>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Independent Forensic Teardown</span>
      </div>
    </div>

    <!-- Matchup Title -->
    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-[1.15] mb-6">
      {duel.headline}
    </h1>

    <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed max-w-4xl mb-12">
      {duel.tagline} We break down raw API speeds, scalable monthly burn, developer satisfaction, and the true cost of ownership.
    </p>

    <!-- Contenders Ring Card (Hero Head-to-Head) -->
    <div class="p-6 sm:p-10 rounded-3xl bg-slate-900/70 border border-slate-800 backdrop-blur-2xl shadow-2xl relative overflow-hidden mb-16">
      <div class="absolute -right-24 -top-24 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-24 -bottom-24 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 md:grid-cols-11 gap-6 items-center">
        
        <!-- Left: Contender A -->
        <div class="md:col-span-5 p-6 rounded-2xl bg-slate-950/80 border border-cyan-500/30 relative">
          {duel.winner === 'toolA' && (
            <div class="absolute -top-3 right-4 px-3 py-0.5 rounded-full bg-gradient-to-r from-emerald-400 to-cyan-400 text-slate-950 text-[10px] font-mono font-black uppercase tracking-wider shadow-glow-emerald">
              🏆 EMPIRICAL WINNER
            </div>
          )}
          <div class="flex items-center gap-3.5 mb-4">
            <ToolIcon slug={toolA.slug} size="lg" />
            <div>
              <h2 class="text-2xl font-black text-white">{toolA.name}</h2>
              <div class="flex items-center gap-2 text-xs font-mono mt-0.5">
                <span class="text-amber-400 font-bold">★ {toolA.rating}</span>
                <span class="text-slate-500">|</span>
                <span class="text-cyan-300 font-bold">{toolA.startingPrice}</span>
              </div>
            </div>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed font-light mb-4">
            {toolA.tagline}
          </p>
          <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-xs font-mono">
            <span class="text-slate-400">Overall Benchmark:</span>
            <span class="text-cyan-400 font-bold text-sm">{avgA}/100</span>
          </div>
        </div>

        <!-- Center: VS Badge -->
        <div class="md:col-span-1 flex flex-col items-center justify-center my-2 md:my-0">
          <div class="w-12 h-12 rounded-full bg-slate-900 border border-slate-700 flex items-center justify-center shadow-lg">
            <span class="text-xs font-mono font-black text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-cyan-400">VS</span>
          </div>
        </div>

        <!-- Right: Contender B -->
        <div class="md:col-span-5 p-6 rounded-2xl bg-slate-950/80 border border-slate-800 relative">
          {duel.winner === 'toolB' && (
            <div class="absolute -top-3 right-4 px-3 py-0.5 rounded-full bg-gradient-to-r from-emerald-400 to-cyan-400 text-slate-950 text-[10px] font-mono font-black uppercase tracking-wider shadow-glow-emerald">
              🏆 EMPIRICAL WINNER
            </div>
          )}
          {duel.winner === 'tie' && (
            <div class="absolute -top-3 right-4 px-3 py-0.5 rounded-full bg-slate-800 text-amber-300 border border-amber-500/30 text-[10px] font-mono font-bold uppercase tracking-wider">
              ⚖️ ARCHITECTURAL DRAW
            </div>
          )}
          <div class="flex items-center gap-3.5 mb-4">
            <ToolIcon slug={toolB.slug} size="lg" />
            <div>
              <h2 class="text-2xl font-black text-white">{toolB.name}</h2>
              <div class="flex items-center gap-2 text-xs font-mono mt-0.5">
                <span class="text-amber-400 font-bold">★ {toolB.rating}</span>
                <span class="text-slate-500">|</span>
                <span class="text-slate-300 font-bold">{toolB.startingPrice}</span>
              </div>
            </div>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed font-light mb-4">
            {toolB.tagline}
          </p>
          <div class="pt-3 border-t border-slate-800 flex items-center justify-between text-xs font-mono">
            <span class="text-slate-400">Overall Benchmark:</span>
            <span class="text-slate-200 font-bold text-sm">{avgB}/100</span>
          </div>
        </div>

      </div>

      <!-- Outbound Affiliate Dual Action Strip -->
      <div class="mt-8 pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2 text-xs font-mono text-slate-400">
          <span>🔒 Verified direct endpoints</span>
          <span class="text-slate-600">•</span>
          <span>Zero markup guarantee</span>
        </div>
        <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
          <a 
            href={`/go/${toolA.slug}`}
            target="_blank"
            rel="noopener sponsored"
            class="flex-1 sm:flex-initial px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-400 hover:from-cyan-400 hover:to-sky-300 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider transition-transform active:scale-95 text-center flex items-center justify-center gap-1.5 shadow-glow-cyan"
          >
            <span>Try {toolA.name}</span>
            <span>↗</span>
          </a>
          <a 
            href={`/go/${toolB.slug}`}
            target="_blank"
            rel="noopener sponsored"
            class="flex-1 sm:flex-initial px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-mono font-bold text-xs uppercase tracking-wider transition-transform active:scale-95 text-center flex items-center justify-center gap-1.5 border border-slate-700 hover:border-slate-600"
          >
            <span>Explore {toolB.name}</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Executive Verdict Box (Bottom-Line Analysis) -->
    <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 border border-amber-500/30 shadow-xl mb-16 relative">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-2xl">🏛️</span>
        <h2 class="text-2xl font-black text-white tracking-tight">The Executive Verdict</h2>
      </div>

      <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-light mb-6">
        {duel.winnerReason}
      </p>

      <!-- Quick Decision Rubric -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-6 border-t border-slate-800">
        <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
          <span class="text-xs font-mono font-bold text-cyan-400 block mb-2">
            ✓ Choose {toolA.name} if:
          </span>
          <p class="text-xs text-slate-300 leading-relaxed m-0 font-light">
            {toolA.bestFor}
          </p>
        </div>

        <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800/80">
          <span class="text-xs font-mono font-bold text-amber-400 block mb-2">
            ✓ Choose {toolB.name} if:
          </span>
          <p class="text-xs text-slate-300 leading-relaxed m-0 font-light">
            {toolB.bestFor}
          </p>
        </div>
      </div>
    </div>

    <!-- Deep Empirical Scorecard (Radar Dimensions) -->
    <div class="mb-16">
      <div class="text-xs font-mono uppercase tracking-widest text-cyan-400 mb-6 font-bold flex items-center gap-2">
        <span>📊 EMPIRICAL PERFORMANCE SCORECARD</span>
        <span class="h-[1px] flex-grow bg-slate-800"></span>
      </div>

      <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/60 border border-slate-800 backdrop-blur-xl space-y-6">
        
        {/* Dimension 1: Performance */}
        <div>
          <div class="flex justify-between items-center text-xs font-mono mb-2">
            <span class="text-white font-semibold">Speed, Latency & Architecture Velocity</span>
            <div class="flex gap-4">
              <span class="text-cyan-400 font-bold">{toolA.name}: {toolA.scores.performance}%</span>
              <span class="text-slate-400 font-bold">{toolB.name}: {toolB.scores.performance}%</span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full bg-cyan-400 rounded-full" style={`width: ${toolA.scores.performance}%`}></div>
            </div>
            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full bg-amber-400 rounded-full" style={`width: ${toolB.scores.performance}%`}></div>
            </div>
          </div>
        </div>

        {/* Dimension 2: Pricing */}
        <div>
          <div class="flex justify-between items-center text-xs font-mono mb-2">
            <span class="text-white font-semibold">Pricing Predictability & TCO at Scale</span>
            <div class="flex gap-4">
              <span class="text-cyan-400 font-bold">{toolA.name}: {toolA.scores.pricing}%</span>
              <span class="text-slate-400 font-bold">{toolB.name}: {toolB.scores.pricing}%</span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full bg-cyan-400 rounded-full" style={`width: ${toolA.scores.pricing}%`}></div>
            </div>
            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full bg-amber-400 rounded-full" style={`width: ${toolB.scores.pricing}%`}></div>
            </div>
          </div>
        </div>

        {/* Dimension 3: Ease of Use */}
        <div>
          <div class="flex justify-between items-center text-xs font-mono mb-2">
            <span class="text-white font-semibold">Developer / User Experience & Onboarding</span>
            <div class="flex gap-4">
              <span class="text-cyan-400 font-bold">{toolA.name}: {toolA.scores.easeOfUse}%</span>
              <span class="text-slate-400 font-bold">{toolB.name}: {toolB.scores.easeOfUse}%</span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full bg-cyan-400 rounded-full" style={`width: ${toolA.scores.easeOfUse}%`}></div>
            </div>
            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full bg-amber-400 rounded-full" style={`width: ${toolB.scores.easeOfUse}%`}></div>
            </div>
          </div>
        </div>

        {/* Dimension 4: Enterprise Compliance */}
        <div>
          <div class="flex justify-between items-center text-xs font-mono mb-2">
            <span class="text-white font-semibold">Enterprise Security & Compliance (SOC2 / GDPR)</span>
            <div class="flex gap-4">
              <span class="text-cyan-400 font-bold">{toolA.name}: {toolA.scores.enterprise}%</span>
              <span class="text-slate-400 font-bold">{toolB.name}: {toolB.scores.enterprise}%</span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full bg-cyan-400 rounded-full" style={`width: ${toolA.scores.enterprise}%`}></div>
            </div>
            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full bg-amber-400 rounded-full" style={`width: ${toolB.scores.enterprise}%`}></div>
            </div>
          </div>
        </div>

        {/* Dimension 5: Ecosystem */}
        <div>
          <div class="flex justify-between items-center text-xs font-mono mb-2">
            <span class="text-white font-semibold">Third-Party Ecosystem & API Extensibility</span>
            <div class="flex gap-4">
              <span class="text-cyan-400 font-bold">{toolA.name}: {toolA.scores.ecosystem}%</span>
              <span class="text-slate-400 font-bold">{toolB.name}: {toolB.scores.ecosystem}%</span>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-2">
            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full bg-cyan-400 rounded-full" style={`width: ${toolA.scores.ecosystem}%`}></div>
            </div>
            <div class="h-2 rounded-full bg-slate-800 overflow-hidden">
              <div class="h-full bg-amber-400 rounded-full" style={`width: ${toolB.scores.ecosystem}%`}></div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Feature-by-Feature Teardown Matrix -->
    <div class="mb-16">
      <div class="text-xs font-mono uppercase tracking-widest text-cyan-400 mb-6 font-bold flex items-center gap-2">
        <span>⚔️ HEAD-TO-HEAD SPECIFICATION MATRIX</span>
        <span class="h-[1px] flex-grow bg-slate-800"></span>
      </div>

      <div class="overflow-x-auto rounded-3xl border border-slate-800 bg-slate-900/60 backdrop-blur-xl">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-800 bg-slate-950/80 text-xs font-mono text-slate-400">
              <th class="py-4 px-6 font-bold">Benchmark Criterion</th>
              <th class="py-4 px-6 font-bold text-cyan-300">{toolA.name}</th>
              <th class="py-4 px-6 font-bold text-amber-300">{toolB.name}</th>
              <th class="py-4 px-6 font-bold text-center">Edge</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/80 text-xs font-mono">
            {duel.comparisonCriteria.map((c) => (
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-4 px-6 font-semibold text-white">
                  {c.feature}
                </td>
                <td class="py-4 px-6 text-slate-300">
                  {c.toolAValue}
                </td>
                <td class="py-4 px-6 text-slate-300">
                  {c.toolBValue}
                </td>
                <td class="py-4 px-6 text-center">
                  {c.winner === 'A' && (
                    <span class="px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20 font-bold">
                      {toolA.name}
                    </span>
                  )}
                  {c.winner === 'B' && (
                    <span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20 font-bold">
                      {toolB.name}
                    </span>
                  )}
                  {c.winner === 'tie' && (
                    <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">
                      Even
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- TCO Financial Model & Burn Rate Teardown -->
    <div class="p-8 sm:p-10 rounded-3xl bg-slate-900/70 border border-emerald-500/30 shadow-xl mb-16 relative overflow-hidden backdrop-blur-xl">
      <div class="absolute -right-20 -bottom-20 w-60 h-60 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex items-center justify-between gap-4 mb-6 flex-wrap">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-emerald-400 font-bold block mb-1">
            FINANCIAL MODELING • 2026 TCO SIMULATION
          </span>
          <h2 class="text-2xl font-black text-white">
            Operational Cost at Scale: {duel.tcoBreakdown.scale}
          </h2>
        </div>
        <a 
          href="/calculator"
          class="px-3.5 py-1.5 rounded-lg bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/20 border border-emerald-500/30 text-xs font-mono font-bold transition-all"
        >
          Open Custom Calculator →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 text-xs font-mono">
          <span class="text-slate-400 block mb-1">{toolA.name} Annual Burn:</span>
          <span class="text-2xl font-black text-cyan-400">{duel.tcoBreakdown.toolACost}</span>
        </div>
        <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 text-xs font-mono">
          <span class="text-slate-400 block mb-1">{toolB.name} Annual Burn:</span>
          <span class="text-2xl font-black text-amber-400">{duel.tcoBreakdown.toolBCost}</span>
        </div>
      </div>

      <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-light m-0">
        <strong class="text-white font-medium">Helia Forensic Takeaway:</strong> {duel.tcoBreakdown.verdict}
      </p>
    </div>

    <!-- Frequently Asked Questions (Schema-Enriched) -->
    <div class="mb-16">
      <div class="text-xs font-mono uppercase tracking-widest text-cyan-400 mb-6 font-bold flex items-center gap-2">
        <span>❓ FREQUENTLY ASKED QUESTIONS</span>
        <span class="h-[1px] flex-grow bg-slate-800"></span>
      </div>

      <div class="space-y-4">
        {duel.faqs.map((faq) => (
          <details class="group p-6 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-slate-700 transition-all backdrop-blur-xl">
            <summary class="font-bold text-white text-sm sm:text-base cursor-pointer list-none flex justify-between items-center">
              <span>{faq.question}</span>
              <span class="text-cyan-400 font-mono transition-transform group-open:rotate-45 text-xl font-light">+</span>
            </summary>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-light mt-4 pt-4 border-t border-slate-800/80 m-0">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>

    <!-- Related Duels Carousel/Grid -->
    <div class="mb-16">
      <div class="text-xs font-mono uppercase tracking-widest text-cyan-400 mb-6 font-bold flex items-center gap-2">
        <span>⚡ RELATED B2B DUELS</span>
        <span class="h-[1px] flex-grow bg-slate-800"></span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {relatedDuels.map((rd) => (
          <a 
            href={`/versus/${rd.slug}`}
            class="p-5 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-cyan-500/40 transition-all duration-200 group flex flex-col justify-between"
          >
            <div>
              <span class="text-[10px] font-mono text-cyan-400 uppercase tracking-wider block mb-2">
                {rd.category}
              </span>
