---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import duelsData from '../../data/versus-duels.json';
import PricingShockCalculator from '../../components/PricingShockCalculator.astro';

// Extract unique categories
const categories = Array.from(new Set(duelsData.map((d) => d.category)));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "HeliaTech B2B Versus Arena — Empirical Head-to-Head Software Showdowns",
  "description": "Rigorous side-by-side technical benchmarks and pricing showdowns between leading enterprise SaaS platforms.",
  "url": "https://heliatech.online/versus/"
};
---

<Layout 
  title="B2B Software Versus Arena | Empirical Head-to-Head Duels 2026"
  description="Exhaustive side-by-side software shootouts. Compare architecture, total cost of ownership at scale, and API performance between industry leaders."
  canonical="https://heliatech.online/versus/"
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-16">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 text-amber-300 border border-amber-500/30 text-xs font-mono font-bold tracking-widest uppercase mb-6 shadow-glow-amber">
        <span>⚔️</span>
        <span>HELIA FORENSIC SHOWDOWNS • 2026 BENCHMARK</span>
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-[1.1] mb-6">
        The B2B Software <br class="hidden sm:block"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-cyan-400 to-amber-300">Versus Arena</span>
      </h1>
      
      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed mb-8">
        We eliminate vendor marketing hype through empirical side-by-side benchmarking. Granular architecture teardowns, pricing math at 100k scale, and unvarnished executive verdicts.
      </p>

      <!-- Viral Tools Banner Trigger -->
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a 
          href="/calculator"
          class="px-4 py-2 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-mono font-bold transition-all flex items-center gap-2"
        >
          <span>📊 SaaS Waste & TCO Calculator</span>
          <span>→</span>
        </a>
        <a 
          href="/calculator/ai-pricing"
          class="px-4 py-2 rounded-xl bg-purple-500/10 hover:bg-purple-500/20 text-purple-300 border border-purple-500/30 text-xs font-mono font-bold transition-all flex items-center gap-2"
        >
          <span>🎙️ AI Audio & Video Pricing Calculator</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Live Filter & Search Controls -->
    <div class="mb-10 space-y-4">
      <!-- Search Bar -->
      <div class="relative max-w-xl mx-auto">
        <input 
          type="text" 
          id="duel-search" 
          placeholder="Filter 32+ shootouts (e.g., 'cursor', 'zapier', 'audio', 'sales')..."
          class="w-full px-5 py-3.5 pl-11 rounded-2xl bg-slate-900/80 border border-slate-800 text-white placeholder-slate-500 text-sm font-mono focus:outline-none focus:border-cyan-400 transition-all backdrop-blur-xl"
        />
        <svg class="w-4 h-4 text-slate-500 absolute left-4 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap items-center justify-center gap-2 pt-2">
        <button 
          type="button" 
          class="cat-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-bold transition-all bg-cyan-500 text-slate-950 border border-cyan-400"
          data-category="all"
        >
          All Showdowns ({duelsData.length})
        </button>
        {categories.map((cat) => (
          <button 
            type="button" 
            class="cat-filter-btn px-3 py-1.5 rounded-full text-xs font-mono font-semibold transition-all bg-slate-900/80 hover:bg-slate-800 text-slate-400 hover:text-white border border-slate-800"
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Duels Grid -->
    <div id="duels-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {duelsData.map((d) => (
        <article 
          class="duel-card p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all duration-300 hover:-translate-y-1 group flex flex-col justify-between backdrop-blur-xl"
          data-slug={d.slug}
          data-category={d.category}
          data-text={`${d.slug} ${d.toolA.name} ${d.toolB.name} ${d.category} ${d.headline}`.toLowerCase()}
        >
          <div>
            <!-- Header Badges -->
            <div class="flex items-center justify-between gap-2 mb-4 text-xs font-mono">
              <span class="px-2.5 py-1 rounded-lg bg-cyan-500/10 text-cyan-300 border border-cyan-500/20 font-semibold uppercase tracking-wider text-[10px]">
                {d.category}
              </span>
              {d.winner === 'toolA' && (
                <span class="text-[10px] font-mono text-emerald-400 font-bold">
                  ★ {d.toolA.name} Wins
                </span>
              )}
              {d.winner === 'toolB' && (
                <span class="text-[10px] font-mono text-emerald-400 font-bold">
                  ★ {d.toolB.name} Wins
                </span>
              )}
              {d.winner === 'tie' && (
                <span class="text-[10px] font-mono text-amber-400 font-bold">
                  ⚖️ Split Verdict
                </span>
              )}
            </div>

            <!-- Contenders Faceoff Bar -->
            <div class="flex items-center justify-between gap-2 mb-4 p-3 rounded-2xl bg-slate-950/80 border border-slate-800/80">
              <div class="flex items-center gap-2 min-w-0">
                <ToolIcon slug={d.toolA.slug} size="sm" />
                <span class="text-xs font-mono font-bold text-white truncate">{d.toolA.name}</span>
              </div>
              <span class="text-[10px] font-mono font-black text-amber-400 px-1.5 py-0.5 rounded bg-amber-500/10 border border-amber-500/20 shrink-0">VS</span>
              <div class="flex items-center gap-2 min-w-0">
                <ToolIcon slug={d.toolB.slug} size="sm" />
                <span class="text-xs font-mono font-bold text-slate-300 truncate">{d.toolB.name}</span>
              </div>
            </div>

            <!-- Title -->
            <h2 class="text-lg font-black text-white tracking-tight leading-snug mb-3 group-hover:text-cyan-300 transition-colors">
              <a href={`/versus/${d.slug}`}>
                {d.headline}
              </a>
            </h2>

            <!-- Excerpt -->
            <p class="text-xs text-slate-400 font-light leading-relaxed mb-6 line-clamp-3">
              {d.tagline}
            </p>

            <!-- TCO Math Preview -->
            <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800/80 mb-6 text-[11px] font-mono text-slate-400">
              <div class="flex justify-between items-center text-slate-300 mb-1">
                <span>{d.toolA.name}: <strong class="text-cyan-400">{d.toolA.startingPrice}</strong></span>
                <span>{d.toolB.name}: <strong class="text-amber-400">{d.toolB.startingPrice}</strong></span>
              </div>
              <p class="text-slate-500 line-clamp-2 m-0 mt-1">
                Scale: {d.tcoBreakdown.scale}
              </p>
            </div>
          </div>

          <!-- Bottom CTA -->
          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
            <span class="text-xs font-mono text-slate-500">Forensic Specs</span>
            <a 
              href={`/versus/${d.slug}`}
              class="px-3.5 py-1.5 rounded-xl bg-slate-800 hover:bg-cyan-500 text-slate-300 hover:text-slate-950 text-xs font-mono font-bold transition-all flex items-center gap-1.5 group-hover:bg-cyan-400 group-hover:text-slate-950"
            >
              <span>Explore Shootout</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty State (hidden by default) -->
    <div id="duels-empty" class="hidden text-center py-16">
      <p class="text-sm font-mono text-slate-400">No showdowns matching your search query.</p>
    </div>

    <!-- Interactive Pricing Shock Simulator -->
    <div class="mb-16">
      <PricingShockCalculator 
        expensiveTool="Zapier" 
        cheaperTool="Make" 
        expensiveToolSlug="zapier" 
        cheaperToolSlug="make" 
      />
    </div>

    <!-- Arena Guarantee Footer -->
    <div class="p-8 rounded-3xl bg-slate-950/60 border border-slate-800 text-center text-xs font-mono text-slate-400 max-w-2xl mx-auto">
      <span class="text-amber-400 font-bold block mb-1">🏛️ HeliaTech Independent Benchmarking Standards</span>
      <p class="m-0 leading-relaxed text-slate-500">
        All duels are generated through empirical testing matrices and production deployments. Software vendors cannot pay for placement or score alterations.
      </p>
    </div>

  </div>

  <!-- Client-side filter & search script -->
  <script is:inline>
    (function() {
      const searchInput = document.getElementById('duel-search');
      const filterBtns = document.querySelectorAll('.cat-filter-btn');
      const cards = document.querySelectorAll('.duel-card');
      const emptyState = document.getElementById('duels-empty');

      let currentCategory = 'all';
      let currentQuery = '';

      function applyFilters() {
        let visibleCount = 0;
        cards.forEach(card => {
          const cardCategory = card.dataset.category;
          const cardText = card.dataset.text || '';

          const matchesCategory = (currentCategory === 'all' || cardCategory === currentCategory);
          const matchesQuery = (!currentQuery || cardText.includes(currentQuery));

          if (matchesCategory && matchesQuery) {
            card.style.display = '';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (emptyState) {
          emptyState.classList.toggle('hidden', visibleCount > 0);
        }
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentQuery = e.target.value.toLowerCase().trim();
          applyFilters();
        });
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          filterBtns.forEach(b => {
            b.classList.remove('bg-cyan-500', 'text-slate-950', 'border-cyan-400');
            b.classList.add('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
          });

          btn.classList.add('bg-cyan-500', 'text-slate-950', 'border-cyan-400');
          btn.classList.remove('bg-slate-900/80', 'text-slate-400', 'border-slate-800');

          currentCategory = btn.dataset.category;
          applyFilters();
        });
      });
    })();
  </script>
</Layout>
