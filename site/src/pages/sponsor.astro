---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Partner & Advertise with HeliaTech | B2B Sponsorships & Reach";
const pageDescription = "Reach over 12,000+ technical founders, CTOs, and software decision-makers. Explore high-impact sponsorship packages, newsletter features, and benchmark placements.";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-24">
    <!-- Header Badge -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono font-bold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        B2B Enterprise Sponsorships &amp; Media Kit
      </div>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight mb-6">
        Put Your Software in Front of <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">
          High-Intent B2B Tech Buyers
        </span>
      </h1>
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        HeliaTech is an independent software intelligence matrix and architectural observatory. We help technical founders, CTOs, and RevOps leaders evaluate and migrate their software stacks.
      </p>
    </div>

    <!-- Audience Demographics Telemetry Matrix -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-black text-cyan-400 font-mono mb-1">12,800+</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Monthly Pageviews</div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-black text-emerald-400 font-mono mb-1">80%+</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">US &amp; Tier-1 Traffic</div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-black text-fuchsia-400 font-mono mb-1">240+</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Indexed Duels &amp; Reviews</div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-black text-amber-400 font-mono mb-1">C-Level</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">CTO &amp; RevOps Audience</div>
      </div>
    </div>

    <!-- Sponsorship Packages -->
    <div class="mb-16">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Available Sponsorship Formats</h2>
        <p class="text-sm text-slate-400 font-light mt-2">Transparent, flat-rate pricing. Zero hidden procurement fees.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Package 1: Featured Duel Placement -->
        <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between relative">
          <div>
            <div class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider mb-2">Category Spotlight</div>
            <h3 class="text-xl font-bold text-white mb-2">Featured Duel Placement</h3>
            <div class="text-3xl font-black text-white font-mono mb-4">$500 <span class="text-sm text-slate-400 font-normal">/ month</span></div>
            <p class="text-xs text-slate-300 leading-relaxed font-light mb-6">
              Place your software as the featured "Verified Editor's Pick" in top-performing head-to-head duels with native CTAs and badge recognition.
            </p>
            <ul class="text-xs text-slate-300 space-y-2.5 font-mono mb-8">
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Top placement on target duel</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Direct do-follow link to your domain</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> High-intent buyer clicks</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Monthly performance analytics</li>
            </ul>
          </div>
          <a 
            href="mailto:partnership@heliatech.online?subject=Inquiry:%20Featured%20Duel%20Placement%20Sponsorship"
            class="w-full py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider text-center transition-all block"
          >
            Book Placement →
          </a>
        </div>

        <!-- Package 2: Newsletter Dispatch -->
        <div class="p-8 rounded-3xl bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 border border-cyan-500/40 shadow-[0_0_30px_rgba(6,182,212,0.1)] flex flex-col justify-between relative">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-cyan-500 text-slate-950 font-mono text-[10px] font-black uppercase tracking-wider">
            Most Popular
          </div>
          <div>
            <div class="text-xs font-mono font-bold text-sky-400 uppercase tracking-wider mb-2">Weekly Executive Reach</div>
            <h3 class="text-xl font-bold text-white mb-2">Newsletter Sponsor</h3>
            <div class="text-3xl font-black text-white font-mono mb-4">$250 <span class="text-sm text-slate-400 font-normal">/ dispatch</span></div>
            <p class="text-xs text-slate-300 leading-relaxed font-light mb-6">
              Exclusive spotlight in "The Thursday Radar" sent directly to technical decision-makers, CTOs, and founders.
            </p>
            <ul class="text-xs text-slate-300 space-y-2.5 font-mono mb-8">
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Exclusive solo sponsor slot</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> 150-word editorial breakdown</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Primary Call-to-Action button</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> 45%+ average executive open rate</li>
            </ul>
          </div>
          <div class="space-y-2.5">
            <a 
              href="https://www.paved.com/sites/heliatech-radar"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-400 hover:from-cyan-400 hover:to-sky-300 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider text-center transition-all block shadow-glow-cyan"
            >
              Book on Paved Marketplace ⚡
            </a>
            <a 
              href="mailto:partnership@heliatech.online?subject=Inquiry:%20Newsletter%20Sponsorship"
              class="w-full py-2.5 rounded-xl bg-slate-950/80 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-800 font-mono text-[11px] uppercase tracking-wider text-center transition-all block"
            >
              Direct Wire / Corporate Invoice →
            </a>
          </div>
        </div>

        <!-- Package 3: Forensic Teardown Masterclass -->
        <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-indigo-500/40 transition-all flex flex-col justify-between relative">
          <div>
            <div class="text-xs font-mono font-bold text-indigo-400 uppercase tracking-wider mb-2">Deep-Dive Authority</div>
            <h3 class="text-xl font-bold text-white mb-2">Forensic Teardown</h3>
            <div class="text-3xl font-black text-white font-mono mb-4">$1,200 <span class="text-sm text-slate-400 font-normal">/ one-off</span></div>
            <p class="text-xs text-slate-300 leading-relaxed font-light mb-6">
              A comprehensive 2,500+ word engineering teardown and architectural review permanently indexed on Google and syndicated across our networks.
            </p>
            <ul class="text-xs text-slate-300 space-y-2.5 font-mono mb-8">
              <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> Dedicated long-form benchmark</li>
              <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> Permanent indexation &amp; SEO ranking</li>
              <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> Custom vector artwork illustration</li>
              <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> LinkedIn &amp; DEV.to syndication</li>
            </ul>
          </div>
          <a 
            href="mailto:partnership@heliatech.online?subject=Inquiry:%20Forensic%20Teardown%20Masterclass"
            class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-mono font-bold text-xs uppercase tracking-wider text-center transition-all block"
          >
            Commission Teardown →
          </a>
        </div>
      </div>
    </div>

    <!-- Contact & Direct Inquiries -->
    <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-950 to-slate-900 border border-slate-800 text-center">
      <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">Custom Enterprise Packages &amp; Questions?</h3>
      <p class="text-sm text-slate-400 font-light max-w-xl mx-auto mb-6">
        Have specific campaign requirements, co-marketing webinars, or custom API benchmark needs? Contact our engineering partnerships desk directly.
      </p>
      <a 
        href="mailto:partnership@heliatech.online"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white hover:bg-slate-100 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider transition-all"
      >
        <span>Email: partnership@heliatech.online</span>
        <span>✉</span>
      </a>
    </div>
  </div>
</Layout>
