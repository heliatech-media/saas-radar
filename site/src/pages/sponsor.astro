---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Partner & Advertise with HeliaTech | B2B Sponsorships & Reach";
const pageDescription = "Reach over 40,000+ technical founders, CTOs, and software decision-makers. Explore ethical, high-impact sponsorship packages, newsletter features, and technical architecture masterclasses.";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 pt-16 pb-24">
    <!-- Header Badge -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono font-bold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        B2B Enterprise Sponsorships &amp; Media Kit
      </div>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight mb-6">
        Put Your Software in Front of <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">
          High-Intent B2B Tech Buyers
        </span>
      </h1>
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        HeliaTech is an independent software intelligence matrix and architectural observatory. We help technical founders, CTOs, and engineering leaders evaluate, integrate, and optimize modern software stacks.
      </p>
    </div>

    <!-- Audience Demographics Telemetry Matrix -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-black text-cyan-400 font-mono mb-1">40,000+</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Monthly Pageviews</div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-black text-emerald-400 font-mono mb-1">80%+</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">US &amp; Tier-1 Traffic</div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-black text-fuchsia-400 font-mono mb-1">450+</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Audited Duels &amp; Repos</div>
      </div>
      <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-3xl font-black text-amber-400 font-mono mb-1">C-Level</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">CTO &amp; Engineering Audience</div>
      </div>
    </div>

    <!-- Sponsorship Packages -->
    <div class="mb-16">
      <div class="text-center mb-10">
        <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">Available Sponsorship Formats</h2>
        <p class="text-sm text-slate-400 font-light mt-2">Transparent, flat-rate pricing. 100% strict editorial firewall.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Package 1: Category Partner Spotlight -->
        <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between relative">
          <div>
            <div class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider mb-2">Category Authority</div>
            <h3 class="text-xl font-bold text-white mb-2">Category Partner Spotlight</h3>
            <div class="text-3xl font-black text-white font-mono mb-4">$400 <span class="text-sm text-slate-400 font-normal">/ month</span></div>
            <p class="text-xs text-slate-300 leading-relaxed font-light mb-6">
              Exclusive presence across an entire vertical (e.g. Workflow Automation, Developer IDEs, Databases). Displayed as a verified partner offer with dedicated coupons or extended credits.
            </p>
            <ul class="text-xs text-slate-300 space-y-2.5 font-mono mb-8">
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Prominent partner callout across category</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Direct link to your landing page or free trial</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> High-intent buyer traffic from active shoppers</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Editorial firewall: review scores stay 100% unbiased</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Monthly click &amp; performance metrics</li>
            </ul>
          </div>
          <a 
            href="mailto:partnership@heliatech.online?subject=Inquiry:%20Category%20Partner%20Spotlight%20Sponsorship"
            class="w-full py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider text-center transition-all block"
          >
            Book Category Spotlight →
          </a>
        </div>

        <!-- Package 2: Newsletter Solo Sponsor (Most Popular) -->
        <div class="p-8 rounded-3xl bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 border border-cyan-500/40 shadow-[0_0_30px_rgba(6,182,212,0.1)] flex flex-col justify-between relative">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-cyan-500 text-slate-950 font-mono text-[10px] font-black uppercase tracking-wider">
            Most Popular
          </div>
          <div>
            <div class="text-xs font-mono font-bold text-sky-400 uppercase tracking-wider mb-2">Weekly Executive Reach</div>
            <h3 class="text-xl font-bold text-white mb-2">The Thursday Radar Solo Sponsor</h3>
            <div class="text-3xl font-black text-white font-mono mb-1">$250 <span class="text-sm text-slate-400 font-normal">/ dispatch</span></div>
            <div class="text-[11px] font-mono text-cyan-400 mb-4 font-bold">Bundle: $750 / 4 dispatches</div>
            <p class="text-xs text-slate-300 leading-relaxed font-light mb-6">
              Exclusive solo sponsor slot in our weekly briefing delivered directly to technical decision-makers, CTOs, and founders every Thursday at 9:00 AM EST.
            </p>
            <ul class="text-xs text-slate-300 space-y-2.5 font-mono mb-8">
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> 100% exclusive solo sponsor (no competing ads)</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> 120-word executive pitch + custom branding &amp; logo</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Primary Call-to-Action button with custom offer/credits</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> 45%+ average executive open rate &amp; strong CTR</li>
              <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Inclusion in permanent newsletter web archive</li>
            </ul>
          </div>
          <div class="space-y-2.5">
            <a 
              href="mailto:partnership@heliatech.online?subject=Inquiry:%20Newsletter%20Solo%20Sponsorship"
              class="w-full py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-400 hover:from-cyan-400 hover:to-sky-300 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider text-center transition-all block shadow-glow-cyan"
            >
              Reserve Newsletter Slot →
            </a>
            <div class="flex items-center justify-center gap-2 pt-1">
              <span class="text-[10px] font-mono text-slate-400">Wire (ACH/SWIFT) · Stripe · PayPal · Invoice</span>
            </div>
          </div>
        </div>

        <!-- Package 3: Technical Masterclass & Architecture Blueprint -->
        <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 hover:border-indigo-500/40 transition-all flex flex-col justify-between relative">
          <div>
            <div class="text-xs font-mono font-bold text-indigo-400 uppercase tracking-wider mb-2">Engineering Authority</div>
            <h3 class="text-xl font-bold text-white mb-2">Technical Masterclass &amp; Blueprint</h3>
            <div class="text-3xl font-black text-white font-mono mb-4">$950 <span class="text-sm text-slate-400 font-normal">/ one-off</span></div>
            <p class="text-xs text-slate-300 leading-relaxed font-light mb-6">
              A comprehensive hands-on engineering tutorial demonstrating how technical teams build, integrate, or scale your solution, with native Mermaid architecture diagrams and Docker/API blueprints.
            </p>
            <ul class="text-xs text-slate-300 space-y-2.5 font-mono mb-8">
              <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> In-depth step-by-step engineering guide</li>
              <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> Interactive Mermaid architecture diagrams</li>
              <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> Verified Docker Compose &amp; code snippets</li>
              <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> Permanent indexation &amp; developer bookmarks</li>
              <li class="flex items-center gap-2"><span class="text-indigo-400">✓</span> Syndication across developer channels</li>
            </ul>
          </div>
          <a 
            href="mailto:partnership@heliatech.online?subject=Inquiry:%20Technical%20Masterclass%20Commission"
            class="w-full py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-mono font-bold text-xs uppercase tracking-wider text-center transition-all block"
          >
            Commission Masterclass →
          </a>
        </div>

      </div>
    </div>

    <!-- Editorial Integrity Firewall Promise -->
    <div class="mb-16 p-8 rounded-3xl bg-slate-900/40 border border-cyan-500/20 text-center relative overflow-hidden">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-[11px] font-mono font-bold uppercase tracking-wider mb-3">
        🛡️ EDITORIAL INTEGRITY FIREWALL
      </div>
      <h3 class="text-lg font-bold text-white mb-2">Our Reviews &amp; Scores Are Never for Sale</h3>
      <p class="text-xs sm:text-sm text-slate-400 font-light max-w-2xl mx-auto leading-relaxed">
        HeliaTech maintains a strict separation between editorial evaluations and paid sponsorships. Sponsors purchase reach, audience exposure, and educational tutorials. We never accept compensation to alter ratings, manipulate duels, or compromise architectural objectivity.
      </p>
    </div>

    <!-- Contact & Direct Inquiries -->
    <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-r from-slate-900 via-slate-950 to-slate-900 border border-slate-800 text-center">
      <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">Custom Enterprise Campaigns &amp; Questions?</h3>
      <p class="text-sm text-slate-400 font-light max-w-xl mx-auto mb-6">
        Have specific campaign requirements, co-marketing webinars, or API benchmark needs? Contact our partnerships desk directly.
      </p>
      <a 
        href="mailto:partnership@heliatech.online"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white hover:bg-slate-100 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider transition-all"
      >
        <span>Email: partnership@heliatech.online</span>
        <span>✉</span>
      </a>
    </div>
  </div>
</Layout>
