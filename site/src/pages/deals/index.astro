    badge: "NEWSLETTER ENGINE",
    badgeColor: "from-orange-500 to-rose-500",
    glowColor: "rgba(249, 115, 22, 0.15)",
    borderColor: "border-orange-500/40",
    affiliateUrl: "/go/beehiiv",
    reviewUrl: "/reviews/beehiiv",
