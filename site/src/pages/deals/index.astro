const categories = ["All Deals", "Automation & No-Code", "AI Voice & Audio", "AI Video & Content Creation", "Growth & Affiliate Infrastructure", "Developer Infrastructure", "Social Growth & Audience", "B2B Sales & Outbound"];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Exclusive SaaS Perks, Extended Trials & Verified Promo Deals (2026)",
  "description": "Hand-verified partner perks, extended free tiers, and exclusive discounts for top B2B software, cloud platforms, and AI tools curated by HeliaTech Media.",
  "url": "https://heliatech.online/deals",
  "publisher": {
    "@type": "Organization",
    "name": "HeliaTech Media",
    "url": "https://heliatech.online"
  }
};
---

<Layout
  title="Exclusive SaaS Perks, Extended Trials & Verified Promo Deals (2026)"
  description="Hand-verified software perks, extended free trials, and exclusive partner promotions for Make, ElevenLabs, Rewardful, Descript, Supabase and more. 0% expired coupon spam."
  jsonLd={jsonLd}
>
  <!-- Hero Section -->
  <section class="relative pt-24 pb-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto text-center">
    <!-- Live Pill -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/90 border border-cyan-500/40 shadow-glow-cyan text-xs font-mono text-cyan-300 mb-6">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>100% HAND-VERIFIED PARTNER PERKS • UPDATED FOR OCTOBER 2026</span>
    </div>

    <!-- Main Title -->
    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white max-w-4xl mx-auto leading-tight">
      Exclusive SaaS Deals &
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-fuchsia-400">
        Extended Partner Perks
      </span>
    </h1>

    <p class="mt-6 text-base sm:text-lg text-slate-400 max-w-2xl mx-auto leading-relaxed">
      Stop wasting hours on spam coupon aggregators with expired codes. Every perk below is established through official developer partnership agreements and verified live weekly.
    </p>

    <!-- Trust Stats Matrix -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto mt-10">
      <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 text-center">
        <span class="block text-2xl font-black text-white font-mono">$0.00</span>
        <span class="text-xs text-slate-400 font-mono uppercase tracking-wider">Expired Spam</span>
      </div>
      <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 text-center">
        <span class="block text-2xl font-black text-cyan-400 font-mono">100%</span>
        <span class="text-xs text-slate-400 font-mono uppercase tracking-wider">Direct Verified</span>
      </div>
      <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 text-center">
        <span class="block text-2xl font-black text-fuchsia-400 font-mono">10,000+</span>
        <span class="text-xs text-slate-400 font-mono uppercase tracking-wider">Free Ops / Credits</span>
      </div>
      <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 text-center">
        <span class="block text-2xl font-black text-emerald-400 font-mono">Weekly</span>
        <span class="text-xs text-slate-400 font-mono uppercase tracking-wider">Health Scanned</span>
      </div>
    </div>
  </section>

  <!-- Filter Buttons (Client-Side Vanilla JS) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
    <div class="flex items-center gap-2 overflow-x-auto pb-4 scrollbar-none justify-start md:justify-center">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`deals-filter-btn px-4 py-2 rounded-full text-xs font-semibold whitespace-nowrap transition-all duration-200 border ${
            idx === 0
              ? "bg-cyan-500/20 text-cyan-300 border-cyan-500/50 shadow-glow-cyan"
              : "bg-slate-900/80 text-slate-400 border-slate-800 hover:text-slate-200 hover:border-slate-700"
          }`}
          data-category={cat}
        >
          {cat}
        </button>
      ))}
    </div>
  </section>

  <!-- Deals Grid -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="deals-container">
      {deals.map((deal) => (
        <article
          class="deal-card group relative rounded-2xl bg-slate-900/60 border border-slate-800/80 p-6 sm:p-8 backdrop-blur-xl transition-all duration-300 hover:border-slate-700 hover:shadow-2xl flex flex-col justify-between"
          data-category={deal.category}
          style={`box-shadow: 0 0 40px -10px ${deal.glowColor};`}
        >
          <div>
            <!-- Header Badges -->
            <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
              <span class={`px-3 py-1 rounded-full text-[10px] font-mono font-bold tracking-wider uppercase text-white bg-gradient-to-r ${deal.badgeColor} shadow-sm`}>
                {deal.badge}
              </span>
              <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-emerald-400">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                {deal.verifiedDate}
              </span>
            </div>

            <!-- Title & Tool with Brand Icon -->
            <div class="flex items-center justify-between gap-3 mb-3">
              <div class="flex items-center gap-3">
                <ToolIcon name={deal.toolName} slug={deal.toolSlug} size="md" />
                <h2 class="text-xl sm:text-2xl font-bold text-white group-hover:text-cyan-300 transition-colors">
                  {deal.toolName}
                </h2>
              </div>
              <span class="text-xs font-mono text-slate-500 uppercase tracking-wider hidden sm:inline-block">
                {deal.category}
              </span>
            </div>

            <!-- Perk Headline -->
            <h3 class="text-lg font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-100 to-slate-300 mb-3">
              {deal.perkTitle}
            </h3>

            <!-- Description -->
            <p class="text-sm text-slate-400 leading-relaxed mb-6">
              {deal.description}
            </p>

            <!-- Highlights Checklist -->
            <ul class="space-y-2 mb-6">
              {deal.highlights.map((item) => (
                <li class="flex items-start gap-2.5 text-xs text-slate-300">
                  <span class="text-cyan-400 font-bold leading-none mt-0.5">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Action Area -->
          <div class="pt-6 border-t border-slate-800/80 mt-2 flex flex-col gap-3">
            {deal.partnerCode ? (
              <div class="flex items-center justify-between p-2.5 rounded-xl bg-black/40 border border-slate-800 mb-1">
                <div class="flex items-center gap-2 pl-2">
                  <span class="text-[10px] font-mono text-slate-500 uppercase">Promo Code:</span>
                  <code class="text-xs font-mono font-bold text-fuchsia-300 tracking-wider">
                    {deal.partnerCode}
                  </code>
                </div>
                <button
                  type="button"
                  class="copy-code-btn px-3 py-1.5 rounded-lg text-[11px] font-mono bg-fuchsia-500/20 text-fuchsia-200 border border-fuchsia-500/40 hover:bg-fuchsia-500/30 transition-colors"
                  data-code={deal.partnerCode}
                >
                  Copy Code
                </button>
              </div>
            ) : null}

            <!-- Primary Claim Button -->
            <div class="flex items-center gap-3">
              <a
                href={deal.affiliateUrl}
                target="_blank"
                rel="sponsored noopener noreferrer"
                class="flex-1 py-3 px-5 rounded-xl text-center text-xs font-bold text-white bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 shadow-glow-cyan transition-all duration-200 flex items-center justify-center gap-2 group-hover:scale-[1.01]"
              >
                <span>Claim Verified Perk</span>
                <span class="text-sm">→</span>
              </a>

              {deal.reviewUrl ? (
                <a
                  href={deal.reviewUrl}
                  class="px-4 py-3 rounded-xl text-xs font-semibold text-slate-300 bg-slate-800/80 border border-slate-700 hover:border-slate-500 transition-colors whitespace-nowrap"
                >
                  Review
                </a>
              ) : null}

              {deal.teardownUrl ? (
                <a
                  href={deal.teardownUrl}
                  class="px-4 py-3 rounded-xl text-xs font-semibold text-cyan-300 bg-cyan-950/40 border border-cyan-800/50 hover:border-cyan-600 transition-colors whitespace-nowrap hidden sm:inline-block"
                >
                  Teardown
                </a>
              ) : null}
            </div>

            <!-- Savings note -->
            <p class="text-[11px] text-center font-mono text-slate-500 mt-1">
              {deal.savingsEstimate} • Automatically applied at destination
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- FAQ Section for Search Intent & Rich Snippets -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-32">
    <div class="p-8 sm:p-12 rounded-3xl bg-slate-900/40 border border-slate-800 backdrop-blur-xl">
      <h2 class="text-2xl sm:text-3xl font-black text-white text-center mb-8">
        Frequently Asked Questions: Software Deals & Perks
      </h2>

      <div class="space-y-6">
        <div>
          <h3 class="text-base font-bold text-cyan-300 mb-2">
            Are these SaaS deals and coupons authentic?
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Yes. Every deal listed in the HeliaTech Vault is backed by direct official developer or partner program agreements (such as Make's official <code class="text-xs font-mono text-slate-300">heliatechmake</code> partner code, ElevenLabs' Starter credits, and Rewardful's native Stripe trial). We never crawl unverified user-submitted coupon sites.
          </p>
        </div>

        <div>
          <h3 class="text-base font-bold text-cyan-300 mb-2">
            Do I need a credit card to activate these promotions?
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Most offers, such as Supabase, Apollo.io, and Descript, feature 100% free lifetime tiers requiring zero payment details. For extended trials like Make.com (1 month Pro free) and Rewardful (14 days), checkout is verified at $0.00 and you can cancel anytime with zero cancellation fees.
          </p>
        </div>

        <div>
          <h3 class="text-base font-bold text-cyan-300 mb-2">
            How often are deals verified and updated?
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Our autonomous LinkSentinel and LinkDoctor agents scan all outbound partner links every 4 hours, validating HTTP 200/302 statuses and ensuring promo terms remain strictly current.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side Interactive Filter & Copy Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Category Filtering Logic
      const filterButtons = document.querySelectorAll('.deals-filter-btn');
      const cards = document.querySelectorAll('.deal-card');

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selectedCategory = btn.getAttribute('data-category');

          filterButtons.forEach((b) => {
            b.classList.remove('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/50', 'shadow-glow-cyan');
            b.classList.add('bg-slate-900/80', 'text-slate-400', 'border-slate-800');
          });

          btn.classList.add('bg-cyan-500/20', 'text-cyan-300', 'border-cyan-500/50', 'shadow-glow-cyan');
          btn.classList.remove('bg-slate-900/80', 'text-slate-400', 'border-slate-800');

          cards.forEach((card) => {
            const cardCat = card.getAttribute('data-category');
            if (selectedCategory === 'All Deals' || cardCat === selectedCategory) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });

      // 2. Copy Code to Clipboard Logic
      const copyButtons = document.querySelectorAll('.copy-code-btn');
      copyButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const code = btn.getAttribute('data-code');
          if (!code) return;

          navigator.clipboard.writeText(code).then(() => {
            const originalText = btn.textContent;
            btn.textContent = 'Copied! ✓';
            btn.classList.add('bg-emerald-500/30', 'text-emerald-300', 'border-emerald-500/60');
            setTimeout(() => {
              btn.textContent = originalText;
              btn.classList.remove('bg-emerald-500/30', 'text-emerald-300', 'border-emerald-500/60');
            }, 2000);
          }).catch(() => {
            btn.textContent = 'Error';
          });
        });
      });
    });
  </script>
</Layout>
