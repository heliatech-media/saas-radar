---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "HeliaTech B2B SaaS Partner Portal & Submission Registry",
  "description": "Submit your software for independent architectural stress-testing, TCO benchmarking, and official accreditation in the 2026 HeliaTech Radar.",
  "url": "https://heliatech.online/partner"
};
---

<Layout 
  title="Partner with HeliaTech | SaaS Submission & Accreditation Portal 2026"
  description="Submit your software to the 2026 HeliaTech Radar. Get your platform evaluated by autonomous benchmark agents and access high-intent enterprise buyers."
  jsonLd={jsonLd}
>
  <div class="max-w-5xl mx-auto px-6 sm:px-8 py-16">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 text-xs font-mono font-bold tracking-widest uppercase mb-6 shadow-glow-cyan">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>OFFICIAL SAAS VENDOR & FOUNDER PORTAL 2026</span>
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-[1.1] mb-6">
        Get Your SaaS Audited by <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">
          The HeliaTech Observatory
        </span>
      </h1>
      
      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        Building high-performance B2B software? Join over <strong class="text-white font-medium">35 accredited platforms</strong> in our Radar and get discovered by tens of thousands of CTOs, founders, and tech operators with high purchasing power.
      </p>
    </div>

    <!-- 2 Pathways Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
      
      <!-- Option A: Standard Affiliate Qualification (Free) -->
      <div class="p-8 sm:p-10 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all duration-300 flex flex-col justify-between backdrop-blur-xl relative group">
        <div>
          <div class="flex items-center justify-between gap-2 mb-6">
            <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-slate-800 text-slate-300 border border-slate-700">
              STANDARD PROGRAM
            </span>
            <span class="text-xs font-mono font-black text-cyan-400">100% FREE</span>
          </div>

          <h2 class="text-2xl font-black text-white mb-4">Partner Qualification</h2>
          <p class="text-xs sm:text-sm text-slate-400 leading-relaxed mb-6 font-light">
            Ideal for software platforms with an active partner or affiliate program (Rewardful, FirstPromoter, Stripe, or PartnerStack).
          </p>

          <ul class="space-y-3 text-xs font-mono text-slate-300 mb-8">
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400">✓</span>
              <span>Inclusion in the Software Radar and category filters</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400">✓</span>
              <span>Dedicated card in the Member Deals Vault (<code class="text-cyan-300">/deals</code>)</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400">✓</span>
              <span>Zero-latency secure edge redirect (<code class="text-cyan-300">/go/your-tool</code>)</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-cyan-400">✓</span>
              <span>Eligibility for the 2026 Software Excellence Awards</span>
            </li>
          </ul>
        </div>

        <a 
          href="#submission-form"
          class="w-full py-3.5 px-6 rounded-xl font-mono text-xs font-bold text-center bg-slate-800 hover:bg-slate-700 text-white border border-slate-700 transition-colors"
        >
          Submit For Free ↓
        </a>
      </div>

      <!-- Option B: Fast-Track Teardown & Guaranteed Syndication ($299) -->
      <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-indigo-950/40 via-slate-900/80 to-slate-950 border border-cyan-500/40 shadow-2xl flex flex-col justify-between backdrop-blur-xl relative group">
        <div class="absolute -top-3 right-6 px-3 py-1 rounded-full text-[10px] font-mono font-black bg-gradient-to-r from-cyan-500 to-indigo-500 text-slate-950 shadow-glow-cyan uppercase tracking-wider">
          FAST-TRACK 48H
        </div>

        <div>
          <div class="flex items-center justify-between gap-2 mb-6">
            <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
              ACCELERATED AUDIT & MEDIA BOOST
            </span>
            <span class="text-sm font-mono font-black text-white">$299 <span class="text-xs text-slate-400 font-normal">one-time</span></span>
          </div>

          <h2 class="text-2xl font-black text-white mb-4">Benchmark & Syndication Pack</h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 font-light">
            For teams seeking immediate authority deployment, a comprehensive architectural benchmark, and guaranteed multi-channel distribution.
          </p>

          <ul class="space-y-3 text-xs font-mono text-slate-300 mb-8">
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400">★</span>
              <span>Comprehensive technical audit published within <strong>48 hours</strong></span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400">★</span>
              <span>Custom 1200x630 4K vector social banner for your marketing</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400">★</span>
              <span>Official HeliaTech Accreditation SVG vector badge</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-emerald-400">★</span>
              <span>Guaranteed syndication on <strong>DEV.to (DA 92)</strong> and <strong>LinkedIn</strong></span>
            </li>
          </ul>
        </div>

        <a 
          href="#submission-form"
          class="w-full py-3.5 px-6 rounded-xl font-mono text-xs font-black text-center bg-gradient-to-r from-cyan-400 via-sky-400 to-indigo-400 hover:from-cyan-300 hover:to-indigo-300 text-slate-950 shadow-lg shadow-cyan-500/20 transition-all hover:scale-[1.02] active:scale-95"
        >
          Order Priority Audit ($299) ➔
        </a>
      </div>

    </div>

    <!-- Official Accreditation Badge Showcase -->
    <div class="mb-20 p-8 sm:p-12 rounded-3xl bg-slate-900/60 border border-slate-800 backdrop-blur-xl text-center">
      <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2 font-bold">
        THE TRUST STANDARD FOR TECH BUYERS
      </span>
      <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight mb-4">
        Official HeliaTech Accreditation Badge
      </h2>
      <p class="text-slate-400 text-xs sm:text-sm max-w-2xl mx-auto mb-8 font-light">
        Accredited platforms can embed our official SVG vector badge directly on their website to boost conversion confidence.
      </p>

      <div class="inline-block p-4 rounded-2xl bg-slate-950/90 border border-slate-800 shadow-2xl">
        <img 
          src="/badges/winner-2026-make.svg" 
          alt="Official HeliaTech Accreditation Badge Example" 
          class="w-72 sm:w-80 h-auto rounded-xl mx-auto"
          width="320" 
          height="120"
        />
      </div>
    </div>

    <!-- Interactive Submission Form -->
    <div id="submission-form" class="p-8 sm:p-12 rounded-3xl bg-slate-900/80 border border-cyan-500/30 shadow-2xl backdrop-blur-2xl relative overflow-hidden">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-8">
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-1">
            RAPID SUBMISSION FORM
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Register Your Platform
          </h2>
          <p class="text-xs sm:text-sm text-slate-400 mt-2 font-light">
            Our benchmark analysts will review your architecture and verify accreditation criteria within 24 business hours.
          </p>
        </div>

        <form id="partner-form" class="space-y-5 text-left text-xs font-mono">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-slate-300 font-bold mb-1.5">Software / SaaS Name *</label>
              <input 
                type="text" 
                id="form-tool-name"
                required
                placeholder="e.g. SuperApp AI"
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-cyan-400 text-sm font-sans"
              />
            </div>
            <div>
              <label class="block text-slate-300 font-bold mb-1.5">Official Website URL *</label>
              <input 
                type="url" 
                id="form-website-url"
                required
                placeholder="https://your-platform.com"
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-cyan-400 text-sm font-sans"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label class="block text-slate-300 font-bold mb-1.5">Affiliate Link / Rewardful Token *</label>
              <input 
                type="text" 
                id="form-affiliate-url"
                required
                placeholder="e.g. ?via=heliatech or partner portal link"
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-cyan-400 text-sm font-sans"
              />
            </div>
            <div>
              <label class="block text-slate-300 font-bold mb-1.5">Primary Category *</label>
              <select 
                id="form-category"
                class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-cyan-400 text-sm font-sans"
              >
                <option value="Workflow Automation & No-Code">Workflow Automation & No-Code</option>
                <option value="Generative AI Video & Voice">Generative AI Video & Voice</option>
                <option value="B2B Sales & Lead Intelligence">B2B Sales & Lead Intelligence</option>
                <option value="Developer Tools & Infrastructure">Developer Tools & Infrastructure</option>
                <option value="Audience, Media & Newsletter">Audience, Media & Newsletter</option>
                <option value="Other">Other / Specialized B2B SaaS</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-slate-300 font-bold mb-1.5">Exclusive Perk / Discount for Readers *</label>
            <input 
              type="text" 
              id="form-perk"
              required
              placeholder="e.g. 30-day extended trial or 20% off first month"
              class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-cyan-400 text-sm font-sans"
            />
          </div>

          <div>
            <label class="block text-slate-300 font-bold mb-1.5">Founder / Partnerships Lead Email *</label>
            <input 
              type="email" 
              id="form-email"
              required
              placeholder="contact@your-platform.com"
              class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-cyan-400 text-sm font-sans"
            />
          </div>

          <div>
            <label class="block text-slate-300 font-bold mb-1.5">Selected Plan</label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
              <label class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-950 border border-slate-800 cursor-pointer">
                <input type="radio" name="plan" value="standard" checked class="accent-cyan-400" />
                <span class="text-xs text-white">Standard (Free with affiliate program)</span>
              </label>
              <label class="flex items-center gap-2.5 p-3 rounded-xl bg-slate-950 border border-cyan-500/40 cursor-pointer">
                <input type="radio" name="plan" value="fasttrack" class="accent-cyan-400" />
                <span class="text-xs text-cyan-300 font-bold">Fast-Track 48h ($299)</span>
              </label>
            </div>
          </div>

          <button 
            type="submit"
            id="form-submit-btn"
            class="w-full py-4 px-6 rounded-2xl font-black font-mono text-xs uppercase tracking-wider text-slate-950 bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400 hover:from-cyan-300 hover:to-indigo-300 shadow-lg shadow-cyan-500/25 transition-all duration-300 hover:scale-[1.02] active:scale-95 cursor-pointer mt-6"
          >
            Submit Application ➔
          </button>
        </form>

        <!-- Success Feedback Banner -->
        <div id="form-success-banner" class="hidden mt-6 p-5 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-center">
          <div class="text-2xl mb-2">🎉</div>
          <h3 class="text-base font-bold text-white mb-1">Application Received Successfully!</h3>
          <p class="text-xs font-mono text-emerald-300">
            Our analysts are reviewing your accreditation parameters. You will receive an email confirmation within 24 hours.
          </p>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    (function() {
      const form = document.getElementById('partner-form');
      const submitBtn = document.getElementById('form-submit-btn');
      const successBanner = document.getElementById('form-success-banner');

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          
          const toolName = document.getElementById('form-tool-name')?.value || '';
          const websiteUrl = document.getElementById('form-website-url')?.value || '';
          const affiliateUrl = document.getElementById('form-affiliate-url')?.value || '';
          const category = document.getElementById('form-category')?.value || '';
          const perk = document.getElementById('form-perk')?.value || '';
          const email = document.getElementById('form-email')?.value || '';
          const plan = document.querySelector('input[name="plan"]:checked')?.value || 'standard';

          const submission = {
            timestamp: new Date().toISOString(),
            toolName,
            websiteUrl,
            affiliateUrl,
            category,
            perk,
            email,
            plan
          };

          try {
            const existing = JSON.parse(localStorage.getItem('_ht_partner_submissions') || '[]');
            existing.push(submission);
            localStorage.setItem('_ht_partner_submissions', JSON.stringify(existing));
          } catch(err) {}

          if (submitBtn) {
            submitBtn.textContent = '✓ Submitted Successfully';
            submitBtn.classList.add('opacity-50', 'pointer-events-none');
          }
          if (successBanner) {
            successBanner.classList.remove('hidden');
          }
          form.reset();
        });
      }
    })();
  </script>
</Layout>
