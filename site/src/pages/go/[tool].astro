---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  const pathMap = new Map<string, { targetUrl: string; toolName: string }>();

  // 1. Load from reviews collection
  reviews.forEach((entry) => {
    pathMap.set(entry.slug, {
      targetUrl: entry.data.affiliate_url || entry.data.website_url,
      toolName: entry.data.name
    });
  });

  // 2. Load and merge from _redirects file
  try {
    const redirectsPath = path.resolve(process.cwd(), 'public/_redirects');
    if (fs.existsSync(redirectsPath)) {
      const lines = fs.readFileSync(redirectsPath, 'utf-8').split('\n');
      for (const line of lines) {
        const trimmed = line.trim();
        if (trimmed.startsWith('/go/') && trimmed.includes('http')) {
          const parts = trimmed.split(/\s+/);
          const slug = parts[0].replace('/go/', '').replace('/', '').trim();
          const url = parts[1]?.trim();
          if (slug && url && !pathMap.has(slug)) {
            const prettyName = slug
              .split('-')
              .map(w => w.charAt(0).toUpperCase() + w.slice(1))
              .join(' ');
            pathMap.set(slug, {
              targetUrl: url,
              toolName: prettyName
            });
          }
        }
      }
    }
  } catch(e) {}

  return Array.from(pathMap.entries()).map(([slug, data]) => ({
    params: { tool: slug },
    props: { 
      targetUrl: data.targetUrl,
      toolName: data.toolName
    },
  }));
}

interface Props {
  targetUrl: string;
  toolName: string;
}

const { targetUrl, toolName } = Astro.props;
---

<!doctype html>
<html lang="en" style="background-color: #030303; color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <title>Redirecting to {toolName}...</title>
  </head>
  <body class="bg-[#030303] text-slate-200 flex items-center justify-center min-h-screen font-sans">
    <div class="text-center p-8 bg-slate-900/90 border border-cyan-500/30 rounded-3xl max-w-md mx-4 shadow-2xl backdrop-blur-xl">
      <div class="w-12 h-12 border-4 border-cyan-400 border-t-transparent rounded-full animate-spin mx-auto mb-6"></div>
      <h1 class="text-xl font-bold mb-2 text-white">Redirecting to {toolName}</h1>
      <p class="text-sm text-slate-400 mb-6">
        Routing to verified official endpoint... If you are not redirected automatically, click below.
      </p>
      <a 
        href={targetUrl} 
        rel="noopener noreferrer sponsored"
        class="inline-block px-6 py-3 bg-gradient-to-r from-cyan-500 to-fuchsia-500 hover:from-cyan-400 hover:to-fuchsia-400 text-slate-950 font-black text-xs rounded-xl shadow-lg transition-all"
      >
        Continue to Official Site ➔
      </a>
    </div>
  </body>
</html>
