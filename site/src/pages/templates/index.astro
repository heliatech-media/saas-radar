---
import Layout from '../../layouts/Layout.astro';
import templates from '../../data/templates_catalog.json';

const pageTitle = "Digital Templates & Automation Marketplace | HeliaTech";
const pageDescription = "Discover, buy and deploy production-grade n8n workflows, Make blueprints, Supabase architectures, AI Agents, and Notion OS verified by Sentinel Anti-Scam.";

const ecosystemColors: Record<string, string> = {
  n8n: "from-orange-500/20 to-amber-500/10 border-orange-500/40 text-orange-400",
  make: "from-purple-500/20 to-indigo-500/10 border-purple-500/40 text-purple-400",
  airtable: "from-yellow-500/20 to-amber-500/10 border-yellow-500/40 text-yellow-400",
  cursor: "from-cyan-500/20 to-sky-500/10 border-cyan-500/40 text-cyan-400",
  supabase: "from-emerald-500/20 to-teal-500/10 border-emerald-500/40 text-emerald-400",
  "ai-agents": "from-rose-500/20 to-pink-500/10 border-rose-500/40 text-rose-400",
  zapier: "from-amber-500/20 to-orange-500/10 border-amber-500/40 text-amber-400",
  notion: "from-slate-400/20 to-slate-600/10 border-slate-400/40 text-slate-300",
  firebase: "from-yellow-600/20 to-amber-600/10 border-amber-500/40 text-amber-400"
};

const categories = [
  "Tous",
  "Lead Gen & Sales",
  "Fintech & RevOps",
  "CRM & Sales",
  "Customer Support",
  "AI Developer Tools",
  "Social & Content",
  "Agency Operations",
  "SaaS Starter Kits",
  "Productivity Systems",
  "Developer Tools"
];

// Top featured blueprints
const featuredTemplates = templates.filter(t => t.is_featured).slice(0, 3);

// Group unique creators
const creatorsMap = new Map();
templates.forEach(t => {
  if (!t.creator) return;
  const slug = t.creator.slug || t.creator.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
  if (!creatorsMap.has(slug)) {
    creatorsMap.set(slug, {
      ...t.creator,
      slug,
      sales: 0,
      templates_count: 0
    });
  }
  const c = creatorsMap.get(slug);
  c.sales += (t.sales_count || 0);
  c.templates_count += 1;
});

const topCreators = Array.from(creatorsMap.values())
  .sort((a, b) => b.sales - a.sales)
  .slice(0, 4);

const freeTemplatesCount = templates.filter(t => t.is_free || t.price_usd === 0).length;
---

<Layout title={pageTitle} description={pageDescription} noindex={false}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-24">
    
    <!-- Top Marketplace Navigation Bar -->
    <div class="flex flex-wrap items-center justify-between p-3.5 mb-8 rounded-2xl bg-slate-900/80 border border-slate-800 text-xs font-mono gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span class="font-bold text-white uppercase tracking-wider">HeliaTech Marketplace</span>
        <span class="text-slate-400 hidden sm:inline">— {templates.length} templates d'ingénierie vérifiés Anti-Scam</span>
      </div>
      <div class="flex items-center gap-2">
        <button id="quick-free-filter-btn" class="px-3 py-1 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-bold transition-all flex items-center gap-1.5">
          <span>🎁</span>
          <span>Gratuits ({freeTemplatesCount})</span>
        </button>
        <a href="/portal/" class="px-3 py-1 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-200 border border-cyan-500/40 font-bold transition-all">
          Mon Espace (/portal) ➔
        </a>
        <a href="/sell/" class="px-3 py-1 rounded-lg bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-200 border border-indigo-500/40 font-bold transition-all">
          Vendre (80% net) ➔
        </a>
      </div>
    </div>

    <!-- Hero Section -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono font-bold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        Discover. Buy. Deploy Production-Grade Digital Templates.
      </div>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight mb-6">
        Production-Ready <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">
          Workflows &amp; AI Systems
        </span>
      </h1>
      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        Déployez instantanément des <strong>automations n8n</strong>, <strong>scénarios Make</strong>, <strong>architectures Supabase RLS</strong> et <strong>agents IA autonomes</strong> audités par le moteur Sentinel Anti-Scam. Téléchargez directement ou vendez vos créations.
      </p>
    </div>

    <!-- Key Telemetry Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono mb-1">{templates.length} Blueprints</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Vérifiés Anti-Scam AST</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono mb-1">80% Payout</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Part Vendeur Nette</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-2xl sm:text-3xl font-black text-amber-400 font-mono mb-1">{freeTemplatesCount} Gratuits</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Templates Open Access</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-2xl sm:text-3xl font-black text-indigo-400 font-mono mb-1">1-Clic Import</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">JSON &amp; DDL SQL Certifiés</div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 🌟 SECTION FEATURED TEMPLATES (Sélection de la Rédaction) -->
    <!-- ========================================================================= -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-cyan-400 font-bold block">Sélection Exclusive</span>
          <h2 class="text-2xl font-black text-white">⭐ Blueprints Recommandés de la Semaine</h2>
        </div>
        <span class="text-xs font-mono text-slate-500 hidden sm:inline">Audités par HeliaTech Security Engine</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredTemplates.map((tpl) => (
          <div class="p-6 rounded-3xl bg-gradient-to-b from-slate-900 to-slate-950 border border-cyan-500/30 hover:border-cyan-500/60 transition-all duration-300 relative overflow-hidden group shadow-lg flex flex-col justify-between">
            <div class="absolute top-0 right-0 px-3 py-1 bg-gradient-to-l from-cyan-500 to-sky-400 text-slate-950 text-[10px] font-mono font-black uppercase rounded-bl-xl tracking-wider">
              FEATURED PRO
            </div>

            <div>
              <div class="flex items-center gap-2 mb-3">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/30">
                  {tpl.ecosystem.toUpperCase()}
                </span>
                <span class="text-xs text-amber-400 font-mono">★ {tpl.rating}</span>
                <span class="text-[10px] text-slate-500 font-mono">({tpl.reviews_count} avis)</span>
              </div>

              <h3 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors mb-2">
                <a href={`/templates/${tpl.slug}/`}>
                  {tpl.title}
                </a>
              </h3>

              <p class="text-xs text-slate-400 line-clamp-2 mb-4 leading-relaxed font-light">
                {tpl.tagline}
              </p>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-slate-800/80">
              <span class="text-xl font-black text-white font-mono">
                {tpl.is_free ? <span class="text-emerald-400">GRATUIT</span> : `$${tpl.price_usd}`}
              </span>
              <a 
                href={`/templates/${tpl.slug}/`}
                class="px-3.5 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-mono font-bold transition-all shadow-glow-cyan"
              >
                Inspecter ➔
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 🔍 LIVE SEARCH & MULTI-FACETED FILTER CONTROLS -->
    <!-- ========================================================================= -->
    <div class="p-6 rounded-3xl bg-slate-900/80 border border-slate-800 mb-10 space-y-6">
      
      <!-- Top Search & Sort Row -->
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        
        <!-- Search Input -->
        <div class="relative w-full md:w-2/3">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500 text-sm">
            🔍
          </span>
          <input 
            type="text" 
            id="live-search-input"
            placeholder="Rechercher par mot-clé (ex: Supabase, Lead, Stripe, Claude, RAG, Webhook, CRM...)"
            class="w-full pl-10 pr-4 py-3 rounded-2xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-xs font-mono focus:border-cyan-500 focus:outline-none transition-all"
          />
        </div>

        <!-- Sort Select -->
        <div class="flex items-center gap-2.5 w-full md:w-auto">
          <span class="text-xs font-mono text-slate-400 whitespace-nowrap">Trier par :</span>
          <select 
            id="sort-select"
            class="w-full md:w-auto px-3.5 py-3 rounded-2xl bg-slate-950 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
          >
            <option value="popular">🔥 Plus Populaires (Ventes)</option>
            <option value="rating">⭐️ Mieux Notés (Avis vérifiés)</option>
            <option value="newest">⚡ Plus Récents</option>
            <option value="price-asc">💵 Prix : Moins cher au plus cher</option>
            <option value="price-desc">💎 Prix : Plus cher au moins cher</option>
          </select>
        </div>

      </div>

      <!-- Quick Platform Filter Tabs -->
      <div class="space-y-3 pt-2 border-t border-slate-800/80">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider">Écosystème &amp; Technologie :</span>
          <span id="results-counter" class="text-xs font-mono text-cyan-400 font-bold">
            Affichage de {templates.length} blueprints
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button class="eco-btn active px-3.5 py-1.5 rounded-xl bg-cyan-500 text-slate-950 font-mono text-xs font-bold transition-all shadow-glow-cyan" data-ecosystem="all">
            ⚡ Tous ({templates.length})
          </button>
          <button class="eco-btn px-3.5 py-1.5 rounded-xl bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="n8n">
            🟠 n8n
          </button>
          <button class="eco-btn px-3.5 py-1.5 rounded-xl bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="make">
            🟣 Make
          </button>
          <button class="eco-btn px-3.5 py-1.5 rounded-xl bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="supabase">
            ⚡ Supabase
          </button>
          <button class="eco-btn px-3.5 py-1.5 rounded-xl bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="ai-agents">
            🤖 AI Agents
          </button>
          <button class="eco-btn px-3.5 py-1.5 rounded-xl bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="notion">
            📜 Notion OS
          </button>
          <button class="eco-btn px-3.5 py-1.5 rounded-xl bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="airtable">
            🟡 Airtable
          </button>
          <button class="eco-btn px-3.5 py-1.5 rounded-xl bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="zapier">
            🔵 Zapier
          </button>
          <button class="eco-btn px-3.5 py-1.5 rounded-xl bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="firebase">
            🔥 Firebase
          </button>
          <button class="eco-btn px-3.5 py-1.5 rounded-xl bg-slate-950 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="cursor">
            💻 Cursor Rules
          </button>
        </div>
      </div>

      <!-- Price & Complexity Filters Row -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-slate-800/60">
        <div>
          <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mb-2">Modèle Tarifaire :</span>
          <div class="flex items-center gap-2">
            <button class="price-btn active px-3 py-1 rounded-lg text-xs font-mono transition-all border bg-slate-800 text-cyan-300 border-cyan-500/40" data-price-type="all">
              Tous
            </button>
            <button class="price-btn px-3 py-1 rounded-lg text-xs font-mono transition-all border bg-slate-950 text-slate-400 hover:text-white border-slate-800" data-price-type="free">
              🎁 100% Gratuits ({freeTemplatesCount})
            </button>
            <button class="price-btn px-3 py-1 rounded-lg text-xs font-mono transition-all border bg-slate-950 text-slate-400 hover:text-white border-slate-800" data-price-type="paid">
              💎 Blueprints Pro ({templates.length - freeTemplatesCount})
            </button>
          </div>
        </div>

        <div>
          <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mb-2">Niveau de Complexité :</span>
          <div class="flex items-center gap-2">
            <button class="diff-btn active px-3 py-1 rounded-lg text-xs font-mono transition-all border bg-slate-800 text-cyan-300 border-cyan-500/40" data-diff="all">
              Tous
            </button>
            <button class="diff-btn px-3 py-1 rounded-lg text-xs font-mono transition-all border bg-slate-950 text-slate-400 hover:text-white border-slate-800" data-diff="beginner">
              Débutant
            </button>
            <button class="diff-btn px-3 py-1 rounded-lg text-xs font-mono transition-all border bg-slate-950 text-slate-400 hover:text-white border-slate-800" data-diff="intermediate">
              Intermédiaire
            </button>
            <button class="diff-btn px-3 py-1 rounded-lg text-xs font-mono transition-all border bg-slate-950 text-slate-400 hover:text-white border-slate-800" data-diff="advanced">
              Avancé
            </button>
          </div>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="space-y-2 pt-2 border-t border-slate-800/60">
        <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block">Domaine Métier &amp; Cas d'Usage :</span>
        <div class="flex flex-wrap items-center gap-2">
          {categories.map((cat) => (
            <button 
              class={`cat-btn px-3 py-1 rounded-lg text-xs font-mono transition-all border ${cat === 'Tous' ? 'bg-slate-800 text-cyan-300 border-cyan-500/40 active' : 'bg-slate-950 text-slate-400 hover:text-white border-slate-800'}`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 📦 TEMPLATE CARDS GRID -->
    <!-- ========================================================================= -->
    <div id="templates-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {templates.map((tpl) => {
        const colorClass = ecosystemColors[tpl.ecosystem] || "from-slate-500/20 to-slate-800/10 border-slate-700 text-slate-300";

        return (
          <div 
            class="template-card flex flex-col justify-between p-6 rounded-3xl bg-slate-950/70 border border-slate-800 hover:border-slate-700 transition-all duration-300 hover:-translate-y-1 group relative overflow-hidden"
            data-id={tpl.id}
            data-ecosystem={tpl.ecosystem}
            data-category={tpl.category}
            data-title={tpl.title.toLowerCase()}
            data-tagline={tpl.tagline.toLowerCase()}
            data-services={tpl.required_services.join(' ').toLowerCase()}
            data-price={tpl.price_usd}
            data-is-free={tpl.is_free ? "true" : "false"}
            data-difficulty={tpl.difficulty || "intermediate"}
            data-sales={tpl.sales_count}
            data-rating={tpl.rating}
          >
            <!-- Glow Accents -->
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/15 transition-all"></div>

            <div>
              <!-- Top Badges & Favorite Button -->
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class={`text-[10px] font-mono font-bold uppercase tracking-wider px-3 py-1 rounded-full border bg-gradient-to-r ${colorClass}`}>
                  {tpl.ecosystem.toUpperCase()}
                </span>
                
                <div class="flex items-center gap-2">
                  <div class="flex items-center gap-1 text-xs font-mono">
                    <span class="text-amber-400">★</span>
                    <span class="font-bold text-white">{tpl.rating}</span>
                    <span class="text-[10px] text-slate-500">({tpl.reviews_count})</span>
                  </div>

                  <!-- Favorite Wishlist Heart Button -->
                  <button 
                    class="btn-favorite p-1.5 rounded-lg bg-slate-900 hover:bg-rose-500/20 text-slate-400 hover:text-rose-400 border border-slate-800 transition-all"
                    data-template-id={tpl.id}
                    title="Ajouter à mes favoris"
                    aria-label="Ajouter aux favoris"
                  >
                    ♥
                  </button>
                </div>
              </div>

              <!-- Title & Tagline -->
              <h2 class="text-lg font-bold text-white group-hover:text-cyan-300 transition-colors mb-2 leading-snug">
                <a href={`/templates/${tpl.slug}/`}>
                  {tpl.title}
                </a>
              </h2>
              <p class="text-xs text-slate-400 font-light leading-relaxed mb-3 line-clamp-2">
                {tpl.tagline}
              </p>

              <!-- Creator Storefront Link -->
              <div class="flex items-center gap-2 mb-4 text-[11px] font-mono text-slate-400">
                <img src={tpl.creator.avatar} alt={tpl.creator.name} class="w-4 h-4 rounded-full border border-slate-700 object-cover" />
                <span class="text-slate-500">Par</span>
                <a href={`/creator/${tpl.creator.slug || tpl.creator.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`} class="text-cyan-400 hover:underline font-bold">
                  {tpl.creator.name}
                </a>
              </div>

              <!-- Mini Pipeline Nodes Preview -->
              {tpl.pipeline_steps && tpl.pipeline_steps.length > 0 && (
                <div class="p-2.5 rounded-xl bg-slate-900/50 border border-slate-800/80 mb-4">
                  <span class="text-[10px] font-mono text-slate-400 block mb-1.5 font-semibold">Flux d'Exécution :</span>
                  <div class="flex items-center gap-1.5 overflow-x-auto text-[11px] font-mono text-slate-300 pb-1 scrollbar-none">
                    {tpl.pipeline_steps.slice(0, 3).map((step, idx) => (
                      <span class="flex items-center gap-1 px-2 py-0.5 rounded bg-slate-950 border border-slate-800 whitespace-nowrap">
                        <span>{step.icon}</span> <span>{step.name}</span>
                        {idx < 2 && <span class="text-slate-600 ml-1">➔</span>}
                      </span>
                    ))}
                    {tpl.pipeline_steps.length > 3 && (
                      <span class="text-[10px] text-cyan-400 font-mono">+{tpl.pipeline_steps.length - 3}</span>
                    )}
                  </div>
                </div>
              )}

              <!-- Technical ROI Metric Tags -->
              <div class="space-y-2 mb-5 text-[11px] font-mono">
                <div class="flex items-center justify-between text-slate-400">
                  <span>Temps économisé :</span>
                  <span class="text-emerald-400 font-bold">~{tpl.estimated_hours_saved}h de dev</span>
                </div>
                <div class="flex items-center justify-between text-slate-400">
                  <span>Stack requise :</span>
                  <span class="text-slate-200 truncate max-w-[170px]" title={tpl.required_services.join(', ')}>
                    {tpl.required_services.join(' • ')}
                  </span>
                </div>
              </div>
            </div>

            <!-- Bottom Price & CTA -->
            <div class="flex items-center justify-between pt-4 border-t border-slate-800">
              <div>
                <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">Licence Commerciale</span>
                {tpl.is_free ? (
                  <span class="text-2xl font-black text-emerald-400 font-mono">GRATUIT</span>
                ) : (
                  <span class="text-2xl font-black text-white font-mono">${tpl.price_usd}</span>
                )}
              </div>
              <a 
                href={`/templates/${tpl.slug}/`}
                class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-400 hover:from-cyan-400 hover:to-sky-300 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider transition-all shadow-glow-cyan"
              >
                Inspecter ➔
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Empty Results Alert (hidden by default) -->
    <div id="no-results-box" class="p-12 rounded-3xl bg-slate-900/40 border border-slate-800 text-center space-y-4 mb-16 hidden">
      <div class="text-4xl">🔍</div>
      <h3 class="text-lg font-bold text-white">Aucun blueprint ne correspond à vos filtres</h3>
      <p class="text-xs font-mono text-slate-400 max-w-md mx-auto">
