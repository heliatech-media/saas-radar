---
import Layout from '../../layouts/Layout.astro';
import templates from '../../data/templates_catalog.json';

const pageTitle = "Automation Blueprints & AI Stack Marketplace | HeliaTech (Private Staging)";
const pageDescription = "Explore battle-tested n8n workflows, Make.com blueprints, Airtable systems, and Cursor AI rules built by verified engineers.";

const ecosystemColors: Record<string, string> = {
  n8n: "from-orange-500/20 to-amber-500/10 border-orange-500/40 text-orange-400",
  make: "from-purple-500/20 to-indigo-500/10 border-purple-500/40 text-purple-400",
  airtable: "from-yellow-500/20 to-amber-500/10 border-yellow-500/40 text-yellow-400",
  cursor: "from-cyan-500/20 to-sky-500/10 border-cyan-500/40 text-cyan-400"
};
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-24">
    
    <!-- Stealth Staging Private Notice -->
    <div class="flex items-center justify-between p-3.5 mb-8 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-mono">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="font-bold uppercase tracking-wider">Mode Stealth / Staging Privé</span>
        <span class="text-amber-400/70 hidden sm:inline">— Cette marketplace est en cours d'assemblage sous-marin. Non indexée.</span>
      </div>
      <a href="/sell/" class="px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-200 border border-amber-500/40 font-bold transition-all">
        Espace Vendeur (/sell) ➔
      </a>
    </div>

    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono font-bold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        HeliaTech Automation &amp; AI Stack Exchange
      </div>
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight mb-6">
        Production-Grade <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400">
          Workflows &amp; Blueprints
        </span>
      </h1>
      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        Stop re-inventing the wheel. Deploy verified <strong>n8n workflows</strong>, <strong>Make.com blueprints</strong>, and <strong>Airtable architectures</strong> built by top engineers. Buy directly or sell your own templates with an 80% creator payout.
      </p>
    </div>

    <!-- Live Marketplace Stats Telemetry -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono mb-1">6 Blueprints</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Vérifiés en Staging</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono mb-1">80% Payout</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Part Créateur Garanti</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-2xl sm:text-3xl font-black text-fuchsia-400 font-mono mb-1">20% Cut</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Commission HeliaTech</div>
      </div>
      <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
        <div class="text-2xl sm:text-3xl font-black text-amber-400 font-mono mb-1">100% JSON</div>
        <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Téléchargement 1-Clic</div>
      </div>
    </div>

    <!-- Filter Buttons (Ecosystem Tabs) -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 mb-12">
      <button class="filter-btn active px-4 py-2 rounded-xl bg-cyan-500 text-slate-950 font-mono text-xs font-bold transition-all shadow-glow-cyan" data-ecosystem="all">
        ⚡ Tous ({templates.length})
      </button>
      <button class="filter-btn px-4 py-2 rounded-xl bg-slate-900 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="n8n">
        🟠 n8n Workflows
      </button>
      <button class="filter-btn px-4 py-2 rounded-xl bg-slate-900 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="make">
        🟣 Make.com Blueprints
      </button>
      <button class="filter-btn px-4 py-2 rounded-xl bg-slate-900 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="airtable">
        🟡 Airtable OS
      </button>
      <button class="filter-btn px-4 py-2 rounded-xl bg-slate-900 text-slate-300 hover:text-white border border-slate-800 hover:border-slate-700 font-mono text-xs font-bold transition-all" data-ecosystem="cursor">
        🤖 Cursor Rules
      </button>
    </div>

    <!-- Template Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {templates.map((tpl) => {
        const colorClass = ecosystemColors[tpl.ecosystem] || "from-slate-500/20 to-slate-800/10 border-slate-700 text-slate-300";

        return (
          <div 
            class="template-card flex flex-col justify-between p-6 rounded-3xl bg-slate-950/70 border border-slate-800 hover:border-slate-700 transition-all duration-300 hover:-translate-y-1 group relative overflow-hidden"
            data-ecosystem={tpl.ecosystem}
          >
            <!-- Glow Accents -->
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/5 rounded-full blur-2xl group-hover:bg-cyan-500/15 transition-all"></div>

            <div>
              <!-- Top Badges -->
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class={`px-2.5 py-1 rounded-full text-[10px] font-mono font-bold uppercase tracking-wider border ${colorClass}`}>
                  {tpl.ecosystem.toUpperCase()}
                </span>
                <span class="text-xs font-mono font-bold text-slate-400">
                  {tpl.nodes_count} Nodes • ~{tpl.estimated_hours_saved}h saved
                </span>
              </div>

              <!-- Title & Tagline -->
              <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors mb-2 leading-snug">
                <a href={`/templates/${tpl.slug}/`}>
                  {tpl.title}
                </a>
              </h3>
              <p class="text-xs text-slate-400 font-light leading-relaxed mb-6">
                {tpl.tagline}
              </p>

              <!-- Value Prop Box -->
              <div class="p-3.5 rounded-2xl bg-slate-900/80 border border-slate-800/80 space-y-2 mb-6">
                <div class="text-[11px] font-mono text-emerald-400 font-bold flex items-center justify-between">
                  <span>💰 ROI Estimé :</span>
                  <span>{tpl.monthly_savings_estimate}</span>
                </div>
                <div class="text-[10px] font-mono text-slate-400">
                  Services : {tpl.required_services.join(', ')}
                </div>
              </div>

              <!-- Creator Info -->
              <div class="flex items-center gap-2.5 mb-6 pt-4 border-t border-slate-800/80">
                <img src={tpl.creator.avatar} alt={tpl.creator.name} class="w-7 h-7 rounded-full bg-slate-800 border border-slate-700" />
                <div class="text-xs">
                  <div class="text-white font-semibold flex items-center gap-1.5">
                    {tpl.creator.name}
                    <span class="text-[9px] px-1.5 py-0.5 rounded bg-cyan-500/10 text-cyan-400 font-mono">
                      {tpl.creator.badge}
                    </span>
                  </div>
                  <div class="text-[10px] text-slate-400 font-mono">
                    ★ {tpl.rating} ({tpl.reviews_count} avis) • {tpl.sales_count} ventes
                  </div>
                </div>
              </div>
            </div>

            <!-- Bottom Price & CTA -->
            <div class="flex items-center justify-between pt-4 border-t border-slate-800">
              <div>
                <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider block">Prix Licence</span>
                <span class="text-2xl font-black text-white font-mono">${tpl.price_usd}</span>
              </div>
              <a 
                href={`/templates/${tpl.slug}/`}
                class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-400 hover:from-cyan-400 hover:to-sky-300 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider transition-all shadow-glow-cyan"
              >
                Inspecter ➔
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Creator Call-to-Action Banner -->
    <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 border border-cyan-500/30 text-center relative overflow-hidden">
      <div class="max-w-2xl mx-auto space-y-4">
        <span class="px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-mono font-bold uppercase tracking-wider">
          Creator Revenue Flywheel
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
          Vous Construisez des Automations Rentables ?
        </h2>
        <p class="text-sm text-slate-300 font-light leading-relaxed">
          Publiez vos blueprints n8n, Make et Airtable sur HeliaTech. Touchez <strong>80% de reversement net</strong> sur chaque vente, sans aucun frais d'hébergement.
        </p>
        <div class="pt-4">
          <a 
            href="/sell/"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider transition-all shadow-glow-cyan"
          >
            Déposer un Workflow &amp; Estimer mes Gains ➔
          </a>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    // Client-side filtering by ecosystem
    document.querySelectorAll('.filter-btn').forEach(button => {
      button.addEventListener('click', () => {
        document.querySelectorAll('.filter-btn').forEach(b => {
          b.classList.remove('bg-cyan-500', 'text-slate-950', 'shadow-glow-cyan');
          b.classList.add('bg-slate-900', 'text-slate-300');
        });
        button.classList.add('bg-cyan-500', 'text-slate-950', 'shadow-glow-cyan');
        button.classList.remove('bg-slate-900', 'text-slate-300');

        const eco = button.getAttribute('data-ecosystem');
        document.querySelectorAll('.template-card').forEach(card => {
          if (eco === 'all' || card.getAttribute('data-ecosystem') === eco) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</Layout>
