  <!-- Interactive Client-side Script: Instant Search, Sorting, Wishlist & Multi-Filters -->
  <script is:inline>
    const searchInput = document.getElementById('live-search-input');
    const sortSelect = document.getElementById('sort-select');
    const ecoButtons = document.querySelectorAll('.eco-btn');
    const catButtons = document.querySelectorAll('.cat-btn');
    const priceButtons = document.querySelectorAll('.price-btn');
    const diffButtons = document.querySelectorAll('.diff-btn');
    const quickFreeBtn = document.getElementById('quick-free-filter-btn');
    const cards = Array.from(document.querySelectorAll('.template-card'));
    const grid = document.getElementById('templates-grid');
    const noResultsBox = document.getElementById('no-results-box');
    const resultsCounter = document.getElementById('results-counter');
    const resetBtn = document.getElementById('reset-filters-btn');

    let currentEco = 'all';
    let currentCat = 'Tous';
    let currentPriceType = 'all';
    let currentDiff = 'all';
    let searchQuery = '';
    let currentSort = 'popular';

    // Wishlist in localStorage
    const WISHLIST_KEY = '_ht_wishlist_ids';
    function getWishlist() {
      try {
        return JSON.parse(localStorage.getItem(WISHLIST_KEY) || '[]');
      } catch (e) {
        return [];
      }
    }

    function toggleWishlist(templateId, btn) {
      const list = getWishlist();
      const idx = list.indexOf(templateId);
      if (idx > -1) {
        list.splice(idx, 1);
        btn.classList.remove('text-rose-500', 'border-rose-500/50');
        btn.classList.add('text-slate-400');
      } else {
        list.push(templateId);
        btn.classList.add('text-rose-500', 'border-rose-500/50');
        btn.classList.remove('text-slate-400');
      }
      localStorage.setItem(WISHLIST_KEY, JSON.stringify(list));
    }

    // Initialize favorite buttons
    document.querySelectorAll('.btn-favorite').forEach(btn => {
      const id = btn.getAttribute('data-template-id');
      const wishlist = getWishlist();
      if (wishlist.includes(id)) {
        btn.classList.add('text-rose-500', 'border-rose-500/50');
        btn.classList.remove('text-slate-400');
      }
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        toggleWishlist(id, btn);
      });
    });

    function applyFilters() {
      let visibleCount = 0;

      cards.forEach(card => {
        const eco = card.getAttribute('data-ecosystem');
        const cat = card.getAttribute('data-category');
        const isFree = card.getAttribute('data-is-free') === 'true';
        const diff = card.getAttribute('data-difficulty');
        const title = card.getAttribute('data-title') || '';
        const tagline = card.getAttribute('data-tagline') || '';
        const services = card.getAttribute('data-services') || '';

        const matchEco = (currentEco === 'all' || eco === currentEco);
        const matchCat = (currentCat === 'Tous' || cat === currentCat);
        const matchPrice = (currentPriceType === 'all' || (currentPriceType === 'free' && isFree) || (currentPriceType === 'paid' && !isFree));
        const matchDiff = (currentDiff === 'all' || diff === currentDiff);
        const matchSearch = (!searchQuery || title.includes(searchQuery) || tagline.includes(searchQuery) || services.includes(searchQuery));

        if (matchEco && matchCat && matchPrice && matchDiff && matchSearch) {
          card.classList.remove('hidden');
          visibleCount++;
        } else {
          card.classList.add('hidden');
        }
      });

      // Sorting
      sortCards();

      // UI Counter & Empty State
      if (resultsCounter) {
        resultsCounter.textContent = `Affichage de ${visibleCount} blueprint${visibleCount > 1 ? 's' : ''}`;
      }

      if (visibleCount === 0) {
        noResultsBox?.classList.remove('hidden');
        grid?.classList.add('hidden');
      } else {
        noResultsBox?.classList.add('hidden');
        grid?.classList.remove('hidden');
      }
    }

    function sortCards() {
      const sorted = cards.slice().sort((a, b) => {
        const priceA = parseFloat(a.getAttribute('data-price') || 0);
        const priceB = parseFloat(b.getAttribute('data-price') || 0);
        const salesA = parseInt(a.getAttribute('data-sales') || 0);
        const salesB = parseInt(b.getAttribute('data-sales') || 0);
        const ratingA = parseFloat(a.getAttribute('data-rating') || 0);
        const ratingB = parseFloat(b.getAttribute('data-rating') || 0);
        const idA = a.getAttribute('data-id') || '';
        const idB = b.getAttribute('data-id') || '';

        if (currentSort === 'price-asc') return priceA - priceB;
        if (currentSort === 'price-desc') return priceB - priceA;
        if (currentSort === 'rating') return ratingB - ratingA;
        if (currentSort === 'newest') return idB.localeCompare(idA);
        return salesB - salesA; // default popular
      });

      sorted.forEach(card => grid?.appendChild(card));
    }

    // Debounced search
    let debounceTimer;
    searchInput?.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        searchQuery = e.target.value.toLowerCase().trim();
        applyFilters();
      }, 150);
    });

    sortSelect?.addEventListener('change', (e) => {
      currentSort = e.target.value;
      applyFilters();
    });

    ecoButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        ecoButtons.forEach(b => {
          b.classList.remove('bg-cyan-500', 'text-slate-950', 'shadow-glow-cyan');
          b.classList.add('bg-slate-950', 'text-slate-300');
        });
        btn.classList.add('bg-cyan-500', 'text-slate-950', 'shadow-glow-cyan');
        btn.classList.remove('bg-slate-950', 'text-slate-300');
        currentEco = btn.getAttribute('data-ecosystem');
        applyFilters();
      });
    });

    priceButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        priceButtons.forEach(b => {
          b.classList.remove('bg-slate-800', 'text-cyan-300', 'border-cyan-500/40');
          b.classList.add('bg-slate-950', 'text-slate-400');
        });
        btn.classList.add('bg-slate-800', 'text-cyan-300', 'border-cyan-500/40');
        btn.classList.remove('bg-slate-950', 'text-slate-400');
        currentPriceType = btn.getAttribute('data-price-type');
        applyFilters();
      });
    });

    diffButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        diffButtons.forEach(b => {
          b.classList.remove('bg-slate-800', 'text-cyan-300', 'border-cyan-500/40');
          b.classList.add('bg-slate-950', 'text-slate-400');
        });
        btn.classList.add('bg-slate-800', 'text-cyan-300', 'border-cyan-500/40');
        btn.classList.remove('bg-slate-950', 'text-slate-400');
        currentDiff = btn.getAttribute('data-diff');
        applyFilters();
      });
    });

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.classList.remove('bg-slate-800', 'text-cyan-300', 'border-cyan-500/40');
          b.classList.add('bg-slate-950', 'text-slate-400');
        });
        btn.classList.add('bg-slate-800', 'text-cyan-300', 'border-cyan-500/40');
        btn.classList.remove('bg-slate-950', 'text-slate-400');
        currentCat = btn.getAttribute('data-category');
        applyFilters();
      });
    });

    quickFreeBtn?.addEventListener('click', () => {
      priceButtons.forEach(b => {
        if (b.getAttribute('data-price-type') === 'free') {
          b.click();
        }
      });
    });

    resetBtn?.addEventListener('click', () => {
      currentEco = 'all';
      currentCat = 'Tous';
      currentPriceType = 'all';
      currentDiff = 'all';
      searchQuery = '';
      currentSort = 'popular';
      if (searchInput) searchInput.value = '';
      if (sortSelect) sortSelect.value = 'popular';
      ecoButtons[0]?.click();
      catButtons[0]?.click();
      priceButtons[0]?.click();
      diffButtons[0]?.click();
      applyFilters();
    });
  </script>
</Layout>
