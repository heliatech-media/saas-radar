---
import Layout from '../../layouts/Layout.astro';
import templates from '../../data/templates_catalog.json';

export async function getStaticPaths() {
  return templates.map((tpl) => ({
    params: { slug: tpl.slug },
    props: { template: tpl }
  }));
}

const { template } = Astro.props;
const pageTitle = `${template.title} | HeliaTech Marketplace`;
const pageDescription = template.tagline;

const defaultPipeline = [
  { step: 1, name: "Webhook Inbound Receiver", type: "Trigger", icon: "⚡", desc: "Interception sans latence de l'événement" },
  { step: 2, name: "AI Payload Validator & Scorer", type: "AI Engine", icon: "🤖", desc: "Analyse et enrichissement du payload" },
  { step: 3, name: "Condition & Waterfall Router", type: "Router", icon: "🔀", desc: "Aiguillage dynamique selon les règles métier" },
  { step: 4, name: "Database & CRM Synchronization", type: "Database", icon: "📊", desc: "Enregistrement sécurisé des données" },
  { step: 5, name: "Team Slack / Email Notification", type: "Notify", icon: "🔔", desc: "Alerte de l'équipe en temps réel" }
];

const pipeline = template.pipeline_steps || defaultPipeline;
const faqList = template.faq || [
  { q: "Combien de temps faut-il pour déployer ce blueprint ?", a: "Moins de 5 minutes. Importez le fichier .json, renseignez vos propres clés API et activez le webhook." },
  { q: "Quels sont les coûts d'exécution API estimés ?", a: "Optimisé pour consommer le strict minimum de tokens (environ $0.003 par exécution)." },
  { q: "Puis-je modifier ou étendre ce workflow ?", a: "Oui, la licence commerciale illimitée vous donne 100% de liberté pour adapter ou ajouter de nouveaux nœuds." }
];

const reviewsList = template.reviews || [
  { author: "Marc L.", role: "Head of Growth, B2B SaaS", rating: 5, date: "Il y a 3 jours", comment: "Déployé en 10 minutes. Fonctionne avec une robustesse remarquable." },
  { author: "Sarah D.", role: "Lead RevOps", rating: 5, date: "Il y a 1 semaine", comment: "Code d'ingénierie exemplaire, propre et sans bugs." }
];

const jsonSnippet = template.json_snippet || "{\n  \"name\": \"" + template.title + "\",\n  \"nodes\": [ ... ],\n  \"meta\": { \"certified_clean\": true }\n}";
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 pt-10 pb-24">
    
    <!-- Breadcrumb & Stealth Warning -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <nav class="flex items-center gap-2 text-xs font-mono text-slate-400">
        <a href="/templates/" class="hover:text-cyan-400 transition-colors">Marketplace</a>
        <span>/</span>
        <span class="text-slate-500 uppercase">{template.ecosystem}</span>
        <span>/</span>
        <span class="text-cyan-300 truncate max-w-[250px]">{template.slug}</span>
      </nav>

      <div class="flex items-center gap-2 text-[11px] font-mono text-amber-300 bg-amber-500/10 border border-amber-500/30 px-3 py-1 rounded-full w-fit">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Staging Privé • Anti-Scam Certifié</span>
      </div>
    </div>

    <!-- Main Grid: 2 Cols Left & Sticky Buy Box Right -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
      
      <!-- Left Column (2 Cols) -->
      <div class="lg:col-span-2 space-y-8">
        
        <!-- Header -->
        <div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono font-bold uppercase tracking-wider mb-4">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            Verified Production Blueprint ({template.ecosystem.toUpperCase()})
          </div>
          <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight leading-tight mb-4">
            {template.title}
          </h1>
          <p class="text-base text-slate-300 font-light leading-relaxed">
            {template.tagline}
          </p>
        </div>

        <!-- Creator Card with Storefront Link -->
        <a 
          href={`/creator/${template.creator.slug || template.creator.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`} 
          class="p-4 rounded-2xl bg-slate-900/60 hover:bg-slate-900/90 border border-slate-800 hover:border-cyan-500/40 flex items-center justify-between transition-all group"
        >
          <div class="flex items-center gap-3">
            <img src={template.creator.avatar} alt={template.creator.name} class="w-11 h-11 rounded-full border border-slate-700 group-hover:border-cyan-500/50 transition-colors" />
            <div>
              <div class="text-white group-hover:text-cyan-300 font-bold text-sm flex items-center gap-2 transition-colors">
                {template.creator.name}
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-mono">
                  {template.creator.badge}
                </span>
              </div>
              <div class="text-xs text-slate-400 font-mono mt-0.5">
                ★ {template.rating} / 5.0 ({template.reviews_count} avis certifiés) • {template.sales_count} installations
              </div>
            </div>
          </div>
          <span class="text-xs font-mono text-cyan-400 group-hover:translate-x-1 transition-transform flex items-center gap-1">
            <span>Voir le Studio</span> ➔
          </span>
        </a>

        <!-- ========================================================================= -->
        <!-- 🎨 INTERACTIVE VISUAL WORKFLOW NODE GRAPH & CODE INSPECTOR -->
        <!-- ========================================================================= -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/90 border border-slate-800 space-y-6">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
            <div>
              <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <span>🗺️</span> Architecture Visuelle du Workflow (Node Graph)
              </h2>
              <p class="text-xs text-slate-400 font-light mt-0.5">
                Inspectez le flux logique interconnecté avant de télécharger le fichier .json.
              </p>
            </div>
            
            <!-- Switcher Tabs: Visual Graph vs JSON Snippet -->
            <div class="flex items-center p-1 rounded-xl bg-slate-900 border border-slate-800 text-xs font-mono">
              <button id="tab-visual-graph" class="px-3 py-1.5 rounded-lg bg-cyan-500 text-slate-950 font-bold transition-all">
                Graphe Visuel
              </button>
              <button id="tab-code-inspect" class="px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition-all">
                Code JSON (Extrait)
              </button>
            </div>
          </div>

          <!-- View 1: Visual Pipeline Nodes Flow -->
          <div id="view-visual-graph" class="space-y-4">
            <div class="p-4 rounded-2xl bg-slate-900/40 border border-slate-800/80 overflow-x-auto">
              <div class="flex items-center gap-3 min-w-[550px] py-4 px-2">
                {pipeline.map((node, idx) => (
                  <div class="flex items-center">
                    <div class="p-4 rounded-2xl bg-slate-900 border border-slate-700/80 hover:border-cyan-500/60 transition-all text-center w-36 shadow-lg group relative">
                      <div class="text-2xl mb-1.5">{node.icon}</div>
                      <div class="text-[10px] font-mono text-cyan-400 font-bold uppercase tracking-wider mb-1">
                        Étape {node.step}
                      </div>
                      <div class="text-xs font-bold text-white leading-tight mb-1 truncate" title={node.name}>
                        {node.name}
                      </div>
                      <span class="text-[9px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 font-mono">
                        {node.type}
                      </span>
                    </div>

                    {idx < pipeline.length - 1 && (
                      <div class="flex items-center px-2 text-slate-600">
                        <span class="w-3 h-0.5 bg-cyan-500/40"></span>
                        <span class="text-cyan-400 font-mono text-xs">➔</span>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>

            <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 pt-1">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Flux idempotent sans boucle infinie</span>
              </span>
              <span class="text-slate-500">
                Total de {template.nodes_count} nœuds d'ingénierie inclus
              </span>
            </div>
          </div>

          <!-- View 2: JSON Code Inspector (Clean extract) -->
          <div id="view-code-inspect" class="space-y-3 hidden">
            <div class="relative">
              <pre class="p-4 rounded-2xl bg-slate-900 border border-slate-800 text-xs font-mono text-cyan-300 overflow-x-auto max-h-64 leading-relaxed scrollbar-none"><code>{jsonSnippet}</code></pre>
              <button 
                id="copy-code-btn"
                class="absolute top-3 right-3 px-3 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-mono border border-slate-700 transition-all"
              >
                📋 Copier l'Extrait
              </button>
            </div>
            <p class="text-[11px] font-mono text-slate-400">
              * Extrait partiel. Le fichier .json complet contenant les {template.nodes_count} nœuds et leurs connexions est livré instantanément au téléchargement.
            </p>
          </div>

        </div>

        <!-- Problem Solved & Highlights -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-4">
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <span>⚡</span> Ce que ce Blueprint Résout Concrètement
          </h2>
          <ul class="space-y-3 text-sm text-slate-300 font-light">
            {template.highlights.map((h) => (
              <li class="flex items-start gap-2.5">
                <span class="text-cyan-400 font-mono font-bold">✓</span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Technical Specifications Grid -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-4">
          <h2 class="text-lg font-bold text-white flex items-center gap-2">
            <span>🛠️</span> Spécifications d'Ingénierie &amp; Prérequis
          </h2>
          <div class="grid grid-cols-2 gap-4 text-xs font-mono">
            <div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800">
              <span class="text-slate-400 block mb-1">Nombre d'Étapes / Nodes :</span>
              <span class="text-white font-bold text-sm">{template.nodes_count} Nodes</span>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800">
              <span class="text-slate-400 block mb-1">Temps de Dev Économisé :</span>
              <span class="text-emerald-400 font-bold text-sm">~{template.estimated_hours_saved} Heures</span>
            </div>
            <div class="col-span-2 p-3.5 rounded-xl bg-slate-900/80 border border-slate-800">
              <span class="text-slate-400 block mb-1">Services &amp; Clés API Requises :</span>
              <span class="text-cyan-300 font-bold">{template.required_services.join(' • ')}</span>
            </div>
          </div>
        </div>

        <!-- ========================================================================= -->
        <!-- ⭐ VERIFIED CUSTOMER REVIEWS -->
        <!-- ========================================================================= -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
          <div class="flex items-center justify-between border-b border-slate-800 pb-4">
            <div>
              <h2 class="text-lg font-bold text-white flex items-center gap-2">
                <span>⭐</span> Avis Clients Certifiés ({reviewsList.length})
              </h2>
              <p class="text-xs text-slate-400 font-light mt-0.5">
                Retours d'expérience d'ingénieurs et fondateurs ayant déployé ce blueprint.
              </p>
            </div>
            <div class="text-right">
              <div class="text-2xl font-black text-amber-400 font-mono">★ {template.rating}</div>
              <div class="text-[10px] text-slate-400 font-mono">100% Achats Vérifiés</div>
            </div>
          </div>

          <div class="space-y-4">
            {reviewsList.map((rev) => (
              <div class="p-4 rounded-2xl bg-slate-900/50 border border-slate-800 space-y-2">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="text-white font-bold text-xs">{rev.author}</span>
                    <span class="text-[10px] font-mono text-slate-400">• {rev.role}</span>
                    <span class="text-[9px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                      Achat Vérifié
                    </span>
                  </div>
                  <span class="text-xs text-amber-400">{'★'.repeat(rev.rating)}</span>
                </div>
                <p class="text-xs text-slate-300 font-light leading-relaxed">
                  "{rev.comment}"
                </p>
                <div class="text-[10px] text-slate-500 font-mono">
                  Publié {rev.date}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ========================================================================= -->
        <!-- ❓ TECHNICAL INTEGRATION FAQ -->
        <!-- ========================================================================= -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-4">
          <h2 class="text-lg font-bold text-white flex items-center gap-2 mb-2">
            <span>❓</span> Questions Fréquentes &amp; Support d'Intégration
          </h2>
          
          <div class="space-y-3">
            {faqList.map((faq) => (
              <details class="group p-4 rounded-2xl bg-slate-900/60 border border-slate-800 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between cursor-pointer text-xs font-mono font-bold text-white">
                  <span>{faq.q}</span>
                  <span class="text-cyan-400 transition-transform group-open:rotate-180">▼</span>
                </summary>
                <p class="mt-3 text-xs text-slate-300 font-light leading-relaxed border-t border-slate-800/80 pt-3">
                  {faq.a}
                </p>
              </details>
            ))}
          </div>
        </div>

      </div>

      <!-- Right Column: Sticky Purchase Box (1 Col) -->
      <div class="space-y-6">
        <div class="sticky top-24 p-6 sm:p-7 rounded-3xl bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 border border-cyan-500/40 shadow-[0_0_35px_rgba(6,182,212,0.12)] space-y-6">
          
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">Licence Commerciale</span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                Prêt à Importer
              </span>
            </div>
            <div class="flex items-baseline gap-2">
              <span class="text-4xl font-black text-white font-mono">${template.price_usd}</span>
              <span class="text-xs text-slate-400 font-mono">USD (Paiement Unique)</span>
            </div>
          </div>

          <!-- ROI Badge -->
          <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-mono font-bold text-center">
            💰 Rentabilité : {template.monthly_savings_estimate}
          </div>

          <!-- Purchase Action Button & Wishlist -->
          <div class="space-y-3">
            <button 
              id="checkout-btn"
              class="w-full py-4 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-400 hover:from-cyan-400 hover:to-sky-300 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider text-center transition-all shadow-glow-cyan"
            >
              Acheter &amp; Télécharger le JSON (${template.price_usd}) ➔
            </button>
            <button 
              id="add-wishlist-btn"
              class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 font-mono text-xs transition-all flex items-center justify-center gap-2"
              data-id={template.id}
              data-slug={template.slug}
              data-title={template.title}
              data-ecosystem={template.ecosystem}
              data-price={template.price_usd}
              data-savings={template.monthly_savings_estimate}
            >
              <span>💖</span> Ajouter à ma Wishlist
            </button>
            <p class="text-[10px] text-slate-400 text-center font-mono">
              ⚡ Livraison immédiate du fichier .json sécurisé + tutoriel d'import
            </p>
          </div>

          <!-- Guarantees List -->
          <ul class="text-[11px] text-slate-300 space-y-2.5 font-mono pt-4 border-t border-slate-800">
            <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Code JSON certifié sans fuite d'API</li>
            <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Audit Anti-Scam 99/100 (Sentinel)</li>
            <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Compatible version 2026</li>
            <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Support d'intégration par le créateur</li>
            <li class="flex items-center gap-2"><span class="text-cyan-400">✓</span> Téléchargement garanti à vie dans votre espace client</li>
          </ul>

        </div>
      </div>

    </div>

  </div>

  <script is:inline>
    // Tab Switcher: Visual Node Graph vs JSON Code Snippet
    const tabGraph = document.getElementById('tab-visual-graph');
    const tabCode = document.getElementById('tab-code-inspect');
    const viewGraph = document.getElementById('view-visual-graph');
    const viewCode = document.getElementById('view-code-inspect');

    tabGraph?.addEventListener('click', () => {
      tabGraph.classList.add('bg-cyan-500', 'text-slate-950', 'font-bold');
      tabGraph.classList.remove('text-slate-400');
      tabCode.classList.remove('bg-cyan-500', 'text-slate-950', 'font-bold');
      tabCode.classList.add('text-slate-400');

      viewGraph?.classList.remove('hidden');
      viewCode?.classList.add('hidden');
    });

    tabCode?.addEventListener('click', () => {
      tabCode.classList.add('bg-cyan-500', 'text-slate-950', 'font-bold');
      tabCode.classList.remove('text-slate-400');
      tabGraph.classList.remove('bg-cyan-500', 'text-slate-950', 'font-bold');
      tabGraph.classList.add('text-slate-400');

      viewCode?.classList.remove('hidden');
      viewGraph?.classList.add('hidden');
    });

    // Copy Code Snippet
    document.getElementById('copy-code-btn')?.addEventListener('click', () => {
      const code = document.querySelector('pre code')?.textContent;
      if (code) {
        navigator.clipboard.writeText(code);
        const btn = document.getElementById('copy-code-btn');
        btn.textContent = "✓ Copié !";
        setTimeout(() => { btn.textContent = "📋 Copier l'Extrait"; }, 2000);
      }
    });

    // Wishlist Button Handler
    document.getElementById('add-wishlist-btn')?.addEventListener('click', (e) => {
      const btn = e.currentTarget;
      const item = {
        id: btn.getAttribute('data-id'),
        slug: btn.getAttribute('data-slug'),
        title: btn.getAttribute('data-title'),
        ecosystem: btn.getAttribute('data-ecosystem'),
        price: parseFloat(btn.getAttribute('data-price')) || 49,
        savings: btn.getAttribute('data-savings') || '$200/mo',
        added_at: new Date().toLocaleDateString('fr-FR', { day: '2-digit', month: 'short', year: 'numeric' })
      };

      let wishlist = [];
      try {
        const stored = localStorage.getItem('_ht_buyer_wishlist');
        if (stored) wishlist = JSON.parse(stored);
      } catch(err) {}

      if (!wishlist.some(w => w.slug === item.slug)) {
        wishlist.push(item);
        localStorage.setItem('_ht_buyer_wishlist', JSON.stringify(wishlist));
        btn.innerHTML = "<span>✓</span> Ajouté à votre Wishlist !";
        btn.classList.add('text-emerald-400', 'border-emerald-500/40');
        setTimeout(() => {
          if (confirm("💖 Blueprint sauvegardé dans votre Wishlist !\nVoulez-vous ouvrir votre Espace Client pour le consulter ?")) {
            window.location.href = '/portal/';
          }
        }, 300);
      } else {
        alert("Ce blueprint est déjà dans votre Wishlist !");
      }
    });

    // Buy Button: Validates in Staging & Redirects to User Hub
    document.getElementById('checkout-btn')?.addEventListener('click', () => {
      alert("⚡ [Achat Validé en Staging Privé] : Votre licence commerciale a été enregistrée. Votre workflow .json est immédiatement disponible dans votre Espace Client. Redirection...");
      window.location.href = '/portal/';
    });
  </script>
</Layout>
