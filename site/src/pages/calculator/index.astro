const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "HeliaTech SaaS Waste & TCO Optimizer 2026",
  "applicationCategory": "BusinessApplication",
  "description": "Real-time SaaS cost calculator. Audit current software stack overhead against high-performance modern cloud alternatives.",
  "url": "https://heliatech.online/calculator/"
};
---

<Layout 
  title="SaaS TCO & Waste Calculator 2026 | HeliaTech Lab"
  description="Audit your SaaS stack in 10 seconds. Discover how much your company overpays each month compared to modern cloud architectures."
  canonical="https://heliatech.online/calculator/"
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-8 py-16 print:hidden">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 text-xs font-mono font-bold tracking-widest uppercase mb-6 shadow-glow-emerald">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>OPEN-ACCESS VIRAL TOOL • 2026 TCO BENCHMARK</span>
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-[1.1] mb-6">
        Stop Overpaying : <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-300 to-indigo-400">
          Your Free SaaS Stack Audit
        </span>
      </h1>
      
      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed mb-8">
        95% of startups and agencies waste between <strong class="text-white font-medium">$3,000 and $25,000 annually</strong> on obsolete software margins. Select your current tools below to calculate immediate recoverable capital.
      </p>

      <!-- Sub-Tool Banner Switcher -->
      <div class="inline-flex items-center gap-2 p-1.5 rounded-2xl bg-slate-900/80 border border-slate-800 text-xs font-mono">
        <span class="px-3 py-1 rounded-xl bg-cyan-500 text-slate-950 font-bold">
          SaaS Stack TCO Optimizer
        </span>
        <a 
          href="/calculator/ai-pricing"
          class="px-3 py-1 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors"
        >
          AI Audio & Video Pricing Calculator ↗
        </a>
      </div>
    </div>

    <!-- Main Interactive Cockpit -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 items-start">
      
      <!-- Left Column: Sliders & Tool Checklist (7 Cols) -->
      <div class="lg:col-span-7 space-y-8">
        
        <!-- Parameter Sliders Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/70 border border-slate-800 backdrop-blur-xl shadow-glass-cyber">
          <h2 class="text-xl font-black text-white mb-6 flex items-center gap-2.5">
            <span class="text-cyan-400">⚡</span>
            <span>Your Team's Operational Scale</span>
          </h2>

          <div class="space-y-6">
            <!-- Operations Slider -->
            <div>
              <div class="flex justify-between items-center text-xs font-mono mb-2">
                <span class="text-slate-300 font-semibold">Monthly Tasks / Operations</span>
                <span id="display-ops" class="text-cyan-400 font-bold bg-cyan-500/10 px-2.5 py-1 rounded-lg border border-cyan-500/20">
                  50,000 ops/mo
                </span>
              </div>
              <input 
                type="range" 
                id="slider-ops" 
                min="5000" 
                max="250000" 
                step="5000" 
                value="50000"
                class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
              />
              <div class="flex justify-between text-[11px] font-mono text-slate-500 mt-1">
                <span>5k ops</span>
                <span>50k ops</span>
                <span>150k ops</span>
                <span>250k+ ops</span>
              </div>
            </div>

            <!-- Team Seats Slider -->
            <div>
              <div class="flex justify-between items-center text-xs font-mono mb-2">
                <span class="text-slate-300 font-semibold">Team Users / Active Seats</span>
                <span id="display-seats" class="text-emerald-400 font-bold bg-emerald-500/10 px-2.5 py-1 rounded-lg border border-emerald-500/20">
                  5 seats
                </span>
              </div>
              <input 
                type="range" 
                id="slider-seats" 
                min="1" 
                max="50" 
                step="1" 
                value="5"
                class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-400"
              />
              <div class="flex justify-between text-[11px] font-mono text-slate-500 mt-1">
                <span>1 seat</span>
                <span>10 seats</span>
                <span>25 seats</span>
                <span>50 seats</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Tool Selection Checkbox Matrix -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/70 border border-slate-800 backdrop-blur-xl shadow-glass-cyber">
          <div class="flex items-center justify-between gap-4 mb-6">
            <div>
              <h2 class="text-xl font-black text-white">Which tools are in your current stack?</h2>
              <p class="text-xs text-slate-400 mt-1">Select your current software bricks to compute optimized replacement economics.</p>
            </div>
            <button 
              id="btn-select-all" 
              type="button" 
              class="text-xs font-mono text-cyan-400 hover:text-cyan-300 underline cursor-pointer"
            >
              Deselect All
            </button>
          </div>

          <div class="space-y-3.5">
            {candidateTools.map((tool) => (
              <label 
                class="flex items-center justify-between p-4 rounded-2xl bg-slate-950/80 border border-slate-800/80 hover:border-cyan-500/40 transition-all cursor-pointer group select-none"
              >
                <div class="flex items-center gap-3.5 min-w-0">
                  <input 
                    type="checkbox" 
                    class="tool-checkbox w-5 h-5 rounded border-slate-700 text-cyan-500 focus:ring-0 focus:ring-offset-0 bg-slate-900 cursor-pointer accent-cyan-400"
                    data-tool-id={tool.id}
                    data-legacy-name={tool.legacyName}
                    data-opt-name={tool.optimizedName}
                    data-legacy-base={tool.baseLegacyCost}
                    data-legacy-unit={tool.perUnitLegacy}
                    data-opt-base={tool.baseOptimizedCost}
                    data-opt-unit={tool.perUnitOptimized}
                    checked={tool.defaultChecked}
                  />
                  <div class="flex items-center gap-2">
                    <ToolIcon slug={tool.legacySlug} size="sm" />
                    <span class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors">
                      {tool.legacyName}
                    </span>
                  </div>
                  <span class="text-xs font-mono text-slate-500 hidden sm:inline-block">→</span>
                  <div class="hidden sm:flex items-center gap-2">
                    <ToolIcon slug={tool.optimizedSlug} size="sm" />
                    <span class="text-sm font-bold text-emerald-400">
                      {tool.optimizedName}
                    </span>
                  </div>
                </div>

                <div class="text-right">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                    Up to -75%
                  </span>
                </div>
              </label>
            ))}
          </div>
        </div>

      </div>

      <!-- Right Column: Live Recovery Odometer & Action Center (5 Cols) -->
      <div class="lg:col-span-5 sticky top-24 space-y-6">
        
        <!-- Big Financial Recovery Card -->
        <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 border border-emerald-500/40 shadow-2xl relative overflow-hidden backdrop-blur-2xl">
          <div class="absolute -right-20 -top-20 w-64 h-64 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

          <div class="mb-6">
            <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest font-bold block mb-1">
              ESTIMATED ANNUAL SAVINGS
            </span>
            <div class="flex items-baseline gap-2">
              <span id="odometer-savings" class="text-5xl sm:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-300 to-emerald-200 font-mono tracking-tight">
                $5,840
              </span>
              <span class="text-xs font-mono text-slate-400">/ yr</span>
            </div>
            <p class="text-xs text-slate-400 mt-2">
              That's approximately <strong id="monthly-savings-badge" class="text-white">$486 / mo</strong> injected directly back into your operational runway.
            </p>
          </div>

          <!-- Breakdown Comparison Box -->
          <div class="p-4 rounded-2xl bg-slate-950/90 border border-slate-800 space-y-3 mb-6 text-xs font-mono">
            <div class="flex justify-between items-center text-slate-400">
              <span>Current estimated cost:</span>
              <span id="cost-legacy" class="text-red-400 font-bold">$7,420 / yr</span>
            </div>
            <div class="flex justify-between items-center text-slate-400">
              <span>Cost with modern stack:</span>
              <span id="cost-optimized" class="text-emerald-400 font-bold">$1,580 / yr</span>
            </div>
            <div class="pt-2 border-t border-slate-800 flex justify-between items-center font-bold">
              <span class="text-slate-200">Gross margin preserved:</span>
              <span id="savings-percent" class="text-cyan-400 font-mono font-black text-sm">-78.7%</span>
            </div>
          </div>

          <!-- Primary Actions -->
          <div class="space-y-3">
            <a 
              href="/deals"
              class="w-full py-4 px-6 rounded-2xl font-black font-mono text-xs uppercase tracking-wider text-slate-950 bg-gradient-to-r from-emerald-400 via-cyan-400 to-emerald-300 hover:from-emerald-300 hover:to-cyan-300 shadow-lg shadow-emerald-500/25 transition-all duration-300 hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-2 text-center"
            >
              <span>Claim Official Deals</span>
              <span class="text-sm">↗</span>
            </a>

            <!-- 1-Click Shareable URL Button -->
            <button 
              id="btn-copy-link"
              type="button"
              class="w-full py-3 px-4 rounded-xl font-mono text-xs font-bold text-slate-300 hover:text-white bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>🔗 Copy Direct Audit Link</span>
            </button>

            <!-- Export CFO Executive Memo -->
            <button 
              id="btn-copy-memo"
              type="button"
              class="w-full py-3 px-4 rounded-xl font-mono text-xs font-bold text-cyan-300 hover:text-cyan-200 bg-cyan-950/40 hover:bg-cyan-950/60 border border-cyan-500/30 hover:border-cyan-500/50 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>📄 Copy CFO Executive Memo</span>
            </button>

            <!-- 1-Click Printable Board Memo (PDF/Print) -->
            <button 
              id="btn-print-memo"
              type="button"
              class="w-full py-3 px-4 rounded-xl font-mono text-xs font-bold text-amber-300 hover:text-amber-200 bg-amber-950/40 hover:bg-amber-950/60 border border-amber-500/30 hover:border-amber-500/50 transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg shadow-amber-500/10"
            >
              <span>🖨️ Generate Printable Board Memo (PDF)</span>
            </button>

            <!-- Social Viral Share Trigger -->
            <button 
              id="btn-share-linkedin"
              type="button"
              class="w-full py-2.5 px-4 rounded-xl font-mono text-xs font-bold text-slate-400 hover:text-slate-200 bg-transparent hover:bg-slate-900/60 border border-slate-800/80 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>💼 Share on LinkedIn</span>
            </button>
          </div>

          <!-- Notification Toast -->
          <div id="copy-toast" class="hidden mt-4 p-2.5 rounded-xl bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs font-mono text-center">
            Copied to clipboard! 📋
          </div>

          <div class="mt-6 pt-4 border-t border-slate-800/80 text-center">
            <span class="text-[11px] font-mono text-slate-500">
              Instant forensic audit • Deep link state supported
            </span>
          </div>
        </div>

      </div>

    </div>

    <!-- Recommended Migration Blueprints Section -->
    <div class="mb-20">
      <div class="text-xs font-mono uppercase tracking-widest text-cyan-400 mb-6 font-bold flex items-center gap-2">
        <span>✦ MIGRATION ROADMAP & VERIFIED DEALS</span>
        <span class="h-[1px] flex-grow bg-slate-800"></span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {candidateTools.map((tool) => (
          <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all duration-300 flex flex-col justify-between backdrop-blur-xl group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="px-2.5 py-1 rounded-lg bg-cyan-500/10 text-cyan-300 border border-cyan-500/20 text-[10px] font-mono font-semibold uppercase">
                  {tool.category}
                </span>
                <span class="text-emerald-400 text-xs font-mono font-bold">
                  {tool.dealBadge}
                </span>
              </div>

              <!-- Matchup Side-by-Side -->
              <div class="flex items-center gap-3 mb-4 p-3 rounded-2xl bg-slate-950/80 border border-slate-800/80">
                <div class="flex items-center gap-2 opacity-60">
                  <ToolIcon slug={tool.legacySlug} size="xs" />
                  <span class="text-xs font-bold line-through text-slate-400">{tool.legacyName}</span>
                </div>
                <span class="text-xs font-mono font-bold text-amber-400">➔</span>
                <div class="flex items-center gap-2">
                  <ToolIcon slug={tool.optimizedSlug} size="sm" />
                  <span class="text-sm font-black text-white">{tool.optimizedName}</span>
                </div>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed font-light mb-6">
                {tool.rationale}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
              <a 
                href={`/reviews/${tool.optimizedSlug}`}
                class="text-xs font-mono text-slate-400 hover:text-cyan-300 transition-colors"
              >
                Read Benchmark
              </a>
              <a 
                href={tool.affiliateUrl}
                target="_blank"
                rel="noopener sponsored"
                class="px-4 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-mono font-bold transition-transform active:scale-95 flex items-center gap-1 shadow-glow-cyan"
              >
                <span>Activate Deal</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Lead Capture Section -->
    <div class="mb-16">
      <NewsletterCapture />
    </div>

  </div>

  <!-- Interactive Simulator Engine with Deep-Link State (Zero-Lag Vanilla JS) -->
  <script is:inline>
    (function() {
      const sliderOps = document.getElementById('slider-ops');
      const sliderSeats = document.getElementById('slider-seats');
      const displayOps = document.getElementById('display-ops');
      const displaySeats = document.getElementById('display-seats');
      const checkboxes = document.querySelectorAll('.tool-checkbox');
      const btnSelectAll = document.getElementById('btn-select-all');

      const odoSavings = document.getElementById('odometer-savings');
      const monthlySavingsBadge = document.getElementById('monthly-savings-badge');
      const costLegacyEl = document.getElementById('cost-legacy');
      const costOptimizedEl = document.getElementById('cost-optimized');
      const savingsPercentEl = document.getElementById('savings-percent');
      
      const btnShareLi = document.getElementById('btn-share-linkedin');
      const btnCopyLink = document.getElementById('btn-copy-link');
      const btnCopyMemo = document.getElementById('btn-copy-memo');
      const copyToast = document.getElementById('copy-toast');

      function showToast(msg) {
        if (!copyToast) return;
        copyToast.textContent = msg;
        copyToast.classList.remove('hidden');
        setTimeout(() => copyToast.classList.add('hidden'), 3500);
      }

      // 1. Parse URL Parameters on initial load
      function parseUrlState() {
        const params = new URLSearchParams(window.location.search);
        if (params.has('ops') && sliderOps) {
          sliderOps.value = params.get('ops');
        }
        if (params.has('seats') && sliderSeats) {
          sliderSeats.value = params.get('seats');
        }
        if (params.has('stack')) {
          const activeIds = params.get('stack').split(',');
          checkboxes.forEach(cb => {
            cb.checked = activeIds.includes(cb.dataset.toolId);
          });
        }
      }

      // 2. Synchronize URL State
      function syncUrlState() {
        if (!sliderOps || !sliderSeats) return;
        const activeIds = [];
        checkboxes.forEach(cb => {
          if (cb.checked) activeIds.push(cb.dataset.toolId);
        });

        const params = new URLSearchParams();
        params.set('ops', sliderOps.value);
        params.set('seats', sliderSeats.value);
        params.set('stack', activeIds.join(','));

        const newUrl = `${window.location.pathname}?${params.toString()}`;
        window.history.replaceState(null, '', newUrl);
      }

      function calculateTCO() {
        if (!sliderOps || !sliderSeats) return;

        const ops = parseInt(sliderOps.value, 10);
        const seats = parseInt(sliderSeats.value, 10);

        if (displayOps) displayOps.textContent = ops.toLocaleString('en-US') + ' ops/mo';
        if (displaySeats) displaySeats.textContent = seats + (seats > 1 ? ' seats' : ' seat');

        let totalLegacyMonthly = 0;
        let totalOptimizedMonthly = 0;

        checkboxes.forEach((cb) => {
          if (cb.checked) {
            const legacyBase = parseFloat(cb.dataset.legacyBase) || 0;
            const legacyUnit = parseFloat(cb.dataset.legacyUnit) || 0;
            const optBase = parseFloat(cb.dataset.optBase) || 0;
            const optUnit = parseFloat(cb.dataset.optUnit) || 0;

            const legCost = legacyBase + (ops * legacyUnit * 0.1) + (seats * 15);
            const optCost = optBase + (ops * optUnit * 0.1) + (seats * 4);

            totalLegacyMonthly += legCost;
            totalOptimizedMonthly += optCost;
          }
        });

        if (totalLegacyMonthly === 0) {
          totalLegacyMonthly = 100;
          totalOptimizedMonthly = 25;
        }

        const totalLegacyAnnual = Math.round(totalLegacyMonthly * 12);
        const totalOptimizedAnnual = Math.round(totalOptimizedMonthly * 12);
        const annualSavings = Math.max(0, totalLegacyAnnual - totalOptimizedAnnual);
        const monthlySavings = Math.round(annualSavings / 12);
        const percent = totalLegacyAnnual > 0 ? Math.round((annualSavings / totalLegacyAnnual) * 100) : 0;

        if (odoSavings) odoSavings.textContent = '$' + annualSavings.toLocaleString('en-US');
        if (monthlySavingsBadge) monthlySavingsBadge.textContent = '$' + monthlySavings.toLocaleString('en-US') + ' / mo';
        if (costLegacyEl) costLegacyEl.textContent = '$' + totalLegacyAnnual.toLocaleString('en-US') + ' / yr';
        if (costOptimizedEl) costOptimizedEl.textContent = '$' + totalOptimizedAnnual.toLocaleString('en-US') + ' / yr';
        if (savingsPercentEl) savingsPercentEl.textContent = '-' + percent + '%';

        syncUrlState();
      }

      // Bind slider and checkbox events
      if (sliderOps) sliderOps.addEventListener('input', calculateTCO);
      if (sliderSeats) sliderSeats.addEventListener('input', calculateTCO);
      checkboxes.forEach(cb => cb.addEventListener('change', calculateTCO));

      if (btnSelectAll) {
        let allState = true;
        btnSelectAll.addEventListener('click', () => {
          allState = !allState;
          checkboxes.forEach(cb => cb.checked = allState);
          btnSelectAll.textContent = allState ? 'Deselect All' : 'Select All';
          calculateTCO();
        });
      }

      // Copy Shareable Direct Link Button
      if (btnCopyLink) {
        btnCopyLink.addEventListener('click', () => {
          navigator.clipboard.writeText(window.location.href).then(() => {
            showToast('Direct audit link copied to clipboard! 📋');
          }).catch(() => {
            showToast('Link ready: ' + window.location.href);
          });
        });
      }

      // Copy CFO Executive Memo
      if (btnCopyMemo) {
        btnCopyMemo.addEventListener('click', () => {
          const ops = sliderOps ? parseInt(sliderOps.value, 10).toLocaleString('en-US') : '50,000';
          const seats = sliderSeats ? sliderSeats.value : '5';
          const legacy = costLegacyEl ? costLegacyEl.textContent : '$7,420 / yr';
          const optimized = costOptimizedEl ? costOptimizedEl.textContent : '$1,580 / yr';
          const savings = odoSavings ? odoSavings.textContent : '$5,840';
          const percent = savingsPercentEl ? savingsPercentEl.textContent : '-78%';

          const checkedList = [];
          checkboxes.forEach(cb => {
            if (cb.checked) {
              checkedList.push(`• ${cb.dataset.legacyName} ➔ Replace with ${cb.dataset.optName}`);
            }
          });

          const memo = 
`🏛️ HELIATECH FORENSIC TCO AUDIT MEMORANDUM
To: Executive Team / CFO
Scale: ${ops} ops/month | ${seats} active seats
--------------------------------------------------
Current Stack Projected Burn : ${legacy}
Modernized Architecture Cost : ${optimized}
Net Recoverable Annual Runway: ${savings} / year (${percent})

Actionable Stack Replacements:
${checkedList.join('\n')}

Audit Breakdown & Verification:
${window.location.href}
--------------------------------------------------
Generated via HeliaTech Autonomous Intelligence Lab`;

          navigator.clipboard.writeText(memo).then(() => {
            showToast('CFO Executive Memo copied to clipboard! 📄');
          });
        });
      }

      // LinkedIn Share
      if (btnShareLi) {
        btnShareLi.addEventListener('click', () => {
          const savings = odoSavings ? odoSavings.textContent : '$5,840';
          const text = encodeURIComponent(
            `I just audited our SaaS stack overhead on HeliaTech Lab.\n\n` +
            `Result: ${savings}/yr in recoverable runway by optimizing our software architecture.\n\n` +
            `Run your team's free audit here: ${window.location.href}`
          );
          const shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(window.location.href)}&summary=${text}`;
          window.open(shareUrl, '_blank', 'width=600,height=500');
        });
      }

      // 1-Click Printable Board Memo Trigger
      const btnPrintMemo = document.getElementById('btn-print-memo');
      if (btnPrintMemo) {
        btnPrintMemo.addEventListener('click', () => {
          // Sync data to printable memo
          const printAuditId = document.getElementById('print-audit-id');
          const printDate = document.getElementById('print-date');
          const printOpsScale = document.getElementById('print-ops-scale');
          const printSeatsScale = document.getElementById('print-seats-scale');
          const printSavingsPercent = document.getElementById('print-savings-percent');
          const printCostLegacy = document.getElementById('print-cost-legacy');
          const printCostOptimized = document.getElementById('print-cost-optimized');
          const printOdoSavings = document.getElementById('print-odometer-savings');
          const printMonthlySavings = document.getElementById('print-monthly-savings');
          const printTableBody = document.getElementById('print-table-body');
          const printVerificationLink = document.getElementById('print-verification-link');

          const now = new Date();
          if (printAuditId) printAuditId.textContent = 'HT-' + now.getFullYear() + '-' + Math.random().toString(36).substring(2, 8).toUpperCase();
          if (printDate) printDate.textContent = now.toLocaleDateString('en-US', { month: 'long', year: 'numeric' }).toUpperCase();
          if (printOpsScale && sliderOps) printOpsScale.textContent = parseInt(sliderOps.value, 10).toLocaleString('en-US') + ' operations/mo';
          if (printSeatsScale && sliderSeats) printSeatsScale.textContent = sliderSeats.value + ' active team seats';
          if (printSavingsPercent && savingsPercentEl) printSavingsPercent.textContent = savingsPercentEl.textContent;
          if (printCostLegacy && costLegacyEl) printCostLegacy.textContent = costLegacyEl.textContent;
          if (printCostOptimized && costOptimizedEl) printCostOptimized.textContent = costOptimizedEl.textContent;
          if (printOdoSavings && odoSavings) printOdoSavings.textContent = odoSavings.textContent + ' / yr';
          if (printMonthlySavings && monthlySavingsBadge) printMonthlySavings.textContent = monthlySavingsBadge.textContent;
          if (printVerificationLink) printVerificationLink.textContent = window.location.href;

          // Populate table rows
          if (printTableBody) {
            printTableBody.innerHTML = '';
            checkboxes.forEach((cb) => {
              if (cb.checked) {
                const legacyName = cb.dataset.legacyName;
                const optName = cb.dataset.optName;
                const legacyBase = parseFloat(cb.dataset.legacyBase) || 0;
                const optBase = parseFloat(cb.dataset.optBase) || 0;
                const ops = parseInt(sliderOps?.value || '50000', 10);
                const seats = parseInt(sliderSeats?.value || '5', 10);
                const legCost = Math.round((legacyBase + (ops * (parseFloat(cb.dataset.legacyUnit) || 0) * 0.1) + (seats * 15)) * 12);
                const optCost = Math.round((optBase + (ops * (parseFloat(cb.dataset.optUnit) || 0) * 0.1) + (seats * 4)) * 12);
                const delta = Math.max(0, legCost - optCost);

                const tr = document.createElement('tr');
                tr.className = 'border-b border-slate-200';
                tr.innerHTML = `
                  <td class="p-2 border-r border-slate-200 font-mono font-medium text-slate-800">${cb.closest('label')?.querySelector('.text-sm')?.textContent || legacyName}</td>
                  <td class="p-2 border-r border-slate-200 font-bold text-rose-700">${legacyName} ($${legCost.toLocaleString('en-US')}/yr)</td>
                  <td class="p-2 border-r border-slate-200 font-bold text-emerald-700">${optName} ($${optCost.toLocaleString('en-US')}/yr)</td>
                  <td class="p-2 border-r border-slate-200 text-right font-mono font-black text-emerald-800">-$${delta.toLocaleString('en-US')}/yr</td>
                  <td class="p-2 text-slate-600 text-[11px]">Replaces punitive tier markups with modern open protocols.</td>
                `;
                printTableBody.appendChild(tr);
              }
            });
          }

          // Trigger browser print dialog
          window.print();
        });
      }

      // Parse and initial run
      parseUrlState();
      calculateTCO();
    })();
  </script>

