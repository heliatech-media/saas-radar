---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import NewsletterCapture from '../../components/NewsletterCapture.astro';

const candidateTools = [
  {
    id: "automation",
    legacyName: "Zapier",
    legacySlug: "zapier",
    optimizedName: "Make",
    optimizedSlug: "make",
    category: "Workflow Automation",
    baseLegacyCost: 299,
    baseOptimizedCost: 29,
    perUnitLegacy: 0.0058, // per op
    perUnitOptimized: 0.0009,
    defaultChecked: true,
    affiliateUrl: "/go/make",
    dealBadge: "1 Mois Pro Offert (10 000 ops)",
    rationale: "Bypasse les surfacturations linéaires de Zapier grâce au multi-branching visuel et au parsing JSON natif."
  },
  {
    id: "sales_intel",
    legacyName: "ZoomInfo",
    legacySlug: "zoominfo",
    optimizedName: "Apollo.io",
    optimizedSlug: "apollo-io",
    category: "B2B Sales Intelligence",
    baseLegacyCost: 750,
    baseOptimizedCost: 79,
    perUnitLegacy: 0.85, // per lead export
    perUnitOptimized: 0.12,
    defaultChecked: true,
    affiliateUrl: "/go/apollo-io",
    dealBadge: "Accès Gratuit + 60 Crédits Mobiles",
    rationale: "Base de données de 275M+ contacts vérifiés sans engagement annuel forcé de 15 000 $."
  },
  {
    id: "eor_payroll",
    legacyName: "Deel",
    legacySlug: "remote", // fallback slug
    optimizedName: "Papaya Global",
    optimizedSlug: "papaya-global",
    category: "Global Payroll & EOR",
    baseLegacyCost: 599,
    baseOptimizedCost: 350,
    perUnitLegacy: 49, // per contractor
    perUnitOptimized: 20,
    defaultChecked: false,
    affiliateUrl: "/go/papaya-global",
    dealBadge: "Taux de Change Interbancaire Direct",
    rationale: "Infrastructure bancaire de niveau 1 éliminant les marges de change cachées sur les virements internationaux."
  },
  {
    id: "voice_ai",
    legacyName: "Murf.ai",
    legacySlug: "murf-ai",
    optimizedName: "ElevenLabs v4",
    optimizedSlug: "elevenlabs",
    category: "AI Voice & Audio Synthesis",
    baseLegacyCost: 199,
    baseOptimizedCost: 22,
    perUnitLegacy: 0.003, // per char
    perUnitOptimized: 0.001,
    defaultChecked: true,
    affiliateUrl: "/go/elevenlabs",
    dealBadge: "Offre Starter 1$ + 30 000 Caractères",
    rationale: "Latence sub-150ms et fidélité de clonage vocal indétectable pour vos serveurs vocaux et vidéos."
  },
  {
    id: "database_cloud",
    legacyName: "AWS RDS / Heroku",
    legacySlug: "retool",
    optimizedName: "Supabase",
    optimizedSlug: "supabase",
    category: "Postgres Cloud Infrastructure",
    baseLegacyCost: 200,
    baseOptimizedCost: 25,
    perUnitLegacy: 0.05,
    perUnitOptimized: 0.01,
    defaultChecked: false,
    affiliateUrl: "/go/supabase",
    dealBadge: "Tier Gratuit Illimité Projets",
    rationale: "PostgreSQL managé avec Row-Level Security, Auth native et WebSockets temps réel sans lock-in cloud."
  },
  {
    id: "newsletter",
    legacyName: "Mailchimp",
    legacySlug: "brevo",
    optimizedName: "Beehiiv",
    optimizedSlug: "beehiiv",
    category: "Newsletter & Audience Media",
    baseLegacyCost: 180,
    baseOptimizedCost: 49,
    perUnitLegacy: 0.015,
    perUnitOptimized: 0.002,
    defaultChecked: false,
    affiliateUrl: "/go/beehiiv",
    dealBadge: "30 Jours d'Essai Gratuit Scale",
    rationale: "Réseau de recommandation natif (Boosts) et monétisation d'audience sans pénalité sur les listes croissantes."
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "HeliaTech SaaS Waste & TCO Optimizer 2026",
  "applicationCategory": "BusinessApplication",
  "description": "Calculateur d'économies SaaS en direct. Comparez les coûts de votre stack logicielle actuelle face aux alternatives modernes haute performance.",
  "url": "https://heliatech.online/calculator"
};
---

<Layout 
  title="Calculateur de TCO & Économies SaaS 2026 | HeliaTech Lab"
  description="Auditez vos abonnements logiciels en 10 secondes. Découvrez combien votre entreprise gaspille chaque mois face aux architectures cloud modernes."
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto px-6 sm:px-8 py-16">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-300 border border-emerald-500/30 text-xs font-mono font-bold tracking-widest uppercase mb-6 shadow-glow-emerald">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>OUTIL VIRAL OPEN-ACCESS • SIMULATION TCO 2026</span>
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-[1.1] mb-6">
        Arrêtez de Surpayer : <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-300 to-indigo-400">
          Votre Audit de Stack SaaS Gratuit
        </span>
      </h1>
      
      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        95% des startups et agences gaspillent entre <strong class="text-white font-medium">3 000 $ et 25 000 $ par an</strong> en marges logicielles obsolètes. Sélectionnez vos outils ci-dessous et visualisez vos économies réelles immédiates.
      </p>
    </div>

    <!-- Main Interactive Cockpit -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 items-start">
      
      <!-- Left Column: Sliders & Tool Checklist (7 Cols) -->
      <div class="lg:col-span-7 space-y-8">
        
        <!-- Parameter Sliders Card -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/70 border border-slate-800 backdrop-blur-xl shadow-glass-cyber">
          <h2 class="text-xl font-black text-white mb-6 flex items-center gap-2.5">
            <span class="text-cyan-400">⚡</span>
            <span>Échelle Opérationnelle de votre Équipe</span>
          </h2>

          <div class="space-y-6">
            <!-- Operations Slider -->
            <div>
              <div class="flex justify-between items-center text-xs font-mono mb-2">
                <span class="text-slate-300 font-semibold">Tâches / Événements Mensuels</span>
                <span id="display-ops" class="text-cyan-400 font-bold bg-cyan-500/10 px-2.5 py-1 rounded-lg border border-cyan-500/20">
                  50 000 ops/mois
                </span>
              </div>
              <input 
                type="range" 
                id="slider-ops" 
                min="5000" 
                max="250000" 
                step="5000" 
                value="50000"
                class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400"
              />
              <div class="flex justify-between text-[11px] font-mono text-slate-500 mt-1">
                <span>5k ops</span>
                <span>50k ops</span>
                <span>150k ops</span>
                <span>250k+ ops</span>
              </div>
            </div>

            <!-- Team Seats Slider -->
            <div>
              <div class="flex justify-between items-center text-xs font-mono mb-2">
                <span class="text-slate-300 font-semibold">Utilisateurs / Sièges Équipe</span>
                <span id="display-seats" class="text-emerald-400 font-bold bg-emerald-500/10 px-2.5 py-1 rounded-lg border border-emerald-500/20">
                  5 sièges
                </span>
              </div>
              <input 
                type="range" 
                id="slider-seats" 
                min="1" 
                max="50" 
                step="1" 
                value="5"
                class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-emerald-400"
              />
              <div class="flex justify-between text-[11px] font-mono text-slate-500 mt-1">
                <span>1 siège</span>
                <span>10 sièges</span>
                <span>25 sièges</span>
                <span>50 sièges</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Tool Selection Checkbox Matrix -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/70 border border-slate-800 backdrop-blur-xl shadow-glass-cyber">
          <div class="flex items-center justify-between gap-4 mb-6">
            <div>
              <h2 class="text-xl font-black text-white">Quels logiciels utilisez-vous ?</h2>
              <p class="text-xs text-slate-400 mt-1">Cochez les briques actuelles pour calculer le TCO alternatif optimisé.</p>
            </div>
            <button 
              id="btn-select-all" 
              type="button" 
              class="text-xs font-mono text-cyan-400 hover:text-cyan-300 underline cursor-pointer"
            >
              Tout cocher
            </button>
          </div>

          <div class="space-y-3.5">
            {candidateTools.map((tool) => (
              <label 
                class="flex items-center justify-between p-4 rounded-2xl bg-slate-950/80 border border-slate-800/80 hover:border-cyan-500/40 transition-all cursor-pointer group select-none"
              >
                <div class="flex items-center gap-3.5 min-w-0">
                  <input 
                    type="checkbox" 
                    class="tool-checkbox w-5 h-5 rounded border-slate-700 text-cyan-500 focus:ring-0 focus:ring-offset-0 bg-slate-900 cursor-pointer accent-cyan-400"
                    data-tool-id={tool.id}
                    data-legacy-base={tool.baseLegacyCost}
                    data-legacy-unit={tool.perUnitLegacy}
                    data-opt-base={tool.baseOptimizedCost}
                    data-opt-unit={tool.perUnitOptimized}
                    checked={tool.defaultChecked}
                  />
                  <div class="flex items-center gap-2">
                    <ToolIcon slug={tool.legacySlug} size="sm" />
                    <span class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors">
                      {tool.legacyName}
                    </span>
                  </div>
                  <span class="text-xs font-mono text-slate-500 hidden sm:inline-block">→</span>
                  <div class="hidden sm:flex items-center gap-2">
                    <ToolIcon slug={tool.optimizedSlug} size="sm" />
                    <span class="text-sm font-bold text-emerald-400">
                      {tool.optimizedName}
                    </span>
                  </div>
                </div>

                <div class="text-right">
                  <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                    Jusqu'à -75%
                  </span>
                </div>
              </label>
            ))}
          </div>
        </div>

      </div>

      <!-- Right Column: Live Recovery Odometer & Action Center (5 Cols) -->
      <div class="lg:col-span-5 sticky top-24 space-y-6">
        
        <!-- Big Financial Recovery Card -->
        <div class="p-8 sm:p-10 rounded-3xl bg-gradient-to-br from-slate-900 via-slate-950 to-slate-900 border border-emerald-500/40 shadow-2xl relative overflow-hidden backdrop-blur-2xl">
          <div class="absolute -right-20 -top-20 w-64 h-64 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>

          <div class="mb-6">
            <span class="text-xs font-mono text-emerald-400 uppercase tracking-widest font-bold block mb-1">
              ÉCONOMIE ANNUELLE ESTIMÉE
            </span>
            <div class="flex items-baseline gap-2">
              <span id="odometer-savings" class="text-5xl sm:text-6xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-300 to-emerald-200 font-mono tracking-tight">
                $5,840
              </span>
              <span class="text-xs font-mono text-slate-400">/ an</span>
            </div>
            <p class="text-xs text-slate-400 mt-2">
              Soit environ <strong id="monthly-savings-badge" class="text-white">$486 / mois</strong> réinjectés dans votre marge opérationnelle.
            </p>
          </div>

          <!-- Breakdown Comparison Box -->
          <div class="p-4 rounded-2xl bg-slate-950/90 border border-slate-800 space-y-3 mb-6 text-xs font-mono">
            <div class="flex justify-between items-center text-slate-400">
              <span>Coût actuel estimé :</span>
              <span id="cost-legacy" class="text-red-400 font-bold">$7,420 / an</span>
            </div>
            <div class="flex justify-between items-center text-slate-400">
              <span>Coût avec stack moderne :</span>
              <span id="cost-optimized" class="text-emerald-400 font-bold">$1,580 / an</span>
            </div>
            <div class="pt-2 border-t border-slate-800 flex justify-between items-center font-bold">
              <span class="text-slate-200">Marge brute préservée :</span>
              <span id="savings-percent" class="text-cyan-400 font-mono font-black text-sm">-78.7%</span>
            </div>
          </div>

          <!-- Primary Actions -->
          <div class="space-y-3">
            <a 
              href="/deals"
              class="w-full py-4 px-6 rounded-2xl font-black font-mono text-xs uppercase tracking-wider text-slate-950 bg-gradient-to-r from-emerald-400 via-cyan-400 to-emerald-300 hover:from-emerald-300 hover:to-cyan-300 shadow-lg shadow-emerald-500/25 transition-all duration-300 hover:scale-[1.02] active:scale-95 flex items-center justify-center gap-2 text-center"
            >
              <span>Réclamer les Deals Officiels</span>
              <span class="text-sm">↗</span>
            </a>

            <!-- Social Viral Share Trigger -->
            <button 
              id="btn-share-linkedin"
              type="button"
              class="w-full py-3 px-4 rounded-xl font-mono text-xs font-bold text-slate-300 hover:text-white bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>💼 Partager mon audit sur LinkedIn</span>
            </button>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-800/80 text-center">
            <span class="text-[11px] font-mono text-slate-500">
              Audit instantané • Aucun moyen de paiement requis
            </span>
          </div>
        </div>

      </div>

    </div>

    <!-- Recommended Migration Blueprints Section -->
    <div class="mb-20">
      <div class="text-xs font-mono uppercase tracking-widest text-cyan-400 mb-6 font-bold flex items-center gap-2">
        <span>✦ FEUILLE DE ROUTE DE MIGRATION & DEALS OFFICIELS</span>
        <span class="h-[1px] flex-grow bg-slate-800"></span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {candidateTools.map((tool) => (
          <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all duration-300 flex flex-col justify-between backdrop-blur-xl group">
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="px-2.5 py-1 rounded-lg bg-cyan-500/10 text-cyan-300 border border-cyan-500/20 text-[10px] font-mono font-semibold uppercase">
                  {tool.category}
                </span>
                <span class="text-emerald-400 text-xs font-mono font-bold">
                  {tool.dealBadge}
                </span>
              </div>

              <!-- Matchup Side-by-Side -->
              <div class="flex items-center gap-3 mb-4 p-3 rounded-2xl bg-slate-950/80 border border-slate-800/80">
                <div class="flex items-center gap-2 opacity-60">
                  <ToolIcon slug={tool.legacySlug} size="xs" />
                  <span class="text-xs font-bold line-through text-slate-400">{tool.legacyName}</span>
                </div>
                <span class="text-xs font-mono font-bold text-amber-400">➔</span>
                <div class="flex items-center gap-2">
                  <ToolIcon slug={tool.optimizedSlug} size="sm" />
                  <span class="text-sm font-black text-white">{tool.optimizedName}</span>
                </div>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed font-light mb-6">
                {tool.rationale}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between gap-3">
              <a 
                href={`/reviews/${tool.optimizedSlug}`}
                class="text-xs font-mono text-slate-400 hover:text-cyan-300 transition-colors"
              >
                Lire le Banc d'Essai
              </a>
              <a 
                href={tool.affiliateUrl}
                target="_blank"
                rel="noopener sponsored"
                class="px-4 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-mono font-bold transition-transform active:scale-95 flex items-center gap-1 shadow-glow-cyan"
              >
                <span>Activer</span>
                <span>↗</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Lead Capture Section -->
    <div class="mb-16">
      <NewsletterCapture />
    </div>

  </div>

  <!-- Interactive Simulator Engine (Vanilla JS Zero-Lag) -->
  <script is:inline>
    (function() {
      const sliderOps = document.getElementById('slider-ops');
      const sliderSeats = document.getElementById('slider-seats');
      const displayOps = document.getElementById('display-ops');
      const displaySeats = document.getElementById('display-seats');
      const checkboxes = document.querySelectorAll('.tool-checkbox');
      const btnSelectAll = document.getElementById('btn-select-all');

      const odoSavings = document.getElementById('odometer-savings');
      const monthlySavingsBadge = document.getElementById('monthly-savings-badge');
      const costLegacyEl = document.getElementById('cost-legacy');
      const costOptimizedEl = document.getElementById('cost-optimized');
      const savingsPercentEl = document.getElementById('savings-percent');
      const btnShareLi = document.getElementById('btn-share-linkedin');

      function calculateTCO() {
        if (!sliderOps || !sliderSeats) return;

        const ops = parseInt(sliderOps.value, 10);
        const seats = parseInt(sliderSeats.value, 10);

        if (displayOps) displayOps.textContent = ops.toLocaleString('fr-FR') + ' ops/mois';
        if (displaySeats) displaySeats.textContent = seats + (seats > 1 ? ' sièges' : ' siège');

        let totalLegacyMonthly = 0;
        let totalOptimizedMonthly = 0;

        checkboxes.forEach((cb) => {
          if (cb.checked) {
            const legacyBase = parseFloat(cb.dataset.legacyBase) || 0;
            const legacyUnit = parseFloat(cb.dataset.legacyUnit) || 0;
            const optBase = parseFloat(cb.dataset.optBase) || 0;
            const optUnit = parseFloat(cb.dataset.optUnit) || 0;

            // Monthly calculation factoring volume and seats
            const legCost = legacyBase + (ops * legacyUnit * 0.1) + (seats * 15);
            const optCost = optBase + (ops * optUnit * 0.1) + (seats * 4);

            totalLegacyMonthly += legCost;
            totalOptimizedMonthly += optCost;
          }
        });

        // Minimum baseline if nothing checked
        if (totalLegacyMonthly === 0) {
          totalLegacyMonthly = 100;
          totalOptimizedMonthly = 25;
        }

        const totalLegacyAnnual = Math.round(totalLegacyMonthly * 12);
        const totalOptimizedAnnual = Math.round(totalOptimizedMonthly * 12);
        const annualSavings = Math.max(0, totalLegacyAnnual - totalOptimizedAnnual);
        const monthlySavings = Math.round(annualSavings / 12);
        const percent = totalLegacyAnnual > 0 ? Math.round((annualSavings / totalLegacyAnnual) * 100) : 0;

        if (odoSavings) odoSavings.textContent = '$' + annualSavings.toLocaleString('en-US');
        if (monthlySavingsBadge) monthlySavingsBadge.textContent = '$' + monthlySavings.toLocaleString('en-US') + ' / mois';
        if (costLegacyEl) costLegacyEl.textContent = '$' + totalLegacyAnnual.toLocaleString('en-US') + ' / an';
        if (costOptimizedEl) costOptimizedEl.textContent = '$' + totalOptimizedAnnual.toLocaleString('en-US') + ' / an';
        if (savingsPercentEl) savingsPercentEl.textContent = '-' + percent + '%';
      }

      // Bind events
      if (sliderOps) sliderOps.addEventListener('input', calculateTCO);
      if (sliderSeats) sliderSeats.addEventListener('input', calculateTCO);
      checkboxes.forEach(cb => cb.addEventListener('change', calculateTCO));

      if (btnSelectAll) {
        let allState = true;
        btnSelectAll.addEventListener('click', () => {
          allState = !allState;
          checkboxes.forEach(cb => cb.checked = allState);
          btnSelectAll.textContent = allState ? 'Tout décocher' : 'Tout cocher';
          calculateTCO();
        });
      }

      // LinkedIn Share Generator
      if (btnShareLi) {
        btnShareLi.addEventListener('click', () => {
          const savings = odoSavings ? odoSavings.textContent : '$5,840';
          const text = encodeURIComponent(
            `J'ai simulé les dépenses de ma stack SaaS sur HeliaTech Lab.\n\n` +
            `Résultat : ${savings}/an de capital récupérable en optimisant nos architectures logicielles (Make, Apollo, ElevenLabs, Supabase).\n\n` +
            `Faites le test vous-même gratuitement ici : https://heliatech.online/calculator`
          );
          const shareUrl = `https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Fheliatech.online%2Fcalculator&summary=${text}`;
          window.open(shareUrl, '_blank', 'width=600,height=500');
        });
      }

      // Initial run
      calculateTCO();
    })();
  </script>
</Layout>
