---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "HeliaTech 2026 Modern SaaS & AI Stack Blueprint",
  "operatingSystem": "All",
  "applicationCategory": "BusinessApplication",
  "description": "Interactive 2026 tech stack generator and TCO benchmark dossier for modern tech founders, CTOs, and growth teams.",
  "url": "https://heliatech.online/blueprint"
};
---

<Layout 
  title="The 2026 Tech Stack Blueprint | Modern AI & Zero-Waste Architecture"
  description="Discover the definitive 2026 software stack architecture. Eliminate up to 65% of legacy SaaS bloat, automate your workflows, and scale high-leverage operations."
  jsonLd={jsonLd}
>
  <!-- Ambient Atmospheric Glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-cyan-600/10 via-fuchsia-600/10 to-transparent blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute top-3/4 left-1/3 w-[500px] h-[300px] bg-gradient-to-br from-indigo-600/10 via-emerald-600/10 to-transparent blur-[150px] pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-6 sm:px-8 py-12 sm:py-20">

    <!-- Hero Section -->
    <div class="text-center max-w-4xl mx-auto mb-16 sm:mb-24">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 text-xs font-mono font-bold tracking-widest uppercase mb-6 shadow-glow-cyan">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>DOSSIER D'ARCHITECTURE 2026 • ACCRÉDITATION EXÉCUTIVE</span>
      </div>

      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.08] mb-8">
        Réduisez Vos Coûts SaaS de 65%. <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-fuchsia-400">
          La Stack Zéro-Gaspillage 2026.
        </span>
      </h1>

      <p class="text-base sm:text-xl text-slate-300 font-light leading-relaxed max-w-3xl mx-auto mb-10">
        Les suites logicielles legacy vous surfacturent pour des fonctionnalités obsolètes. L'Observatoire HeliaTech a benchmarqué et sélectionné les architectures logicielles les plus performantes du marché mondial pour concevoir votre stack sur-mesure.
      </p>

      <!-- Key Proof Metrics -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto mb-10 text-left">
        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-white font-mono">-$14.8k</div>
          <div class="text-xs text-slate-400 mt-1">Économie moyenne/an</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono">10x</div>
          <div class="text-xs text-slate-400 mt-1">Vitesse d'exécution</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-fuchsia-400 font-mono">35+</div>
          <div class="text-xs text-slate-400 mt-1">Moteurs audités</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono">100%</div>
          <div class="text-xs text-slate-400 mt-1">Audit indépendant</div>
        </div>
      </div>

      <!-- Quick Action CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="#stack-architect"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-cyan-500 to-fuchsia-500 hover:from-cyan-400 hover:to-fuchsia-400 text-slate-950 font-black text-sm tracking-wide shadow-xl shadow-cyan-500/20 hover:shadow-cyan-500/35 transition-all duration-300 hover:scale-[1.03] flex items-center justify-center gap-2"
        >
          <span>Générer Ma Stack 2026 ↓</span>
        </a>
        <a 
          href="#newsletter-lead"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 hover:text-white font-mono text-sm border border-slate-700 transition-all flex items-center justify-center gap-2"
        >
          <span>Recevoir le Blueprint Complet ➔</span>
        </a>
      </div>
    </div>

    <!-- Interactive Stack Architect Section -->
    <section id="stack-architect" class="scroll-mt-24 mb-24">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2">GÉNÉRATEUR D'ARCHITECTURE</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          Configurez Votre Stack Idéale en 30s
        </h2>
        <p class="text-slate-400 text-sm mt-3">
          Sélectionnez votre modèle opérationnel. Notre moteur calcule instantanément les outils accrédités et votre gain de trésorerie net.
        </p>
      </div>

      <!-- Persona Selector Tabs -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto mb-10">
        <button 
          type="button" 
          data-persona="solo" 
          class="persona-btn active p-4 rounded-2xl border text-left transition-all duration-200 bg-cyan-500/10 border-cyan-500 text-white shadow-glow-cyan"
        >
          <div class="text-xl mb-1.5">⚡</div>
          <div class="text-xs font-mono font-black uppercase text-cyan-300">Solopreneur / IA</div>
          <div class="text-[11px] text-slate-400 mt-1 leading-snug">Opérateur 1 personne à effet de levier maximal</div>
        </button>

        <button 
          type="button" 
          data-persona="agency" 
          class="persona-btn p-4 rounded-2xl border text-left transition-all duration-200 bg-slate-900/60 border-slate-800 text-slate-400 hover:text-white hover:border-slate-700"
        >
          <div class="text-xl mb-1.5">💼</div>
          <div class="text-xs font-mono font-black uppercase text-slate-300">Agence B2B & Conseil</div>
          <div class="text-[11px] text-slate-400 mt-1 leading-snug">Prospection agressive & livraison automatisée</div>
        </button>

        <button 
          type="button" 
          data-persona="startup" 
          class="persona-btn p-4 rounded-2xl border text-left transition-all duration-200 bg-slate-900/60 border-slate-800 text-slate-400 hover:text-white hover:border-slate-700"
        >
          <div class="text-xl mb-1.5">🚀</div>
          <div class="text-xs font-mono font-black uppercase text-slate-300">SaaS & Startups</div>
          <div class="text-[11px] text-slate-400 mt-1 leading-snug">Vitesse de shipping & cloud réactif moderne</div>
        </button>

        <button 
          type="button" 
          data-persona="media" 
          class="persona-btn p-4 rounded-2xl border text-left transition-all duration-200 bg-slate-900/60 border-slate-800 text-slate-400 hover:text-white hover:border-slate-700"
        >
          <div class="text-xl mb-1.5">🎙️</div>
          <div class="text-xs font-mono font-black uppercase text-slate-300">Media, Pod & Vidéo</div>
          <div class="text-[11px] text-slate-400 mt-1 leading-snug">Multiplication multicanale & voix de synthèse</div>
        </button>
      </div>

      <!-- Live Generated Architecture Card Container -->
      <div class="p-6 sm:p-10 rounded-3xl bg-slate-900/70 border border-slate-800 backdrop-blur-2xl shadow-2xl relative overflow-hidden">
        
        <!-- Header of the Stack Result -->
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-8 border-b border-slate-800 mb-8">
          <div>
            <div class="flex items-center gap-3">
              <h3 id="stack-title" class="text-2xl font-black text-white">Stack Solopreneur AI-First 2026</h3>
              <span id="stack-badge" class="px-3 py-1 rounded-full text-[10px] font-mono font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 uppercase">
                Architecture Éprouvée
              </span>
            </div>
            <p id="stack-desc" class="text-xs sm:text-sm text-slate-400 mt-1">
              Architecture conçue pour générer 6 chiffres de CA sans recruter, en automatisant 90% des tâches répétitives.
            </p>
          </div>

          <!-- Savings Badge Odometer -->
          <div class="p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-right min-w-[220px]">
            <div class="text-xs font-mono text-emerald-400 font-bold uppercase tracking-wider">ÉCONOMIE ANNUELLE ESTIMÉE</div>
            <div id="stack-savings" class="text-3xl font-black text-emerald-300 font-mono mt-0.5">+$8,400 / an</div>
            <div id="stack-cost-comparison" class="text-[11px] text-slate-400 mt-1">
              Coût : <strong class="text-white">$78/m</strong> au lieu de <span class="line-through text-slate-500">$780/m</span>
            </div>
          </div>
        </div>

        <!-- Dynamic Grid of Recommended Tools -->
        <div id="stack-tools-grid" class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
          <!-- Populated dynamically via JS -->
        </div>

        <!-- Integrated Architecture Workflow Diagram (Mermaid Representation) -->
        <div class="p-6 rounded-2xl bg-slate-950/80 border border-slate-800 mb-8">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono text-slate-400 uppercase tracking-wider">FLUX DE DONNÉES & INTERCONNEXION</span>
            <span class="text-[11px] font-mono text-cyan-400 font-bold">100% SANS CODE BLOQUÉ</span>
          </div>
          <div id="workflow-flow-diagram" class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono">
            <!-- Dynamic flow nodes -->
          </div>
        </div>

        <!-- Action Row -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t border-slate-800/80">
          <div class="text-xs text-slate-400">
            Tous les outils ci-dessus bénéficient de <strong class="text-white">liens partenaires vérifiés</strong> avec réductions exclusives appliquées automatiquement.
          </div>
          <div class="flex items-center gap-3 w-full sm:w-auto">
            <button 
              id="copy-stack-btn"
              type="button"
              class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white font-mono text-xs border border-slate-700 transition-all flex items-center gap-2 cursor-pointer"
            >
              <span id="copy-btn-text">Copier la Stack (Markdown)</span>
            </button>
            <a 
              id="share-linkedin-btn"
              href="https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Fheliatech.online%2Fblueprint"
              target="_blank"
              rel="noopener noreferrer"
              class="px-5 py-3 rounded-xl bg-[#0077b5] hover:bg-[#006097] text-white font-mono text-xs font-bold transition-all flex items-center gap-2 shadow-md hover:scale-[1.02]"
            >
              <span>Partager sur LinkedIn ↗</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- The 4 Core Architectural Pillars Bento Section -->
    <section class="mb-24">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2">LES FONDATIONS 2026</span>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
          Pourquoi les Architectures 2026 Surclassent le Reste.
        </h2>
        <p class="text-slate-400 text-sm leading-relaxed">
          Quatre ruptures technologiques majeures permettent aujourd'hui à une équipe de 3 personnes de produire la valeur d'une entreprise de 50 salariés.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Pillar 1 -->
        <div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all backdrop-blur-xl group">
          <div class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 font-mono text-lg font-bold mb-6 group-hover:scale-110 transition-transform">
            01
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Orchestration Événementielle Réactive</h3>
          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-4">
            Remplacement des webhooks lents par des moteurs de flux sans temps d'arrêt. Un scénario <strong class="text-white">Make</strong> ou <strong class="text-white">n8n</strong> coûte jusqu'à 85% moins cher qu'une armée de micro-services non documentés.
          </p>
          <div class="flex items-center gap-2 font-mono text-xs text-cyan-300">
            <span>Outils validés : Make, n8n</span>
            <span>→</span>
          </div>
        </div>

        <!-- Pillar 2 -->
        <div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-fuchsia-500/40 transition-all backdrop-blur-xl group">
          <div class="w-12 h-12 rounded-2xl bg-fuchsia-500/10 border border-fuchsia-500/30 flex items-center justify-center text-fuchsia-400 font-mono text-lg font-bold mb-6 group-hover:scale-110 transition-transform">
            02
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Intelligence Commerciale B2B Intégrée</h3>
          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-4">
            Fini les bases de données froides à 10 000 $/an. Avec <strong class="text-white">Apollo.io</strong> et <strong class="text-white">Lusha</strong>, vous enrichissez vos cibles directement au contact vérifié, synchronisé instantanément avec votre pipeline CRM.
          </p>
          <div class="flex items-center gap-2 font-mono text-xs text-fuchsia-300">
            <span>Outils validés : Apollo.io, Lusha</span>
            <span>→</span>
          </div>
        </div>

        <!-- Pillar 3 -->
        <div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-violet-500/40 transition-all backdrop-blur-xl group">
          <div class="w-12 h-12 rounded-2xl bg-violet-500/10 border border-violet-500/30 flex items-center justify-center text-violet-400 font-mono text-lg font-bold mb-6 group-hover:scale-110 transition-transform">
            03
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Génération Média & Voix IA Hyper-Réaliste</h3>
          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-4">
            Production vidéo et doublage multilingue instantanés via les modèles <strong class="text-white">ElevenLabs</strong> et <strong class="text-white">HeyGen</strong>. Divisez vos coûts de post-production par 12 tout en adressant le marché mondial.
          </p>
          <div class="flex items-center gap-2 font-mono text-xs text-violet-300">
            <span>Outils validés : ElevenLabs, HeyGen, Submagic</span>
            <span>→</span>
          </div>
        </div>

        <!-- Pillar 4 -->
        <div class="p-8 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/40 transition-all backdrop-blur-xl group">
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-mono text-lg font-bold mb-6 group-hover:scale-110 transition-transform">
            04
          </div>
          <h3 class="text-xl font-bold text-white mb-2">Infrastructure Edge & Postgres Moderne</h3>
          <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-4">
            Migration des serveurs traditionnels vers des bases temps réel managées. <strong class="text-white">Supabase</strong> et <strong class="text-white">Vercel</strong> assurent une latence quasi nulle sous un modèle de facturation à l'usage réel.
          </p>
          <div class="flex items-center gap-2 font-mono text-xs text-emerald-300">
            <span>Outils validés : Supabase, Vercel, Resend</span>
            <span>→</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Lead Capture Section: The Confidential Intelligence Dispatch -->
    <section id="newsletter-lead" class="p-8 sm:p-14 rounded-3xl bg-gradient-to-br from-indigo-950/40 via-slate-900/90 to-slate-950 border border-cyan-500/40 text-center relative overflow-hidden shadow-2xl mb-24">
      <div class="max-w-2xl mx-auto">
        <span class="text-xs font-mono text-cyan-300 uppercase tracking-widest block mb-3">ACCÈS PRIVÉ AUX AUDITS</span>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
          Recevez les Rapports Confidentiels de l'Observatoire
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed mb-8 font-light">
          Chaque mardi matin, recevez les benchmarks de latence réels, les fuites de tarifs des éditeurs et les nouvelles intégrations accréditées par nos analystes. Zéro spam, zéro complaisance.
        </p>

        <!-- Lead Capture Form -->
        <form id="blueprint-lead-form" class="flex flex-col sm:flex-row items-center gap-3 max-w-lg mx-auto">
          <input 
            type="email" 
            id="lead-email"
            required
            placeholder="votre.email.pro@entreprise.com" 
            class="w-full px-5 py-4 rounded-2xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 text-sm font-sans focus:outline-none focus:border-cyan-400 transition-colors"
          />
          <button 
            type="submit" 
            id="lead-submit-btn"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-cyan-400 to-sky-400 hover:from-cyan-300 hover:to-sky-300 text-slate-950 font-black text-xs font-mono uppercase tracking-wider shadow-lg shadow-cyan-500/20 transition-all hover:scale-[1.02] cursor-pointer whitespace-nowrap"
          >
            Obtenir le Dossier ➔
          </button>
        </form>

        <div id="lead-success-msg" class="hidden mt-4 p-4 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 font-mono text-xs">
          ✓ Inscription confirmée. Le dossier Blueprint 2026 a été synchronisé !
        </div>

        <div class="mt-4 flex items-center justify-center gap-4 text-[11px] font-mono text-slate-500">
          <span>🔒 Chiffrement SSL</span>
          <span>•</span>
          <span>Désinscription 1-click</span>
          <span>•</span>
          <span>Rejoignez +4 200 décideurs tech</span>
        </div>
      </div>
    </section>

    <!-- Institutional Methodology Guarantee (Protecting Secrets) -->
    <section class="p-8 rounded-3xl bg-slate-900/40 border border-slate-800 text-center max-w-4xl mx-auto">
      <h3 class="text-lg font-bold text-white mb-2">Notre Charte d'Indépendance Technologique</h3>
      <p class="text-xs text-slate-400 leading-relaxed max-w-2xl mx-auto">
        L'Observatoire HeliaTech opère une suite de bancs d'essai automatisés mesurant la latence synthétique, la résilience aux pannes et les coûts d'utilisation réels. Aucun éditeur de logiciel ne peut acheter son inclusion dans nos sélections d'excellence. Les partenariats d'affiliation négociés financent nos infrastructures sans impacter l'impartialité absolue de nos rapports.
      </p>
    </section>

  </div>

  <!-- Dynamic Stack Switching Logic -->
  <script is:inline>
    (function() {
      const stacks = {
        solo: {
          title: "Stack Solopreneur AI-First 2026",
          badge: "LEVIER MAXIMAL (1 PERSONNE)",
          desc: "Architecture ultralégère pour générer plus de $10k/mois de CA sans aucun employé, en automatisant prospection, média et support client.",
          savings: "+$8,400 / an",
          comparison: "Coût : $78/m au lieu de $780/m (Zapier + Hubspot)",
          tools: [
            {
              name: "Make",
              slug: "make",
              category: "Automatisation de Flux",
              perk: "10 000 opérations offertes",
              reason: "Remplace Zapier pour 1/5ème du tarif avec une logique visuelle illimitée."
            },
            {
              name: "Apollo.io",
              slug: "apollo-io",
