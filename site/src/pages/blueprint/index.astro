              category: "Hébergement Edge & Frontend",
              perk: "Free Tier Global Edge",
              reason: "Déploiements continus instantanés et latence de 0ms à l'échelle planétaire."
            },
            {
              name: "Resend",
              slug: "resend",
              category: "API Email Transactionnel",
              perk: "3 000 emails/mois offerts",
              reason: "API pour développeurs la plus élégante, support React Email natif."
            }
          ],
          workflow: [
            { step: "01. Frontend", tool: "Vercel" },
            { step: "02. Database & Auth", tool: "Supabase" },
            { step: "03. Transactionnel", tool: "Resend" },
            { step: "04. Automatisation", tool: "n8n / Make" }
          ]
        },
        media: {
          title: "Stack Média, Podcasting & Studio IA 2026",
          badge: "STUDIO AUDIO/VIDÉO ILLIMITÉ",
          desc: "Industrialisez la publication de contenus courts et longs sur TikTok, YouTube, Spotify et LinkedIn grâce aux meilleurs modèles de synthèse vocale.",
          savings: "+$12,000 / an",
          comparison: "Coût : $95/m au lieu de $1,100/m (Équipes de montage manuelles)",
          tools: [
            {
              name: "ElevenLabs",
              slug: "elevenlabs",
              category: "Synthèse Vocale & Voix IA",
              perk: "Essai 10 000 caractères offerts",
              reason: "Qualité vocale indiscernable de la voix humaine en 29 langues."
            },
            {
              name: "HeyGen",
              slug: "heygen",
              category: "Avatars Vidéo Photoréalistes",
              perk: "Crédit vidéo d'essai",
              reason: "Création de présentateurs et vidéos de vente sans caméra ni studio."
            },
            {
              name: "Submagic",
              slug: "submagic",
              category: "Shorts & Sous-titrage Viral",
              perk: "3 exports gratuits",
              reason: "Sous-titres dynamiques, b-rolls automatiques et zooms captivants."
            }
          ],
          workflow: [
            { step: "01. Scripting", tool: "Jasper / Notion AI" },
            { step: "02. Audio", tool: "ElevenLabs" },
            { step: "03. Vidéo", tool: "HeyGen / Submagic" },
            { step: "04. Syndication", tool: "Transistor / Beehiiv" }
          ]
        }
      };

      function renderStack(personaKey) {
        const stack = stacks[personaKey] || stacks.solo;
        
        // Update Title & descriptions
        const titleEl = document.getElementById('stack-title');
        const badgeEl = document.getElementById('stack-badge');
        const descEl = document.getElementById('stack-desc');
        const savingsEl = document.getElementById('stack-savings');
        const comparisonEl = document.getElementById('stack-cost-comparison');
        const toolsGrid = document.getElementById('stack-tools-grid');
        const workflowGrid = document.getElementById('workflow-flow-diagram');

        if (titleEl) titleEl.textContent = stack.title;
        if (badgeEl) badgeEl.textContent = stack.badge;
        if (descEl) descEl.textContent = stack.desc;
        if (savingsEl) savingsEl.textContent = stack.savings;
        if (comparisonEl) comparisonEl.innerHTML = stack.comparison;

        // Render Tool Cards
        if (toolsGrid) {
          toolsGrid.innerHTML = stack.tools.map(tool => `
            <div class="p-6 rounded-2xl bg-slate-950/70 border border-slate-800 hover:border-cyan-500/40 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-[10px] font-mono text-cyan-400 font-bold uppercase tracking-wider bg-cyan-500/10 px-2.5 py-1 rounded-md border border-cyan-500/20">
                    ${tool.category}
                  </span>
                  <span class="text-xs font-mono text-emerald-400">★ 4.8/5</span>
                </div>
                <h4 class="text-xl font-bold text-white mb-2 group-hover:text-cyan-300 transition-colors">${tool.name}</h4>
                <p class="text-xs text-slate-400 leading-relaxed mb-4">${tool.reason}</p>
              </div>

              <div>
                <div class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-[11px] font-mono text-slate-300 mb-4 flex items-center justify-between">
                  <span class="text-slate-400">Avantage :</span>
                  <span class="text-cyan-300 font-bold">${tool.perk}</span>
                </div>
                <div class="grid grid-cols-2 gap-2">
                  <a 
                    href="/reviews/${tool.slug}" 
                    class="py-2 px-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-medium text-center border border-slate-700 transition-all"
                  >
                    Dossier
                  </a>
                  <a 
                    href="/go/${tool.slug}" 
                    target="_blank" 
                    rel="noopener noreferrer sponsored"
                    class="py-2 px-3 rounded-xl bg-gradient-to-r from-cyan-500 to-fuchsia-500 hover:from-cyan-400 hover:to-fuchsia-400 text-slate-950 text-xs font-bold font-mono text-center shadow-md transition-all flex items-center justify-center gap-1"
                  >
                    Accéder ↗
                  </a>
                </div>
              </div>
            </div>
          `).join('');
        }

        // Render Workflow Nodes
        if (workflowGrid) {
          workflowGrid.innerHTML = stack.workflow.map((node, i) => `
            <div class="flex-1 w-full p-3 rounded-xl bg-slate-900/80 border border-slate-800 text-center">
              <div class="text-[10px] text-slate-500 font-mono">${node.step}</div>
              <div class="text-xs text-white font-bold font-mono mt-0.5">${node.tool}</div>
            </div>
            ${i < stack.workflow.length - 1 ? '<span class="text-slate-600 font-bold hidden sm:inline">➔</span>' : ''}
          `).join('');
        }
      }

      // Initialize default
      renderStack('solo');

      // Bind persona buttons
      const buttons = document.querySelectorAll('.persona-btn');
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => {
            b.classList.remove('active', 'bg-cyan-500/10', 'border-cyan-500', 'text-white', 'shadow-glow-cyan');
            b.classList.add('bg-slate-900/60', 'border-slate-800', 'text-slate-400');
          });
          btn.classList.add('active', 'bg-cyan-500/10', 'border-cyan-500', 'text-white', 'shadow-glow-cyan');
          btn.classList.remove('bg-slate-900/60', 'border-slate-800', 'text-slate-400');

          const persona = btn.getAttribute('data-persona');
          renderStack(persona);
        });
      });

      // Lead capture form handler
      const leadForm = document.getElementById('blueprint-lead-form');
      const leadSuccess = document.getElementById('lead-success-msg');
      const leadBtn = document.getElementById('lead-submit-btn');

      if (leadForm) {
        leadForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const emailInput = document.getElementById('lead-email');
          const email = emailInput ? emailInput.value : '';

          // Save to local storage telemetry
          try {
            const list = JSON.parse(localStorage.getItem('_ht_blueprint_leads') || '[]');
            list.push({ email, timestamp: new Date().toISOString() });
            localStorage.setItem('_ht_blueprint_leads', JSON.stringify(list));
          } catch(err) {}

          if (leadBtn) {
            leadBtn.textContent = '✓ Transmis';
            leadBtn.classList.add('opacity-50', 'pointer-events-none');
          }
          if (leadSuccess) {
            leadSuccess.classList.remove('hidden');
          }
          leadForm.reset();
        });
      }

      // Copy stack handler
      const copyBtn = document.getElementById('copy-stack-btn');
      const copyText = document.getElementById('copy-btn-text');
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const currentTitle = document.getElementById('stack-title')?.textContent || 'Stack 2026';
          const textToCopy = `### ${currentTitle}\nAudité par HeliaTech Media (https://heliatech.online/blueprint)\nÉconomie moyenne : +$14.8k/an.`;
          navigator.clipboard.writeText(textToCopy).then(() => {
            if (copyText) copyText.textContent = '✓ Stack Copiée !';
            setTimeout(() => {
              if (copyText) copyText.textContent = 'Copier la Stack (Markdown)';
            }, 2500);
          });
        });
      }

    })();
  </script>
</Layout>
