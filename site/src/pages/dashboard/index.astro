---

import Layout from '../../layouts/Layout.astro';

import templates from '../../data/templates_catalog.json';

const pageTitle = "Tableau de Bord Acheteur | HeliaTech Marketplace";

const pageDescription = "Accédez à votre bibliothèque de templates, téléchargez vos workflows n8n & Make certifiés, consultez vos factures et échangez avec vos vendeurs.";

// Recommended blueprints for buyer (top rated)

const recommendedBlueprints = templates.filter(t => t.rating >= 4.95).slice(0, 3);

---

<Layout title={pageTitle} description={pageDescription} noindex={true}>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-24">

    

    <!-- Top Staging Notice -->

    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 mb-8 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono gap-3">

      <div class="flex items-center gap-2.5">

        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-pulse flex-shrink-0"></span>

        <span class="font-bold uppercase tracking-wider">Espace Acheteur Certifié</span>

        <span class="text-cyan-400/70 hidden lg:inline">— Vos licences commerciales, téléchargements sécurisés et factures B2B.</span>

      </div>

      <div class="flex items-center gap-3 w-full sm:w-auto justify-end">

        <a href="/templates/" class="px-3 py-1 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-200 border border-cyan-500/40 font-bold transition-all">

          Catalogue (/templates/) ➔

        </a>

        <a href="/sell/" class="px-3 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-200 border border-emerald-500/40 font-bold transition-all">

          Studio Vendeur (80%) ➔

        </a>

      </div>

    </div>

    <!-- ========================================================================= -->

    <!-- 🔐 AUTH GATE MODAL (If user session not detected) -->

    <!-- ========================================================================= -->

    <div id="buyer-auth-gate" class="max-w-xl mx-auto my-12 p-8 sm:p-10 rounded-3xl bg-slate-900/90 border border-slate-800 shadow-2xl relative overflow-hidden hidden">

      <div class="text-center space-y-3 mb-8">

        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 text-3xl shadow-glow-cyan mb-2">

          🔐

        </div>

        <h1 class="text-2xl sm:text-3xl font-black text-white">Connexion à votre Espace</h1>

        <p class="text-xs text-slate-400 font-light leading-relaxed max-w-md mx-auto">

          Retrouvez instantanément vos licences commerciales, téléchargez vos blueprints n8n, Make &amp; Supabase et gérez vos factures.

        </p>

      </div>

      <form id="buyer-login-form" class="space-y-4">

        <div>

          <label class="block text-xs font-mono text-slate-300 mb-1.5 font-bold">Email Professionnel :</label>

          <input 

            type="email" 

            id="auth-email-input" 

            required 

            placeholder="ex: votre-email@domaine.com" 

            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-xs font-mono focus:border-cyan-500 focus:outline-none transition-all"

          />

        </div>

        <div>

          <label class="block text-xs font-mono text-slate-300 mb-1.5 font-bold">Nom Complet :</label>

          <input 

            type="text" 

            id="auth-name-input" 

            placeholder="ex: Hamza El Fahsi" 

            class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 text-xs font-mono focus:border-cyan-500 focus:outline-none transition-all"

          />

        </div>

        <button 

          type="submit" 

          class="w-full py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-400 hover:from-cyan-400 hover:to-sky-300 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider transition-all shadow-glow-cyan"

        >

          Accéder à mon Tableau de Bord ➔

        </button>

      </form>

      

    </div>

    <!-- ========================================================================= -->

    <!-- 📊 AUTHENTICATED BUYER DASHBOARD CONTAINER -->

    <!-- ========================================================================= -->

    <div id="buyer-main-container" class="space-y-8">

      

      <!-- Buyer Header Card -->

      <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-slate-800 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 shadow-2xl relative overflow-hidden">

        <div class="flex items-center gap-4 relative z-10">

          <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500 via-sky-600 to-indigo-600 p-0.5 shadow-glow-cyan flex-shrink-0">

            <div class="w-full h-full bg-slate-950 rounded-2xl flex items-center justify-center text-xl font-bold text-white font-mono" id="buyer-avatar-initials">
              HF
            </div>

          </div>

          <div>

            <div class="flex items-center gap-2.5 mb-1">

              <h1 class="text-xl sm:text-2xl font-black text-white" id="buyer-display-name">Mon Espace Client</h1>

              <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-bold">

                Acheteur Vérifié

              </span>

            </div>

            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 font-mono">

              <span id="buyer-display-email">client@heliatech.online</span>

              <span>•</span>

              <span class="text-emerald-400 font-bold">✓ Licences à vie actives</span>

            </div>

          </div>

        </div>

        <!-- Mode switcher / Logout -->

        <div class="flex items-center gap-3 w-full lg:w-auto justify-end">

          <a href="/seller/" class="px-4 py-2 rounded-xl bg-slate-950 hover:bg-slate-800 text-slate-300 border border-slate-800 text-xs font-mono font-bold transition-all">

            Studio Vendeur ➔

          </a>

          <button id="btn-buyer-logout" class="px-3 py-2 rounded-xl bg-slate-900 hover:bg-rose-950/50 text-slate-400 hover:text-rose-300 border border-slate-800 text-xs font-mono transition-all">

            🚪 Déconnexion

          </button>

        </div>

      </div>

      <!-- Main Navigation Tabs Bar -->

      <div class="flex flex-wrap items-center gap-2 border-b border-slate-800 pb-4">

        <button id="tab-overview" class="dash-tab px-4 py-2.5 rounded-xl bg-cyan-500 text-slate-950 font-mono text-xs font-bold transition-all flex items-center gap-2 shadow-glow-cyan">

          <span>📊</span> Vue d'Ensemble

        </button>

        <button id="tab-library" class="dash-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">

          <span>📦</span> Ma Bibliothèque

          <span id="badge-lib-count" class="px-2 py-0.5 rounded-full bg-slate-950 text-cyan-300 text-[10px]">2</span>

        </button>

        <button id="tab-orders" class="dash-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">

          <span>🧾</span> Mes Commandes &amp; Factures

          <span class="px-2 py-0.5 rounded-full bg-slate-950 text-slate-400 text-[10px]">2</span>

        </button>

        <button id="tab-wishlist" class="dash-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">

          <span>💖</span> Ma Wishlist

          <span id="badge-wishlist-count" class="px-2 py-0.5 rounded-full bg-slate-950 text-rose-400 text-[10px]">0</span>

        </button>

        <button id="tab-reviews" class="dash-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">

          <span>⭐</span> Mes Avis Laissés

        </button>

        <button id="tab-support" class="dash-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">

          <span>💬</span> Support &amp; Échanges

          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>

        </button>

      </div>

      <!-- ========================================================================= -->

      <!-- 1. VUE D'ENSEMBLE (OVERVIEW) -->

      <!-- ========================================================================= -->

      <div id="panel-overview" class="space-y-8">

        

        <!-- KPI Metrics Grid -->

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">

          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">

            <div class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono mb-1" id="stat-overview-count">2</div>

            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Blueprints Achetés</div>

          </div>

          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">

            <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono mb-1" id="stat-overview-spent">$88.00</div>

            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Investissement Total</div>

          </div>

          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">

            <div class="text-2xl sm:text-3xl font-black text-indigo-400 font-mono mb-1" id="stat-overview-downloads">4</div>

            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Téléchargements Effectués</div>

          </div>

          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">

            <div class="text-2xl sm:text-3xl font-black text-amber-400 font-mono mb-1" id="stat-overview-savings">~48 Heures</div>

            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Temps Dev Économisé</div>

          </div>

        </div>

        <!-- Quick Access: Recently Purchased Blueprints -->

        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">

          <div class="flex items-center justify-between border-b border-slate-800 pb-4">

            <div>

              <h2 class="text-lg font-bold text-white flex items-center gap-2">

                <span>⚡</span> Accès Immédiat : Derniers Workflows Achetés

              </h2>

              <p class="text-xs text-slate-400 font-light mt-0.5">

                Téléchargez en 1 clic vos fichiers .json audités sans attendre.

              </p>

            </div>

            <button id="btn-goto-library" class="text-xs font-mono text-cyan-400 hover:underline">

              Voir toute ma bibliothèque ➔

            </button>

          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="recent-blueprints-grid">

            <!-- Dynamically populated or default cards -->

            <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col justify-between space-y-4">

              <div>

                <div class="flex items-center justify-between mb-2">

                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-orange-500/10 text-orange-400 border border-orange-500/30 font-bold uppercase">N8N</span>

                  <span class="text-[10px] font-mono text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20">Mise à jour v1.4.2 dispo</span>

                </div>

                <h3 class="text-sm font-bold text-white mb-1">n8n AI Waterfall Lead Enrichment &amp; Scoring Engine</h3>

                <p class="text-xs font-mono text-slate-400">Licence : HLT-LIC-N8N-8842-PRO-2026</p>

              </div>

              <div class="flex items-center justify-between pt-3 border-t border-slate-800/80">

                <span class="text-xs font-mono text-slate-500">Version v1.2.0</span>

                <a 

                  href="/api/marketplace/buyer/download?slug=n8n-ai-lead-enricher-waterfall" 

                  download 

                  class="px-3.5 py-1.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-mono font-bold transition-all shadow-glow-cyan"

                >

                  Télécharger .JSON ➔

                </a>

              </div>

            </div>

            <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 flex flex-col justify-between space-y-4">

              <div>

                <div class="flex items-center justify-between mb-2">

                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-400 border border-purple-500/30 font-bold uppercase">MAKE</span>

                  <span class="text-[10px] font-mono text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">À jour (v1.1.0)</span>

                </div>

                <h3 class="text-sm font-bold text-white mb-1">Make.com Stripe Failed Payment Recovery &amp; Smart Churn Rescue</h3>

                <p class="text-xs font-mono text-slate-400">Licence : HLT-LIC-MAK-9102-PRO-2026</p>

              </div>

              <div class="flex items-center justify-between pt-3 border-t border-slate-800/80">

                <span class="text-xs font-mono text-slate-500">Version v1.1.0</span>

                <a 

                  href="/api/marketplace/buyer/download?slug=make-stripe-churn-rescue-blueprint" 

                  download 

                  class="px-3.5 py-1.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 text-xs font-mono font-bold transition-all shadow-glow-cyan"

                >

                  Télécharger .JSON ➔

                </a>

              </div>

            </div>

          </div>

        </div>

        <!-- Curated Recommendations for Buyer -->

        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">

          <div class="flex items-center justify-between border-b border-slate-800 pb-4">

            <div>

              <h2 class="text-lg font-bold text-white flex items-center gap-2">

                <span>🎯</span> Recommandations Personnalisées pour Votre Stack

              </h2>

              <p class="text-xs text-slate-400 font-light mt-0.5">

                Blueprints haute-performance compatibles avec vos outils d'automatisation.

              </p>

            </div>

            <a href="/templates/" class="text-xs font-mono text-cyan-400 hover:underline">

              Parcourir le catalogue complet ➔

            </a>

          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            {recommendedBlueprints.map((rec) => (

              <div class="p-5 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-cyan-500/40 transition-all flex flex-col justify-between group">

                <div>

                  <div class="flex items-center justify-between mb-2">

                    <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-400 border border-cyan-500/30">

                      {rec.ecosystem.toUpperCase()}

                    </span>

                    <span class="text-xs font-mono text-amber-400">★ {rec.rating}</span>

                  </div>

                  <h3 class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors mb-2">

                    <a href={`/templates/${rec.slug}/`}>{rec.title}</a>

                  </h3>

                  <p class="text-xs text-slate-400 font-light line-clamp-2 mb-3">

                    {rec.tagline}

                  </p>

                </div>

                <div class="flex items-center justify-between pt-3 border-t border-slate-800">

                  <span class="text-sm font-black text-white font-mono">

                    {rec.is_free ? <span class="text-emerald-400">GRATUIT</span> : `$${rec.price_usd}`}

                  </span>

                  <a href={`/templates/${rec.slug}/`} class="text-xs font-mono text-cyan-400 hover:underline">

                    Détails ➔

                  </a>

                </div>

              </div>

            ))}

          </div>

        </div>

      </div>

