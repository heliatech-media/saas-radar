---
import Layout from '../layouts/Layout.astro';
import ToolIcon from '../components/ToolIcon.astro';
import toolsData from '../data/tools-index.json';
import { getCollection } from 'astro:content';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "HeliaTech | Observatoire Indépendant des Logiciels SaaS & IA 2026",
  "url": "https://heliatech.online",
  "description": "L'Observatoire indépendant de référence pour évaluer, benchmarker et sélectionner les meilleures architectures logicielles SaaS et IA du marché mondial.",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://heliatech.online/radar?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

// Curated Showcase Selection (Top 6 Premier Accredited Platforms)
const showcaseSlugs = ["make", "apollo-io", "elevenlabs", "supabase", "clickup", "beehiiv"];
const showcaseTools = toolsData.filter((t: any) => showcaseSlugs.includes(t.slug));

// Latest Blog Articles for Intelligence Feed
const blogPosts = await getCollection('blog');
const latestArticles = blogPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<Layout 
  title="HeliaTech | Observatoire Indépendant des Logiciels SaaS & IA 2026"
  description="L'Observatoire indépendant de référence : découvrez les meilleures architectures SaaS, réduisez vos coûts d'abonnements jusqu'à 65% et accédez aux benchmarks sans concession."
  jsonLd={jsonLd}
>
  <!-- Atmospheric Gradient Lighting -->
  <div class="absolute top-20 left-1/2 -translate-x-1/2 w-[800px] h-[450px] bg-gradient-to-tr from-cyan-600/10 via-sky-500/10 to-fuchsia-600/10 blur-[150px] pointer-events-none -z-10"></div>
  <div class="absolute top-[800px] right-10 w-[500px] h-[350px] bg-gradient-to-br from-indigo-600/10 to-transparent blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-6 sm:px-8 pt-12 sm:pt-20 pb-24">

    <!-- Hero Section: High-Converting Flagship Value Proposition -->
    <section class="text-center max-w-4xl mx-auto mb-20 sm:mb-28">
      
      <!-- Trust Accreditation Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 text-xs font-mono font-bold tracking-widest uppercase mb-8 shadow-glow-cyan">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>L'OBSERVATOIRE INDÉPENDANT DES LOGICIELS SAAS & IA • ÉDITION 2026</span>
      </div>

      <!-- Main Catchphrase -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.08] mb-8">
        Ne Surpayez Plus Vos Logiciels. <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-fuchsia-400">
          L'Observatoire Indépendant des Meilleures Architectures SaaS.
        </span>
      </h1>

      <!-- Subtitle Description -->
      <p class="text-base sm:text-xl text-slate-300 font-light leading-relaxed max-w-3xl mx-auto mb-10">
        HeliaTech audite, benchmarke et certifie en continu les logiciels les plus performants du marché mondial. Éliminez jusqu'à <strong class="text-white font-medium">65% de dépenses superflues</strong>, remplacez les outils obsolètes et accélérez votre rentabilité.
      </p>

      <!-- Institutional Proof Metrics Bar -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto mb-10 text-left">
        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono">35+</div>
          <div class="text-xs text-slate-400 mt-1">Logiciels Accrédités</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono">-$14.8k</div>
          <div class="text-xs text-slate-400 mt-1">Économie Moyenne/an</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-fuchsia-400 font-mono">Sub-150ms</div>
          <div class="text-xs text-slate-400 mt-1">Latence Synthétique</div>
        </div>
        <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800/80 backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-white font-mono">100%</div>
          <div class="text-xs text-slate-400 mt-1">Audits Impartiaux</div>
        </div>
      </div>

      <!-- Hero Call-To-Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="/radar"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-cyan-500 to-fuchsia-500 hover:from-cyan-400 hover:to-fuchsia-400 text-slate-950 font-black text-sm tracking-wide shadow-xl shadow-cyan-500/20 hover:shadow-cyan-500/35 transition-all duration-300 hover:scale-[1.03] flex items-center justify-center gap-2"
        >
          <span>Explorer le Radar 2026 ➔</span>
        </a>
        <a 
          href="/calculator"
          class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 hover:text-white font-mono text-sm border border-slate-700 transition-all flex items-center justify-center gap-2"
        >
          <span>Calculer Vos Économies 🧮</span>
        </a>
      </div>

    </section>

    <!-- The 4 Core Pillars Bento Grid Section -->
    <section class="mb-24">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2">LES OUTILS DE DÉCISION HELIATECH</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          Un Écosystème Dédié aux Décideurs Tech
        </h2>
        <p class="text-slate-400 text-sm mt-3">
          Tout ce dont vous avez besoin pour auditer, comparer et déployer vos logiciels d'entreprise sans risquer un centime.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Pillar 1: Le Radar -->
        <a 
          href="/radar"
          class="p-8 sm:p-10 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/50 transition-all duration-300 group backdrop-blur-xl relative overflow-hidden flex flex-col justify-between"
        >
          <div class="absolute top-0 right-0 w-48 h-48 bg-cyan-500/5 rounded-full blur-3xl pointer-events-none group-hover:bg-cyan-500/10 transition-colors"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="w-12 h-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-xl font-bold">
                🛰️
              </span>
              <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider">
                ANNUAIRE INTERACTIF
              </span>
            </div>
            <h3 class="text-2xl font-black text-white mb-3 group-hover:text-cyan-300 transition-colors">
              Le Radar des Logiciels 2026
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed font-light mb-6">
              Accédez à la matrice complète des plus de 35 logiciels accrédités. Filtrez par catégorie, comparez les prix réels et consultez nos dossiers médico-légaux d'architecture.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-mono text-cyan-400 font-bold group-hover:translate-x-1 transition-transform">
            <span>Explorer la Matrice Active</span>
            <span>→</span>
          </div>
        </a>

        <!-- Pillar 2: Le Calculateur TCO -->
        <a 
          href="/calculator"
          class="p-8 sm:p-10 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-emerald-500/50 transition-all duration-300 group backdrop-blur-xl relative overflow-hidden flex flex-col justify-between"
        >
          <div class="absolute top-0 right-0 w-48 h-48 bg-emerald-500/5 rounded-full blur-3xl pointer-events-none group-hover:bg-emerald-500/10 transition-colors"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-xl font-bold">
                🧮
              </span>
              <span class="text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider">
                SIMULATEUR TEMPS RÉEL
              </span>
            </div>
            <h3 class="text-2xl font-black text-white mb-3 group-hover:text-emerald-300 transition-colors">
              Détecteur de Gaspillage SaaS
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed font-light mb-6">
              Ajustez vos volumes d'opérations et la taille de vos effectifs pour quantifier instantanément le capital récupérable en migrant de suites legacy vers des alternatives modernes.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-mono text-emerald-400 font-bold group-hover:translate-x-1 transition-transform">
            <span>Lancer la Simulation de TCO</span>
            <span>→</span>
          </div>
        </a>

        <!-- Pillar 3: Versus Arena -->
        <a 
          href="/versus"
          class="p-8 sm:p-10 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-amber-500/50 transition-all duration-300 group backdrop-blur-xl relative overflow-hidden flex flex-col justify-between"
        >
          <div class="absolute top-0 right-0 w-48 h-48 bg-amber-500/5 rounded-full blur-3xl pointer-events-none group-hover:bg-amber-500/10 transition-colors"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 text-xl font-bold">
                ⚔️
              </span>
              <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider">
                DUELS 1 CONTRE 1
              </span>
            </div>
            <h3 class="text-2xl font-black text-white mb-3 group-hover:text-amber-300 transition-colors">
              La Versus Arena Comparative
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed font-light mb-6">
              Make vs Zapier, ClickUp vs Monday, Apollo vs Lusha, ElevenLabs vs HeyGen. Des confrontations techniques directes basées sur la latence réelle et les coûts de montée en charge.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-mono text-amber-400 font-bold group-hover:translate-x-1 transition-transform">
            <span>Consulter les Duels Vérifiés</span>
            <span>→</span>
          </div>
        </a>

        <!-- Pillar 4: Deals & Perks -->
        <a 
          href="/deals"
          class="p-8 sm:p-10 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-pink-500/50 transition-all duration-300 group backdrop-blur-xl relative overflow-hidden flex flex-col justify-between"
        >
          <div class="absolute top-0 right-0 w-48 h-48 bg-pink-500/5 rounded-full blur-3xl pointer-events-none group-hover:bg-pink-500/10 transition-colors"></div>
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="w-12 h-12 rounded-2xl bg-pink-500/10 border border-pink-500/30 flex items-center justify-center text-pink-400 text-xl font-bold">
                🎁
              </span>
              <span class="text-xs font-mono font-bold text-pink-400 uppercase tracking-wider">
                RÉDUCTIONS & PERKS
              </span>
            </div>
            <h3 class="text-2xl font-black text-white mb-3 group-hover:text-pink-300 transition-colors">
              Le Vault d'Avantages Membres
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed font-light mb-6">
              Bénéficiez d'accords partenariaux exclusifs avec les plus grands éditeurs tech : jusqu'à 10 000 opérations offertes, remises pluriannuelles et paliers d'accès réservés.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-mono text-pink-400 font-bold group-hover:translate-x-1 transition-transform">
            <span>Accéder au Coffre-Fort de Deals</span>
            <span>→</span>
          </div>
        </a>

      </div>
    </section>

    <!-- Curated Showcase: 6 Premier Accredited Platforms -->
    <section class="mb-24">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-4 border-b border-slate-800">
        <div>
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-1">ÉLITE DU RADAR</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Plateformes Accréditées d'Excellence
          </h2>
        </div>
        <a href="/radar" class="text-xs font-mono text-slate-400 hover:text-cyan-400 transition-colors flex items-center gap-1">
          <span>Voir les 35+ outils audités</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {showcaseTools.map((tool: any) => (
          <div class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all duration-300 flex flex-col justify-between group backdrop-blur-xl">
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center gap-3">
                  <ToolIcon slug={tool.slug} name={tool.name} size="md" className="group-hover:scale-105 transition-transform" />
                  <div>
                    <h3 class="font-bold text-white text-base group-hover:text-cyan-300 transition-colors">
                      {tool.name}
                    </h3>
                    <span class="text-[11px] font-mono text-slate-400">{tool.category}</span>
                  </div>
                </div>
                <div class="px-2 py-0.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 font-mono text-[10px] font-bold">
                  ★ {tool.rating}
                </div>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed font-light mb-6 line-clamp-3">
                {tool.tagline}
              </p>
            </div>

            <div>
              <div class="flex items-center justify-between text-xs font-mono text-slate-400 pb-4 mb-4 border-t border-slate-800/80">
                <span>Tarif d'entrée :</span>
                <span class="text-white font-bold">{tool.starting_price}</span>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <a 
                  href={`/reviews/${tool.slug}`}
                  class="py-2.5 px-3 rounded-xl bg-slate-800/70 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-medium text-center border border-slate-700 transition-all"
                >
                  Audit
                </a>
                <a 
                  href={`/go/${tool.slug}`}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  class="py-2.5 px-3 rounded-xl bg-gradient-to-r from-cyan-500 to-fuchsia-500 hover:from-cyan-400 hover:to-fuchsia-400 text-slate-950 text-xs font-black font-mono text-center shadow-md transition-all flex items-center justify-center gap-1 hover:scale-[1.02]"
                >
                  Accéder ↗
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Why Trust HeliaTech: Institutional Standards (Stealth Mode) -->
    <section class="mb-24 p-8 sm:p-14 rounded-3xl bg-slate-900/40 border border-slate-800 backdrop-blur-2xl">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2">CHARTE MÉTHODOLOGIQUE</span>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight mb-4">
          L'Impartialité comme Unique Boussole.
        </h2>
        <p class="text-slate-400 text-sm leading-relaxed font-light">
          Dans un écosystème pollué par les comparateurs affiliés complaisants et les faux classements sponsorisés, HeliaTech garantit une rigueur technique absolue.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-slate-950/70 border border-slate-800">
          <div class="text-2xl mb-3">🧪</div>
          <h3 class="text-base font-bold text-white mb-2">Bancs d'Essai Synthétiques</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            Chaque plateforme est soumise à des tests de charge continus mesurant les temps de réponse API, les latences de routage et le comportement en cas de pic de trafic.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-950/70 border border-slate-800">
          <div class="text-2xl mb-3">⚖️</div>
          <h3 class="text-base font-bold text-white mb-2">Zéro Position Achetée</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            Aucun éditeur de logiciel ne peut acheter son rang ou modifier les verdicts de nos teardowns. Seule la supériorité technique et le ratio valeur/coût déterminent notre sélection.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-950/70 border border-slate-800">
          <div class="text-2xl mb-3">💼</div>
          <h3 class="text-base font-bold text-white mb-2">TCO Forensic</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            Nous disséquons les grilles tarifaires cachées, les surcoûts par palier d'opérations et les coûts réels de migration pour éliminer tout risque financier lors de vos choix.
          </p>
        </div>
      </div>
    </section>

    <!-- Latest Intelligence & Teardowns Feed -->
    <section class="mb-24">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-4 border-b border-slate-800">
        <div>
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-1">ANALYSES RÉCENTES</span>
          <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
            Derniers Dossiers & Masterclasses
          </h2>
        </div>
        <a href="/blog" class="text-xs font-mono text-slate-400 hover:text-cyan-400 transition-colors flex items-center gap-1">
          <span>Consulter toutes les publications ({blogPosts.length})</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {latestArticles.map((article: any) => (
          <a 
            href={`/blog/${article.slug}`}
            class="p-6 rounded-3xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-all duration-300 group flex flex-col justify-between backdrop-blur-xl"
          >
            <div>
              <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 mb-3">
                <span>{new Date(article.data.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                <span class="text-cyan-400 uppercase font-bold">{article.data.category || 'Tech Guide'}</span>
              </div>
              <h3 class="text-base font-bold text-white mb-3 group-hover:text-cyan-300 transition-colors line-clamp-2">
                {article.data.title}
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed font-light line-clamp-3 mb-6">
                {article.data.excerpt || article.data.description}
              </p>
            </div>
            <div class="text-xs font-mono text-cyan-400 font-bold flex items-center gap-1">
              <span>Lire le teardown</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Lead Capture Section: The Confidential Intelligence Dispatch -->
    <section class="p-8 sm:p-14 rounded-3xl bg-gradient-to-br from-indigo-950/40 via-slate-900/90 to-slate-950 border border-cyan-500/40 text-center relative overflow-hidden shadow-2xl mb-24">
      <div class="max-w-2xl mx-auto">
        <span class="text-xs font-mono text-cyan-300 uppercase tracking-widest block mb-3">DISPATCH EXÉCUTIF HEBDOMADAIRE</span>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
          Recevez les Rapports Confidentiels HeliaTech
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed mb-8 font-light">
          Chaque mardi matin, rejoignez plus de <strong class="text-white">4 200 CTOs et fondateurs</strong> qui reçoivent nos benchmarks de latence réels, les fuites tarifaires d'éditeurs et les alertes de nouveaux outils accrédités.
        </p>

        <!-- Newsletter Form -->
        <form id="home-newsletter-form" class="flex flex-col sm:flex-row items-center gap-3 max-w-lg mx-auto">
          <input 
            type="email" 
            id="home-lead-email"
            required
            placeholder="votre.email.pro@entreprise.com" 
            class="w-full px-5 py-4 rounded-2xl bg-slate-950 border border-slate-700 text-white placeholder-slate-500 text-sm font-sans focus:outline-none focus:border-cyan-400 transition-colors"
          />
          <button 
            type="submit" 
            id="home-lead-btn"
            class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-gradient-to-r from-cyan-400 to-sky-400 hover:from-cyan-300 hover:to-sky-300 text-slate-950 font-black text-xs font-mono uppercase tracking-wider shadow-lg shadow-cyan-500/20 transition-all hover:scale-[1.02] cursor-pointer whitespace-nowrap"
          >
            S'abonner Gratuitement ➔
          </button>
        </form>

        <div id="home-success-msg" class="hidden mt-4 p-4 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 font-mono text-xs">
          ✓ Inscription confirmée. Bienvenue parmi les décideurs tech accrédités !
        </div>

        <div class="mt-4 flex items-center justify-center gap-4 text-[11px] font-mono text-slate-500">
          <span>🔒 Respect strict des données</span>
          <span>•</span>
          <span>Désinscription 1-clic</span>
          <span>•</span>
          <span>0% spam</span>
        </div>
      </div>
    </section>

    <!-- Partner Ingestion Portal Callout Banner -->
    <section class="p-8 sm:p-10 rounded-3xl bg-slate-900/60 border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="max-w-xl">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-1">PROGRAMME ÉDITEURS</span>
        <h3 class="text-xl sm:text-2xl font-bold text-white mb-2">
          Vous développez une application logicielle B2B ?
        </h3>
        <p class="text-xs sm:text-sm text-slate-400 font-light leading-relaxed">
          Soumettez votre plateforme pour un audit d'accréditation. Rejoignez le Radar HeliaTech et présentez votre solution auprès de notre audience d'acheteurs tech qualifiés.
        </p>
      </div>
      <a 
        href="/partner"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl font-mono text-xs font-bold text-center bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 transition-all hover:scale-105 whitespace-nowrap"
      >
        Soumettre Votre Logiciel ➔
      </a>
    </section>

  </div>

  <script is:inline>
    (function() {
      const form = document.getElementById('home-newsletter-form');
      const btn = document.getElementById('home-lead-btn');
      const success = document.getElementById('home-success-msg');

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const email = document.getElementById('home-lead-email')?.value || '';
          
          try {
            const list = JSON.parse(localStorage.getItem('_ht_home_subscribers') || '[]');
            list.push({ email, timestamp: new Date().toISOString() });
            localStorage.setItem('_ht_home_subscribers', JSON.stringify(list));
          } catch(err) {}

          if (btn) {
            btn.textContent = '✓ Inscrit';
            btn.classList.add('opacity-50', 'pointer-events-none');
          }
          if (success) {
            success.classList.remove('hidden');
          }
          form.reset();
        });
      }
    })();
  </script>
</Layout>
