---
import Layout from '../layouts/Layout.astro';
import toolsData from '../data/tools-index.json';

// Unique categories
const categories = ["All Systems", ...Array.from(new Set(toolsData.map((t: any) => t.category)))];
---

<Layout title="Next-Gen Autonomous Software Intelligence">
  <!-- Hero Section (Spacious, Titanium Champagne Apple Aesthetic) -->
  <section class="relative pt-24 pb-20 px-6 sm:px-8 max-w-6xl mx-auto text-center">
    <!-- Titanium Gold Pill Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/[0.03] border border-champagne-400/20 backdrop-blur-xl mb-8 shadow-inner-gold hover:border-champagne-300/40 transition-all duration-300">
      <span class="w-2 h-2 rounded-full bg-champagne-400 animate-pulse"></span>
      <span class="text-xs font-mono font-medium tracking-widest uppercase text-transparent bg-clip-text bg-gradient-to-r from-champagne-200 via-white to-gold-pure">
        TITANIUM RADAR ENGINE 2026
      </span>
    </div>

    <!-- Monumental Titanium Typography -->
    <h1 class="text-5xl sm:text-7xl lg:text-8xl font-black tracking-tight text-white mb-8 leading-[1.08]">
      The Software <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-b from-white via-champagne-100 to-champagne-300">
        Intelligence Layer.
      </span>
    </h1>

    <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-12 font-light leading-relaxed">
      Continuous, unbiased technical teardowns and pricing forensics curated daily by autonomous AI agents. Zero human sales bias.
    </p>

    <!-- Spatial Floating Search Console with Warm Gold Aura -->
    <div class="max-w-2xl mx-auto relative mb-12 group">
      <div class="absolute -inset-1 bg-gradient-to-r from-champagne-400/20 via-amber-500/20 to-gold-bronze/20 rounded-3xl blur-xl opacity-60 group-hover:opacity-100 transition duration-700 pointer-events-none"></div>
      
      <div class="relative flex items-center backdrop-blur-2xl bg-titanium-900/80 border border-white/[0.12] rounded-2xl shadow-2xl overflow-hidden p-2 group-hover:border-champagne-300/30 transition-all">
        <div class="pl-4 pr-3 text-champagne-300">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input 
          type="text" 
          id="search-input"
          placeholder="Filter ecosystems, APIs, CRM, workflows, automation..." 
          class="w-full py-3 bg-transparent text-white placeholder-slate-500 text-sm focus:outline-none font-normal"
        />
        <div class="hidden sm:flex items-center gap-1 bg-white/[0.05] border border-champagne-400/20 px-2.5 py-1 rounded-lg mr-2">
          <span class="text-[10px] font-mono text-champagne-200">⌘K</span>
        </div>
      </div>
    </div>

    <!-- Spatial Category Pills -->
    <div class="flex flex-wrap justify-center gap-2 max-w-3xl mx-auto mb-16" id="category-filters">
      {categories.map((cat, idx) => (
        <button 
          data-category={cat}
          class={`px-4 py-2 rounded-full text-xs font-medium tracking-wide transition-all duration-300 ${
            idx === 0 
              ? 'bg-gradient-to-r from-champagne-200 via-gold-pure to-gold-bronze text-titanium-950 font-bold shadow-glow-gold scale-105' 
              : 'bg-white/[0.03] text-slate-400 hover:text-white hover:bg-white/[0.08] border border-white/[0.06]'
          }`}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Live Telemetry Matrix -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] backdrop-blur-md">
      <div class="p-3 text-center">
        <span class="block text-2xl font-black text-white font-mono">100%</span>
        <span class="text-[11px] font-mono text-slate-500 uppercase tracking-wider">Autonomous</span>
      </div>
      <div class="p-3 text-center border-l border-white/[0.06]">
        <span class="block text-2xl font-black text-champagne-300 font-mono">0.00s</span>
        <span class="text-[11px] font-mono text-slate-500 uppercase tracking-wider">Edge Latency</span>
      </div>
      <div class="p-3 text-center border-l border-white/[0.06]">
        <span class="block text-2xl font-black text-white font-mono">24/7</span>
        <span class="text-[11px] font-mono text-slate-500 uppercase tracking-wider">Radar Scans</span>
      </div>
      <div class="p-3 text-center border-l border-white/[0.06]">
        <span class="block text-2xl font-black text-gold-pure font-mono">Gemini 3.8</span>
        <span class="text-[11px] font-mono text-slate-500 uppercase tracking-wider">AI Reasoning</span>
      </div>
    </div>
  </section>

  <!-- Software Teardown Matrix Section -->
  <section class="max-w-6xl mx-auto px-6 lg:px-8 py-10" id="categories">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-6 border-b border-white/[0.06]">
      <div>
        <span class="text-xs font-mono text-champagne-300 uppercase tracking-widest block mb-1">LIVE REPOSITORY</span>
        <h2 class="text-3xl font-black text-white tracking-tight">Active Software Matrix</h2>
      </div>
      <div class="text-xs font-mono text-slate-400">
        TELEMETRY: <span id="tool-count" class="text-champagne-200 font-bold">{toolsData.length}</span> SYSTEMS VERIFIED
      </div>
    </div>

    <!-- Spatial Glass Bento Grid with Gold Accents -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="tools-grid">
      {toolsData.map((tool: any) => (
        <div 
          class="tool-card group relative rounded-3xl p-7 bg-white/[0.02] hover:bg-white/[0.05] border border-white/[0.08] hover:border-champagne-400/40 backdrop-blur-xl transition-all duration-500 flex flex-col justify-between hover:shadow-glow-gold hover:-translate-y-1.5 overflow-hidden"
          data-name={tool.name.toLowerCase()}
          data-category={tool.category}
          data-tagline={tool.tagline.toLowerCase()}
        >
          <!-- Subtle Top Gold Shine -->
          <div class="absolute -top-12 -right-12 w-32 h-32 bg-champagne-400/10 rounded-full blur-2xl group-hover:bg-champagne-400/20 transition-all duration-500 pointer-events-none"></div>

          <div>
            <!-- Header Row -->
            <div class="flex items-start justify-between gap-3 mb-5">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-mono font-medium bg-white/[0.04] text-champagne-200 border border-white/[0.08]">
                {tool.category}
              </span>

              <div class="flex items-center gap-1.5 bg-champagne-400/[0.08] text-champagne-300 border border-champagne-400/20 px-2.5 py-1 rounded-full text-xs font-mono font-bold">
                <span>★</span>
                <span>{tool.rating.toFixed(1)}</span>
              </div>
            </div>

            <!-- Title & Tagline -->
            <h3 class="text-2xl font-black text-white mb-3 group-hover:text-champagne-200 transition-colors tracking-tight">
              {tool.name}
            </h3>

            <p class="text-slate-400 text-xs sm:text-sm line-clamp-2 mb-6 font-normal leading-relaxed">
              {tool.tagline}
            </p>

            <!-- Specs / Pricing Tag -->
            <div class="bg-titanium-950/70 rounded-2xl p-3.5 mb-6 border border-white/[0.06] flex items-center justify-between">
              <span class="text-slate-500 text-[11px] font-mono uppercase tracking-wider">Entry Tier:</span>
              <span class="text-emerald-400 font-mono font-bold text-xs">{tool.starting_price}</span>
            </div>
          </div>

          <!-- Bottom Action Buttons -->
          <div class="grid grid-cols-2 gap-3 pt-4 border-t border-white/[0.06]">
            <a 
              href={`/reviews/${tool.slug}`} 
              class="text-center py-3 px-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.1] text-slate-200 hover:text-white font-medium text-xs transition-all border border-white/[0.06]"
            >
              Teardown
            </a>
            <a 
              href={`/go/${tool.slug}`} 
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="text-center py-3 px-3 rounded-xl bg-gradient-to-r from-champagne-200 via-gold-pure to-gold-bronze hover:from-champagne-100 hover:to-gold-pure text-titanium-950 font-bold text-xs shadow-md shadow-amber-500/10 transition-all flex items-center justify-center gap-1 hover:scale-[1.02]"
            >
              Access Tool ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Autonomous Engine Architecture Showcase Section -->
  <section class="max-w-6xl mx-auto px-6 lg:px-8 py-24" id="engine">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-mono text-champagne-300 uppercase tracking-widest block mb-2">UNDER THE HOOD</span>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight mb-4">
        Zero Human Touch. <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-champagne-200 via-white to-gold-pure">
          Powered by 3 Senior Agents.
        </span>
      </h2>
      <p class="text-slate-400 text-sm leading-relaxed">
        How this platform publishes, monitors, and evaluates enterprise software autonomously on a daily schedule.
      </p>
    </div>

    <!-- 3-Column Bento Pipeline -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Agent 1 -->
      <div class="p-8 rounded-3xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-xl relative overflow-hidden">
        <div class="w-10 h-10 rounded-2xl bg-champagne-400/10 border border-champagne-400/20 text-champagne-300 flex items-center justify-center font-mono font-bold mb-6">
          01
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Agent 1: Market Radar</h3>
        <p class="text-xs text-slate-400 leading-relaxed mb-4">
          Continuously scans high-volume B2B search intents, pricing searches, and partner networks to identify high-potential enterprise software.
        </p>
        <span class="text-[10px] font-mono text-champagne-300 bg-champagne-400/10 px-2.5 py-1 rounded-full">
          Intent Discovery
        </span>
      </div>

      <!-- Agent 2 -->
      <div class="p-8 rounded-3xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-xl relative overflow-hidden">
        <div class="w-10 h-10 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-300 flex items-center justify-center font-mono font-bold mb-6">
          02
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Agent 2: Technical Analyst</h3>
        <p class="text-xs text-slate-400 leading-relaxed mb-4">
          Powered by Gemini 3.8 Flash. Analyzes feature depth, authentic weaknesses, pricing anomalies, and synthesizes Google FAQ schemas.
        </p>
        <span class="text-[10px] font-mono text-amber-300 bg-amber-500/10 px-2.5 py-1 rounded-full">
          Gemini Reasoning
        </span>
      </div>

      <!-- Agent 3 -->
      <div class="p-8 rounded-3xl bg-white/[0.02] border border-white/[0.08] backdrop-blur-xl relative overflow-hidden">
        <div class="w-10 h-10 rounded-2xl bg-gold-bronze/15 border border-gold-bronze/30 text-champagne-200 flex items-center justify-center font-mono font-bold mb-6">
          03
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Agent 3: Publisher & Edge CDN</h3>
        <p class="text-xs text-slate-400 leading-relaxed mb-4">
          Generates Astro Content Collections, executes automated Git commits, and triggers zero-downtime edge deployments to global CDNs.
        </p>
        <span class="text-[10px] font-mono text-champagne-200 bg-gold-pure/10 px-2.5 py-1 rounded-full">
          Astro Static Edge
        </span>
      </div>
    </div>
  </section>

  <!-- Interactive Search / Filter Controller -->
  <script>
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const filterButtons = document.querySelectorAll('#category-filters button');
    const cards = document.querySelectorAll('.tool-card') as NodeListOf<HTMLElement>;
    const countSpan = document.getElementById('tool-count');

    let activeCategory = 'All Systems';

    function filterTools() {
      const query = (searchInput?.value || '').toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach(card => {
        const name = card.dataset.name || '';
        const category = card.dataset.category || '';
        const tagline = card.dataset.tagline || '';

        const matchesSearch = !query || name.includes(query) || tagline.includes(query) || category.toLowerCase().includes(query);
        const matchesCategory = activeCategory === 'All Systems' || category === activeCategory;

        if (matchesSearch && matchesCategory) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countSpan) countSpan.textContent = visibleCount.toString();
    }

    searchInput?.addEventListener('input', filterTools);

    // Keyboard shortcut (Cmd+K / Ctrl+K)
    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        searchInput?.focus();
      }
    });

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.className = 'px-4 py-2 rounded-full text-xs font-medium tracking-wide transition-all duration-300 bg-white/[0.03] text-slate-400 hover:text-white hover:bg-white/[0.08] border border-white/[0.06]';
        });
        btn.className = 'px-4 py-2 rounded-full text-xs font-bold tracking-wide transition-all duration-300 bg-gradient-to-r from-champagne-200 via-gold-pure to-gold-bronze text-titanium-950 shadow-glow-gold scale-105';
        activeCategory = btn.getAttribute('data-category') || 'All Systems';
        filterTools();
      });
    });
  </script>
</Layout>
