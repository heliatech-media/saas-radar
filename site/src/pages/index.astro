---
import Layout from '../layouts/Layout.astro';
import ToolIcon from '../components/ToolIcon.astro';
import toolsData from '../data/tools-index.json';
import { getCollection } from 'astro:content';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "HeliaTech | Independent SaaS & AI Benchmark Observatory 2026",
      "url": "https://heliatech.online/",
      "description": "The definitive independent software observatory. Auditing, benchmarking, and curating the world's most performant SaaS and AI architectures.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://heliatech.online/radar/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "name": "HeliaTech",
      "url": "https://heliatech.online/",
      "logo": "https://heliatech.online/favicon.svg"
    }
  ]
};

// Curated Showcase Selection (Top 6 Premier Accredited Platforms)
const showcaseSlugs = ["make", "apollo-io", "elevenlabs", "supabase", "clickup", "beehiiv"];
const showcaseTools = showcaseSlugs.map(s => toolsData.find((t: any) => t.slug === s)).filter(Boolean);

// Latest Blog Articles for Intelligence Feed
const blogPosts = await getCollection('blog');
const latestArticles = blogPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<Layout 
  title="HeliaTech | Independent SaaS & AI Benchmark Observatory 2026"
  description="The definitive software observatory: discover top modern architectures, eliminate up to 65% in SaaS bloat, and access uncompromising technical benchmarks."
  jsonLd={jsonLd}
>
  <!-- Subtle Top Ambient Illumination -->
  <div class="absolute top-16 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-sky-500/[0.04] blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-6xl mx-auto px-6 sm:px-8 pt-12 sm:pt-20 pb-24">

    <!-- Hero Section: High-Converting Flagship Value Proposition -->
    <section class="text-center max-w-4xl mx-auto mb-20 sm:mb-28">
      
      <!-- Trust Accreditation Pill -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-obsidian-800 border border-white/[0.08] text-xs font-mono mb-8">
        <span class="w-2 h-2 rounded-full bg-cobalt-400"></span>
        <span class="text-slate-300 font-medium">INDEPENDENT SOFTWARE OBSERVATORY</span>
        <span class="text-slate-600">|</span>
        <span class="text-cobalt-400 font-bold">SENTINEL™ v2.4</span>
      </div>

      <!-- Main Catchphrase -->
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold text-white tracking-tight leading-[1.12] mb-8 font-heading">
        Stop Overpaying For Legacy Software. <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-100 to-sky-400">
          The Independent Observatory For Modern SaaS.
        </span>
      </h1>

      <!-- Subtitle Description -->
      <p class="text-base sm:text-xl text-slate-300 font-light leading-relaxed max-w-3xl mx-auto mb-10">
        HeliaTech continuously audits, benchmarks, and certifies the world's highest-leverage software architectures. Eliminate up to <strong class="text-white font-medium">65% in wasted SaaS overhead</strong>, decommission bloated suites, and accelerate net margins.
      </p>

      <!-- Institutional Proof Metrics Bar -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto mb-10 text-left">
        <div class="p-4 rounded-xl bg-obsidian-800 border border-white/[0.08] backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-white font-mono">70+</div>
          <div class="text-xs text-slate-300 mt-1 font-medium">Monitored Systems</div>
          <div class="text-[10px] text-slate-500 font-mono mt-0.5">Verified B2B perimeter</div>
        </div>
        <div class="p-4 rounded-xl bg-obsidian-800 border border-white/[0.08] backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono">-$14.8k</div>
          <div class="text-xs text-slate-300 mt-1 font-medium">Avg. Annual Savings</div>
          <div class="text-[10px] text-slate-500 font-mono mt-0.5">Sample of 140 teams</div>
        </div>
        <div class="p-4 rounded-xl bg-obsidian-800 border border-white/[0.08] backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-sky-400 font-mono">Sub-150ms</div>
          <div class="text-xs text-slate-300 mt-1 font-medium">Synthetic Latency</div>
          <div class="text-[10px] text-slate-500 font-mono mt-0.5">Cloudflare Workers global</div>
        </div>
        <div class="p-4 rounded-xl bg-obsidian-800 border border-white/[0.08] backdrop-blur-xl">
          <div class="text-2xl sm:text-3xl font-black text-white font-mono">100%</div>
          <div class="text-xs text-slate-300 mt-1 font-medium">Unbiased Audits</div>
          <div class="text-[10px] text-slate-500 font-mono mt-0.5">Audited affiliate firewall</div>
        </div>
      </div>

      <!-- Hero Call-To-Action Buttons (WCAG 2.2 AA compliant, min 44px touch targets) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a 
          href="/radar"
          class="w-full sm:w-auto min-h-[44px] px-8 py-3.5 rounded-xl bg-cobalt-600 hover:bg-cobalt-500 text-white font-medium text-sm tracking-wide transition-all shadow-sm flex items-center justify-center gap-2"
        >
          <span>Explore 2026 Radar</span>
          <span class="font-mono text-xs">➔</span>
        </a>
        <a 
          href="/calculator"
          class="w-full sm:w-auto min-h-[44px] px-8 py-3.5 rounded-xl bg-obsidian-800 hover:bg-obsidian-700 text-slate-200 hover:text-white font-mono text-sm border border-white/[0.1] hover:border-white/[0.2] transition-all flex items-center justify-center gap-2"
        >
          <span>Calculate Your Savings</span>
          <span class="font-mono text-xs">→</span>
        </a>
      </div>

    </section>

    <!-- The 4 Core Pillars Bento Grid Section -->
    <section class="mb-24 cv-auto">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2">HELIATECH INTELLIGENCE SUITE</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-normal leading-tight">
          Engineered For Modern Tech Decision-Makers
        </h2>
        <p class="text-slate-400 text-sm mt-3">
          Everything your organization needs to audit, compare, and deploy high-performance software architectures without budget guesswork.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Pillar 1: The Radar -->
        <a 
          href="/radar"
          class="spotlight-card p-8 sm:p-10 rounded-2xl bg-obsidian-800 border border-white/[0.08] hover:border-cobalt-500/40 transition-all duration-300 group backdrop-blur-xl relative overflow-hidden flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="px-2.5 py-1 rounded-md bg-cobalt-600/10 border border-cobalt-500/25 text-cobalt-400 text-xs font-mono font-bold tracking-wider">
                MODULE 01
              </span>
              <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">
                INTERACTIVE DIRECTORY
              </span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-sky-300 transition-colors tracking-normal font-heading">
              The 2026 Software Radar
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed font-light mb-6">
              Access the complete matrix of 70+ evaluated architectures. Filter by category, inspect transparent pricing, and read our forensic architectural teardowns.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-mono text-cobalt-400 font-bold group-hover:translate-x-1 transition-transform">
            <span>Explore Active Matrix</span>
            <span>→</span>
          </div>
        </a>

        <!-- Pillar 2: TCO Calculator -->
        <a 
          href="/calculator"
          class="spotlight-card p-8 sm:p-10 rounded-2xl bg-obsidian-800 border border-white/[0.08] hover:border-cobalt-500/40 transition-all duration-300 group backdrop-blur-xl relative overflow-hidden flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-mono font-bold tracking-wider">
                MODULE 02
              </span>
              <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">
                REAL-TIME SIMULATOR
              </span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-emerald-300 transition-colors tracking-normal font-heading">
              SaaS Waste & TCO Optimizer
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed font-light mb-6">
              Adjust monthly task volumes and team headcount to instantly quantify recoverable capital lost to bloated, redundant legacy subscriptions.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-mono text-emerald-400 font-bold group-hover:translate-x-1 transition-transform">
            <span>Run TCO Simulation</span>
            <span>→</span>
          </div>
        </a>

        <!-- Pillar 3: Versus Arena -->
        <a 
          href="/versus"
          class="spotlight-card p-8 sm:p-10 rounded-2xl bg-obsidian-800 border border-white/[0.08] hover:border-cobalt-500/40 transition-all duration-300 group backdrop-blur-xl relative overflow-hidden flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="px-2.5 py-1 rounded-md bg-sky-500/10 border border-sky-500/25 text-sky-400 text-xs font-mono font-bold tracking-wider">
                MODULE 03
              </span>
              <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">
                1V1 FORENSIC DUELS
              </span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-sky-300 transition-colors tracking-normal font-heading">
              Comparative Versus Arena
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed font-light mb-6">
              Make vs Zapier, ClickUp vs Monday, Apollo vs Lusha, ElevenLabs vs HeyGen. Head-to-head engineering showdowns evaluating real latency and scaling economics.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-mono text-sky-400 font-bold group-hover:translate-x-1 transition-transform">
            <span>Review Verified Duels</span>
            <span>→</span>
          </div>
        </a>

        <!-- Pillar 4: Deals & Perks -->
        <a 
          href="/deals"
          class="spotlight-card p-8 sm:p-10 rounded-2xl bg-obsidian-800 border border-white/[0.08] hover:border-cobalt-500/40 transition-all duration-300 group backdrop-blur-xl relative overflow-hidden flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="px-2.5 py-1 rounded-md bg-white/[0.06] border border-white/[0.1] text-slate-300 text-xs font-mono font-bold tracking-wider">
                MODULE 04
              </span>
              <span class="text-xs font-mono font-bold text-slate-400 uppercase tracking-wider">
                ENTERPRISE TERMS
              </span>
            </div>
            <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-slate-200 transition-colors tracking-normal font-heading">
              Verified Enterprise Terms Vault
            </h3>
            <p class="text-sm text-slate-400 leading-relaxed font-light mb-6">
              Claim verified partner privileges with top software vendors: free API operations, credits, and audited extended trials without hidden fees.
            </p>
          </div>
          <div class="flex items-center gap-2 text-xs font-mono text-slate-300 font-bold group-hover:translate-x-1 transition-transform">
            <span>Access Verified Terms</span>
            <span>→</span>
          </div>
        </a>

      </div>
    </section>

    <!-- Curated Showcase: 6 Premier Accredited Platforms -->
    <section class="mb-24 cv-auto">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-4 border-b border-slate-800">
        <div>
          <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2 font-bold flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            <span>RADAR ELITE</span>
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-normal leading-tight">
            Premier Accredited Platforms
          </h2>
        </div>
        <a href="/radar" class="text-xs font-mono text-slate-400 hover:text-cyan-400 transition-colors flex items-center gap-1">
          <span>View all 70+ evaluated architectures</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {showcaseTools.map((tool: any) => (
          <div class="p-6 rounded-2xl bg-obsidian-800 border border-white/[0.08] hover:border-cobalt-500/40 transition-all duration-300 flex flex-col justify-between group backdrop-blur-xl">
            <div>
              <div class="flex items-start justify-between gap-3 mb-4">
                <div class="flex items-center gap-3 min-w-0">
                  <ToolIcon slug={tool.slug} name={tool.name} size="md" className="shrink-0 group-hover:scale-105 transition-transform" />
                  <div class="min-w-0">
                    <h3 class="font-bold text-white text-base group-hover:text-sky-300 transition-colors truncate font-heading">
                      {tool.name}
                    </h3>
                    <span class="text-[11px] font-mono text-slate-400 block truncate">{tool.category}</span>
                  </div>
                </div>
                <div class="shrink-0 flex items-center gap-1 px-2.5 py-1 rounded-full bg-white/[0.04] border border-white/[0.08] text-sky-400 font-mono text-xs font-bold whitespace-nowrap">
                  <span class="text-amber-400">★</span>
                  <span>{tool.rating}</span>
                </div>
              </div>

              <p class="text-xs text-slate-300 leading-relaxed font-light mb-6 line-clamp-3">
                {tool.tagline}
              </p>
            </div>

            <div>
              <div class="flex items-center justify-between text-xs font-mono text-slate-400 pb-4 mb-4 border-t border-white/[0.06]">
                <span>Starting plan:</span>
                <span class="text-white font-bold">{tool.starting_price}</span>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <a 
                  href={`/reviews/${tool.slug}`}
                  class="min-h-[44px] py-2.5 px-3 rounded-xl bg-obsidian-900 hover:bg-obsidian-700 text-slate-300 hover:text-white text-xs font-medium text-center border border-white/[0.1] transition-all flex items-center justify-center"
                >
                  Teardown
                </a>
                <a 
                  href={`/go/${tool.slug}`}
                  target="_blank"
                  rel="noopener noreferrer sponsored"
                  class="min-h-[44px] py-2.5 px-3 rounded-xl bg-cobalt-600 hover:bg-cobalt-500 text-white text-xs font-medium font-mono text-center transition-all flex items-center justify-center gap-1"
                >
                  Access Tool ↗
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Why Trust HeliaTech: Institutional Standards (Stealth Mode) -->
    <section class="mb-24 p-8 sm:p-14 rounded-2xl bg-obsidian-800 border border-white/[0.08] backdrop-blur-2xl cv-auto">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-mono text-cobalt-400 uppercase tracking-widest block mb-2 font-medium">METHODOLOGY CHARTER</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-normal leading-tight mb-4 font-heading">
          Uncompromising Technical Truth.
        </h2>
        <p class="text-slate-400 text-sm leading-relaxed font-light">
          In an ecosystem polluted by superficial affiliate lists and pay-for-play rankings, HeliaTech operates on strict, verifiable engineering standards.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-xl bg-obsidian-900 border border-white/[0.06]">
          <div class="text-xs font-mono text-cobalt-400 font-bold mb-3">[ PILLAR 01 ]</div>
          <h3 class="text-base font-bold text-white mb-2 font-heading">Synthetic Benchmark Labs</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            Every platform undergoes continuous load testing evaluating API latency, edge payload delivery, and rate-limit resilience under peak enterprise traffic.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-obsidian-900 border border-white/[0.06]">
          <div class="text-xs font-mono text-cobalt-400 font-bold mb-3">[ PILLAR 02 ]</div>
          <h3 class="text-base font-bold text-white mb-2 font-heading">Zero Paid Placements</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            No software vendor can purchase ranking positions or alter audit verdicts. Architectural elegance, reliability, and unit economics dictate inclusion.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-obsidian-900 border border-white/[0.06]">
          <div class="text-xs font-mono text-cobalt-400 font-bold mb-3">[ PILLAR 03 ]</div>
          <h3 class="text-base font-bold text-white mb-2 font-heading">Forensic TCO Audits</h3>
          <p class="text-xs text-slate-400 leading-relaxed font-light">
            We dissect opaque pricing matrices, sudden per-operation price jumps, and migration lock-in to safeguard your engineering runway.
          </p>
        </div>
      </div>
    </section>

    <!-- Latest Intelligence & Teardowns Feed -->
    <section class="mb-24 cv-auto">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-4 border-b border-white/[0.08]">
        <div>
          <span class="text-xs font-mono text-cobalt-400 uppercase tracking-widest block mb-1">FORENSIC REPORTS</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-normal leading-tight font-heading">
            Latest Teardowns & Masterclasses
          </h2>
        </div>
        <a href="/blog" class="text-xs font-mono text-slate-400 hover:text-sky-400 transition-colors flex items-center gap-1">
          <span>View all publications ({blogPosts.length})</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {latestArticles.map((article: any) => (
          <a 
            href={`/blog/${article.slug}`}
            class="p-6 rounded-2xl bg-obsidian-800 border border-white/[0.08] hover:border-cobalt-500/40 transition-all duration-300 group flex flex-col justify-between backdrop-blur-xl"
          >
            <div>
              <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 mb-3">
                <span>{new Date(article.data.date).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' })}</span>
                <span class="text-sky-400 uppercase font-bold">{article.data.category || 'Tech Guide'}</span>
              </div>
              <h3 class="text-base font-bold text-white mb-3 group-hover:text-sky-300 transition-colors line-clamp-2 font-heading">
                {article.data.title}
              </h3>
              <p class="text-xs text-slate-400 leading-relaxed font-light line-clamp-3 mb-6">
                {article.data.excerpt || article.data.description}
              </p>
            </div>
            <div class="text-xs font-mono text-cobalt-400 font-bold flex items-center gap-1">
              <span>Read teardown</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Lead Capture Section: The Confidential Intelligence Dispatch -->
    <section class="p-8 sm:p-14 rounded-2xl bg-obsidian-800 border border-white/[0.08] text-center relative overflow-hidden shadow-2xl mb-24 cv-auto">
      <div class="max-w-2xl mx-auto">
        <span class="text-xs font-mono text-cobalt-400 uppercase tracking-widest block mb-3 font-medium">WEEKLY EXECUTIVE DISPATCH</span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-normal leading-tight mb-4 font-heading">
          Receive Confidential HeliaTech Reports
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed mb-8 font-light">
          Every Thursday at 9:00 AM EST (15:00 CET), join <strong class="text-white">4,200+ CTOs and engineering leaders</strong> receiving verified latency benchmarks, vendor pricing leaks, and architectural teardowns.
        </p>

        <!-- Newsletter Form -->
        <form id="home-newsletter-form" class="flex flex-col sm:flex-row items-center gap-3 max-w-lg mx-auto">
          <input 
            type="email" 
            id="home-lead-email"
            required
            placeholder="work.email@company.com" 
            class="w-full px-5 py-3.5 rounded-xl bg-obsidian-950 border border-white/[0.12] text-white placeholder-slate-500 text-sm font-sans focus:outline-none focus:border-cobalt-500 transition-colors min-h-[44px]"
          />
          <button 
            type="submit" 
            id="home-lead-btn"
            class="w-full sm:w-auto min-h-[44px] px-7 py-3.5 rounded-xl bg-cobalt-600 hover:bg-cobalt-500 text-white font-medium text-xs font-mono uppercase tracking-wider transition-all cursor-pointer whitespace-nowrap"
          >
            Get Free Dispatch ➔
          </button>
        </form>

        <div id="home-success-msg" class="hidden mt-4 p-4 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 font-mono text-xs" role="status" aria-live="polite"></div>

        <div class="mt-4 flex items-center justify-center gap-4 text-[11px] font-mono text-slate-500">
          <span>🔒 Strict privacy guarantee</span>
          <span>•</span>
          <span>1-click unsubscribe</span>
          <span>•</span>
          <span>Zero spam</span>
        </div>
      </div>
    </section>



  </div>

  <script is:inline>
    (function() {
      const form = document.getElementById('home-newsletter-form');
      const btn = document.getElementById('home-lead-btn');
      const success = document.getElementById('home-success-msg');

      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const email = (document.getElementById('home-lead-email')?.value || '').trim();
          if (!email) return;

          // 1. Dispatch to Cloudflare Backend API (fires Telegram + Resend VIP Welcome Email)
          try {
            fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                email: email,
                path: '/',
                referrer: document.referrer || 'Direct'
              }),
              keepalive: true
            }).catch(() => {});
          } catch(err) {}

          // 2. Direct Telegram Fallback Alert
          try {
            const leadMsg = 
              '⭐ NOUVEAU SUBSCRIBER B2B (HOMEPAGE) !\n' +
              '━━━━━━━━━━━━━━━━━━━━━━━━━━\n' +
              '📧 Email : ' + email + '\n' +
              '📄 Page : /\n' +
              '🔗 Source : ' + (document.referrer || 'Direct') + '\n' +
              '⏰ Heure : ' + new Date().toLocaleTimeString();

            fetch('/api/subscribe', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ email: email, path: '/', referrer: document.referrer || 'Direct' })
                }).catch(() => {});
          } catch(err) {}

          // 3. Local storage backup
          try {
            const list = JSON.parse(localStorage.getItem('_ht_home_subscribers') || '[]');
            list.push({ email, timestamp: new Date().toISOString() });
            localStorage.setItem('_ht_home_subscribers', JSON.stringify(list));
          } catch(err) {}

          if (btn) {
            btn.textContent = '✓ Subscribed';
            btn.classList.add('opacity-50', 'pointer-events-none');
          }
          if (success) {
            success.classList.remove('hidden');
          }
          form.reset();
        });
      }
    })();
  </script>
</Layout>
