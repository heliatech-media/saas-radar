---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Commande Confirmée & Licence Activée | HeliaTech Marketplace";
const pageDescription = "Votre paiement a été validé. Votre blueprint digital et votre clé de licence commerciale sont prêts au téléchargement.";
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 pt-12 pb-24">
    
    <!-- Top Success Pill -->
    <div class="text-center space-y-4 mb-10">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-emerald-500/10 border-2 border-emerald-500/40 text-4xl shadow-glow-emerald mx-auto mb-2 animate-bounce">
        ✓
      </div>
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-mono font-bold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Transaction Validée • 100% Anti-Scam Certifié
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Merci pour votre Achat !
      </h1>
      <p class="text-sm text-slate-300 font-light max-w-lg mx-auto leading-relaxed">
        Votre commande a été traitée avec succès. Votre licence commerciale illimitée a été émise et votre fichier d'ingénierie est prêt.
      </p>
    </div>

    <!-- License & Instant Download Box -->
    <div class="p-8 sm:p-10 rounded-3xl bg-slate-900/90 border border-emerald-500/40 shadow-2xl relative overflow-hidden space-y-6 mb-8">
      <div class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Order ID & License Key Row -->
      <div class="p-5 rounded-2xl bg-slate-950 border border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-3">
          <span class="text-xs font-mono text-slate-400">Numéro de Commande :</span>
          <span class="text-xs font-mono font-bold text-white" id="success-order-id">HLT-ORD-2026-9214</span>
        </div>

        <div>
          <span class="text-xs font-mono text-slate-400 block mb-1.5">Votre Clé de Licence Commerciale :</span>
          <div class="flex items-center gap-2">
            <input 
              type="text" 
              readonly 
              id="success-license-key" 
              value="HLT-LIC-PRO-8842-2026" 
              class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-cyan-500/40 text-cyan-300 text-xs font-mono font-bold focus:outline-none"
            />
            <button 
              id="btn-copy-license"
              class="px-4 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-mono font-bold transition-all whitespace-nowrap"
            >
              📋 Copier
            </button>
          </div>
        </div>
      </div>

      <!-- Instant Download Action Button -->
      <div class="space-y-3 pt-2 text-center">
        <a 
          id="btn-direct-download"
          href="/api/marketplace/buyer/download?slug=n8n-ai-lead-enricher-waterfall" 
          download 
          class="w-full py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider transition-all shadow-glow-emerald flex items-center justify-center gap-2"
        >
          <span>⬇️</span> Télécharger le Fichier .JSON Immédiatement
        </a>
        <p class="text-[11px] font-mono text-slate-400">
          * Le blueprint est également synchronisé à vie dans votre <a href="/dashboard/" class="text-cyan-400 hover:underline">Espace Client</a>.
        </p>
      </div>

      <!-- Security Reassurance -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-slate-800 text-[11px] font-mono text-slate-400 text-center">
        <div>✓ Scan Sentinel 100/100</div>
        <div>✓ Zéro Clé d'API Exfiltrée</div>
        <div>✓ Mises à jour gratuites à vie</div>
      </div>
    </div>

    <!-- Next Steps Navigation Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a 
        href="/dashboard/" 
        class="w-full sm:w-auto px-6 py-3 rounded-xl bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-200 border border-cyan-500/40 text-xs font-mono font-bold transition-all text-center"
      >
        Ouvrir mon Tableau de Bord Acheteur ➔
      </a>
      <a 
        href="/templates/" 
        class="w-full sm:w-auto px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 text-xs font-mono font-bold transition-all text-center"
      >
        Retourner à la Marketplace
      </a>
    </div>

  </div>

  <script is:inline>
    // Extract query parameters if present
    const urlParams = new URLSearchParams(window.location.search);
    const slug = urlParams.get('slug') || 'n8n-ai-lead-enricher-waterfall';
    const amount = urlParams.get('amount') || '49.00';
    const randomHex = Math.random().toString(36).substring(2, 6).toUpperCase();
    const orderNum = Math.floor(1000 + Math.random() * 9000);

    const orderId = `HLT-ORD-2026-${orderNum}`;
    const licenseKey = `HLT-LIC-${slug.substring(0, 3).toUpperCase()}-${randomHex}-2026`;

    const orderIdEl = document.getElementById('success-order-id');
    const licenseKeyEl = document.getElementById('success-license-key');
    const downloadBtn = document.getElementById('btn-direct-download');

    if (orderIdEl) orderIdEl.textContent = orderId;
    if (licenseKeyEl) licenseKeyEl.value = licenseKey;
    if (downloadBtn) downloadBtn.href = `/api/marketplace/buyer/download?slug=${slug}`;

    // Copy license key handler
    document.getElementById('btn-copy-license')?.addEventListener('click', () => {
      if (licenseKeyEl) {
        navigator.clipboard.writeText(licenseKeyEl.value);
        const btn = document.getElementById('btn-copy-license');
        btn.textContent = "✓ Copié !";
        setTimeout(() => { btn.textContent = "📋 Copier"; }, 2000);
      }
    });
  </script>
</Layout>
