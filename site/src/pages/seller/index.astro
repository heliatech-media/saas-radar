---
import Layout from '../../layouts/Layout.astro';
import templates from '../../data/templates_catalog.json';

const pageTitle = "Studio Créateur & Vendeur (80% Net) | HeliaTech";
const pageDescription = "Publiez vos blueprints n8n, Make, Supabase et AI Agents, suivez vos ventes en temps réel, gérez vos versions et recevez vos versements à 80% net.";

// Seller's existing templates from catalog (AutomateScale Studio)
const sellerBlueprints = templates.filter(t => t.creator?.slug === "automatescale-studio");
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-24">
    
    <!-- Top Seller Staging Banner -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 mb-8 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-mono gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse flex-shrink-0"></span>
        <span class="font-bold uppercase tracking-wider">Studio Vendeur Pro Certifié</span>
        <span class="text-emerald-400/70 hidden lg:inline">— Reversement garanti de 80% net sur chaque vente avec audit Sentinel automatique.</span>
      </div>
      <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
        <a href="/templates/" class="px-3 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 font-bold transition-all">
          Marketplace ➔
        </a>
        <a href="/dashboard/" class="px-3 py-1 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-200 border border-cyan-500/40 font-bold transition-all">
          Espace Acheteur ➔
        </a>
      </div>
    </div>

    <!-- Seller Header Card -->
    <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-slate-800 mb-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 shadow-2xl relative overflow-hidden">
      <div class="flex items-center gap-4 relative z-10">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-500 via-teal-600 to-cyan-600 p-0.5 shadow-glow-emerald flex-shrink-0">
          <img src="https://api.dicebear.com/7.x/identicon/svg?seed=AutomateScale" alt="AutomateScale" class="w-full h-full rounded-2xl object-cover bg-slate-950" />
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2.5 mb-1">
            <h1 class="text-xl sm:text-2xl font-black text-white">AutomateScale Studio</h1>
            <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold">
              ✓ Vendeur Partenaire 80% Net
            </span>
          </div>
          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 font-mono">
            <span>automatescale@heliatech.online</span>
            <span>•</span>
            <span class="text-cyan-400">IBAN SEPA •••• 4021 Vérifié</span>
          </div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-3 w-full lg:w-auto justify-end relative z-10">
        <button id="btn-open-wizard-top" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider transition-all shadow-glow-emerald flex items-center gap-1.5">
          <span>+</span> Nouveau Produit (Wizard)
        </button>
        <button id="btn-request-payout-top" class="px-4 py-2.5 rounded-xl bg-slate-950 hover:bg-slate-800 text-emerald-300 border border-emerald-500/30 font-mono text-xs font-bold transition-all">
          💸 Demander Versement ($1,472)
        </button>
      </div>
    </div>

    <!-- Seller Sub-Navigation Tabs Bar -->
    <div class="flex flex-wrap items-center gap-2 border-b border-slate-800 pb-4 mb-8">
      <button id="stab-overview" class="seller-nav-tab px-4 py-2.5 rounded-xl bg-emerald-500 text-slate-950 font-mono text-xs font-bold transition-all flex items-center gap-2 shadow-glow-emerald">
        <span>📊</span> Vue d'Ensemble
      </button>
      <button id="stab-products" class="seller-nav-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
        <span>📦</span> Mes Produits ({sellerBlueprints.length})
      </button>
      <button id="stab-wizard" class="seller-nav-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
        <span>⚡</span> Déposer un Template (Wizard 7 Étapes)
      </button>
      <button id="stab-sales" class="seller-nav-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
        <span>💰</span> Ventes &amp; Split 80/20
      </button>
      <button id="stab-coupons" class="seller-nav-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
        <span>🎟️</span> Codes Promo &amp; Réductions
      </button>
      <button id="stab-payouts" class="seller-nav-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
        <span>🏦</span> Versements &amp; Stripe Connect
      </button>
    </div>

    <!-- ========================================================================= -->
    <!-- 1. VUE D'ENSEMBLE (OVERVIEW) -->
    <!-- ========================================================================= -->
    <div id="spanel-overview" class="space-y-8">
      
      <!-- Key Financial Metrics Bar (80% Net) -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono mb-1">$5,566.40</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Revenus Nets Vendeur (80%)</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono mb-1">$1,472.00</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Solde Disponible Immédiat</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl sm:text-3xl font-black text-white font-mono mb-1">142</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Ventes Confirmées</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl sm:text-3xl font-black text-amber-400 font-mono mb-1">★ 4.95</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Note Moyenne Boutique</div>
        </div>
      </div>

      <!-- Sales Performance Chart (SVG Visualization) -->
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
          <div>
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <span>📈</span> Dynamique des Revenus Nets Hebdomadaires (Part 80%)
            </h2>
            <p class="text-xs text-slate-400 font-light mt-0.5">
              Croissance régulière tirée par les flux n8n d'enrichissement B2B.
            </p>
          </div>
          <div class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
            +38% vs mois précédent
          </div>
        </div>

        <!-- SVG Mini Bar Chart -->
        <div class="space-y-4">
          <div class="grid grid-cols-4 gap-4 items-end h-40 pt-4 px-4 bg-slate-900/40 rounded-2xl border border-slate-800/80">
            <div class="flex flex-col items-center gap-2 h-full justify-end">
              <span class="text-[11px] font-mono text-emerald-400 font-bold">$705</span>
              <div class="w-full bg-emerald-500/40 rounded-t-lg transition-all hover:bg-emerald-400" style="height: 42%;"></div>
              <span class="text-[10px] font-mono text-slate-400">Semaine 1</span>
            </div>
            <div class="flex flex-col items-center gap-2 h-full justify-end">
              <span class="text-[11px] font-mono text-emerald-400 font-bold">$940</span>
              <div class="w-full bg-emerald-500/60 rounded-t-lg transition-all hover:bg-emerald-400" style="height: 56%;"></div>
              <span class="text-[10px] font-mono text-slate-400">Semaine 2</span>
            </div>
            <div class="flex flex-col items-center gap-2 h-full justify-end">
              <span class="text-[11px] font-mono text-emerald-400 font-bold">$1,215</span>
              <div class="w-full bg-emerald-500/80 rounded-t-lg transition-all hover:bg-emerald-400" style="height: 72%;"></div>
              <span class="text-[10px] font-mono text-slate-400">Semaine 3</span>
            </div>
            <div class="flex flex-col items-center gap-2 h-full justify-end">
              <span class="text-[11px] font-mono text-emerald-400 font-bold">$1,646</span>
              <div class="w-full bg-emerald-400 rounded-t-lg transition-all shadow-glow-emerald" style="height: 98%;"></div>
              <span class="text-[10px] font-mono text-white font-bold">Semaine 4</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Sales Log Preview -->
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <div>
            <h2 class="text-lg font-bold text-white flex items-center gap-2">
              <span>⚡</span> Dernières Ventes Enregistrées (Split 80/20)
            </h2>
            <p class="text-xs text-slate-400 font-light mt-0.5">
              Chaque transaction crédite instantanément 80% de la valeur nette sur votre solde.
            </p>
          </div>
          <button id="btn-goto-sales" class="text-xs font-mono text-cyan-400 hover:underline">
            Voir tout l'historique ➔
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono">
            <thead>
              <tr class="border-b border-slate-800 text-slate-400">
                <th class="py-3 px-4 font-bold">Produit</th>
                <th class="py-3 px-4 font-bold">Acheteur</th>
                <th class="py-3 px-4 font-bold">Prix Brut</th>
                <th class="py-3 px-4 font-bold">Commission (20%)</th>
                <th class="py-3 px-4 font-bold text-emerald-400">Votre Part Nette (80%)</th>
                <th class="py-3 px-4 font-bold text-right">Statut</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80 text-slate-300">
              <tr>
                <td class="py-3 px-4 text-white font-bold">n8n AI Waterfall Lead Enrichment</td>
                <td class="py-3 px-4 text-slate-400">al***@heliatech.online</td>
                <td class="py-3 px-4">$49.00</td>
                <td class="py-3 px-4 text-slate-500">-$9.80</td>
                <td class="py-3 px-4 text-emerald-400 font-bold">+$39.20</td>
                <td class="py-3 px-4 text-right"><span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px]">REVERSÉ</span></td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-white font-bold">n8n AI Waterfall Lead Enrichment</td>
                <td class="py-3 px-4 text-slate-400">ma***@saasgrowth.io</td>
                <td class="py-3 px-4">$49.00</td>
                <td class="py-3 px-4 text-slate-500">-$9.80</td>
                <td class="py-3 px-4 text-emerald-400 font-bold">+$39.20</td>
                <td class="py-3 px-4 text-right"><span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px]">REVERSÉ</span></td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-white font-bold">n8n AI Waterfall Lead Enrichment</td>
                <td class="py-3 px-4 text-slate-400">sa***@cloudscale.co</td>
                <td class="py-3 px-4">$49.00</td>
                <td class="py-3 px-4 text-slate-500">-$9.80</td>
                <td class="py-3 px-4 text-emerald-400 font-bold">+$39.20</td>
                <td class="py-3 px-4 text-right"><span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px]">REVERSÉ</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 2. MES PRODUITS (CATALOGUE VENDEUR) -->
    <!-- ========================================================================= -->
    <div id="spanel-products" class="space-y-6 hidden">
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>📦</span> Catalogue des Blueprints Publiés
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Gérez les versions, suivez les avis et mettez à jour vos workflows.
            </p>
          </div>
          <button id="btn-open-wizard-prod" class="px-4 py-2 rounded-xl bg-emerald-500 text-slate-950 font-mono text-xs font-bold shadow-glow-emerald">
            + Déposer un Nouveau Blueprint
          </button>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono">
            <thead>
              <tr class="border-b border-slate-800 text-slate-400">
                <th class="py-3 px-4 font-bold">Blueprint</th>
                <th class="py-3 px-4 font-bold">Prix</th>
                <th class="py-3 px-4 font-bold">Statut</th>
                <th class="py-3 px-4 font-bold">Version</th>
                <th class="py-3 px-4 font-bold">Ventes</th>
                <th class="py-3 px-4 font-bold">Revenu Net (80%)</th>
                <th class="py-3 px-4 font-bold text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80 text-slate-300">
              {sellerBlueprints.map((bp) => (
                <tr class="hover:bg-slate-900/40 transition-colors">
                  <td class="py-4 px-4">
                    <div class="font-bold text-white text-sm">{bp.title}</div>
                    <div class="text-[11px] text-slate-400">{bp.ecosystem.toUpperCase()} • {bp.category}</div>
                  </td>
                  <td class="py-4 px-4 font-bold text-white">
                    {bp.is_free ? <span class="text-emerald-400">GRATUIT</span> : `$${bp.price_usd}`}
                  </td>
                  <td class="py-4 px-4">
                    <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px] font-bold">
                      PUBLIÉ
                    </span>
                  </td>
                  <td class="py-4 px-4 text-cyan-400">{bp.version || "v1.4.2"}</td>
                  <td class="py-4 px-4 font-bold text-white">{bp.sales_count}</td>
                  <td class="py-4 px-4 font-bold text-emerald-400">
                    ${((bp.price_usd || 0) * (bp.sales_count || 0) * 0.8).toFixed(2)}
                  </td>
                  <td class="py-4 px-4 text-right space-x-2">
                    <a href={`/templates/${bp.slug}/`} class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700">
                      Voir
                    </a>
                    <button class="btn-new-version px-3 py-1.5 rounded-lg bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 hover:bg-cyan-500/30" data-slug={bp.slug}>
                      + Version
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 3. CRÉATION DE PRODUIT (WIZARD 7 ÉTAPES) -->
    <!-- ========================================================================= -->
    <div id="spanel-wizard" class="space-y-6 hidden">
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-8">
        
        <!-- Wizard Progress Bar -->
        <div>
          <div class="flex items-center justify-between mb-3 text-xs font-mono">
            <span class="font-bold text-white" id="wizard-step-title">Étape 1 sur 7 : Informations Générales</span>
            <span class="text-emerald-400 font-bold" id="wizard-progress-percent">14% Complété</span>
          </div>
          <div class="w-full h-2 rounded-full bg-slate-900 border border-slate-800 overflow-hidden">
            <div id="wizard-progress-fill" class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 transition-all duration-300" style="width: 14%;"></div>
          </div>
        </div>

        <form id="product-creation-wizard-form" class="space-y-6">
          
          <!-- STEP 1: Informations Générales -->
          <div id="wstep-1" class="wizard-step space-y-4">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span>📝</span> Informations Générales du Produit
            </h3>
            <div>
              <label class="block text-xs font-mono text-slate-300 mb-1 font-bold">Titre du Blueprint :</label>
              <input type="text" id="wiz-title" required placeholder="ex: Supabase Multi-Tenant Auth & Stripe Metered Billing Engine" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-emerald-500 focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-mono text-slate-300 mb-1 font-bold">Accroche Synthétique (Tagline) :</label>
              <input type="text" id="wiz-tagline" required placeholder="ex: Déployez un système d'abonnements B2B sans risque de fuite de données en 10 minutes." class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-emerald-500 focus:outline-none" />
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-mono text-slate-300 mb-1 font-bold">Écosystème Principal :</label>
                <select id="wiz-ecosystem" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-emerald-500 focus:outline-none">
                  <option value="n8n">n8n Workflow</option>
                  <option value="make">Make.com Scenario</option>
                  <option value="supabase">Supabase Schema / RLS</option>
                  <option value="ai-agents">AI Agent / Prompt Stack</option>
                  <option value="notion">Notion OS Template</option>
                  <option value="zapier">Zapier Blueprint</option>
                  <option value="airtable">Airtable Architecture</option>
                  <option value="firebase">Firebase Firestore</option>
                  <option value="cursor">Cursor System Rules</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-mono text-slate-300 mb-1 font-bold">Catégorie Métier :</label>
                <select id="wiz-category" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-emerald-500 focus:outline-none">
                  <option value="Lead Gen & Sales">Lead Gen &amp; Sales</option>
                  <option value="Fintech & RevOps">Fintech &amp; RevOps</option>
                  <option value="CRM & Sales">CRM &amp; Sales</option>
                  <option value="Customer Support">Customer Support</option>
                  <option value="SaaS Starter Kits">SaaS Starter Kits</option>
                  <option value="Productivity Systems">Productivity Systems</option>
                  <option value="Developer Tools">Developer Tools</option>
                </select>
              </div>
            </div>
          </div>

          <!-- STEP 2: Spécifications Techniques -->
          <div id="wstep-2" class="wizard-step space-y-4 hidden">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span>🛠️</span> Spécifications Techniques &amp; Prérequis
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-xs font-mono text-slate-300 mb-1 font-bold">Complexité :</label>
                <select id="wiz-difficulty" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-emerald-500 focus:outline-none">
                  <option value="beginner">Débutant (&lt; 15 min)</option>
                  <option value="intermediate" selected>Intermédiaire (15-45 min)</option>
                  <option value="advanced">Avancé (Configuration avancée)</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-mono text-slate-300 mb-1 font-bold">Nombre de Nœuds / Étapes :</label>
                <input type="number" id="wiz-nodes" value="12" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-emerald-500 focus:outline-none" />
              </div>
              <div>
                <label class="block text-xs font-mono text-slate-300 mb-1 font-bold">Temps Économisé (Heures) :</label>
                <input type="number" id="wiz-hours" value="24" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-emerald-500 focus:outline-none" />
              </div>
            </div>
            <div>
              <label class="block text-xs font-mono text-slate-300 mb-1 font-bold">Services &amp; APIs Externes Requis :</label>
              <input type="text" id="wiz-services" placeholder="ex: OpenAI, Stripe, PostgreSQL, Slack" class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-emerald-500 focus:outline-none" />
            </div>
          </div>

          <!-- STEP 3: Fichier & Scan Sentinel AST -->
          <div id="wstep-3" class="wizard-step space-y-4 hidden">
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <span>🛡️</span> Fichier du Produit &amp; Audit Sentinel Anti-Scam
            </h3>
            <p class="text-xs text-slate-400 font-light">
