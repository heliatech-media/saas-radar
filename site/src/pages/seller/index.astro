  <script is:inline>
    // Tab Switching Logic
    const stabs = {
      overview: document.getElementById('stab-overview'),
      products: document.getElementById('stab-products'),
      wizard: document.getElementById('stab-wizard'),
      sales: document.getElementById('stab-sales'),
      coupons: document.getElementById('stab-coupons'),
      payouts: document.getElementById('stab-payouts')
    };

    const spanels = {
      overview: document.getElementById('spanel-overview'),
      products: document.getElementById('spanel-products'),
      wizard: document.getElementById('spanel-wizard'),
      sales: document.getElementById('spanel-sales'),
      coupons: document.getElementById('spanel-coupons'),
      payouts: document.getElementById('spanel-payouts')
    };

    function switchSellerTab(targetName) {
      Object.keys(stabs).forEach(name => {
        const tabBtn = stabs[name];
        const panel = spanels[name];
        if (name === targetName) {
          tabBtn?.classList.add('bg-emerald-500', 'text-slate-950', 'shadow-glow-emerald');
          tabBtn?.classList.remove('bg-slate-900', 'text-slate-300');
          panel?.classList.remove('hidden');
        } else {
          tabBtn?.classList.remove('bg-emerald-500', 'text-slate-950', 'shadow-glow-emerald');
          tabBtn?.classList.add('bg-slate-900', 'text-slate-300');
          panel?.classList.add('hidden');
        }
      });
    }

    Object.keys(stabs).forEach(name => {
      stabs[name]?.addEventListener('click', () => switchSellerTab(name));
    });

    document.getElementById('btn-open-wizard-top')?.addEventListener('click', () => switchSellerTab('wizard'));
    document.getElementById('btn-open-wizard-prod')?.addEventListener('click', () => switchSellerTab('wizard'));
    document.getElementById('btn-goto-sales')?.addEventListener('click', () => switchSellerTab('sales'));
    document.getElementById('btn-request-payout-top')?.addEventListener('click', () => switchSellerTab('payouts'));

    // 7-Step Wizard Management
    let currentStep = 1;
    const totalSteps = 7;
    const stepTitles = [
      "Informations Générales",
      "Spécifications Techniques",
      "Fichier & Scan Sentinel AST",
      "Médias & Démo",
      "Tarification & Répartition 80%",
      "FAQ & Instructions",
      "Prévisualisation & Soumission"
    ];

    const prevBtn = document.getElementById('wizard-prev-btn');
    const nextBtn = document.getElementById('wizard-next-btn');
    const progressFill = document.getElementById('wizard-progress-fill');
    const progressText = document.getElementById('wizard-progress-percent');
    const stepTitle = document.getElementById('wizard-step-title');

    function updateWizardView() {
      for (let i = 1; i <= totalSteps; i++) {
        const stepEl = document.getElementById(`wstep-${i}`);
        if (i === currentStep) {
          stepEl?.classList.remove('hidden');
        } else {
          stepEl?.classList.add('hidden');
        }
      }

      const percent = Math.round((currentStep / totalSteps) * 100);
      if (progressFill) progressFill.style.width = `${percent}%`;
      if (progressText) progressText.textContent = `${percent}% Complété`;
      if (stepTitle) stepTitle.textContent = `Étape ${currentStep} sur ${totalSteps} : ${stepTitles[currentStep - 1]}`;

      if (currentStep === 1) {
        prevBtn?.classList.add('hidden');
      } else {
        prevBtn?.classList.remove('hidden');
      }

      if (currentStep === totalSteps) {
        if (nextBtn) nextBtn.textContent = "Soumettre pour Certification Sentinel ➔";
      } else {
        if (nextBtn) nextBtn.textContent = "Étape Suivante ➔";
      }
    }

    prevBtn?.addEventListener('click', () => {
      if (currentStep > 1) {
        currentStep--;
        updateWizardView();
      }
    });

    nextBtn?.addEventListener('click', async () => {
      if (currentStep < totalSteps) {
        currentStep++;
        updateWizardView();

        // Update preview at step 7
        if (currentStep === 7) {
          const t = document.getElementById('wiz-title')?.value || "Blueprint sans titre";
          const e = document.getElementById('wiz-ecosystem')?.value || "n8n";
          const c = document.getElementById('wiz-category')?.value || "Lead Gen";
          const p = parseFloat(document.getElementById('wiz-price')?.value || 49);

          document.getElementById('preview-final-title').textContent = t;
          document.getElementById('preview-final-sub').textContent = `${e.toUpperCase()} • ${c}`;
          document.getElementById('preview-final-price').textContent = `Prix : $${p.toFixed(2)} (Votre part nette : $${(p * 0.8).toFixed(2)})`;
        }
      } else {
        // Final submit
        const payload = {
          title: document.getElementById('wiz-title')?.value || "Nouveau Blueprint",
          ecosystem: document.getElementById('wiz-ecosystem')?.value || "n8n",
          category: document.getElementById('wiz-category')?.value || "Lead Gen",
          price_usd: parseFloat(document.getElementById('wiz-price')?.value || 49),
          workflow_json: document.getElementById('wiz-workflow-json')?.value || "{}",
          submit_for_review: true
        };

        try {
          const res = await fetch('/api/marketplace/seller/products', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (data.success) {
            alert("✓ " + data.message);
            switchSellerTab('products');
          } else {
            alert("❌ Erreur : " + data.error);
          }
        } catch(err) {
          alert("✓ Blueprint certifié et soumis pour validation administrative !");
          switchSellerTab('products');
        }
      }
    });

    // Price calculator live update
    document.getElementById('wiz-price')?.addEventListener('input', (e) => {
      const price = parseFloat(e.target.value) || 0;
      const net = (price * 0.8).toFixed(2);
      const cut = (price * 0.2).toFixed(2);
      document.getElementById('calc-net-payout').textContent = `$${net} USD`;
      document.getElementById('calc-platform-cut').textContent = `$${cut} USD`;
    });

    // Payout button
    document.getElementById('btn-request-payout-modal')?.addEventListener('click', async () => {
      if (confirm("Confirmer la demande de virement de $1,472.00 USD vers votre IBAN •••• 4021 ?")) {
        try {
          const res = await fetch('/api/marketplace/seller/payouts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ amount_usd: 1472.00 })
          });
          const data = await res.json();
          alert(data.message || "✓ Virement initié avec succès !");
        } catch(e) {
          alert("✓ Virement de $1,472.00 USD initié vers votre compte bancaire !");
        }
      }
    });

    // Version Modal Handler
    const versionModal = document.getElementById('version-modal');
    document.querySelectorAll('.btn-new-version').forEach(btn => {
      btn.addEventListener('click', () => {
        versionModal?.classList.remove('hidden');
      });
    });

    document.getElementById('btn-close-version-modal')?.addEventListener('click', () => {
      versionModal?.classList.add('hidden');
    });

    document.getElementById('version-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const version = document.getElementById('ver-num')?.value;
      const changelog = document.getElementById('ver-changelog')?.value;

      try {
        const res = await fetch('/api/marketplace/seller/versions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            product_slug: 'n8n-ai-lead-enricher-waterfall',
            version,
            changelog
          })
        });
        const data = await res.json();
        alert(data.message || "✓ Version publiée !");
        versionModal?.classList.add('hidden');
      } catch(err) {
        alert("✓ Version publiée ! Les acheteurs ont été notifiés.");
        versionModal?.classList.add('hidden');
      }
    });

    // Coupon creation form
    document.getElementById('create-coupon-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const code = document.getElementById('coupon-code-input')?.value;
      const percent = document.getElementById('coupon-percent-input')?.value;

      try {
        const res = await fetch('/api/marketplace/seller/coupons', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code, discount_value: percent })
        });
        const data = await res.json();
        alert(data.message || "✓ Code promo activé !");
        document.getElementById('coupon-code-input').value = '';
      } catch(err) {
        alert("✓ Code promo activé !");
      }
    });
  </script>
</Layout>
