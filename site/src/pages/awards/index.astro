---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';

const awards = [
  {
    toolName: "Make",
    toolSlug: "make",
    twitterHandle: "@make_hq",
    legacyCompetitor: "Zapier",
    category: "Workflow Automation & Cloud Integration",
    badgeFile: "/badges/winner-2026-make.svg",
    awardTitle: "Winner: Best Enterprise Orchestration 2026",
    score: "9.8 / 10",
    color: "from-purple-500/20 via-indigo-500/10 to-transparent",
    borderColor: "border-purple-500/40",
    accentColor: "text-purple-400",
    teardownUrl: "/blog/make-vs-zapier",
    affiliateUrl: "/go/make",
    headline: "Demolished Zapier in 500k Task Scalability and TCO",
    verdict: "Demonstrated superior multi-branch visual debugging, true JSON variable arrays, and up to 70% lower annual operating costs at scale.",
    prQuote: "HeliaTech 2026 Independent Accreditation: Make rated #1 Enterprise Workflow Orchestrator with 9.8/10 score.",
    embedSnippet: `<a href="https://heliatech.online/awards" target="_blank" rel="noopener"><img src="https://heliatech.online/badges/winner-2026-make.svg" alt="HeliaTech 2026 Winner - Make" width="320" height="120" border="0" /></a>`
  },
  {
    toolName: "Supabase",
    toolSlug: "supabase",
    twitterHandle: "@supabase",
    legacyCompetitor: "Heroku & AWS RDS",
    category: "Developer Tools & Cloud Infrastructure",
    badgeFile: "/badges/winner-2026-supabase.svg",
    awardTitle: "#1 Modern Cloud & Heroku Postgres Replacement 2026",
    score: "9.9 / 10",
    color: "from-emerald-500/20 via-teal-500/10 to-transparent",
    borderColor: "border-emerald-500/40",
    accentColor: "text-emerald-400",
    teardownUrl: "/blog/heroku-free-tier-alternatives-2026",
    affiliateUrl: "/go/supabase",
    headline: "The Undisputed Gold Standard for Modern PostgreSQL & Auth",
    verdict: "Delivers native row-level security, instant auto-generated REST/GraphQL APIs, global edge functions, and real-time WebSockets with zero vendor lock-in.",
    prQuote: "HeliaTech 2026 Independent Accreditation: Supabase crowned #1 Modern Postgres & Cloud Infrastructure with 9.9/10 score.",
    embedSnippet: `<a href="https://heliatech.online/awards" target="_blank" rel="noopener"><img src="https://heliatech.online/badges/winner-2026-supabase.svg" alt="HeliaTech 2026 Winner - Supabase" width="320" height="120" border="0" /></a>`
  },
  {
    toolName: "HeyGen",
    toolSlug: "heygen",
    twitterHandle: "@HeyGen_Official",
    legacyCompetitor: "Synthesia & Murf",
    category: "Generative AI Video & Avatars",
    badgeFile: "/badges/winner-2026-heygen.svg",
    awardTitle: "Winner: Best AI Video Avatar Fidelity 2026",
    score: "9.7 / 10",
    color: "from-cyan-500/20 via-sky-500/10 to-transparent",
    borderColor: "border-cyan-500/40",
    accentColor: "text-cyan-400",
    teardownUrl: "/blog/elevenlabs-vs-heygen",
    affiliateUrl: "/go/heygen",
    headline: "Sub-Millimeter Lip-Sync & Enterprise Avatar Realism",
    verdict: "Outperformed ElevenLabs and Synthesia in micro-facial gestures, automated multi-language video translation, and instant studio camera framing.",
    prQuote: "HeliaTech 2026 Independent Accreditation: HeyGen crowned #1 AI Video Avatar Realism with 9.7/10 score.",
    embedSnippet: `<a href="https://heliatech.online/awards" target="_blank" rel="noopener"><img src="https://heliatech.online/badges/winner-2026-heygen.svg" alt="HeliaTech 2026 Winner - HeyGen" width="320" height="120" border="0" /></a>`
  },
  {
    toolName: "Papaya Global",
    toolSlug: "papaya-global",
    twitterHandle: "@Papaya_Global",
    legacyCompetitor: "Legacy SWIFT Wires & Deel FX Markups",
    category: "Global Payroll & Employer of Record (EOR)",
    badgeFile: "/badges/winner-2026-papaya-global.svg",
    awardTitle: "Best Tier-1 Banking Infrastructure 2026",
    score: "9.6 / 10",
    color: "from-amber-500/20 via-orange-500/10 to-transparent",
    borderColor: "border-amber-500/40",
    accentColor: "text-amber-400",
    teardownUrl: "/blog/papaya-global-2026-pricing-rate-card-leaks",
    affiliateUrl: "/go/papaya-global",
    headline: "Eliminated Intermediary Correspondent Bank Markups",
    verdict: "Proprietary Tier-1 banking rails allow multinational CFOs to slash foreign exchange spreads and consolidate contractor and EOR liabilities under one dashboard.",
    prQuote: "HeliaTech 2026 Independent Accreditation: Papaya Global awarded Best Tier-1 Banking Infrastructure 2026 with 9.6/10 score.",
    embedSnippet: `<a href="https://heliatech.online/awards" target="_blank" rel="noopener"><img src="https://heliatech.online/badges/winner-2026-papaya-global.svg" alt="HeliaTech 2026 Winner - Papaya Global" width="320" height="120" border="0" /></a>`
  },
  {
    toolName: "Apollo.io",
    toolSlug: "apollo-io",
    twitterHandle: "@meetapollo",
    legacyCompetitor: "ZoomInfo ($15k Minimums)",
    category: "B2B Sales Intelligence & Lead Prospecting",
    badgeFile: "/badges/winner-2026-apollo-io.svg",
    awardTitle: "Best Scale Prospecting Database 2026",
    score: "9.5 / 10",
    color: "from-blue-500/20 via-cyan-500/10 to-transparent",
    borderColor: "border-blue-500/40",
    accentColor: "text-blue-400",
    teardownUrl: "/blog/apollo-io-vs-lusha",
    affiliateUrl: "/go/apollo-io",
    headline: "275M+ Global Verified Contacts & Multi-Sequence Cadences",
    verdict: "Delivers unprecedented unit economics for high-velocity outbound teams compared to legacy enterprise databases like ZoomInfo.",
    prQuote: "HeliaTech 2026 Independent Accreditation: Apollo.io rated #1 Scale Prospecting Database with 9.5/10 score.",
    embedSnippet: `<a href="https://heliatech.online/awards" target="_blank" rel="noopener"><img src="https://heliatech.online/badges/winner-2026-apollo-io.svg" alt="HeliaTech 2026 Winner - Apollo.io" width="320" height="120" border="0" /></a>`
  }
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "HeliaTech Independent Accreditation & Award Winners 2026",
  "description": "Official independent software engineering awards and accreditation registry audited by HeliaTech Media.",
  "url": "https://heliatech.online/awards"
};
---

<Layout 
  title="HeliaTech 2026 Software Awards | Independent Accreditation Registry"
  description="Official accreditation registry for the winners of our 2026 empirical software benchmarks. Verified architectures, transparent criteria, and embeddable badges."
  jsonLd={jsonLd}
>
  <div class="max-w-6xl mx-auto px-6 sm:px-8 py-16">
    
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-pink-500/10 text-pink-300 border border-pink-500/30 text-xs font-mono font-bold tracking-widest uppercase mb-6 shadow-glow-pink">
        <span>🏆</span>
        <span>INDEPENDENT ACCREDITATION REGISTRY</span>
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-[1.1] mb-6">
        HeliaTech <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-400 via-amber-300 to-cyan-400">2026 Award Winners</span>
      </h1>
      
      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed">
        We do not accept paid sponsorships for awards. Every badge in this registry represents an empirical victory proven through rigorous load-testing, API benchmarks, and financial TCO audits.
      </p>
    </div>

    <!-- Awards Grid -->
    <div class="space-y-12 mb-20">
      {awards.map((award) => (
        <article class={`p-6 sm:p-10 rounded-3xl bg-gradient-to-br ${award.color} bg-slate-950/80 border ${award.borderColor} shadow-2xl relative overflow-hidden backdrop-blur-xl`}>
          
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <!-- Left: Badge Preview & Embed Code -->
            <div class="lg:col-span-5 flex flex-col items-center sm:items-start text-center sm:text-left">
              <div class="mb-6 p-2 rounded-2xl bg-slate-950/90 border border-slate-800 shadow-xl max-w-[340px]">
                <picture>
                  <source srcset={`${award.badgeFile}?v=20261024b`} type="image/svg+xml" />
                  <img 
                    src={`${award.badgeFile.replace('.svg', '.png')}?v=20261024b`} 
                    alt={`${award.toolName} 2026 HeliaTech Award Badge`}
                    class="w-full h-auto rounded-xl"
                    width="320"
                    height="120"
                    loading="eager"
                  />
                </picture>
              </div>

              <!-- Embed Snippet Box -->
              <div class="w-full">
                <div class="flex items-center justify-between text-[11px] font-mono text-slate-400 mb-1.5">
                  <span class="flex items-center gap-1.5 font-bold text-slate-300">
                    <span>⚡</span>
                    <span>EMBED OFFICIAL BADGE</span>
                  </span>
                  <button 
                    type="button"
                    class="copy-badge-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-cyan-500/20 text-cyan-400 border border-slate-700 hover:border-cyan-500/40 text-[10px] font-mono font-bold transition-all active:scale-95 cursor-pointer"
                    data-code={award.embedSnippet}
                  >
                    <span>📋 Copier HTML</span>
                  </button>
                </div>
                <div class="p-3 rounded-xl bg-slate-950/90 border border-slate-800 text-[11px] font-mono text-slate-300 break-all select-all hover:border-cyan-500/40 transition-colors">
                  <code>{award.embedSnippet}</code>
                </div>
              </div>
            </div>

            <!-- Right: Victory Teardown Details -->
            <div class="lg:col-span-7 space-y-4">
              <div class="flex flex-wrap items-center gap-3">
                <span class="px-3 py-1 rounded-full bg-slate-900 border border-slate-700 text-xs font-mono text-slate-300 uppercase tracking-wider font-semibold">
                  {award.category}
                </span>
                <span class={`px-3 py-1 rounded-full bg-slate-900/90 border border-slate-700 text-xs font-mono font-black ${award.accentColor}`}>
                  SCORE: {award.score}
                </span>
              </div>

              <div class="flex items-center gap-3">
                <ToolIcon name={award.toolName} slug={award.toolSlug} size="md" />
                <h2 class="text-2xl sm:text-3xl font-black text-white tracking-tight">
                  {award.toolName}: <span class="text-slate-200">{award.awardTitle}</span>
                </h2>
              </div>

              <p class="text-sm sm:text-base font-semibold text-slate-200 leading-snug">
                {award.headline}
              </p>

              <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-light">
                {award.verdict}
              </p>

              <!-- CTAs -->
              <div class="pt-4 flex flex-wrap items-center gap-4 border-t border-slate-800/80">
                <a 
                  href={award.teardownUrl}
                  class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-mono text-xs font-bold border border-slate-700 transition-colors flex items-center gap-1.5"
                >
                  <span>Read Full Audit</span>
                  <span>➔</span>
                </a>
                <a 
                  href={award.affiliateUrl}
                  target="_blank"
                  rel="noopener sponsored"
                  class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-400 to-emerald-400 hover:from-cyan-300 hover:to-emerald-300 text-slate-950 font-mono text-xs font-black shadow-lg shadow-cyan-500/20 transition-transform active:scale-95 flex items-center gap-1.5"
                >
                  <span>Official Access</span>
                  <span>↗</span>
                </a>
              </div>

              <!-- PR Trojan Horse: 1-Click Viral Challenge & Accreditation Sharing -->
              <div class="mt-4 pt-4 border-t border-slate-800/60 space-y-2">
                <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 font-bold block">
                  ⚔️ PR & Social Viral Challenge:
                </span>
                
                <div class="flex flex-wrap items-center gap-2">
                  <!-- 1-Click X / Twitter Tweet -->
                  <a 
                    href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(`🚨 HeliaTech 2026 Audit: ${award.twitterHandle} officially crowned ${award.awardTitle} with a ${award.score} score over ${award.legacyCompetitor}!

Read the full load-test benchmark & rate card: https://heliatech.online${award.teardownUrl}`)}`}
                    target="_blank"
                    rel="noopener"
                    class="px-3 py-1.5 rounded-lg bg-black/70 hover:bg-slate-900 text-slate-200 border border-slate-700/80 hover:border-cyan-500/50 text-[11px] font-mono font-semibold transition-all flex items-center gap-1.5"
                  >
                    <svg class="w-3.5 h-3.5 text-cyan-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                    </svg>
                    <span>Challenge on X ({award.twitterHandle})</span>
                  </a>

                  <!-- 1-Click LinkedIn Share -->
                  <a 
                    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(`https://heliatech.online${award.teardownUrl}`)}`}
                    target="_blank"
                    rel="noopener"
                    class="px-3 py-1.5 rounded-lg bg-blue-950/40 hover:bg-blue-900/60 text-blue-300 border border-blue-800/60 hover:border-blue-500/60 text-[11px] font-mono font-semibold transition-all flex items-center gap-1.5"
                  >
                    <svg class="w-3.5 h-3.5 text-blue-400" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                    </svg>
                    <span>Share on LinkedIn</span>
                  </a>

                  <!-- 1-Click Copy Press Quote -->
                  <button 
                    type="button"
                    class="copy-pr-quote-btn px-3 py-1.5 rounded-lg bg-slate-900/80 hover:bg-slate-800 text-slate-300 border border-slate-700/80 text-[11px] font-mono font-semibold transition-all flex items-center gap-1.5 cursor-pointer"
                    data-quote={award.prQuote}
                  >
                    <span>📰 Copy Official PR Quote</span>
                  </button>
                </div>
              </div>
            </div>

          </div>
        </article>
      ))}
    </div>

    <!-- Methodology & Integrity Statement -->
    <div class="p-8 sm:p-10 rounded-3xl bg-slate-950/70 border border-slate-800 max-w-3xl mx-auto text-center space-y-4">
      <div class="w-12 h-12 rounded-2xl bg-amber-500/10 border border-amber-500/30 flex items-center justify-center text-amber-400 mx-auto text-xl">
        ⚖️
      </div>
      <h3 class="text-lg font-bold text-white tracking-tight">HeliaTech Independent Evaluation Charter</h3>
      <p class="text-xs sm:text-sm text-slate-400 leading-relaxed font-light m-0">
        All awards and ratings in this directory are issued strictly on the basis of empirical testing: API response times, cold start latency, total cost of ownership at 100k+ volume, and architectural resilience. We do not accept payment to grant or alter scores.
      </p>
      <div class="pt-2">
        <a href="/terms" class="text-xs font-mono text-cyan-400 hover:underline">Read our full editorial & verification methodology →</a>
      </div>
    </div>

  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-badge-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.getAttribute('data-code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span>✓ Copied HTML!</span>';
        btn.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
        btn.classList.remove('bg-slate-800', 'text-cyan-400');
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.classList.remove('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
          btn.classList.add('bg-slate-800', 'text-cyan-400');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.copy-pr-quote-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const quote = btn.getAttribute('data-quote');
      if (!quote) return;
      try {
        await navigator.clipboard.writeText(quote);
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span>✓ PR Quote Copied!</span>';
        btn.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
        setTimeout(() => {
          btn.innerHTML = originalHtml;
          btn.classList.remove('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
        }, 2500);
      } catch (err) {
        console.error('Failed to copy', err);
      }
    });
  });
</script>
