---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
// Sort by date descending
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const featuredPost = sortedPosts[0];
const otherPosts = sortedPosts.slice(1);
---

<Layout 
  title="Blog & SaaS Investigations: Evolution, Case Studies & Hands-on Guides"
  description="Exhaustive teardowns, product evolution stories, and step-by-step masterclasses on top-tier B2B software and autonomous AI engines."
>
  <div class="max-w-6xl mx-auto px-6 sm:px-8 py-16">
    <!-- Header Hero -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-800/80 border border-cyan-500/30 text-cyan-300 text-xs font-mono mb-6 shadow-glow-cyan">
        <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>HELIATECH EDITORIAL • DEEP DIVES & MASTERCLASSES</span>
      </div>

      <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight mb-6 leading-tight">
        The Software & AI <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-fuchsia-400">
          Intelligence Lab.
        </span>
      </h1>

      <p class="text-slate-400 text-base sm:text-lg leading-relaxed">
        Uncover the origins of world-class SaaS, master their hidden superpowers, and apply our step-by-step workshops to scale your enterprise velocity.
      </p>
    </div>

    <!-- Featured Post Spotlight -->
    {featuredPost && (
      <div class="mb-16">
        <div class="text-xs font-mono uppercase tracking-widest text-cyan-400 mb-4 font-bold flex items-center gap-2">
          <span>✦ FEATURED INVESTIGATION</span>
        </div>
        <a 
          href={`/blog/${featuredPost.slug}`}
          class="group block relative rounded-3xl bg-slate-900/80 border border-slate-800 hover:border-cyan-500/50 p-8 sm:p-12 transition-all duration-300 shadow-glass-cyber overflow-hidden"
        >
          <div class="absolute -right-20 -top-20 w-96 h-96 bg-gradient-to-br from-cyan-500/10 via-fuchsia-500/5 to-transparent rounded-full blur-3xl group-hover:scale-125 transition-transform duration-700 pointer-events-none"></div>

          <div class="flex flex-wrap items-center gap-3 mb-6 text-xs font-mono">
            <span class="px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 font-semibold">
              {featuredPost.data.category}
            </span>
            <span class="text-slate-500">•</span>
            <span class="text-slate-400">{featuredPost.data.readingTime} READ</span>
            <span class="text-slate-500">•</span>
            <span class="text-slate-400">{new Date(featuredPost.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
          </div>

          <h2 class="text-2xl sm:text-4xl font-black text-white group-hover:text-cyan-300 transition-colors mb-4 max-w-4xl leading-tight">
            {featuredPost.data.title}
          </h2>

          <p class="text-slate-400 text-sm sm:text-base leading-relaxed max-w-3xl mb-8">
            {featuredPost.data.description}
          </p>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-slate-800/80">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-cyan-500 to-fuchsia-500 p-[1px]">
                <div class="w-full h-full bg-slate-950 rounded-full flex items-center justify-center text-[10px] font-bold text-white">
                  HT
                </div>
              </div>
              <span class="text-xs font-mono text-slate-300 font-medium">By {featuredPost.data.author}</span>
            </div>

            <span class="inline-flex items-center gap-2 text-xs font-mono font-bold text-cyan-400 group-hover:text-cyan-300 group-hover:translate-x-1 transition-all">
              <span>READ FULL INVESTIGATION</span>
              <span>➔</span>
            </span>
          </div>
        </a>
      </div>
    )}

    <!-- Other Articles Grid -->
    {otherPosts.length > 0 && (
      <div>
        <div class="text-xs font-mono uppercase tracking-widest text-slate-400 mb-6 font-bold flex items-center gap-2">
          <span>ALL INVESTIGATIONS & GUIDES</span>
          <span class="h-[1px] flex-grow bg-slate-800"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {otherPosts.map((post) => (
            <a 
              href={`/blog/${post.slug}`}
              class="group flex flex-col justify-between rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-fuchsia-500/40 p-8 transition-all duration-300 hover:-translate-y-1 shadow-glass-cyber"
            >
              <div>
                <div class="flex items-center gap-2 mb-4 text-xs font-mono">
                  <span class="px-2.5 py-0.5 rounded-full bg-fuchsia-500/10 text-fuchsia-300 border border-fuchsia-500/25">
                    {post.data.category}
                  </span>
                  <span class="text-slate-500">•</span>
                  <span class="text-slate-400 text-[11px]">{post.data.readingTime} READ</span>
                </div>

                <h3 class="text-xl font-bold text-white group-hover:text-fuchsia-300 transition-colors mb-3 leading-snug">
                  {post.data.title}
                </h3>

                <p class="text-slate-400 text-xs sm:text-sm line-clamp-3 leading-relaxed mb-6">
                  {post.data.description}
                </p>
              </div>

              <div class="flex items-center justify-between pt-4 border-t border-slate-800/60 text-xs font-mono">
                <span class="text-slate-500 text-[11px]">
                  {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
                <span class="text-fuchsia-400 group-hover:translate-x-1 transition-transform flex items-center gap-1 font-bold">
                  <span>Explore</span>
                  <span>➔</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Bottom Radar Link Section -->
    <div class="mt-20 p-8 sm:p-12 rounded-3xl bg-slate-900/70 border border-slate-800 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/5 via-fuchsia-500/5 to-transparent pointer-events-none"></div>
      <h3 class="text-2xl font-black text-white mb-3">Looking for granular technical benchmarks?</h3>
      <p class="text-slate-400 text-sm max-w-xl mx-auto mb-6">
        Access our SaaS Radar directory to inspect real-time performance scores, ROI payback velocity, and pricing architectures for 20+ audited tools.
      </p>
      <a 
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-cyan-500/30 text-xs font-mono font-bold tracking-wider uppercase transition-all duration-300"
      >
        <span>Access SaaS Radar Engine</span>
        <span>➔</span>
      </a>
    </div>
  </div>
</Layout>
