---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import RoiCalculator from '../../components/RoiCalculator.astro';
import StickyAffiliateBar from '../../components/StickyAffiliateBar.astro';
import NewsletterCapture from '../../components/NewsletterCapture.astro';
import PricingShockCalculator from '../../components/PricingShockCalculator.astro';
import AdSlot from '../../components/AdSlot.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const post = entry.data;
const { Content } = await entry.render();

// Sentinel v2.4 Duel Detection for Header Contenders
const isVersus = entry.slug.includes('-vs-') || post.category === 'Comparatif';
let contenderA = post.tool_slug || '';
let contenderB = '';
if (entry.slug.includes('-vs-')) {
  const parts = entry.slug.split('-vs-');
  contenderA = parts[0];
  contenderB = parts[1].replace(/-2026.*$/, '').replace(/-claude.*$/, '').replace(/-fr$/, '');
}

// Generate Schema.org JSON-LD for Google Rich Results
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": post.title,
      "description": post.description,
      "datePublished": post.date,
      "author": {
        "@type": "Organization",
        "name": post.author,
        "url": "https://heliatech.online"
      },
      "publisher": {
        "@type": "Organization",
        "name": "HeliaTech Media",
        "url": "https://heliatech.online"
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://heliatech.online/blog/${entry.slug}/`
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://heliatech.online/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://heliatech.online/blog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": post.title,
          "item": `https://heliatech.online/blog/${entry.slug}/`
        }
      ]
    }
  ]
};
---

<Layout 
  title={`${post.title}`}
  description={post.description}
  jsonLd={jsonLd}
  image={post.image || `/images/blog/${post.tool_slug || entry.slug}.svg`}
>
  <!-- Reading Progress Bar (Fixed Top) -->
  <div id="read-progress" class="fixed top-0 left-0 w-0 h-1 bg-gradient-to-r from-cyan-400 via-sky-400 to-fuchsia-500 z-50 transition-all duration-75"></div>

  <article class="max-w-4xl mx-auto px-6 sm:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/80 border border-slate-800 text-xs font-mono text-slate-400 mb-10 shadow-sm">
      <a href="/" class="hover:text-cyan-400 transition-colors">HOME</a>
      <span class="text-slate-600">/</span>
      <a href="/blog" class="hover:text-cyan-400 transition-colors">BLOG</a>
      <span class="text-slate-600">/</span>
      <span class="text-cyan-300 font-medium truncate max-w-[200px] sm:max-w-xs">{post.category}</span>
    </nav>

    <!-- Header Meta & Badges -->
    <header class="mb-12">
      <div class="flex flex-wrap items-center gap-3 mb-6 text-xs font-mono">
        <span class="px-3 py-1 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 font-semibold uppercase tracking-wider">
          {post.category}
        </span>
        <span class="text-slate-500">•</span>
        <span class="text-slate-400 font-mono">{post.readingTime} READ</span>
        <span class="text-slate-500">•</span>
        <span class="text-slate-400 font-mono">PUBLISHED ON {new Date(post.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>

        {isVersus && contenderA && contenderB ? (
          <span class="ml-auto inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-obsidian-800 text-slate-300 border border-white/[0.08] font-semibold">
            <ToolIcon slug={contenderA} size="xs" />
            <span class="text-white">{contenderA.toUpperCase()}</span>
            <span class="text-sky-400 font-bold px-0.5">VS</span>
            <ToolIcon slug={contenderB} size="xs" />
            <span class="text-slate-300">{contenderB.toUpperCase()}</span>
          </span>
        ) : post.tool_slug ? (
          <span class="ml-auto inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cobalt-500/10 text-cobalt-300 border border-cobalt-500/30 font-semibold">
            <ToolIcon slug={post.tool_slug} size="xs" />
            <span>Dedicated to {post.tool_slug.toUpperCase()}</span>
          </span>
        ) : null}
      </div>

      <div class="flex items-start gap-4 mb-8">
        {isVersus && contenderA && contenderB ? (
          <div class="mt-1 hidden sm:flex items-center gap-2 p-2 rounded-2xl bg-obsidian-900 border border-white/[0.08]">
            <ToolIcon slug={contenderA} size="md" />
            <span class="text-xs font-mono font-bold text-sky-400 px-1">VS</span>
            <ToolIcon slug={contenderB} size="md" />
          </div>
        ) : post.tool_slug ? (
          <ToolIcon slug={post.tool_slug} size="lg" className="mt-1 hidden sm:inline-flex" />
        ) : null}
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.15] font-heading">
          {post.title}
        </h1>
      </div>

      <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed mb-8">
        {post.description}
      </p>

      <!-- Author Capsule & Direct Links -->
      <div class="flex flex-wrap items-center justify-between gap-4 p-4 rounded-2xl bg-slate-900/60 border border-slate-800">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-cyan-500 to-fuchsia-500 p-[1px] shadow-glow-cyan">
            <div class="w-full h-full bg-[#030303] rounded-full flex items-center justify-center font-black text-xs text-white">
              HT
            </div>
          </div>
          <div>
            <span class="text-xs font-bold text-white block">HELIATECH EDITORIAL</span>
            <span class="text-[11px] font-mono text-cyan-400">Forensics & Intelligence Division</span>
          </div>
        </div>

        {post.tool_slug && (
          <div class="flex items-center gap-3">
            <a 
              href={`/reviews/${post.tool_slug}`}
              class="px-3.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-mono text-slate-300 border border-slate-700 transition-colors flex items-center gap-1"
            >
              <span>Teardown Dossier</span>
              <span>➔</span>
            </a>
            <a 
              href={`/go/${post.tool_slug}`} 
              target="_blank"
              rel="noopener sponsored"
              class="px-3.5 py-1.5 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-xs font-mono font-bold text-slate-950 transition-colors shadow-glow-cyan flex items-center gap-1.5"
            >
              <ToolIcon slug={post.tool_slug} size="xs" />
              <span>Direct Access</span>
              <span>↗</span>
            </a>
          </div>
        )}
      </div>
    </header>

    <!-- Flagship Hero Artwork (Architected by Helia-VisualArtist) -->
    {post.image && (
      <div class="my-10 rounded-3xl overflow-hidden border border-slate-800 shadow-glass-cyber bg-slate-950/60 relative group">
        <div class="absolute inset-0 bg-gradient-to-t from-[#030303] via-transparent to-transparent opacity-30 z-10 pointer-events-none"></div>
        <picture>
          <source srcset={`${post.image}?v=20261024b`} type="image/svg+xml" />
          <img 
            src={`${post.image.replace('.svg', '.png')}?v=20261024b`} 
            alt={`${post.title} — Flagship Architectural Artwork`}
            class="w-full h-auto aspect-[1200/630] object-cover transition-transform duration-700 group-hover:scale-[1.01]"
            loading="eager"
          />
        </picture>
      </div>
    )}

    <!-- TL;DR Executive Summary Box (TechPulse Cyber Style) -->
    {post.tldr && post.tldr.length > 0 && (
      <div class="my-10 p-6 sm:p-8 rounded-3xl bg-slate-900/90 border border-cyan-500/30 shadow-glow-cyan relative overflow-hidden">
        <div class="flex items-center gap-2 mb-4">
          <span class="text-cyan-400 font-mono text-sm font-bold tracking-widest uppercase">✦ EXECUTIVE TAKEAWAYS (TL;DR)</span>
        </div>
        <ul class="space-y-3 m-0 p-0 list-none">
          {post.tldr.map((item) => (
            <li class="flex items-start gap-3 text-sm sm:text-base text-slate-200 leading-relaxed m-0">
              <span class="text-sky-400 font-bold mt-1 text-base leading-none">▹</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    <!-- Sentinel™ v2.4 Forensic Evidence & Protocol Dossier Component -->
    <div class="my-8 p-5 sm:p-6 rounded-2xl bg-obsidian-800 border border-white/[0.08] text-xs font-mono shadow-sm">
      <div class="flex flex-wrap items-center justify-between gap-3 pb-3 mb-3 border-b border-white/[0.06]">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-white font-bold tracking-wider">SENTINEL™ EVIDENCE DOSSIER</span>
          <span class="text-slate-500">•</span>
          <span class="text-cobalt-400 font-medium">Protocol v2.4</span>
        </div>
        <a 
          href="/methodology/" 
          class="inline-flex items-center gap-1 text-sky-400 hover:text-sky-300 font-bold transition-colors underline"
        >
          <span>Audit Methodology & Weights</span>
          <span>→</span>
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-slate-300">
        <div>
          <span class="text-slate-500 block text-[10px] uppercase">Audit Cadence</span>
          <span class="font-bold text-white">48h Re-verification</span>
        </div>
        <div>
          <span class="text-slate-500 block text-[10px] uppercase">TCO Tolerance</span>
          <span class="font-bold text-emerald-400">±15% Uncertainty</span>
        </div>
        <div>
          <span class="text-slate-500 block text-[10px] uppercase">Perimeter</span>
          <span class="font-bold text-white">November 2026</span>
        </div>
        <div>
          <span class="text-slate-500 block text-[10px] uppercase">Dispute Protocol</span>
          <span class="font-bold text-sky-400">Open Vendor Window</span>
        </div>
      </div>
      <p class="text-[11px] text-slate-400 font-light mt-3 mb-0 leading-relaxed">
        This investigation adheres to the Sentinel v2.4 independent observatory standard. Benchmarks and rate cards are gathered via direct telemetry and authenticated testbeds without vendor compensation.
      </p>
    </div>

    <!-- Quick Decision & Immediate Action Banner (High Conversion Hook Above The Fold) -->
    <div class="my-8 p-6 sm:p-7 rounded-3xl bg-gradient-to-r from-cyan-950/40 via-slate-900/90 to-purple-950/40 border border-cyan-500/40 shadow-glow-cyan flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-cyan-500/20 border border-cyan-500/40 flex items-center justify-center text-2xl flex-shrink-0">
          ⚡
        </div>
        <div>
          <span class="text-[11px] font-mono text-cyan-400 font-bold uppercase tracking-wider block">
            SKIP THE 8-MINUTE DEEP DIVE
          </span>
          <h3 class="text-base sm:text-lg font-black text-white tracking-tight m-0">
            Calculate How Much You Overpay in 10 Seconds
          </h3>
          <p class="text-xs text-slate-400 font-light mt-1 mb-0">
            Audit your active software stack against verified 2026 enterprise rate cards.
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3 w-full sm:w-auto flex-shrink-0">
        <a 
          href={`/calculator/?stack=${post.tool_slug || 'make'}`}
          class="w-full sm:w-auto px-5 py-3 rounded-xl bg-gradient-to-r from-cyan-400 to-emerald-400 hover:from-cyan-300 hover:to-emerald-300 text-slate-950 font-mono text-xs font-black uppercase tracking-wider shadow-lg shadow-cyan-500/20 transition-all text-center flex items-center justify-center gap-1.5 active:scale-95"
        >
          <span>Run Free Stack Audit</span>
          <span>➔</span>
        </a>
      </div>
    </div>

    <!-- Quick Navigation / Article Map -->
    <nav class="my-8 p-4 sm:p-5 rounded-2xl bg-slate-900/50 border border-slate-800 text-xs font-mono shadow-inner-cyan">
      <div class="flex items-center gap-2 mb-3 text-cyan-400 font-bold uppercase tracking-wider text-[11px]">
        <span>✦</span>
        <span>INVESTIGATION ROADMAP & SITEMAP</span>
      </div>
      <div class="flex flex-wrap gap-2 text-slate-300">
        <span class="px-2.5 py-1 rounded-lg bg-slate-800/90 border border-slate-700/60 text-slate-300">1. Genesis & Disruption</span>
        <span class="px-2.5 py-1 rounded-lg bg-slate-800/90 border border-slate-700/60 text-slate-300">2. Business Superpowers</span>
        <span class="px-2.5 py-1 rounded-lg bg-slate-800/90 border border-slate-700/60 text-slate-300">3. Hands-on Workshop</span>
        <span class="px-2.5 py-1 rounded-lg bg-slate-800/90 border border-slate-700/60 text-slate-300">4. Critical Trade-Offs</span>
        <span class="px-2.5 py-1 rounded-lg bg-slate-800/90 border border-slate-700/60 text-slate-300">5. Final Verdict & Access</span>
      </div>
    </nav>

    <!-- Main Content Container with Elite Article Typography -->
    <div class="elite-article mt-8">
      <Content />
    </div>

    <!-- Interactive Financial ROI Simulator (Helia-CalculatorEngine) -->
    {post.tool_slug && (
      <RoiCalculator toolSlug={post.tool_slug} toolName={post.title.split(/[:—–-]/)[0].trim()} />
    )}

    {/* Helia-Lupin: Pricing Shock Simulator for Automation & Cost Optimization Articles */}
    {(entry.slug.includes('zapier') || entry.slug.includes('make') || post.tool_slug === 'make' || post.tool_slug === 'zapier') && (
      <PricingShockCalculator 
        expensiveTool="Zapier" 
        cheaperTool="Make" 
        expensiveToolSlug="zapier" 
        cheaperToolSlug="make" 
      />
    )}

    <!-- Google AdSense Managed Partner Slot -->
    <AdSlot />

    <!-- HeliaTech B2B Executive Lead Magnet -->
    <NewsletterCapture />

    <!-- Bottom Tool Crosslink & Navigation -->
    <footer class="mt-20 pt-12 border-t border-slate-800">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <a 
          href="/blog"
          class="flex items-center gap-3 p-5 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-cyan-500/40 transition-colors group"
        >
          <span class="text-cyan-400 group-hover:-translate-x-1 transition-transform font-bold">←</span>
          <div>
            <span class="text-[11px] font-mono text-slate-500 block uppercase">Back to Blog</span>
            <span class="text-sm font-bold text-white group-hover:text-cyan-300">All investigations & masterclasses</span>
          </div>
        </a>

        {post.tool_slug && (
          <a 
            href={`/reviews/${post.tool_slug}`}
            class="flex items-center justify-between p-5 rounded-2xl bg-slate-900/60 border border-slate-800 hover:border-fuchsia-500/40 transition-colors group text-right"
          >
            <div>
              <span class="text-[11px] font-mono text-slate-500 block uppercase">Technical Benchmark</span>
              <span class="text-sm font-bold text-white group-hover:text-fuchsia-300">View complete audit for {post.tool_slug}</span>
            </div>
            <span class="text-fuchsia-400 group-hover:translate-x-1 transition-transform font-bold">→</span>
          </a>
        )}
      </div>
    </footer>
  </article>

  <!-- Helia-CRO: Sticky Floating Conversion Bar -->
  {post.tool_slug && (
    <StickyAffiliateBar toolSlug={post.tool_slug} toolName={post.title.split(/[:—–-]/)[0].trim()} />
  )}

  <!-- Interactive Client Enhancements: Reading Progress, Tables & Code Copy -->
  <script is:inline>
    // 1. Reading Progress Bar
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      const bar = document.getElementById('read-progress');
      if (bar) bar.style.width = scrolled + '%';
    }, { passive: true });

    // 2. Wrap all markdown tables inside .table-responsive-container
    document.querySelectorAll('.elite-article table').forEach((table) => {
      if (!table.parentElement.classList.contains('table-responsive-container')) {
        const wrapper = document.createElement('div');
        wrapper.className = 'table-responsive-container';
        table.parentNode.insertBefore(wrapper, table);
        wrapper.appendChild(table);
      }
    });

    // 3. Add Copy Button to Code Blocks (excluding Mermaid diagrams)
    document.querySelectorAll('.elite-article pre').forEach((pre) => {
      if (pre.getAttribute('data-language') === 'mermaid') return;
      if (pre.querySelector('.copy-btn')) return;
      pre.style.position = 'relative';

      const btn = document.createElement('button');
      btn.className = 'copy-btn absolute top-3 right-3 px-2.5 py-1 rounded bg-slate-800/80 hover:bg-slate-700 text-[10px] font-mono text-slate-300 border border-slate-700 transition-colors';
      btn.textContent = 'Copy';

      btn.addEventListener('click', () => {
        const code = pre.querySelector('code')?.innerText || pre.innerText;
        navigator.clipboard.writeText(code).then(() => {
          btn.textContent = 'Copied!';
          btn.classList.add('text-cyan-400', 'border-cyan-500/40');
          setTimeout(() => {
            btn.textContent = 'Copy';
            btn.classList.remove('text-cyan-400', 'border-cyan-500/40');
          }, 2000);
        });
      });

      pre.appendChild(btn);
    });

    // 4. Client-side Mermaid Dynamic Vector Rendering (Executive Architectural Theme)
    const mermaidPres = document.querySelectorAll('.elite-article pre[data-language="mermaid"]');
    if (mermaidPres.length > 0) {
      import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs')
        .then(({ default: mermaid }) => {
          mermaid.initialize({
            startOnLoad: false,
            theme: 'dark',
            securityLevel: 'loose',
            flowchart: {
              useMaxWidth: false,
              htmlLabels: true,
              curve: 'basis',
              nodeSpacing: 35,
              rankSpacing: 40
            },
            themeVariables: {
              darkMode: true,
              background: '#090e1a',
              primaryColor: '#0c1425',
              primaryTextColor: '#f8fafc',
              primaryBorderColor: '#0284c7',
              lineColor: '#38bdf8',
              secondaryColor: '#1e293b',
              tertiaryColor: '#0c1425',
              fontSize: '13.5px',
              fontFamily: 'Inter, system-ui, sans-serif'
            }
          });
          mermaidPres.forEach(async (pre, idx) => {
            const rawCode = pre.querySelector('code')?.innerText || pre.innerText;
            const wrapper = document.createElement('div');
            wrapper.className = 'my-8 rounded-2xl bg-[#090e1a] border border-cyan-500/20 shadow-2xl overflow-hidden';

            const header = document.createElement('div');
            header.className = 'flex items-center justify-between px-5 py-2.5 bg-slate-900/80 border-b border-white/[0.08] text-xs font-mono text-slate-400';
            header.innerHTML = `
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                <span class="text-cyan-300 font-bold tracking-wider">SYSTEM ARCHITECTURE</span>
              </div>
              <span class="text-[11px] text-slate-500 hidden sm:inline">↔ Drag or scroll to explore</span>
            `;
            wrapper.appendChild(header);

            const canvas = document.createElement('div');
            canvas.className = 'mermaid-body p-6 overflow-x-auto flex justify-center items-center';
            canvas.style.webkitOverflowScrolling = 'touch';
            wrapper.appendChild(canvas);

            try {
              const { svg } = await mermaid.render('mermaid-diag-' + idx, rawCode);
              canvas.innerHTML = svg;
              const svgEl = canvas.querySelector('svg');
              if (svgEl) {
                svgEl.style.height = 'auto';
                svgEl.style.display = 'block';
                svgEl.style.margin = '0 auto';
              }
              pre.parentNode.replaceChild(wrapper, pre);
            } catch (e) {
              console.warn('Mermaid rendering fallback:', e);
            }
          });
        })
        .catch((err) => console.warn('Mermaid script loader note:', err));
    }
  </script>
</Layout>
