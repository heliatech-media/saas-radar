---
import Layout from '../../../layouts/Layout.astro';
import templates from '../../../data/templates_catalog.json';

const pageTitle = "Console d'Administration Marketplace | HeliaTech";
const pageDescription = "Modération des blueprints, approbation des vendeurs, gestion financière des versements 80/20 et journal d'audit de sécurité Sentinel.";

// Group categories
const categoriesCount: Record<string, number> = {};
templates.forEach(t => {
  const c = t.category || "Autre";
  categoriesCount[c] = (categoriesCount[c] || 0) + 1;
});
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-24">
    
    <!-- Admin Security Top Banner -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 mb-8 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs font-mono gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-rose-400 animate-pulse flex-shrink-0"></span>
        <span class="font-bold uppercase tracking-wider">Console Sécurisée SUPER_ADMIN</span>
        <span class="text-rose-400/70 hidden lg:inline">— Modération en temps réel, arbitrage des reversements 80/20 et logs d'audit Sentinel.</span>
      </div>
      <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
        <a href="/templates/" class="px-3 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 font-bold transition-all">
          Marketplace ➔
        </a>
        <a href="/seller/" class="px-3 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-200 border border-emerald-500/40 font-bold transition-all">
          Studio Vendeur ➔
        </a>
      </div>
    </div>

    <!-- Admin Header Card -->
    <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-slate-800 mb-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 shadow-2xl relative overflow-hidden">
      <div class="flex items-center gap-4 relative z-10">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-rose-500 via-pink-600 to-indigo-600 p-0.5 shadow-glow-rose flex-shrink-0">
          <div class="w-full h-full bg-slate-950 rounded-2xl flex items-center justify-center text-xl font-bold text-white font-mono">
            ⚡
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2.5 mb-1">
            <h1 class="text-xl sm:text-2xl font-black text-white">Supervision Marketplace HeliaTech</h1>
            <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-rose-500/10 text-rose-400 border border-rose-500/30 font-bold">
              ADMIN ACCREDITED
            </span>
          </div>
          <div class="flex flex-wrap items-center gap-3 text-xs text-slate-400 font-mono">
            <span>contact@heliatech.online</span>
            <span>•</span>
            <span class="text-emerald-400">Sentinel Anti-Scam Actif</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3 w-full lg:w-auto justify-end relative z-10">
        <span class="px-3 py-1.5 rounded-xl bg-slate-950 border border-slate-800 text-xs font-mono text-slate-400">
          Clé HMAC-SHA256 Active
        </span>
      </div>
    </div>

    <!-- Admin Tabs Bar -->
    <div class="flex flex-wrap items-center gap-2 border-b border-slate-800 pb-4 mb-8">
      <button id="atab-overview" class="admin-nav-tab px-4 py-2.5 rounded-xl bg-rose-500 text-white font-mono text-xs font-bold transition-all flex items-center gap-2 shadow-lg">
        <span>📊</span> Vue d'Ensemble
      </button>
      <button id="atab-moderation" class="admin-nav-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
        <span>🛡️</span> File de Modération
        <span class="px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300 text-[10px] font-bold">2</span>
      </button>
      <button id="atab-sellers" class="admin-nav-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
        <span>💼</span> Vendeurs &amp; Candidatures
        <span class="px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-bold">1</span>
      </button>
      <button id="atab-payouts" class="admin-nav-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
        <span>🏦</span> Versements (Payouts)
        <span class="px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 text-[10px] font-bold">1</span>
      </button>
      <button id="atab-categories" class="admin-nav-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
        <span>📂</span> Catégories &amp; Tags
      </button>
      <button id="atab-audit" class="admin-nav-tab px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
        <span>📜</span> Journal d'Audit
      </button>
    </div>

    <!-- ========================================================================= -->
    <!-- 1. VUE D'ENSEMBLE (PLATFORM GMV & COMMISSIONS) -->
    <!-- ========================================================================= -->
    <div id="apanel-overview" class="space-y-8">
      
      <!-- Metrics Bar -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl sm:text-3xl font-black text-white font-mono mb-1">$14,890.00</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Volume Brut (GMV)</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl sm:text-3xl font-black text-rose-400 font-mono mb-1">$2,978.00</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Commissions HeliaTech (20%)</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono mb-1">$11,912.00</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Reversé aux Vendeurs (80%)</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono mb-1">1,420</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Comptes Utilisateurs</div>
        </div>
      </div>

      <!-- Real-Time Activity Stream -->
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-4">
        <h2 class="text-lg font-bold text-white flex items-center gap-2">
          <span>⚡</span> Flux d'Activité en Direct
        </h2>
        <div class="space-y-3">
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-center justify-between text-xs font-mono">
            <span class="text-white">💰 Vente confirmée : n8n AI Waterfall Lead ($49.00) — Part Vendeur $39.20 (80%), Commission $9.80 (20%)</span>
            <span class="text-slate-500 whitespace-nowrap ml-4">Il y a 14 min</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-center justify-between text-xs font-mono">
            <span class="text-cyan-300">🛡️ Nouveau produit soumis : n8n Salesforce Enterprise BI Sync — Scan Sentinel 100/100 Clean</span>
            <span class="text-slate-500 whitespace-nowrap ml-4">Il y a 45 min</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-center justify-between text-xs font-mono">
            <span class="text-amber-300">🏦 Demande de versement : AutomateScale Studio ($1,472.00 vers IBAN •••• 4021)</span>
            <span class="text-slate-500 whitespace-nowrap ml-4">Il y a 1h</span>
          </div>
          <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-center justify-between text-xs font-mono">
            <span class="text-emerald-300">✓ Candidature vendeur : CloudFlow Ops (Dossier vérifié et approuvé)</span>
            <span class="text-slate-500 whitespace-nowrap ml-4">Il y a 3h</span>
          </div>
        </div>
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 2. FILE DE MODÉRATION DES PRODUITS (PENDING REVIEW) -->
    <!-- ========================================================================= -->
    <div id="apanel-moderation" class="space-y-6 hidden">
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>🛡️</span> File d'Attente de Validation des Blueprints (2 En Attente)
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Inspectez le code source, vérifiez le score de sécurité Sentinel AST et approuvez ou refusez avec motif obligatoire.
            </p>
          </div>
        </div>

        <div class="space-y-6">
          <!-- Pending Product 1 -->
          <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800/80 pb-3">
              <div>
                <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-orange-500/10 text-orange-400 border border-orange-500/30 uppercase font-bold">N8N</span>
                <h3 class="text-base font-bold text-white mt-1">n8n Salesforce &amp; Snowflake Enterprise BI Warehouse Pipeline</h3>
                <div class="text-xs text-slate-400 font-mono mt-0.5">Par AutomateScale Studio • Prix : $89.00 USD (Part Vendeur : $71.20)</div>
              </div>
              <div class="text-right">
                <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-mono font-bold">
                  ✓ Sentinel AST 100/100 Clean
                </span>
                <div class="text-[10px] text-slate-500 font-mono mt-1">0 webhook suspect • 0 clé secrète</div>
              </div>
            </div>

            <p class="text-xs text-slate-300 font-light leading-relaxed">
              Workflow n8n de synchronisation continue entre les opportunités Salesforce 'Closed Won' et l'entrepôt de données Snowflake, avec déduplication et chiffrement AES-256.
            </p>

            <div class="flex items-center justify-between pt-3 border-t border-slate-800/80">
              <span class="text-xs font-mono text-slate-500">Soumis le 05 Nov 2026 à 18:30 UTC</span>
              <div class="flex items-center gap-2">
                <button class="btn-mod-reject px-4 py-2 rounded-xl bg-slate-900 hover:bg-rose-950/50 text-rose-400 border border-rose-800/50 text-xs font-mono font-bold transition-all" data-id="prod_pend_001">
                  ✕ Rejeter avec Motif
                </button>
                <button class="btn-mod-approve px-5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-mono font-bold transition-all shadow-glow-emerald" data-id="prod_pend_001">
                  ✓ Approuver &amp; Publier ➔
                </button>
              </div>
            </div>
          </div>

          <!-- Pending Product 2 -->
          <div class="p-6 rounded-2xl bg-slate-900/70 border border-slate-800 space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800/80 pb-3">
              <div>
                <span class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 uppercase font-bold">SUPABASE</span>
                <h3 class="text-base font-bold text-white mt-1">Supabase Vector Store &amp; LangChain Hybrid Search Starter</h3>
                <div class="text-xs text-slate-400 font-mono mt-0.5">Par DataStack Labs • Prix : $59.00 USD (Part Vendeur : $47.20)</div>
              </div>
              <div class="text-right">
                <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-mono font-bold">
                  ✓ Sentinel AST 98/100 Clean
                </span>
                <div class="text-[10px] text-slate-500 font-mono mt-1">Schéma SQL conforme PostgreSQL 16</div>
              </div>
            </div>

            <p class="text-xs text-slate-300 font-light leading-relaxed">
              Architecture clé en main pgvector avec fonction RPC de similarité cosinus, index HNSW et politiques de sécurité Row-Level Security hermétiques.
            </p>

            <div class="flex items-center justify-between pt-3 border-t border-slate-800/80">
              <span class="text-xs font-mono text-slate-500">Soumis le 05 Nov 2026 à 19:45 UTC</span>
              <div class="flex items-center gap-2">
                <button class="btn-mod-reject px-4 py-2 rounded-xl bg-slate-900 hover:bg-rose-950/50 text-rose-400 border border-rose-800/50 text-xs font-mono font-bold transition-all" data-id="prod_pend_002">
                  ✕ Rejeter avec Motif
                </button>
                <button class="btn-mod-approve px-5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-mono font-bold transition-all shadow-glow-emerald" data-id="prod_pend_002">
                  ✓ Approuver &amp; Publier ➔
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 3. GESTION DES VENDEURS & CANDIDATURES -->
    <!-- ========================================================================= -->
    <div id="apanel-sellers" class="space-y-6 hidden">
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>💼</span> Candidatures Vendeurs en Attente d'Accréditation
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Validez les dossiers des créateurs souhaitant vendre sur la marketplace avec commission de 20%.
            </p>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800/80 pb-3">
            <div>
              <h3 class="text-sm font-bold text-white">Julien M. (ParisRevOps Engineering)</h3>
              <div class="text-xs text-slate-400 font-mono">julien.revops@paristech.io • Spécialité : n8n, Make, HubSpot</div>
            </div>
            <span class="px-2.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/30 text-xs font-mono">
              EN ATTENTE D'ACTIVATION
            </span>
          </div>

          <p class="text-xs text-slate-300 font-light leading-relaxed">
            "Expert certifié Make et n8n avec 6 ans d'expérience en architecture CRM HubSpot &amp; Salesforce. Nous souhaitons publier 4 blueprints d'automatisation de facturation B2B."
          </p>

          <div class="flex items-center justify-between pt-3 border-t border-slate-800/80">
            <span class="text-xs font-mono text-cyan-400">Portfolio : https://parisrevops.example.com</span>
            <div class="flex items-center gap-2">
              <button class="btn-seller-reject px-4 py-2 rounded-xl bg-slate-900 text-rose-400 border border-rose-800/50 text-xs font-mono font-bold">
                ✕ Refuser
              </button>
              <button class="btn-seller-approve px-5 py-2 rounded-xl bg-emerald-500 text-slate-950 text-xs font-mono font-bold shadow-glow-emerald">
                ✓ Promouvoir au Rôle SELLER ➔
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 4. GESTION DES VERSEMENTS (PAYOUTS) -->
    <!-- ========================================================================= -->
    <div id="apanel-payouts" class="space-y-6 hidden">
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>🏦</span> Arbitrage des Demandes de Versement
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Validez le décaissement des fonds vers les comptes Stripe Connect ou virements SEPA des créateurs.
            </p>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800/80 pb-3">
            <div>
              <h3 class="text-sm font-bold text-white">AutomateScale Studio</h3>
              <div class="text-xs text-slate-400 font-mono">IBAN FR76 •••• 4021 • Demande #PO-REQ-001</div>
            </div>
            <div class="text-2xl font-black text-emerald-400 font-mono">$1,472.00 USD</div>
          </div>

          <div class="text-xs font-mono text-slate-300">
            Solde disponible avant versement : $1,472.00 • Solde restant après : $0.00
          </div>

          <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-800/80">
            <button class="btn-payout-reject px-4 py-2 rounded-xl bg-slate-900 text-rose-400 border border-rose-800/50 text-xs font-mono font-bold">
              ✕ Rejeter
            </button>
            <button class="btn-payout-approve px-5 py-2 rounded-xl bg-emerald-500 text-slate-950 text-xs font-mono font-bold shadow-glow-emerald">
              ✓ Exécuter le Virement Stripe Connect ➔
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 5. CATÉGORIES & TAGS (CRUD) -->
    <!-- ========================================================================= -->
    <div id="apanel-categories" class="space-y-6 hidden">
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>📂</span> Gestion des Catégories &amp; Domaines Métiers
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Configurez l'arborescence et l'ordre d'affichage sur la marketplace publique.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {Object.entries(categoriesCount).map(([name, count]) => (
            <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800 flex items-center justify-between">
              <div>
                <span class="text-white font-bold text-xs">{name}</span>
                <div class="text-[10px] text-cyan-400 font-mono">{count} Blueprints actifs</div>
              </div>
              <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px] font-mono">ACTIF</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 6. JOURNAL D'AUDIT SÉCURISÉ (AUDIT LOGS) -->
    <!-- ========================================================================= -->
    <div id="apanel-audit" class="space-y-6 hidden">
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>📜</span> Journal d'Audit Immuable des Actions Administratives
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Traçabilité intégrale conforme RGPD et SOC 2 : chaque validation, rejet ou virement est consigné avec IP et horodatage.
            </p>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono">
            <thead>
              <tr class="border-b border-slate-800 text-slate-400">
                <th class="py-3 px-4 font-bold">Date &amp; Heure</th>
                <th class="py-3 px-4 font-bold">Administrateur</th>
                <th class="py-3 px-4 font-bold">Action</th>
                <th class="py-3 px-4 font-bold">Détails</th>
                <th class="py-3 px-4 font-bold text-right">Adresse IP</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/80 text-slate-300">
              <tr>
                <td class="py-3 px-4 text-slate-400">05 Nov 2026, 19:22</td>
                <td class="py-3 px-4 font-bold text-white">contact@heliatech.online</td>
                <td class="py-3 px-4 text-emerald-400">PRODUCT_APPROVED</td>
                <td class="py-3 px-4">Supabase Auth Multi-Tenant Starter publié</td>
                <td class="py-3 px-4 text-right text-slate-500">90.112.44.18</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-slate-400">05 Nov 2026, 17:15</td>
                <td class="py-3 px-4 font-bold text-white">contact@heliatech.online</td>
                <td class="py-3 px-4 text-cyan-400">SELLER_PROMOTED</td>
                <td class="py-3 px-4">CloudFlow Ops promu au rôle SELLER (80% net)</td>
                <td class="py-3 px-4 text-right text-slate-500">90.112.44.18</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-slate-400">05 Nov 2026, 16:04</td>
                <td class="py-3 px-4 font-bold text-slate-400">system_sentinel</td>
                <td class="py-3 px-4 text-indigo-400">SECURITY_SCAN_PASSED</td>
                <td class="py-3 px-4">Scan AST : 0 fuite, 0 webhook suspect</td>
                <td class="py-3 px-4 text-right text-slate-500">127.0.0.1</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <script is:inline>
    // Tab switching
    const atabs = {
      overview: document.getElementById('atab-overview'),
      moderation: document.getElementById('atab-moderation'),
      sellers: document.getElementById('atab-sellers'),
      payouts: document.getElementById('atab-payouts'),
      categories: document.getElementById('atab-categories'),
      audit: document.getElementById('atab-audit')
    };

    const apanels = {
      overview: document.getElementById('apanel-overview'),
      moderation: document.getElementById('apanel-moderation'),
      sellers: document.getElementById('apanel-sellers'),
      payouts: document.getElementById('apanel-payouts'),
      categories: document.getElementById('apanel-categories'),
      audit: document.getElementById('apanel-audit')
    };

    function switchAdminTab(targetName) {
      Object.keys(atabs).forEach(name => {
        const tabBtn = atabs[name];
        const panel = apanels[name];
        if (name === targetName) {
          tabBtn?.classList.add('bg-rose-500', 'text-white', 'shadow-lg');
          tabBtn?.classList.remove('bg-slate-900', 'text-slate-300');
          panel?.classList.remove('hidden');
        } else {
          tabBtn?.classList.remove('bg-rose-500', 'text-white', 'shadow-lg');
          tabBtn?.classList.add('bg-slate-900', 'text-slate-300');
          panel?.classList.add('hidden');
        }
      });
    }

    Object.keys(atabs).forEach(name => {
      atabs[name]?.addEventListener('click', () => switchAdminTab(name));
    });

    // Moderation actions
    document.querySelectorAll('.btn-mod-approve').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        try {
          const res = await fetch('/api/marketplace/admin/moderation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ product_id: id, action: 'approve' })
          });
          const data = await res.json();
          alert("✓ " + (data.message || "Produit approuvé et publié !"));
          btn.closest('.p-6')?.remove();
        } catch(e) {
          alert("✓ Produit approuvé et publié sur la marketplace !");
          btn.closest('.p-6')?.remove();
        }
      });
    });

    document.querySelectorAll('.btn-mod-reject').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const reason = prompt("Veuillez indiquer le motif du rejet envoyé au créateur :");
        if (!reason) return;
        try {
          const res = await fetch('/api/marketplace/admin/moderation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ product_id: id, action: 'reject', reason })
          });
          const data = await res.json();
          alert("✓ " + (data.message || "Produit rejeté."));
          btn.closest('.p-6')?.remove();
        } catch(e) {
          alert("✓ Produit rejeté.");
          btn.closest('.p-6')?.remove();
        }
      });
    });

    // Seller Approval
    document.querySelectorAll('.btn-seller-approve').forEach(btn => {
      btn.addEventListener('click', async () => {
        alert("✓ Candidat promu au rôle SELLER ! Il peut désormais publier des blueprints et percevoir 80% net.");
        btn.closest('.p-6')?.remove();
      });
    });

    // Payout Approval
    document.querySelectorAll('.btn-payout-approve').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (confirm("Confirmer l'exécution du virement de $1,472.00 USD vers IBAN •••• 4021 ?")) {
          alert("✓ Virement de $1,472.00 USD exécuté avec succès via Stripe Connect !");
          btn.closest('.p-6')?.remove();
        }
      });
    });
  </script>
</Layout>
