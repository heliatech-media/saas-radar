---
import Layout from '../../layouts/Layout.astro';

const pageTitle = "Vendre des Templates & Workflows | HeliaTech Creator Hub (Stealth Staging)";
const pageDescription = "Rejoignez les meilleurs architectes n8n, Make et Airtable. Vendez vos blueprints et touchez 80% de commission nette sur chaque transaction.";
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 pt-12 pb-24">
    
    <!-- Stealth Staging Notice -->
    <div class="flex items-center justify-between p-3.5 mb-8 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-mono">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="font-bold uppercase tracking-wider">Mode Stealth / Staging Privé</span>
        <span class="text-amber-400/70 hidden sm:inline">— Espace Créateur en pré-lancement.</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/portal/" class="px-3 py-1 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/30 text-cyan-200 border border-cyan-500/40 font-bold transition-all">
          Mon Espace Client (/portal) ➔
        </a>
        <a href="/templates/" class="px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-200 border border-amber-500/40 font-bold transition-all">
          Catalogue (/templates) ➔
        </a>
      </div>
    </div>

    <!-- Header Section -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs font-mono font-bold uppercase tracking-wider mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        HeliaTech Creator Economy 2026
      </div>
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight leading-tight mb-6">
        Monétisez vos Workflows <br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-300 to-sky-400">
          Touchez 80% sur Chaque Vente
        </span>
      </h1>
      <p class="text-base text-slate-300 font-light leading-relaxed">
        Vous avez passé des semaines à perfectionner un workflow n8n, un blueprint Make ou une architecture Airtable ? Proposez-le à nos <strong>15 000+ décideurs tech</strong> et encaissez des revenus passifs récurrents.
      </p>
    </div>

    <!-- Interactive Earnings & Commission Simulator -->
    <div class="p-8 rounded-3xl bg-slate-900/70 border border-slate-800 mb-14 space-y-6">
      <div class="flex items-center justify-between border-b border-slate-800 pb-4">
        <div>
          <h2 class="text-lg font-bold text-white">💰 Simulateur de Revenus Créateur</h2>
          <p class="text-xs text-slate-400 font-light">Calcul basé sur notre split transparent : 80% Créateur / 20% HeliaTech.</p>
        </div>
        <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-mono font-bold">
          80% Net Payout
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-mono text-slate-300 mb-2">Prix de vente de votre template ($ USD) :</label>
          <input 
            type="range" 
            id="price-range" 
            min="10" 
            max="150" 
            step="5" 
            value="49" 
            class="w-full accent-cyan-400 cursor-pointer"
          />
          <div class="flex justify-between text-xs font-mono text-slate-400 mt-1">
            <span>$10</span>
            <span id="price-display" class="text-cyan-400 font-bold text-sm">$49</span>
            <span>$150</span>
          </div>
        </div>

        <div>
          <label class="block text-xs font-mono text-slate-300 mb-2">Ventes mensuelles estimées :</label>
          <input 
            type="range" 
            id="sales-range" 
            min="5" 
            max="200" 
            step="5" 
            value="50" 
            class="w-full accent-cyan-400 cursor-pointer"
          />
          <div class="flex justify-between text-xs font-mono text-slate-400 mt-1">
            <span>5 ventes</span>
            <span id="sales-display" class="text-cyan-400 font-bold text-sm">50 ventes</span>
            <span>200 ventes</span>
          </div>
        </div>
      </div>

      <!-- Live Calculation Result Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4 border-t border-slate-800">
        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 text-center">
          <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mb-1">Votre Gain par Vente (80%)</span>
          <span id="creator-per-sale" class="text-xl font-black text-emerald-400 font-mono">$39.20</span>
        </div>
        <div class="p-4 rounded-2xl bg-slate-950 border border-slate-800 text-center">
          <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mb-1">Commission HeliaTech (20%)</span>
          <span id="platform-cut" class="text-xl font-black text-slate-400 font-mono">$9.80</span>
        </div>
        <div class="p-4 rounded-2xl bg-gradient-to-br from-emerald-950/40 to-slate-950 border border-emerald-500/40 text-center">
          <span class="text-[11px] font-mono text-emerald-300 uppercase tracking-wider block mb-1">Vos Revenus Mensuels</span>
          <span id="monthly-total" class="text-2xl font-black text-white font-mono">$1,960.00</span>
        </div>
      </div>
    </div>

    <!-- Workflow Submission Form -->
    <div class="p-8 sm:p-10 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-8">
      <div>
        <h2 class="text-2xl font-bold text-white mb-2">Déposer votre Workflow en Examen</h2>
        <p class="text-xs text-slate-400 font-light">
          Chaque soumission est inspectée par nos agents IA (*DatabaseArchitect* et *MarketplaceSecurity*) pour vérifier l'absence de clés privées et garantir le fonctionnement 100% propre.
        </p>
      </div>

      <form id="submission-form" class="space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-mono text-slate-300 mb-2">Titre du Template :</label>
            <input 
              type="text" 
              required
              placeholder="ex: n8n AI Lead Enrichment & CRM Sync"
              class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-500 text-xs font-mono focus:border-cyan-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-mono text-slate-300 mb-2">Écosystème Principal :</label>
            <select class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none">
              <option value="n8n">🟠 n8n (.json)</option>
              <option value="make">🟣 Make.com (.json blueprint)</option>
              <option value="airtable">🟡 Airtable (Base / Schema)</option>
              <option value="zapier">⚡ Zapier (Template)</option>
              <option value="cursor">🤖 Cursor AI Rules (.cursorrules)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-mono text-slate-300 mb-2">Pitch &amp; Problème résolu (1 à 2 phrases) :</label>
          <input 
            type="text" 
            required
            placeholder="ex: Automatise la prospection B2B sans abonnement mensuel Clay, économise 20h de dev."
            class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-500 text-xs font-mono focus:border-cyan-500 focus:outline-none"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label class="block text-xs font-mono text-slate-300 mb-2">Prix souhaité ($ USD) :</label>
            <input 
              type="number" 
              min="0" 
              max="500" 
              value="49" 
              class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block text-xs font-mono text-slate-300 mb-2">Email pour recevoir les versements (80%) :</label>
            <input 
              type="email" 
              required
              placeholder="votre-email@domaine.com"
              class="w-full px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-500 text-xs font-mono focus:border-cyan-500 focus:outline-none"
            />
          </div>
        </div>

        <!-- File Upload Area -->
        <div>
          <label class="block text-xs font-mono text-slate-300 mb-2">Fichier Workflow (.json, .zip ou blueprint) :</label>
          <div class="p-8 border-2 border-dashed border-slate-800 hover:border-cyan-500/50 rounded-2xl bg-slate-900/40 text-center transition-all cursor-pointer">
            <div class="text-3xl mb-2">📦</div>
            <p class="text-xs font-mono text-slate-300 font-semibold mb-1">Glissez votre fichier .json ou cliquez pour parcourir</p>
            <p class="text-[10px] font-mono text-slate-500">Taille max : 25 Mo. Scan automatique de sécurité anti-fuite de clés inclus.</p>
          </div>
        </div>

        <button 
          type="submit"
          class="w-full py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider text-center transition-all shadow-glow-cyan"
        >
          Soumettre mon Workflow &amp; Activer mon Compte Vendeur ➔
        </button>
      </form>
    </div>

  </div>

  <script is:inline>
    // Live simulator calculations
    const priceRange = document.getElementById('price-range');
    const salesRange = document.getElementById('sales-range');
    const priceDisplay = document.getElementById('price-display');
    const salesDisplay = document.getElementById('sales-display');
    const creatorPerSale = document.getElementById('creator-per-sale');
    const platformCut = document.getElementById('platform-cut');
    const monthlyTotal = document.getElementById('monthly-total');

    function updateSim() {
      const p = parseFloat(priceRange.value);
      const s = parseInt(salesRange.value);

      priceDisplay.textContent = `$${p}`;
      salesDisplay.textContent = `${s} ventes`;

      const creatorCut = (p * 0.8).toFixed(2);
      const heliaCut = (p * 0.2).toFixed(2);
      const total = (p * 0.8 * s).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      creatorPerSale.textContent = `$${creatorCut}`;
      platformCut.textContent = `$${heliaCut}`;
      monthlyTotal.textContent = `$${total}`;
    }

    priceRange?.addEventListener('input', updateSim);
    salesRange?.addEventListener('input', updateSim);

    document.getElementById('submission-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      alert("✅ [Mode Stealth / Simulation] : Workflow reçu et scanné avec succès par Helia-MarketplaceSecurity (0 vulnérabilité détectée). Enregistrement dans le staging.");
    });
  </script>
</Layout>
