    // --- 8. REAL JSON BLOB DOWNLOAD GENERATOR ---
    function triggerDownloadJson(title, ecosystem, filename) {
      let content = {};
      if (ecosystem === 'n8n') {
        content = {
          "name": title,
          "nodes": [
            {
              "parameters": { "path": "webhook-inbound", "responseMode": "onReceived" },
              "name": "Webhook Inbound Receiver",
              "type": "n8n-nodes-base.webhook",
              "typeVersion": 1,
              "position": [250, 300]
            },
            {
              "parameters": {
                "model": "gpt-4o-mini",
                "prompt": "Evaluate inbound lead against ICP. Clean data and structure response."
              },
              "name": "AI Pipeline Engine",
              "type": "n8n-nodes-base.openAi",
              "typeVersion": 1,
              "position": [480, 300]
            },
            {
              "parameters": { "resource": "record", "operation": "append" },
