        version: "1.0.0",
        creator_name: "AutomateScale Studio",
        creator_slug: "automatescale-studio",
        invoice_id: `HLT-INV-2026-${Math.floor(1000 + Math.random() * 9000)}`,
        license_key: `HLT-${ecosystem.toUpperCase().slice(0,3)}-${Math.floor(1000 + Math.random() * 9000)}-COMMERCIAL-KEY`,
        nodes_count: 12,
        filename: `heliatech-${ecosystem}-${slug}.json`
