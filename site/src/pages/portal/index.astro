                  <button 
                    class="download-workflow-btn px-4 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-400 hover:from-cyan-400 hover:to-sky-300 text-slate-950 font-mono text-xs font-bold transition-all shadow-glow-cyan flex items-center gap-2"
                    data-title="${p.title}"
                    data-ecosystem="${p.ecosystem}"
