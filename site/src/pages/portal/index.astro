---
import Layout from '../../layouts/Layout.astro';
import templates from '../../data/templates_catalog.json';

const pageTitle = "Espace Client & Studio Créateur | HeliaTech Hub (Stealth Staging)";
const pageDescription = "Gérez vos licences de workflows n8n, Make et Airtable achetés, téléchargez vos fichiers .json et pilotez vos ventes avec audit anti-scam certifié.";
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-24">
    
    <!-- Stealth Staging Top Notice -->
    <div class="flex items-center justify-between p-3.5 mb-8 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-mono">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span class="font-bold uppercase tracking-wider">Mode Stealth / Staging Privé</span>
        <span class="text-amber-400/70 hidden md:inline">— Espace Client &amp; Studio Créateur avec Scanner Anti-Scam actif.</span>
      </div>
      <div class="flex items-center gap-3">
        <a href="/templates/" class="px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-200 border border-amber-500/40 font-bold transition-all">
          Catalogue (/templates/) ➔
        </a>
        <a href="/sell/" class="px-3 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-200 border border-emerald-500/40 font-bold transition-all">
          Vendre (/sell/) ➔
        </a>
      </div>
    </div>

    <!-- Main Header Bar: User Profile & Dynamic Mode Switcher -->
    <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-slate-800 mb-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 shadow-2xl">
      
      <!-- User Info & Avatar -->
      <div class="flex items-center gap-4">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500 via-sky-600 to-indigo-600 p-0.5 shadow-glow-cyan flex-shrink-0">
          <div class="w-full h-full bg-slate-950 rounded-2xl flex items-center justify-center text-xl font-bold text-white font-mono" id="user-avatar-initials">
            HT
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2.5 mb-1">
            <h1 class="text-xl sm:text-2xl font-black text-white" id="user-display-name">Alexandre R.</h1>
            <span id="user-role-badge" class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-bold">
              Acheteur Vérifié
            </span>
          </div>
          <div class="flex items-center gap-3 text-xs text-slate-400 font-mono">
            <span id="user-email">alexandre.partner@heliatech.online</span>
            <span>•</span>
            <span class="text-emerald-400 flex items-center gap-1 font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Session Sécurisée
            </span>
          </div>
        </div>
      </div>

      <!-- Unified Dual-Mode Tabs Switcher -->
      <div class="flex items-center p-1.5 rounded-2xl bg-slate-950 border border-slate-800 w-full lg:w-auto">
        <button 
          id="btn-buyer-mode" 
          class="flex-1 lg:flex-none flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl font-mono text-xs font-bold transition-all bg-cyan-500 text-slate-950 shadow-glow-cyan"
        >
          <span>🛒</span> Espace Acheteur (Mes Blueprints)
        </button>
        <button 
          id="btn-seller-mode" 
          class="flex-1 lg:flex-none flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl font-mono text-xs font-bold transition-all text-slate-400 hover:text-white"
        >
          <span>💼</span> Espace Vendeur (Mon Studio 80%)
        </button>
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 🛒 1. VUE ACHETEUR (Mes Blueprints, Licences, Factures & Téléchargements) -->
    <!-- ========================================================================= -->
    <div id="buyer-dashboard-view" class="space-y-8">
      
      <!-- Buyer Telemetry Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl font-black text-cyan-400 font-mono mb-1" id="stat-buyer-blueprints">2 Blueprints</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Licences Commerciales Actives</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl font-black text-emerald-400 font-mono mb-1">~48 Heures</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Temps de Dev Économisé</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
          <div class="text-2xl font-black text-indigo-400 font-mono mb-1">100% Anti-Scam</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Code Certifié &amp; Sans Fuite API</div>
        </div>
      </div>

      <!-- Purchased Blueprints Library -->
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>📦</span> Vos Blueprints Achetés &amp; Prêts à Déployer
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Téléchargez immédiatement vos fichiers .json propres, accédez à vos clés de licence commerciale et aux guides d'import.
            </p>
          </div>
          <a href="/templates/" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 text-xs font-mono font-bold transition-all">
            + Parcourir le Catalogue ➔
          </a>
        </div>

        <!-- Buyer Blueprints Container (Dynamic from localStorage or default) -->
        <div id="buyer-blueprints-list" class="space-y-4">
          <!-- Rendered dynamically via JavaScript -->
        </div>

      </div>

      <!-- Invoices & Transaction History -->
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/60 border border-slate-800 space-y-4">
        <h3 class="text-sm font-bold text-white font-mono uppercase tracking-wider flex items-center gap-2">
          <span>🧾</span> Historique de Facturation &amp; Justificatifs Comptables
        </h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs font-mono">
            <thead>
              <tr class="text-slate-400 border-b border-slate-800">
                <th class="pb-3">Date</th>
                <th class="pb-3">Réf. Facture</th>
                <th class="pb-3">Produit</th>
                <th class="pb-3">Montant Net</th>
                <th class="pb-3">Statut</th>
                <th class="pb-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody id="buyer-invoices-list" class="text-slate-300 divide-y divide-slate-900">
              <!-- Rendered via JS -->
            </tbody>
          </table>
        </div>
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 💼 2. VUE VENDEUR (Mon Studio, CRUD Produits, Audit Anti-Scam & Payouts 80%) -->
    <!-- ========================================================================= -->
    <div id="seller-dashboard-view" class="space-y-8 hidden">
      
      <!-- Seller Real-time Financial Telemetry -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="p-5 rounded-2xl bg-gradient-to-br from-emerald-950/40 via-slate-900 to-slate-900 border border-emerald-500/40 text-center">
          <div class="text-2xl sm:text-3xl font-black text-emerald-400 font-mono mb-1" id="stat-seller-earnings">$1,420.80</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Vos Gains Nets (80%)</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
          <div class="text-2xl sm:text-3xl font-black text-cyan-400 font-mono mb-1" id="stat-seller-sales">36 Ventes</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Ventes Confirmées</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
          <div class="text-2xl sm:text-3xl font-black text-fuchsia-400 font-mono mb-1" id="stat-seller-rating">4.9 ★</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Note Moyenne Clients</div>
        </div>
        <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 text-center">
          <div class="text-2xl sm:text-3xl font-black text-amber-400 font-mono mb-1" id="stat-seller-pending">$392.00</div>
          <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Prochain Versement (01 Déc)</div>
        </div>
      </div>

      <!-- Seller Blueprints Management & CRUD Table -->
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-5">
          <div>
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>💼</span> Vos Blueprints Publiés en Vente
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Gérez votre catalogue, éditez les prix, retéléchargez vos fichiers et consultez le score d'audit Anti-Scam.
            </p>
          </div>
          <button 
            id="open-upload-modal-btn"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 font-mono text-xs font-bold transition-all shadow-glow-cyan"
          >
            <span>⚡</span> + Déposer un Nouveau Template ➔
          </button>
        </div>

        <!-- Dynamic Seller Products Cards / Table -->
        <div id="seller-products-list" class="space-y-4">
          <!-- Rendered dynamically via JavaScript -->
        </div>

      </div>

      <!-- Payout Settings & Stripe Connect Account -->
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/60 border border-slate-800 space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <h3 class="text-sm font-bold text-white font-mono uppercase tracking-wider flex items-center gap-2">
            <span>🏦</span> Paramètres de Versement (Split 80% Créateur / 20% HeliaTech)
          </h3>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px] font-mono font-bold w-fit">
            ✓ Compte Stripe Connect Rattaché
          </span>
        </div>
        <p class="text-xs text-slate-400 font-light">
          Vos versements sont expédiés automatiquement le 1er de chaque mois directement sur votre compte bancaire (IBAN) ou PayPal.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono pt-2">
          <div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800">
            <span class="text-slate-400 block mb-1">Email pour vos Reversements :</span>
            <span class="text-white font-bold" id="seller-payout-email">alexandre.partner@heliatech.online</span>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-900/80 border border-slate-800">
            <span class="text-slate-400 block mb-1">Prochain Virement Programmé :</span>
            <span class="text-emerald-400 font-bold">$392.00 USD (01 Décembre 2026)</span>
          </div>
        </div>
      </div>

    </div>

    <!-- Quick Switcher Bar (For Testing Perspective) -->
    <div class="mt-12 p-4 rounded-2xl bg-slate-900/40 border border-slate-800/80 flex flex-wrap items-center justify-between gap-4 text-xs font-mono">
      <div class="text-slate-400">
        <span class="text-cyan-400 font-bold">💡 Simulateur d'Espace Client :</span> Basculez instantanément pour tester les deux perspectives ou réinitialisez les données de test.
      </div>
      <div class="flex items-center gap-2">
        <button id="quick-demo-buyer" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-all">
          Vue Acheteur
        </button>
        <button id="quick-demo-seller" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 transition-all">
          Vue Vendeur
        </button>
        <button id="btn-reset-data" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-red-950 text-slate-400 hover:text-red-300 border border-slate-800 hover:border-red-800 transition-all">
          🔄 Réinitialiser Données Démo
        </button>
      </div>
    </div>

  </div>

  <!-- ========================================================================= -->
  <!-- 🛡️ MODALS INTERACTIFS (Upload avec Anti-Scam, Édition, Suppression, Facture) -->
  <!-- ========================================================================= -->

  <!-- 1. MODAL D'UPLOAD AVEC SCANNER ANTI-SCAM EN TEMPS RÉEL -->
  <div id="upload-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="bg-slate-950 border border-slate-800 rounded-3xl max-w-2xl w-full p-6 sm:p-8 space-y-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-slate-800 pb-4">
        <div>
          <h3 class="text-xl font-bold text-white flex items-center gap-2">
            <span>🛡️</span> Déposer un Template avec Scanner Anti-Scam
          </h3>
          <p class="text-xs text-slate-400 font-light mt-0.5">
            Chaque blueprint subit une vérification structurelle AST et une désinfection de clés en temps réel.
          </p>
        </div>
        <button id="close-upload-modal-btn" class="w-8 h-8 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center text-sm font-bold">
          ✕
        </button>
      </div>

      <form id="upload-template-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1.5">Titre du Blueprint :</label>
            <input 
              type="text" 
              id="upload-title" 
              required 
              placeholder="ex: n8n HubSpot CRM & AI Lead Enricher"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-500 text-xs font-mono focus:border-cyan-500 focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1.5">Écosystème Principal :</label>
            <select id="upload-ecosystem" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none">
              <option value="n8n">🟠 n8n (.json workflow)</option>
              <option value="make">🟣 Make.com (.json blueprint)</option>
              <option value="airtable">🟡 Airtable (Base / Schema)</option>
              <option value="cursor">🤖 Cursor AI (.cursorrules)</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1.5">Prix Public ($ USD) :</label>
            <input 
              type="number" 
              id="upload-price" 
              min="5" 
              max="500" 
              value="49" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
            />
            <span class="text-[10px] font-mono text-emerald-400 mt-1 block">Votre part nette (80%) : <strong id="upload-net-gain">$39.20</strong></span>
          </div>
          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1.5">Version Initiale :</label>
            <input 
              type="text" 
              id="upload-version" 
              value="1.0.0" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-mono text-slate-300 mb-1.5">Pitch &amp; Problème Résolu :</label>
          <input 
            type="text" 
            id="upload-tagline" 
            required 
            placeholder="ex: Automatise la prospection B2B sans abonnement Clay, fait gagner 20h de dev."
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-500 text-xs font-mono focus:border-cyan-500 focus:outline-none"
          />
        </div>

        <!-- File Upload Drag & Drop Area -->
        <div>
          <label class="block text-xs font-mono text-slate-300 mb-1.5">Fichier Workflow (.json) :</label>
          <div id="drop-zone" class="p-8 border-2 border-dashed border-slate-800 hover:border-cyan-500/50 rounded-2xl bg-slate-900/40 text-center transition-all cursor-pointer">
            <div class="text-3xl mb-2">📦</div>
            <p class="text-xs font-mono text-slate-300 font-semibold mb-1" id="drop-zone-text">
              Cliquez pour parcourir vos fichiers ou glissez votre workflow .json ici
            </p>
            <p class="text-[10px] font-mono text-slate-500">
              Formats supportés : .json (n8n, Make.com, Airtable, Cursor). Audit automatique anti-scam et désinfection de clés inclus.
            </p>
            <input type="file" id="file-input" accept=".json,.txt" class="hidden" />
          </div>
        </div>

        <!-- Real-Time Anti-Scam Scanner Checklist -->
        <div id="anti-scam-audit-box" class="p-4 rounded-2xl bg-slate-900/70 border border-slate-800 space-y-3 hidden">
          <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
            <span class="text-xs font-mono text-slate-300 font-bold uppercase tracking-wider flex items-center gap-1.5">
              <span>🔍</span> Audit Sentinel Anti-Scam
            </span>
            <span id="scanner-trust-badge" class="text-[10px] font-mono px-2 py-0.5 rounded font-bold bg-cyan-500/10 text-cyan-400 border border-cyan-500/30">
              Analyse en cours...
            </span>
          </div>

          <ul class="text-xs font-mono space-y-2" id="scanner-checklist">
            <li class="flex items-center gap-2" id="chk-structure">
              <span class="chk-icon">⏳</span> <span>Vérification structurelle AST (Nœuds &gt;= 2 et connexions)</span>
            </li>
            <li class="flex items-center gap-2" id="chk-phishing">
              <span class="chk-icon">⏳</span> <span>Scan anti-phishing &amp; shortlinks masqués (bit.ly, ngrok, discord)</span>
            </li>
            <li class="flex items-center gap-2" id="chk-secrets">
              <span class="chk-icon">⏳</span> <span>Recherche de clés API exposées (OpenAI, Stripe, tokens)</span>
            </li>
            <li class="flex items-center gap-2" id="chk-malware">
              <span class="chk-icon">⏳</span> <span>Contrôle de code malveillant (eval, exec, injection)</span>
            </li>
          </ul>

          <div id="scanner-verdict-alert" class="p-2.5 rounded-xl text-xs font-mono hidden">
            <!-- Dynamic verdict text -->
          </div>
        </div>

        <button 
          type="submit" 
          id="btn-submit-blueprint" 
          disabled
          class="w-full py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider text-center transition-all opacity-50 cursor-not-allowed shadow-glow-cyan"
        >
          Valider &amp; Mettre en Ligne mon Blueprint ➔
        </button>
      </form>
    </div>
  </div>

  <!-- 2. MODAL D'ÉDITION DE PRODUIT VENDEUR -->
  <div id="edit-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 hidden">
    <div class="bg-slate-950 border border-slate-800 rounded-3xl max-w-lg w-full p-6 sm:p-8 space-y-5 shadow-2xl relative">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
          <span>✏️</span> Modifier votre Blueprint
        </h3>
        <button id="close-edit-modal-btn" class="w-8 h-8 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-white flex items-center justify-center text-sm font-bold">
          ✕
        </button>
      </div>

      <form id="edit-product-form" class="space-y-4">
        <input type="hidden" id="edit-product-id" />
        
        <div>
          <label class="block text-xs font-mono text-slate-300 mb-1">Titre :</label>
          <input 
            type="text" 
            id="edit-title" 
            required 
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
          />
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1">Prix ($ USD) :</label>
            <input 
              type="number" 
              id="edit-price" 
              min="5" 
              max="500" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-xs font-mono text-slate-300 mb-1">Version :</label>
            <input 
              type="text" 
              id="edit-version" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-mono text-slate-300 mb-1">Pitch court :</label>
          <input 
            type="text" 
            id="edit-tagline" 
            class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
          />
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button type="button" id="cancel-edit-btn" class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 text-xs font-mono">
            Annuler
          </button>
