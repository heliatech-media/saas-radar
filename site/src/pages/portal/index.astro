      localStorage.setItem('_ht_seller_products', JSON.stringify(DEFAULT_SELLER_PRODUCTS));
      return DEFAULT_SELLER_PRODUCTS;
    }

    function saveSellerProducts(data) {
      localStorage.setItem('_ht_seller_products', JSON.stringify(data));
      renderSellerDashboard();
    }

    function getSellerInbox() {
      const stored = localStorage.getItem('_ht_seller_inbox');
      if (stored) {
        try { return JSON.parse(stored); } catch(e) {}
      }
      localStorage.setItem('_ht_seller_inbox', JSON.stringify(DEFAULT_SELLER_INBOX));
      return DEFAULT_SELLER_INBOX;
    }

    function saveSellerInbox(data) {
      localStorage.setItem('_ht_seller_inbox', JSON.stringify(data));
      renderSellerInbox();
    }

