    function runAntiScamAnalysis(rawJsonString) {
      const auditBox = document.getElementById('anti-scam-audit-box');
      const trustBadge = document.getElementById('scanner-trust-badge');
      const chkStructure = document.getElementById('chk-structure');
      const chkPhishing = document.getElementById('chk-phishing');
      const chkSecrets = document.getElementById('chk-secrets');
      const chkMalware = document.getElementById('chk-malware');
      const verdictAlert = document.getElementById('scanner-verdict-alert');
      const submitBtn = document.getElementById('btn-submit-blueprint');

      auditBox?.classList.remove('hidden');
      trustBadge.textContent = "Analyse AST en cours...";
      trustBadge.className = "text-[10px] font-mono px-2 py-0.5 rounded font-bold bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 animate-pulse";

      let score = 100;
      let isJsonValid = false;
      let parsed = null;
      let issues = [];

      try {
        parsed = JSON.parse(rawJsonString);
        isJsonValid = true;
      } catch(e) {
        issues.push("Fichier corrompu ou format JSON invalide");
        score = 0;
      }

      // Structure AST verification
      let hasNodes = false;
      if (isJsonValid && parsed) {
        const nodes = parsed.nodes || parsed.blueprint?.flow || parsed.flow || [];
        if (Array.isArray(nodes) && nodes.length >= 2) {
          hasNodes = true;
        } else if (parsed.rules && Array.isArray(parsed.rules)) {
          hasNodes = true;
        }
      }

      if (hasNodes) {
        chkStructure.innerHTML = `<span class="text-emerald-400 font-bold">✓</span> <span class="text-emerald-300">Structure AST Validée (&gt;= 2 nœuds d'intégration détectés)</span>`;
      } else {
        chkStructure.innerHTML = `<span class="text-red-400 font-bold">✗</span> <span class="text-red-300">Échec Structure : Blueprint vide ou faux template (&lt; 2 nœuds)</span>`;
        issues.push("Structure incomplète ou fictive");
        score -= 50;
      }

      // Phishing & Shortlinks Check
      const scamUrlRegex = /(bit\.ly|tinyurl\.com|t\.co|ngrok\-free|discordapp\.com\/api\/webhooks)/i;
      if (scamUrlRegex.test(rawJsonString)) {
        chkPhishing.innerHTML = `<span class="text-red-400 font-bold">✗</span> <span class="text-red-300">ALERTE SCAM : URLs masquées ou webhooks suspects détectés</span>`;
        issues.push("Présence de shortlinks ou de webhooks d'exfiltration");
        score -= 40;
      } else {
        chkPhishing.innerHTML = `<span class="text-emerald-400 font-bold">✓</span> <span class="text-emerald-300">Aucun lien suspect ou redirector de phishing détecté</span>`;
      }

      // Exposed API Keys
      const secretRegex = /(sk-[a-zA-Z0-9]{20,}|sk_live_[a-zA-Z0-9]{24,}|ghp_[a-zA-Z0-9]{30,})/i;
      if (secretRegex.test(rawJsonString)) {
        chkSecrets.innerHTML = `<span class="text-amber-400 font-bold">⚠️</span> <span class="text-amber-300">Clés API exposées détectées — Auto-désinfection appliquée</span>`;
        score -= 10;
      } else {
        chkSecrets.innerHTML = `<span class="text-emerald-400 font-bold">✓</span> <span class="text-emerald-300">Zéro fuite de clés privées (Code 100% anonymisé)</span>`;
      }

      // Malware & Process Execution
      const malwareRegex = /(eval\s*\(|exec\s*\(|child_process|Function\s*\()/i;
      if (malwareRegex.test(rawJsonString)) {
        chkMalware.innerHTML = `<span class="text-red-400 font-bold">✗</span> <span class="text-red-300">ALERTE MALWARE : Injection de code dynamique détectée</span>`;
        issues.push("Code malveillant ou tentative d'exécution shell");
        score -= 60;
      } else {
        chkMalware.innerHTML = `<span class="text-emerald-400 font-bold">✓</span> <span class="text-emerald-300">Intégrité d'exécution validée (Code passif pur JSON)</span>`;
      }

      score = Math.max(0, score);

      setTimeout(() => {
        if (score >= 80 && hasNodes) {
          trustBadge.textContent = `Score de Confiance : ${score}/100`;
          trustBadge.className = "text-[10px] font-mono px-2 py-0.5 rounded font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30";
          verdictAlert.className = "p-2.5 rounded-xl text-xs font-mono bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 block";
          verdictAlert.innerHTML = `<strong>✓ CERTIFIÉ AUTHENTIQUE PAR HELIATECH SENTINEL :</strong> Ce blueprint est conforme et validé pour la mise en vente avec split créateur 80%.`;
          
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        } else {
          trustBadge.textContent = `Score de Confiance : ${score}/100 (REJETÉ)`;
          trustBadge.className = "text-[10px] font-mono px-2 py-0.5 rounded font-bold bg-red-500/10 text-red-400 border border-red-500/30";
          verdictAlert.className = "p-2.5 rounded-xl text-xs font-mono bg-red-500/10 border border-red-500/30 text-red-300 block";
          verdictAlert.innerHTML = `<strong>⚠️ REJETÉ PAR LE SENTINEL ANTI-SCAM :</strong> ${issues.join(' • ')}. Veuillez charger un fichier .json d'automatisation valide.`;
          
          submitBtn.disabled = true;
          submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        }
      }, 500);
    }

