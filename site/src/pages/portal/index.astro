    document.getElementById('subtab-seller-support')?.addEventListener('click', () => switchSellerSubtab('panel-seller-support', 'subtab-seller-support'));
    document.getElementById('subtab-seller-profile')?.addEventListener('click', () => switchSellerSubtab('panel-seller-profile', 'subtab-seller-profile'));
    document.getElementById('subtab-seller-payouts')?.addEventListener('click', () => switchSellerSubtab('panel-seller-payouts', 'subtab-seller-payouts'));

    // --- 12. BUYER SUPPORT & CHAT SIMULATOR ---
    const chatContainer = document.getElementById('support-chat-messages');
    const defaultChat = [
      { sender: 'creator', text: "Bonjour Alexandre ! Merci d'avoir choisi nos blueprints. Je suis disponible si vous avez la moindre question pour le déploiement ou la connexion d'API.", time: "10:14" },
      { sender: 'buyer', text: "Bonjour ! Est-ce que les webhooks sont compatibles avec un déploiement n8n sur Docker ?", time: "10:18" },
      { sender: 'creator', text: "Absolument ! Tous nos nœuds utilisent des routes relatives standard. Vous avez juste à configurer votre WEBHOOK_URL dans vos variables d'environnement Docker.", time: "10:20" }
    ];

    function renderSupportChat() {
      if (!chatContainer) return;
      chatContainer.innerHTML = defaultChat.map(m => {
        const isBuyer = m.sender === 'buyer';
        return `
          <div class="flex flex-col ${isBuyer ? 'items-end' : 'items-start'}">
            <div class="flex items-center gap-1.5 mb-1 text-[10px] text-slate-500">
              <span>${isBuyer ? 'Vous (Alexandre R.)' : 'AutomateScale Studio'}</span>
              <span>• ${m.time}</span>
            </div>
            <div class="p-3 rounded-2xl max-w-md ${isBuyer ? 'bg-cyan-500 text-slate-950 font-semibold' : 'bg-slate-800 text-slate-200 border border-slate-700'}">
              ${m.text}
            </div>
          </div>
        `;
      }).join('');
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    document.getElementById('support-message-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = document.getElementById('support-message-input');
      const val = input.value.trim();
      if (!val) return;

      const now = new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });
      defaultChat.push({ sender: 'buyer', text: val, time: now });
      renderSupportChat();
      input.value = "";

      // Realistic instant assistant feedback
      setTimeout(() => {
        defaultChat.push({
          sender: 'creator',
          text: `Merci pour votre message ! Un architecte certifié examine votre demande technique (${val.slice(0, 30)}...) et vous répond en détail.`,
          time: new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })
        });
        renderSupportChat();
      }, 700);
    });

    document.querySelectorAll('.quick-prompt-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const input = document.getElementById('support-message-input');
        if (input) input.value = btn.textContent.trim().replace(/^[^\s]+\s*/, '');
      });
    });

    // --- 13. B2B BILLING FORM ---
    document.getElementById('buyer-b2b-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const b2b = {
        company: document.getElementById('b2b-company').value,
        vat: document.getElementById('b2b-vat').value,
        address: document.getElementById('b2b-address').value,
        country: document.getElementById('b2b-country').value,
        email: document.getElementById('b2b-email').value,
        currency: document.getElementById('b2b-currency').value
      };
      localStorage.setItem('_ht_buyer_b2b', JSON.stringify(b2b));
      alert("✓ Coordonnées d'entreprise B2B enregistrées avec succès !\nElles figureront sur l'ensemble de vos prochaines factures officielles.");
    });

    // Populate B2B Form from localStorage
    const savedB2b = getBuyerB2B();
    if (document.getElementById('b2b-company')) document.getElementById('b2b-company').value = savedB2b.company || '';
    if (document.getElementById('b2b-vat')) document.getElementById('b2b-vat').value = savedB2b.vat || '';
    if (document.getElementById('b2b-address')) document.getElementById('b2b-address').value = savedB2b.address || '';
    if (document.getElementById('b2b-country')) document.getElementById('b2b-country').value = savedB2b.country || 'France';
    if (document.getElementById('b2b-email')) document.getElementById('b2b-email').value = savedB2b.email || '';
    if (document.getElementById('b2b-currency')) document.getElementById('b2b-currency').value = savedB2b.currency || 'USD';

    // --- 14. API TOKEN CONTROLLER ---
    document.getElementById('toggle-token-btn')?.addEventListener('click', () => {
      const field = document.getElementById('deploy-token-field');
      const btn = document.getElementById('toggle-token-btn');
      if (field.type === 'password') {
        field.type = 'text';
        btn.textContent = '🔒 Masquer';
      } else {
        field.type = 'password';
        btn.textContent = '👁️ Afficher';
      }
    });

    document.getElementById('copy-token-btn')?.addEventListener('click', () => {
      const field = document.getElementById('deploy-token-field');
      navigator.clipboard.writeText(field.value);
      const btn = document.getElementById('copy-token-btn');
      btn.textContent = '✓ Copié !';
      setTimeout(() => { btn.textContent = '📋 Copier'; }, 2000);
    });

    document.getElementById('btn-regen-token')?.addEventListener('click', () => {
      if (confirm("Générer un nouveau Token de Déploiement API ? L'ancien token sera révoqué.")) {
        const rand = Array.from(crypto.getRandomValues(new Uint8Array(12))).map(b => b.toString(16).padStart(2, '0')).join('');
        document.getElementById('deploy-token-field').value = `hlt_live_deploy_${rand}`;
        alert("✓ Nouveau Token API généré avec succès !");
      }
    });

    // Buy all wishlist
    document.getElementById('btn-buy-all-wishlist')?.addEventListener('click', () => {
      const wl = getBuyerWishlist();
      if (wl.length === 0) return;

      if (confirm(`Commander les ${wl.length} blueprints de votre wishlist ?`)) {
        wl.forEach(item => {
          executeBuyerPurchase(item.title, item.slug, item.ecosystem, item.price);
        });
        localStorage.setItem('_ht_buyer_wishlist', JSON.stringify([]));
        renderBuyerWishlist();
      }
    });

    // --- 15. SELLER PROFILE FORM ---
    document.getElementById('seller-profile-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const studioProfile = {
        name: document.getElementById('seller-studio-name').value,
        badge: document.getElementById('seller-studio-badge').value,
        bio: document.getElementById('seller-studio-bio').value,
        website: document.getElementById('seller-studio-website').value,
        github: document.getElementById('seller-studio-github').value,
        linkedin: document.getElementById('seller-studio-linkedin').value
      };
      localStorage.setItem('_ht_seller_profile', JSON.stringify(studioProfile));
      alert("✓ Profil Studio Créateur mis à jour ! Votre vitrine publique a été actualisée.");
    });

    // Tax cert download
    document.getElementById('btn-download-tax-cert')?.addEventListener('click', () => {
      alert("✓ Génération de l'attestation fiscale annuelle 2026 (Revenus nets de cession de licences logicielles sous le régime des redevances d'auteur/split 80%).");
    });

    // --- 16. DUAL-MODE SWITCHER LOGIC ---
    const btnBuyer = document.getElementById('btn-buyer-mode');
    const btnSeller = document.getElementById('btn-seller-mode');
    const buyerView = document.getElementById('buyer-dashboard-view');
    const sellerView = document.getElementById('seller-dashboard-view');
    const userDisplayName = document.getElementById('user-display-name');
    const userRoleBadge = document.getElementById('user-role-badge');
    const userInitials = document.getElementById('user-avatar-initials');

    function setBuyerMode() {
      btnBuyer.classList.add('bg-cyan-500', 'text-slate-950', 'shadow-glow-cyan');
      btnBuyer.classList.remove('text-slate-400');
      btnSeller.classList.remove('bg-cyan-500', 'text-slate-950', 'shadow-glow-cyan');
      btnSeller.classList.add('text-slate-400');

      buyerView.classList.remove('hidden');
      sellerView.classList.add('hidden');

      userDisplayName.textContent = "Alexandre R.";
      userRoleBadge.textContent = "Acheteur Vérifié";
      userRoleBadge.className = "text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-bold";
      userInitials.textContent = "AR";
      localStorage.setItem('_ht_portal_role', 'buyer');
      renderBuyerDashboard();
      renderBuyerWishlist();
      renderSupportChat();
    }

    function setSellerMode() {
      btnSeller.classList.add('bg-cyan-500', 'text-slate-950', 'shadow-glow-cyan');
      btnSeller.classList.remove('text-slate-400');
      btnBuyer.classList.remove('bg-cyan-500', 'text-slate-950', 'shadow-glow-cyan');
      btnBuyer.classList.add('text-slate-400');

      sellerView.classList.remove('hidden');
      buyerView.classList.add('hidden');

      userDisplayName.textContent = "Alexandre R. (Studio Créateur)";
      userRoleBadge.textContent = "Architecte Vendeur (80% Net)";
      userRoleBadge.className = "text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-bold";
      userInitials.textContent = "AS";
      localStorage.setItem('_ht_portal_role', 'seller');
      renderSellerDashboard();
      renderSellerInbox();
    }

    btnBuyer?.addEventListener('click', setBuyerMode);
    btnSeller?.addEventListener('click', setSellerMode);
    document.getElementById('quick-demo-buyer')?.addEventListener('click', setBuyerMode);
    document.getElementById('quick-demo-seller')?.addEventListener('click', setSellerMode);

    document.getElementById('btn-reset-data')?.addEventListener('click', () => {
      if (confirm("Réinitialiser toutes les données de test à l'état d'origine ?")) {
        localStorage.removeItem('_ht_buyer_purchases');
        localStorage.removeItem('_ht_buyer_wishlist');
        localStorage.removeItem('_ht_seller_products');
        localStorage.removeItem('_ht_seller_inbox');
        localStorage.removeItem('_ht_buyer_b2b');
        renderBuyerDashboard();
        renderBuyerWishlist();
        renderSellerDashboard();
        renderSellerInbox();
        alert("✓ Données démo réinitialisées.");
      }
    });

    // Boot on load
    if (localStorage.getItem('_ht_portal_role') === 'seller') {
      setSellerMode();
    } else {
      setBuyerMode();
    }
  </script>
</Layout>
