                  <button 
                    class="open-review-btn px-3 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-amber-300 border border-slate-800 text-xs font-mono transition-all flex items-center gap-1"
                    data-id="${p.id}"
                    data-title="${p.title}"
                  >
                    <span>★</span> Noter
                  </button>
                </div>
              </div>
            `;
          }).join('');
        }
      }

      if (invoicesEl) {
        invoicesEl.innerHTML = purchases.map(p => `
          <tr>
            <td class="py-3">${p.date}</td>
            <td class="py-3 text-slate-400">${p.invoice_id}</td>
            <td class="py-3 font-semibold text-white">${p.title}</td>
            <td class="py-3 text-emerald-400 font-bold">$${p.price}.00 USD</td>
            <td class="py-3"><span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 text-[10px]">Payé & Validé</span></td>
            <td class="py-3 text-right">
              <button 
                class="view-invoice-btn text-cyan-400 hover:underline"
                data-inv="${p.invoice_id}"
                data-title="${p.title}"
                data-price="${p.price}"
                data-date="${p.date}"
              >
                Reçu PDF
              </button>
            </td>
          </tr>
        `).join('');
      }

      bindBuyerActionButtons();
    }

    // --- 4. DYNAMIC RENDERING: SELLER VIEW ---
    function renderSellerDashboard() {
      const products = getSellerProducts();
      const listEl = document.getElementById('seller-products-list');
      
      // Calculate real stats
      let totalSales = 0;
      let totalGains = 0;
      products.forEach(p => {
        totalSales += (p.sales_count || 0);
        totalGains += (p.sales_count || 0) * (p.price * 0.8);
      });

      const gainsEl = document.getElementById('stat-seller-earnings');
      const salesEl = document.getElementById('stat-seller-sales');
      if (gainsEl) gainsEl.textContent = `$${totalGains.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
      if (salesEl) salesEl.textContent = `${totalSales} Vente${totalSales > 1 ? 's' : ''}`;

      if (listEl) {
        if (products.length === 0) {
          listEl.innerHTML = `
            <div class="p-8 text-center border border-dashed border-slate-800 rounded-2xl">
              <p class="text-xs font-mono text-slate-400 mb-3">Aucun blueprint publié pour l'instant.</p>
              <button id="empty-add-btn" class="px-4 py-2 rounded-xl bg-emerald-500 text-slate-950 font-mono text-xs font-bold inline-block">
                + Déposer mon Premier Blueprint ➔
              </button>
            </div>
          `;
          document.getElementById('empty-add-btn')?.addEventListener('click', openUploadModal);
        } else {
          listEl.innerHTML = products.map(prod => {
            const ecoBadge = prod.ecosystem === 'n8n' ? '🟠 n8n' : (prod.ecosystem === 'make' ? '🟣 Make' : (prod.ecosystem === 'airtable' ? '🟡 Airtable' : '🤖 Cursor'));
            const isPending = prod.status === 'pending_audit';
            const statusBadge = isPending 
              ? `<span class="px-2 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/30 text-[10px] font-mono">🟡 Audit Sentinel en cours</span>`
              : `<span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-[10px] font-mono">🟢 En Ligne (Anti-Scam ${prod.trust_score || 99}/100)</span>`;

            const creatorGainPerSale = (prod.price * 0.8).toFixed(2);
            const totalProdGains = ((prod.sales_count || 0) * prod.price * 0.8).toFixed(2);

            return `
              <div class="p-5 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-slate-700 transition-all flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="space-y-1.5 max-w-xl">
                  <div class="flex items-center gap-2">
                    ${statusBadge}
                    <span class="text-xs text-slate-400 font-mono">• ${ecoBadge}</span>
                    <span class="text-xs text-slate-500 font-mono">• v${prod.version || '1.0.0'}</span>
                  </div>
                  <h3 class="text-base font-bold text-white">${prod.title}</h3>
                  <p class="text-xs text-slate-400 font-mono">
                    Prix : <span class="text-white font-bold">$${prod.price}</span> | Part Créateur (80%) : <span class="text-emerald-400 font-bold">$${creatorGainPerSale}</span>
                  </p>
                  <p class="text-xs text-slate-400 font-light truncate">${prod.tagline || ''}</p>
                </div>

                <div class="flex items-center justify-between lg:justify-end gap-4 border-t lg:border-t-0 border-slate-800 pt-3 lg:pt-0">
                  <div class="text-left lg:text-right">
                    <div class="text-base font-black text-white font-mono">${prod.sales_count || 0} ventes</div>
                    <div class="text-xs text-emerald-400 font-mono font-bold">$${totalProdGains} nets</div>
                  </div>

                  <!-- Seller Product Actions: Edit, Delete, Redownload -->
                  <div class="flex items-center gap-1.5">
                    <button 
                      class="redownload-prod-btn p-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-cyan-400 border border-slate-800 text-xs font-mono transition-all"
                      title="Retélécharger mon template .json"
                      data-title="${prod.title}"
                      data-ecosystem="${prod.ecosystem}"
                      data-filename="${prod.filename || 'blueprint.json'}"
                    >
                      📥
                    </button>
                    <button 
                      class="edit-prod-btn p-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 text-xs font-mono transition-all"
                      title="Éditer le titre, prix ou description"
                      data-id="${prod.id}"
                    >
                      ✏️
                    </button>
                    <button 
                      class="delete-prod-btn p-2 rounded-xl bg-slate-900 hover:bg-red-950/60 text-slate-400 hover:text-red-400 border border-slate-800 hover:border-red-800/60 text-xs font-mono transition-all"
                      title="Supprimer / Archiver"
                      data-id="${prod.id}"
                      data-title="${prod.title}"
                    >
                      🗑️
                    </button>
                  </div>
                </div>
              </div>
            `;
          }).join('');
        }
      }

      bindSellerActionButtons();
    }

    // --- 5. BINDING ACTION BUTTONS ---
    function bindBuyerActionButtons() {
      // 1-Click License Copy
      document.querySelectorAll('.copy-key-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-key');
          if (key) {
            navigator.clipboard.writeText(key);
            const orig = btn.textContent;
            btn.textContent = "✓ Copié !";
            btn.classList.add('text-emerald-400');
            setTimeout(() => {
              btn.textContent = orig;
              btn.classList.remove('text-emerald-400');
            }, 2000);
          }
        });
      });

      // 1-Click Download Clean JSON
      document.querySelectorAll('.download-workflow-btn, .redownload-prod-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const title = btn.getAttribute('data-title');
          const eco = btn.getAttribute('data-ecosystem');
          const filename = btn.getAttribute('data-filename') || 'heliatech-blueprint.json';
          triggerDownloadJson(title, eco, filename);
        });
      });

      // Open Guide Modal
      document.querySelectorAll('.open-guide-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const eco = btn.getAttribute('data-ecosystem');
          openGuideModal(eco);
        });
      });

      // View Invoice Modal
      document.querySelectorAll('.view-invoice-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const inv = btn.getAttribute('data-inv');
          const title = btn.getAttribute('data-title');
          const price = btn.getAttribute('data-price');
          const date = btn.getAttribute('data-date');
          openInvoiceModal(inv, title, price, date);
        });
      });

      // Open Review Modal
      document.querySelectorAll('.open-review-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const title = btn.getAttribute('data-title');
          openReviewModal(id, title, btn);
        });
      });
    }

    function bindSellerActionButtons() {
      // Edit Button
      document.querySelectorAll('.edit-prod-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          openEditModal(id);
        });
      });

      // Delete Button
      document.querySelectorAll('.delete-prod-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const title = btn.getAttribute('data-title');
          openDeleteModal(id, title);
        });
      });
    }

    // --- 6. REAL JSON BLOB DOWNLOAD GENERATOR ---
    function triggerDownloadJson(title, ecosystem, filename) {
      let content = {};
      if (ecosystem === 'n8n') {
        content = {
          "name": title,
          "nodes": [
            {
              "parameters": { "path": "webhook-inbound", "responseMode": "onReceived" },
              "name": "Webhook Inbound Receiver",
              "type": "n8n-nodes-base.webhook",
              "typeVersion": 1,
              "position": [250, 300]
            },
            {
              "parameters": {
                "model": "gpt-4o-mini",
                "prompt": "Evaluate inbound lead against ICP. Clean data and structure response."
