---
import Layout from '../../layouts/Layout.astro';
import templates from '../../data/templates_catalog.json';

const pageTitle = "Espace Client & Studio Créateur | HeliaTech Hub (Stealth Staging)";
const pageDescription = "Gérez vos licences d'automatisation n8n, Make et Airtable, suivez vos gains créateurs à 80% et pilotez vos déploiements avec audit Sentinel Anti-Scam.";
---

<Layout title={pageTitle} description={pageDescription} noindex={true}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-24">
    
    <!-- Stealth Staging Top Notice -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between p-3.5 mb-8 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-mono gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse flex-shrink-0"></span>
        <span class="font-bold uppercase tracking-wider">Mode Stealth / Staging Privé</span>
        <span class="text-amber-400/70 hidden lg:inline">— Espace Client Acheteur &amp; Studio Vendeur avec Sentinel Anti-Scam actif.</span>
      </div>
      <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
        <a href="/templates/" class="px-3 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-200 border border-amber-500/40 font-bold transition-all">
          Catalogue (/templates/) ➔
        </a>
        <a href="/sell/" class="px-3 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-200 border border-emerald-500/40 font-bold transition-all">
          Vendre (/sell/) ➔
        </a>
      </div>
    </div>

    <!-- Main Header Bar: User Identity & Dynamic Mode Switcher -->
    <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-slate-800 mb-8 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 shadow-2xl relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-48 h-48 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- User Profile & Avatar -->
      <div class="flex items-center gap-4 relative z-10">
        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500 via-sky-600 to-indigo-600 p-0.5 shadow-glow-cyan flex-shrink-0">
          <div class="w-full h-full bg-slate-950 rounded-2xl flex items-center justify-center text-xl font-bold text-white font-mono" id="user-avatar-initials">
            AR
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2.5 mb-1">
            <h1 class="text-xl sm:text-2xl font-black text-white" id="user-display-name">Alexandre R.</h1>
            <span id="user-role-badge" class="text-[10px] font-mono px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 font-bold">
              Acheteur Vérifié
            </span>
          </div>
          <div class="flex items-center gap-3 text-xs text-slate-400 font-mono">
            <span id="user-email">alexandre.partner@heliatech.online</span>
            <span>•</span>
            <span class="text-emerald-400 flex items-center gap-1 font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Session Sécurisée
            </span>
          </div>
        </div>
      </div>

      <!-- Unified Dual-Mode Tabs Switcher -->
      <div class="flex items-center p-1.5 rounded-2xl bg-slate-950 border border-slate-800 w-full lg:w-auto relative z-10">
        <button 
          id="btn-buyer-mode" 
          class="flex-1 lg:flex-none flex items-center justify-center gap-2 px-5 sm:px-6 py-2.5 rounded-xl font-mono text-xs font-bold transition-all bg-cyan-500 text-slate-950 shadow-glow-cyan"
        >
          <span>🛒</span> Espace Acheteur
        </button>
        <button 
          id="btn-seller-mode" 
          class="flex-1 lg:flex-none flex items-center justify-center gap-2 px-5 sm:px-6 py-2.5 rounded-xl font-mono text-xs font-bold transition-all text-slate-400 hover:text-white"
        >
          <span>💼</span> Espace Vendeur (Studio 80%)
        </button>
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 🛒 1. VUE ACHETEUR (Mes Blueprints, Wishlist, Support, Profil B2B, Deploy) -->
    <!-- ========================================================================= -->
    <div id="buyer-dashboard-view" class="space-y-8">
      
      <!-- Buyer Sub-Navigation Tabs Bar -->
      <div class="flex flex-wrap items-center gap-2 border-b border-slate-800 pb-4">
        <button id="subtab-buyer-blueprints" class="buyer-subtab px-4 py-2 rounded-xl bg-cyan-500 text-slate-950 font-mono text-xs font-bold transition-all flex items-center gap-2 shadow-glow-cyan">
          <span>📦</span> Mes Blueprints &amp; Licences
          <span id="badge-buyer-count" class="px-2 py-0.5 rounded-full bg-slate-950 text-cyan-300 text-[10px]">2</span>
        </button>
        <button id="subtab-buyer-wishlist" class="buyer-subtab px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
          <span>💖</span> Ma Wishlist &amp; Favoris
          <span id="badge-wishlist-count" class="px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 text-[10px]">2</span>
        </button>
        <button id="subtab-buyer-support" class="buyer-subtab px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
          <span>💬</span> Support &amp; Échanges Créateurs
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        </button>
        <button id="subtab-buyer-b2b" class="buyer-subtab px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
          <span>🏢</span> Profil B2B &amp; Facturation
        </button>
        <button id="subtab-buyer-deploy" class="buyer-subtab hidden px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
          <span>🔑</span> Token API Déploiement
        </button>
      </div>

      <!-- Sub-Panel 1: Mes Blueprints & Licences -->
      <div id="panel-buyer-blueprints" class="space-y-8">
        
        <!-- Buyer Telemetry Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-black text-cyan-400 font-mono mb-1" id="stat-buyer-blueprints">2 Blueprints</div>
            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Licences Commerciales Actives</div>
          </div>
          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-black text-emerald-400 font-mono mb-1">~48 Heures</div>
            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Temps de Dev Économisé</div>
          </div>
          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-2xl font-black text-indigo-400 font-mono mb-1">100% Anti-Scam</div>
            <div class="text-xs font-mono text-slate-400 uppercase tracking-wider">Code Certifié &amp; Sans Fuite API</div>
          </div>
        </div>

        <!-- Purchased Blueprints Library -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-5">
            <div>
              <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <span>📦</span> Vos Blueprints Achetés &amp; Prêts à Déployer
              </h2>
              <p class="text-xs text-slate-400 font-light mt-1">
                Téléchargez immédiatement vos fichiers .json certifiés propres, accédez à vos clés de licence commerciale et aux guides d'import.
              </p>
            </div>
            <a href="/templates/" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 text-xs font-mono font-bold transition-all">
              + Parcourir le Catalogue ➔
            </a>
          </div>

          <!-- Dynamic Buyer Blueprints Container -->
          <div id="buyer-blueprints-list" class="space-y-4">
            <!-- Injected via JavaScript -->
          </div>

        </div>

        <!-- Invoices & Transaction History -->
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/60 border border-slate-800 space-y-4">
          <h3 class="text-sm font-bold text-white font-mono uppercase tracking-wider flex items-center gap-2">
            <span>🧾</span> Historique de Facturation &amp; Justificatifs Comptables
          </h3>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono">
              <thead>
                <tr class="text-slate-400 border-b border-slate-800">
                  <th class="pb-3">Date</th>
                  <th class="pb-3">Réf. Facture</th>
                  <th class="pb-3">Produit</th>
                  <th class="pb-3">Montant Net</th>
                  <th class="pb-3">Statut</th>
                  <th class="pb-3 text-right">Action</th>
                </tr>
              </thead>
              <tbody id="buyer-invoices-list" class="text-slate-300 divide-y divide-slate-900">
                <!-- Injected via JavaScript -->
              </tbody>
            </table>
          </div>
        </div>

      </div>

      <!-- Sub-Panel 2: Ma Wishlist & Favoris -->
      <div id="panel-buyer-wishlist" class="space-y-6 hidden">
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-5">
            <div>
              <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <span>💖</span> Ma Wishlist &amp; Blueprints Mis de Côté
              </h2>
              <p class="text-xs text-slate-400 font-light mt-1">
                Activez vos workflows favoris en un clic pour les transférer directement dans votre bibliothèque.
              </p>
            </div>
            <a href="/templates/" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-800 text-xs font-mono font-bold transition-all">
              + Ajouter depuis le Catalogue ➔
            </a>
          </div>

          <div id="buyer-wishlist-container" class="space-y-4">
            <!-- Dynamic Wishlist Cards -->
          </div>

          <!-- Wishlist Order Summary Box -->
          <div id="wishlist-summary-box" class="p-5 rounded-2xl bg-slate-900/50 border border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <div class="text-xs font-mono text-slate-400">Total de votre sélection Wishlist :</div>
              <div class="text-2xl font-black text-cyan-400 font-mono" id="wishlist-total-price">$0.00 USD</div>
            </div>
            <button 
              id="btn-buy-all-wishlist"
              class="px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-sky-400 hover:from-cyan-400 hover:to-sky-300 text-slate-950 font-mono text-xs font-bold uppercase tracking-wider transition-all shadow-glow-cyan"
            >
              Commander toute ma Wishlist en 1-Clic ➔
            </button>
          </div>
        </div>
      </div>

      <!-- Sub-Panel 3: Support & Échanges Créateurs -->
      <div id="panel-buyer-support" class="space-y-6 hidden">
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
          <div class="border-b border-slate-800 pb-5">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>💬</span> Centre d'Assistance &amp; Échanges Créateurs
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Posez directement vos questions techniques aux architectes créateurs de vos blueprints achetés.
            </p>
          </div>

          <!-- Support Chat Interface -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            
            <!-- Left: Blueprint Selector / Conversations -->
            <div class="space-y-3">
              <label class="block text-xs font-mono text-slate-400 font-bold uppercase tracking-wider">Sélectionner le Blueprint :</label>
              <select id="support-blueprint-select" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none">
                <!-- Populated dynamically -->
              </select>

              <div class="p-4 rounded-2xl bg-slate-900/50 border border-slate-800 space-y-3">
                <div class="text-xs font-mono text-cyan-400 font-bold flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  Architecte Assigné
                </div>
                <div class="text-xs text-slate-300 font-mono" id="support-creator-info">
                  AutomateScale Studio (Délai moyen : &lt; 15 min)
                </div>
                <p class="text-[11px] text-slate-400 font-light leading-relaxed">
                  Support d'intégration inclus à vie dans votre licence commerciale.
                </p>
              </div>
            </div>

            <!-- Right: Chat Box -->
            <div class="lg:col-span-2 space-y-4">
              <div id="support-chat-messages" class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 h-72 overflow-y-auto space-y-3 font-mono text-xs">
                <!-- Messages dynamic -->
              </div>

              <!-- Quick Prompt Pills -->
              <div class="flex flex-wrap items-center gap-2">
                <button class="quick-prompt-btn px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-800 text-[11px] font-mono text-slate-300 transition-all">
                  ⚙️ Comment connecter mon Webhook ?
                </button>
                <button class="quick-prompt-btn px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-800 text-[11px] font-mono text-slate-300 transition-all">
                  📦 Compatible avec la version Cloud ?
                </button>
                <button class="quick-prompt-btn px-2.5 py-1 rounded-lg bg-slate-900 hover:bg-slate-800 border border-slate-800 text-[11px] font-mono text-slate-300 transition-all">
                  🔑 Où renseigner mes clés API ?
                </button>
              </div>

              <!-- Message Input & Send -->
              <form id="support-message-form" class="flex gap-2">
                <input 
                  type="text" 
                  id="support-message-input" 
                  placeholder="Tapez votre message ou question technique pour l'architecte..."
                  class="flex-1 px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white placeholder-slate-500 text-xs font-mono focus:border-cyan-500 focus:outline-none"
                  required
                />
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-mono text-xs font-bold transition-all shadow-glow-cyan flex items-center gap-1.5">
                  <span>Envoyer</span> ➔
                </button>
              </form>
            </div>

          </div>

        </div>
      </div>

      <!-- Sub-Panel 4: Profil B2B & Facturation -->
      <div id="panel-buyer-b2b" class="space-y-6 hidden">
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
          <div class="border-b border-slate-800 pb-5">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>🏢</span> Profil Entreprise &amp; Coordonnées de Facturation B2B
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Renseignez les mentions légales de votre entreprise afin que tous vos reçus et factures PDF soient 100% conformes sur le plan comptable.
            </p>
          </div>

          <form id="buyer-b2b-form" class="space-y-5 max-w-2xl">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-mono text-slate-300 mb-1.5">Raison Sociale / Société :</label>
                <input 
                  type="text" 
                  id="b2b-company" 
                  value="Acme Growth Technologies SAS" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
                  required
                />
              </div>
              <div>
                <label class="block text-xs font-mono text-slate-300 mb-1.5">Numéro TVA Intracommunautaire / SIRET :</label>
                <input 
                  type="text" 
                  id="b2b-vat" 
                  value="FR82910293847" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
                  required
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-mono text-slate-300 mb-1.5">Adresse de Facturation Complète :</label>
              <input 
                type="text" 
                id="b2b-address" 
                value="142 Avenue des Champs-Élysées, 75008 Paris" 
                class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
                required
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label class="block text-xs font-mono text-slate-300 mb-1.5">Pays de Résidence :</label>
                <select id="b2b-country" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none">
                  <option value="France">France (FR)</option>
                  <option value="États-Unis">États-Unis (US)</option>
                  <option value="Royaume-Uni">Royaume-Uni (UK)</option>
                  <option value="Belgique">Belgique (BE)</option>
                  <option value="Suisse">Suisse (CH)</option>
                  <option value="Canada">Canada (CA)</option>
                </select>
              </div>
              <div>
                <label class="block text-xs font-mono text-slate-300 mb-1.5">Email Comptabilité :</label>
                <input 
                  type="email" 
                  id="b2b-email" 
                  value="comptabilite@acmegrowth.com" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none"
                  required
                />
              </div>
              <div>
                <label class="block text-xs font-mono text-slate-300 mb-1.5">Devise Préférée :</label>
                <select id="b2b-currency" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-white text-xs font-mono focus:border-cyan-500 focus:outline-none">
                  <option value="USD">USD ($) Dollar US</option>
                  <option value="EUR">EUR (€) Euro</option>
                </select>
              </div>
            </div>

            <div class="pt-2">
              <button 
                type="submit" 
                id="btn-save-b2b"
                class="px-6 py-3 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-mono text-xs font-bold transition-all shadow-glow-cyan"
              >
                Enregistrer mes Coordonnées B2B ➔
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Sub-Panel 5: Token API Déploiement -->
      <div id="panel-buyer-deploy" class="space-y-6 hidden">
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-950/80 border border-slate-800 space-y-6">
          <div class="border-b border-slate-800 pb-5">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
              <span>🔑</span> Token Personnel d'Auto-Déploiement (HeliaTech Deploy API)
            </h2>
            <p class="text-xs text-slate-400 font-light mt-1">
              Synchronisez automatiquement vos blueprints achetés vers vos instances de production n8n ou Make self-hosted via API ou CLI.
            </p>
          </div>

          <div class="space-y-4 max-w-2xl">
            <div>
              <label class="block text-xs font-mono text-slate-300 mb-1.5">Votre Clé d'Accès API Secrète :</label>
              <div class="flex items-center gap-2">
                <input 
                  type="password" 
                  id="deploy-token-field" 
                  value="hlt_live_deploy_89f0a82b9e71029c3d" 
                  readonly 
                  class="flex-1 px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-800 text-cyan-400 font-mono text-xs focus:outline-none select-all"
                />
                <button id="toggle-token-btn" class="px-3 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 font-mono text-xs transition-all">
                  👁️ Afficher
                </button>
                <button id="copy-token-btn" class="px-4 py-2.5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-mono text-xs font-bold transition-all shadow-glow-cyan">
                  📋 Copier
                </button>
              </div>
            </div>

            <div class="p-4 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2">
              <span class="text-xs font-mono text-slate-300 font-bold block">Exemple d'Intégration cURL :</span>
              <pre class="p-3 rounded-xl bg-slate-950 text-[11px] font-mono text-cyan-300 overflow-x-auto">curl -X POST https://api.heliatech.online/v1/deploy \
  -H "Authorization: Bearer hlt_live_deploy_89f0a82b..." \
  -d '&#123; "blueprint": "n8n-lead-enrichment", "destination": "self-hosted" &#125;'</pre>
            </div>

            <button id="btn-regen-token" class="text-xs font-mono text-amber-400 hover:underline">
              🔄 Régénérer un nouveau Token
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- ========================================================================= -->
    <!-- 💼 2. VUE VENDEUR (CRUD Blueprints, Analytics, Support, Profil, Payouts) -->
    <!-- ========================================================================= -->
    <div id="seller-dashboard-view" class="space-y-8 hidden">
      
      <!-- Seller Sub-Navigation Tabs Bar -->
      <div class="flex flex-wrap items-center gap-2 border-b border-slate-800 pb-4">
        <button id="subtab-seller-products" class="seller-subtab px-4 py-2 rounded-xl bg-cyan-500 text-slate-950 font-mono text-xs font-bold transition-all flex items-center gap-2 shadow-glow-cyan">
          <span>💼</span> Mes Blueprints en Vente
          <span id="badge-seller-count" class="px-2 py-0.5 rounded-full bg-slate-950 text-cyan-300 text-[10px]">3</span>
        </button>
        <button id="subtab-seller-analytics" class="seller-subtab px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 font-mono text-xs transition-all flex items-center gap-2 border border-slate-800">
