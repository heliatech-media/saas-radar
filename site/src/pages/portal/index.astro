    // --- 2. LOCAL STORAGE INITIALIZATION ---
    function getBuyerPurchases() {
      const stored = localStorage.getItem('_ht_buyer_purchases');
      if (stored) {
        try { return JSON.parse(stored); } catch(e) {}
      }
      localStorage.setItem('_ht_buyer_purchases', JSON.stringify(DEFAULT_BUYER_PURCHASES));
      return DEFAULT_BUYER_PURCHASES;
    }

    function saveBuyerPurchases(data) {
      localStorage.setItem('_ht_buyer_purchases', JSON.stringify(data));
      renderBuyerDashboard();
    }

    function getSellerProducts() {
      const stored = localStorage.getItem('_ht_seller_products');
      if (stored) {
        try { return JSON.parse(stored); } catch(e) {}
      }
      localStorage.setItem('_ht_seller_products', JSON.stringify(DEFAULT_SELLER_PRODUCTS));
      return DEFAULT_SELLER_PRODUCTS;
    }

    function saveSellerProducts(data) {
      localStorage.setItem('_ht_seller_products', JSON.stringify(data));
      renderSellerDashboard();
    }

    // --- 3. DYNAMIC RENDERING: BUYER VIEW ---
    function renderBuyerDashboard() {
      const purchases = getBuyerPurchases();
      const listEl = document.getElementById('buyer-blueprints-list');
      const invoicesEl = document.getElementById('buyer-invoices-list');
      const countEl = document.getElementById('stat-buyer-blueprints');

      if (countEl) countEl.textContent = `${purchases.length} Blueprint${purchases.length > 1 ? 's' : ''}`;

      if (listEl) {
        if (purchases.length === 0) {
          listEl.innerHTML = `
            <div class="p-8 text-center border border-dashed border-slate-800 rounded-2xl">
              <p class="text-xs font-mono text-slate-400 mb-3">Vous n'avez pas encore acheté de blueprint.</p>
              <a href="/templates/" class="px-4 py-2 rounded-xl bg-cyan-500 text-slate-950 font-mono text-xs font-bold inline-block">
                Explorer le Catalogue ➔
              </a>
            </div>
          `;
        } else {
          listEl.innerHTML = purchases.map(p => {
            const ecoBadge = p.ecosystem === 'n8n' ? '🟠 n8n Workflow' : (p.ecosystem === 'make' ? '🟣 Make.com Blueprint' : (p.ecosystem === 'airtable' ? '🟡 Airtable OS' : '🤖 Cursor Rules'));
            return `
              <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-slate-700 transition-all flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div class="space-y-2">
                  <div class="flex items-center gap-2.5">
                    <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 text-[10px] font-mono font-bold">
                      ${ecoBadge}
                    </span>
                    <span class="text-xs text-slate-400 font-mono">Acheté le ${p.date}</span>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
                      Licence Commerciale
                    </span>
                  </div>
                  <h3 class="text-lg font-bold text-white">${p.title}</h3>
                  <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-slate-400">
                    <span>Clé Licence : <code class="text-cyan-400 bg-slate-950 px-2 py-1 rounded border border-slate-800">${p.license_key}</code></span>
