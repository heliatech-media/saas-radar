              },
              {
                "parameters": {
                  "model": "gpt-4o-mini",
                  "prompt": "Evaluate this lead against B2B ideal customer profile: {{$json.body.email}}"
                },
                "name": "AI Lead Scoring Engine",
                "type": "n8n-nodes-base.openAi",
                "typeVersion": 1,
                "position": [450, 300]
              },
              {
                "parameters": {
                  "resource": "record",
                  "operation": "append",
                  "application": "appLeadTracker"
                },
                "name": "Sync to Airtable CRM",
                "type": "n8n-nodes-base.airtable",
                "typeVersion": 1,
                "position": [650, 300]
              }
            ],
            "connections": {
              "Webhook Inbound Lead": { "main": [[{ "node": "AI Lead Scoring Engine", "type": "main", "index": 0 }]] },
              "AI Lead Scoring Engine": { "main": [[{ "node": "Sync to Airtable CRM", "type": "main", "index": 0 }]] }
            },
            "meta": {
              "generator": "HeliaTech Security Sanitizer v2026.1",
              "certified_clean": true,
              "license": "Commercial Unlimited"
            }
          };
        } else {
          filename = "heliatech-make-stripe-recovery-v1.json";
          content = {
            "name": "HeliaTech Make.com Stripe Failed Payment Recovery Engine",
            "blueprint": {
              "name": "Stripe Churn Recovery Waterfall",
              "flow": [
                { "id": 1, "module": "stripe:WatchEvents", "version": 1 },
                { "id": 2, "module": "resend:SendEmail", "version": 1 },
                { "id": 3, "module": "slack:CreateMessage", "version": 1 }
              ]
            },
            "meta": {
              "generator": "HeliaTech Security Sanitizer v2026.1",
              "certified_clean": true,
              "license": "Commercial Unlimited"
            }
          };
        }

        const blob = new Blob([JSON.stringify(content, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        document.body.appendChild(a);
