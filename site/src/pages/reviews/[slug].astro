---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'reviews'>;
}

const { entry } = Astro.props;
const tool = entry.data;
const slug = entry.slug;

// Generate Schema.org JSON-LD for Google Rich Results
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": tool.name,
      "applicationCategory": tool.category,
      "operatingSystem": "Web, Cloud, Windows, macOS",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": tool.rating.toString(),
        "bestRating": "5.0",
        "worstRating": "1.0",
        "ratingCount": "128"
      },
      "offers": tool.pricing_tiers.map(tier => ({
        "@type": "Offer",
        "name": tier.name,
        "price": tier.price.replace(/[^0-9.]/g, '') || "0",
        "priceCurrency": "USD"
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": tool.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={`${tool.name} Teardown & Benchmarks (2026)`}
  description={tool.summary}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-6 sm:px-8 py-12">
    <!-- Breadcrumb Capsule -->
    <nav class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/[0.03] border border-white/[0.08] text-xs font-mono text-slate-400 mb-10">
      <a href="/" class="hover:text-champagne-200 transition-colors">RADAR.TITANIUM</a>
      <span class="text-slate-600">/</span>
      <span class="text-slate-400">{tool.category}</span>
      <span class="text-slate-600">/</span>
      <span class="text-champagne-300 font-bold">{tool.name}</span>
    </nav>

    <!-- Main Spatial Hero Card with Champagne Glow -->
    <div class="relative rounded-3xl p-8 sm:p-12 bg-white/[0.02] border border-white/[0.1] backdrop-blur-2xl shadow-glass-titanium mb-12 overflow-hidden">
      <!-- Ambient Radial Aura -->
      <div class="absolute -top-24 -right-24 w-80 h-80 bg-gradient-to-br from-champagne-400/20 via-amber-500/15 to-transparent rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 mb-8">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-[11px] font-mono font-medium bg-white/[0.04] text-champagne-200 border border-white/[0.08] mb-3">
            {tool.category}
          </span>
          <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight">
            {tool.name}
          </h1>
        </div>

        <div class="flex items-center gap-3 bg-white/[0.03] border border-champagne-400/20 px-5 py-3 rounded-2xl backdrop-blur-md">
          <span class="text-2xl text-champagne-400">★</span>
          <div>
            <span class="text-2xl font-black text-white font-mono leading-none">{tool.rating.toFixed(1)}</span>
            <span class="text-[10px] font-mono text-slate-500 block uppercase tracking-wider mt-1">AI Rating</span>
          </div>
        </div>
      </div>

      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed mb-10 max-w-2xl">
        {tool.tagline}
      </p>

      <!-- Primary Titanium Gold CTA -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 pt-6 border-t border-white/[0.06]">
        <a 
          href={`/go/${slug}`} 
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-champagne-200 via-gold-pure to-gold-bronze hover:from-champagne-100 hover:to-gold-pure text-titanium-950 font-bold text-sm rounded-2xl shadow-glow-gold transition-all text-center flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <span>Deploy {tool.name} Free</span>
          <span>↗</span>
        </a>
        <span class="text-xs font-mono text-slate-500">Autonomous evaluation • Verified pricing</span>
      </div>
    </div>

    <!-- Executive Summary & Best For Bento -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
      <div class="md:col-span-2 rounded-3xl p-7 bg-white/[0.02] border border-white/[0.07] backdrop-blur-xl">
        <span class="text-xs font-mono text-champagne-300 uppercase tracking-widest block mb-2">INTELLIGENCE BRIEF</span>
        <h2 class="text-xl font-bold text-white mb-3">Executive Summary</h2>
        <p class="text-slate-300 text-sm leading-relaxed font-light">{tool.summary}</p>
      </div>

      <div class="rounded-3xl p-7 bg-champagne-500/[0.03] border border-champagne-400/20 backdrop-blur-xl">
        <span class="text-xs font-mono text-champagne-300 uppercase tracking-widest block mb-2">TARGET PERSONA</span>
        <h2 class="text-xl font-bold text-white mb-3">Optimal Fit</h2>
        <p class="text-slate-300 text-sm leading-relaxed font-light">{tool.best_for}</p>
      </div>
    </div>

    <!-- Pros & Cons Grid (Spatial Cards) -->
    <div class="mb-14">
      <h2 class="text-2xl font-black text-white mb-6 tracking-tight">Capabilities & Trade-offs</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Pros -->
        <div class="rounded-3xl p-7 bg-emerald-500/[0.03] border border-emerald-500/20 backdrop-blur-xl shadow-inner-gold">
          <div class="flex items-center gap-2 text-emerald-400 font-mono font-bold text-xs uppercase tracking-wider mb-5">
            <span class="w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center text-xs">✓</span>
            <span>Verified Advantages</span>
          </div>
          <ul class="space-y-3.5">
            {tool.pros.map((pro: string) => (
              <li class="flex items-start gap-3 text-slate-300 text-xs sm:text-sm leading-relaxed font-light">
                <span class="text-emerald-400 font-bold mt-0.5">•</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Cons -->
        <div class="rounded-3xl p-7 bg-rose-500/[0.03] border border-rose-500/20 backdrop-blur-xl shadow-inner-gold">
          <div class="flex items-center gap-2 text-rose-400 font-mono font-bold text-xs uppercase tracking-wider mb-5">
            <span class="w-6 h-6 rounded-full bg-rose-500/20 flex items-center justify-center text-xs">✕</span>
            <span>Observed Limitations</span>
          </div>
          <ul class="space-y-3.5">
            {tool.cons.map((con: string) => (
              <li class="flex items-start gap-3 text-slate-300 text-xs sm:text-sm leading-relaxed font-light">
                <span class="text-rose-400 font-bold mt-0.5">•</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Key Capabilities Grid -->
    <div class="mb-14 rounded-3xl p-8 bg-white/[0.02] border border-white/[0.07] backdrop-blur-xl">
      <span class="text-xs font-mono text-champagne-300 uppercase tracking-widest block mb-2">SYSTEM ARCHITECTURE</span>
      <h2 class="text-2xl font-black text-white mb-6 tracking-tight">Core Standout Features</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {tool.key_features.map((feature: string) => (
          <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-titanium-950/70 border border-white/[0.06]">
            <div class="w-8 h-8 rounded-xl bg-champagne-400/10 border border-champagne-400/20 text-champagne-300 flex items-center justify-center text-sm font-bold">
              ✦
            </div>
            <span class="text-slate-200 text-xs sm:text-sm font-medium">{feature}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Pricing Tiers Grid -->
    <div class="mb-14">
      <span class="text-xs font-mono text-champagne-300 uppercase tracking-widest block mb-2">COMMERCIAL TIERS</span>
      <h2 class="text-2xl font-black text-white mb-6 tracking-tight">Verified Pricing Architecture</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {tool.pricing_tiers.map((tier: any) => (
          <div class={`rounded-3xl p-7 flex flex-col justify-between backdrop-blur-xl transition-all duration-300 ${
            tier.is_popular 
              ? 'bg-white/[0.05] border-2 border-gold-pure shadow-glow-gold relative scale-[1.02]' 
              : 'bg-white/[0.02] border border-white/[0.07]'
          }`}>
            {tier.is_popular && (
              <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-1 bg-gradient-to-r from-champagne-200 via-gold-pure to-gold-bronze text-titanium-950 text-[10px] font-mono font-bold rounded-full uppercase tracking-widest shadow-md">
                RECOMMENDED
              </span>
            )}
            <div>
              <h3 class="text-lg font-bold text-white mb-2">{tier.name}</h3>
              <div class="flex items-baseline gap-1.5 mb-6">
                <span class="text-3xl font-black text-white font-mono">{tier.price}</span>
                <span class="text-xs font-mono text-slate-500">/{tier.billing_period}</span>
              </div>
              <ul class="space-y-3 mb-8 border-t border-white/[0.06] pt-5">
                {tier.features.map((feat: string) => (
                  <li class="text-xs text-slate-300 flex items-start gap-2.5 font-light">
                    <span class="text-champagne-400">✓</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a 
              href={`/go/${slug}`} 
              target="_blank"
              rel="noopener noreferrer sponsored"
              class={`w-full py-3 px-4 rounded-xl text-center text-xs font-mono font-bold transition-all ${
                tier.is_popular 
                  ? 'bg-gradient-to-r from-champagne-200 via-gold-pure to-gold-bronze hover:from-champagne-100 hover:to-gold-pure text-titanium-950 shadow-lg' 
                  : 'bg-white/[0.04] hover:bg-white/[0.1] text-slate-200 border border-white/[0.08]'
              }`}
            >
              Select Tier ↗
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Editorial Verdict -->
    <div class="mb-14 rounded-3xl p-8 sm:p-10 bg-gradient-to-b from-white/[0.03] to-white/[0.01] border border-white/[0.08] backdrop-blur-2xl">
      <span class="text-xs font-mono text-champagne-300 uppercase tracking-widest block mb-2">FINAL SYNTHESIS</span>
      <h2 class="text-2xl font-black text-white mb-4 tracking-tight">Autonomous Editorial Verdict</h2>
      <div class="text-slate-300 leading-relaxed text-sm sm:text-base font-light space-y-4">
        {tool.detailed_verdict}
      </div>

      <div class="mt-8 pt-6 border-t border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-[11px] font-mono text-slate-500 block uppercase">Alternatives Matrix:</span>
          <span class="text-xs font-mono text-slate-300 font-semibold">
            {tool.alternatives.join(" • ")}
          </span>
        </div>
        <a 
          href={`/go/${slug}`} 
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="px-6 py-3 bg-gradient-to-r from-champagne-200 to-gold-pure text-titanium-950 font-bold text-xs rounded-xl transition-all shadow-lg hover:brightness-105"
        >
          Visit {tool.name} ↗
        </a>
      </div>
    </div>

    <!-- FAQ Accordion -->
    <div class="mb-14">
      <h2 class="text-2xl font-black text-white mb-6 tracking-tight">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {tool.faqs.map((faq: any) => (
          <details class="group rounded-2xl p-5 bg-white/[0.02] border border-white/[0.06] hover:border-champagne-400/20 transition-colors cursor-pointer">
            <summary class="flex items-center justify-between text-sm sm:text-base font-semibold text-slate-200">
              <span>{faq.question}</span>
              <span class="text-champagne-300 transition-transform group-open:rotate-180">↓</span>
            </summary>
            <p class="mt-4 text-xs sm:text-sm text-slate-400 leading-relaxed border-t border-white/[0.06] pt-3 font-light">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</Layout>
