---
import Layout from '../../layouts/Layout.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'reviews'>;
}

const { entry } = Astro.props;
const tool = entry.data;
const slug = entry.slug;

// Find if there is an in-depth dedicated blog post for this tool
const allBlogPosts = await getCollection('blog');
const relatedBlogPost = allBlogPosts.find((p) => p.data.tool_slug === slug);

// Generate Schema.org JSON-LD for Google Rich Results
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": tool.name,
      "applicationCategory": tool.category,
      "operatingSystem": "Web, Cloud, Windows, macOS",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": tool.rating.toString(),
        "bestRating": "5.0",
        "worstRating": "1.0",
        "ratingCount": "128"
      },
      "offers": tool.pricing_tiers.map(tier => ({
        "@type": "Offer",
        "name": tier.name,
        "price": tier.price.replace(/[^0-9.]/g, '') || "0",
        "priceCurrency": "USD"
      }))
    },
    {
      "@type": "Review",
      "itemReviewed": {
        "@type": "SoftwareApplication",
        "name": tool.name,
        "applicationCategory": tool.category
      },
      "reviewRating": {
        "@type": "Rating",
        "ratingValue": tool.rating.toString(),
        "bestRating": "5",
        "worstRating": "1"
      },
      "name": `${tool.name} Independent Architectural Teardown & Benchmarks`,
      "author": {
        "@type": "Organization",
        "name": "HeliaTech Media",
        "url": "https://heliatech.online"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Helia Autonomous Intelligence",
        "url": "https://heliatech.online"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": tool.faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer
        }
      }))
    }
  ]
};
---

<Layout 
  title={`${tool.name} Teardown & Benchmarks (2026)`}
  description={tool.summary}
  jsonLd={jsonLd}
>
  <div class="max-w-4xl mx-auto px-6 sm:px-8 py-12">
    <!-- Breadcrumb Capsule -->
    <nav class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-900/80 border border-slate-800 text-xs font-mono text-slate-400 mb-10 shadow-sm">
      <a href="/" class="hover:text-cyan-400 transition-colors">SAAS RADAR</a>
      <span class="text-slate-600">/</span>
      <span class="text-slate-400">{tool.category}</span>
      <span class="text-slate-600">/</span>
      <span class="text-cyan-300 font-bold">{tool.name}</span>
    </nav>

    <!-- Dedicated Blog Guide Callout Banner (if available) -->
    {relatedBlogPost && (
      <div class="mb-10 p-5 rounded-2xl bg-slate-900/90 border border-cyan-500/40 shadow-glow-cyan flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 flex items-center justify-center font-bold text-lg">
            📖
          </div>
          <div>
            <span class="text-[10px] font-mono text-cyan-400 uppercase tracking-wider font-bold block">IN-DEPTH INVESTIGATION & WORKSHOP AVAILABLE</span>
            <span class="text-sm font-bold text-white">{relatedBlogPost.data.title}</span>
          </div>
        </div>
        <a 
          href={`/blog/${relatedBlogPost.slug}`}
          class="px-4 py-2 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold text-xs font-mono whitespace-nowrap transition-all shadow-md"
        >
          Read Masterclass ➔
        </a>
      </div>
    )}

    <!-- Main Spatial Hero Card with Cyber Neon Glow -->
    <div class="relative rounded-3xl p-8 sm:p-12 bg-slate-900/70 border border-slate-800 backdrop-blur-2xl shadow-glass-cyber mb-12 overflow-hidden">
      <!-- Ambient Radial Aura -->
      <div class="absolute -top-24 -right-24 w-80 h-80 bg-gradient-to-br from-cyan-500/20 via-fuchsia-500/15 to-transparent rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 mb-8">
        <div>
          <span class="inline-block px-3 py-1 rounded-full text-[11px] font-mono font-medium bg-slate-800 text-cyan-300 border border-slate-700 mb-4">
            {tool.category}
          </span>
          <div class="flex items-center gap-4 sm:gap-5">
            <ToolIcon name={tool.name} websiteUrl={tool.website_url} slug={slug} size="xl" />
            <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight">
              {tool.name}
            </h1>
          </div>
        </div>

        <div class="flex items-center gap-3 bg-slate-800/80 border border-cyan-500/30 px-5 py-3 rounded-2xl backdrop-blur-md shadow-inner-cyan">
          <span class="text-2xl text-cyan-400">★</span>
          <div>
            <span class="text-2xl font-black text-white font-mono leading-none">{tool.rating.toFixed(1)}</span>
            <span class="text-[10px] font-mono text-slate-400 block uppercase tracking-wider mt-1">AI Rating</span>
          </div>
        </div>
      </div>

      <p class="text-base sm:text-lg text-slate-300 font-light leading-relaxed mb-10 max-w-2xl">
        {tool.tagline}
      </p>

      <!-- Primary Cyber CTA -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 pt-6 border-t border-slate-800">
        <a 
          href={`/go/${slug}`} 
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-cyan-500 to-fuchsia-500 hover:from-cyan-400 hover:to-fuchsia-400 text-slate-950 font-black text-sm rounded-2xl shadow-glow-cyan transition-all text-center flex items-center justify-center gap-2 hover:scale-[1.02]"
        >
          <ToolIcon name={tool.name} websiteUrl={tool.website_url} slug={slug} size="xs" />
          <span>Deploy {tool.name} Free</span>
          <span>↗</span>
        </a>
        <span class="text-xs font-mono text-slate-500">Autonomous evaluation • Verified commercial pricing</span>
      </div>
    </div>

    <!-- Benchmark Telemetry Scorecard -->
    {tool.benchmark_scores && (
      <div class="mb-14 rounded-3xl p-7 sm:p-8 bg-slate-900/60 border border-slate-800 backdrop-blur-xl">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
          <div>
            <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-1">RADAR TELEMETRY</span>
            <h2 class="text-2xl font-black text-white tracking-tight">Benchmark Performance Scores</h2>
          </div>
          <span class="px-3.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs font-mono font-bold">
            Composite Score: {tool.rating.toFixed(1)} / 5.0
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800">
            <div class="flex justify-between items-center text-xs font-mono mb-2">
              <span class="text-slate-300">Technical Speed & Uptime</span>
              <span class="text-cyan-400 font-bold">{tool.benchmark_scores.performance}/10</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
              <div class="bg-gradient-to-r from-cyan-500 to-sky-400 h-2 rounded-full" style={`width: ${tool.benchmark_scores.performance * 10}%`}></div>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800">
            <div class="flex justify-between items-center text-xs font-mono mb-2">
              <span class="text-slate-300">UX & Onboarding Velocity</span>
              <span class="text-cyan-400 font-bold">{tool.benchmark_scores.ease_of_use}/10</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
              <div class="bg-gradient-to-r from-cyan-500 to-sky-400 h-2 rounded-full" style={`width: ${tool.benchmark_scores.ease_of_use * 10}%`}></div>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800">
            <div class="flex justify-between items-center text-xs font-mono mb-2">
              <span class="text-slate-300">Pricing vs Feature Allowance</span>
              <span class="text-fuchsia-400 font-bold">{tool.benchmark_scores.value_for_money}/10</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
              <div class="bg-gradient-to-r from-fuchsia-500 to-pink-400 h-2 rounded-full" style={`width: ${tool.benchmark_scores.value_for_money * 10}%`}></div>
            </div>
          </div>
          <div class="p-4 rounded-2xl bg-slate-950/70 border border-slate-800">
            <div class="flex justify-between items-center text-xs font-mono mb-2">
              <span class="text-slate-300">API Robustness & Ecosystem</span>
              <span class="text-cyan-400 font-bold">{tool.benchmark_scores.integrations}/10</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2 overflow-hidden">
              <div class="bg-gradient-to-r from-cyan-500 to-sky-400 h-2 rounded-full" style={`width: ${tool.benchmark_scores.integrations * 10}%`}></div>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Executive Summary & Best For Bento -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-14">
      <div class="md:col-span-2 rounded-3xl p-7 bg-slate-900/60 border border-slate-800 backdrop-blur-xl">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2">INTELLIGENCE BRIEF</span>
        <h2 class="text-xl font-bold text-white mb-3">Executive Summary</h2>
        <p class="text-slate-300 text-sm leading-relaxed font-light">{tool.summary}</p>
      </div>

      <div class="rounded-3xl p-7 bg-slate-900/60 border border-fuchsia-500/20 backdrop-blur-xl">
        <span class="text-xs font-mono text-fuchsia-400 uppercase tracking-widest block mb-2">TARGET PERSONA</span>
        <h2 class="text-xl font-bold text-white mb-3">Optimal Fit</h2>
        <p class="text-slate-300 text-sm leading-relaxed font-light">{tool.best_for}</p>
      </div>
    </div>

    <!-- Pros & Cons Grid (Spatial Cards) -->
    <div class="mb-14">
      <h2 class="text-2xl font-black text-white mb-6 tracking-tight">Capabilities & Trade-offs</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Pros -->
        <div class="rounded-3xl p-7 bg-emerald-500/[0.04] border border-emerald-500/25 backdrop-blur-xl">
          <div class="flex items-center gap-2 text-emerald-400 font-mono font-bold text-xs uppercase tracking-wider mb-5">
            <span class="w-6 h-6 rounded-full bg-emerald-500/20 flex items-center justify-center text-xs">✓</span>
            <span>Verified Advantages</span>
          </div>
          <ul class="space-y-3.5">
            {tool.pros.map((pro: string) => (
              <li class="flex items-start gap-3 text-slate-300 text-xs sm:text-sm leading-relaxed font-light">
                <span class="text-emerald-400 font-bold mt-0.5">•</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Cons -->
        <div class="rounded-3xl p-7 bg-rose-500/[0.04] border border-rose-500/25 backdrop-blur-xl">
          <div class="flex items-center gap-2 text-rose-400 font-mono font-bold text-xs uppercase tracking-wider mb-5">
            <span class="w-6 h-6 rounded-full bg-rose-500/20 flex items-center justify-center text-xs">✕</span>
            <span>Observed Limitations</span>
          </div>
          <ul class="space-y-3.5">
            {tool.cons.map((con: string) => (
              <li class="flex items-start gap-3 text-slate-300 text-xs sm:text-sm leading-relaxed font-light">
                <span class="text-rose-400 font-bold mt-0.5">•</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Key Capabilities Grid -->
    <div class="mb-14 rounded-3xl p-8 bg-slate-900/60 border border-slate-800 backdrop-blur-xl">
      <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2">SYSTEM ARCHITECTURE</span>
      <h2 class="text-2xl font-black text-white mb-6 tracking-tight">Core Standout Features</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {tool.key_features.map((feature: string) => (
          <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-slate-950/70 border border-slate-800">
            <div class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-500/30 text-cyan-400 flex items-center justify-center text-sm font-bold">
              ✦
            </div>
            <span class="text-slate-200 text-xs sm:text-sm font-medium">{feature}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Projected ROI & Productivity Lift Card -->
    {tool.roi_metrics && (
      <div class="mb-14 rounded-3xl p-8 sm:p-10 bg-slate-900/70 border border-cyan-500/30 backdrop-blur-2xl shadow-glass-cyber relative overflow-hidden">
        <div class="absolute -top-16 -right-16 w-56 h-56 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
          <div>
            <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-1">FINANCIAL TELEMETRY</span>
            <h2 class="text-2xl font-black text-white tracking-tight">Projected ROI & Productivity Lift</h2>
          </div>
          <span class="px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-bold">
            Breakeven Velocity: ~{tool.roi_metrics.payback_period_weeks} Weeks
          </span>
        </div>
        <p class="text-slate-300 text-sm font-light leading-relaxed mb-8 max-w-2xl">
          {tool.roi_metrics.roi_summary || `Implementing ${tool.name} eliminates high-friction manual operational cycles, directly reducing overhead.`}
        </p>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
          <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 text-center">
            <span class="text-3xl font-black text-white font-mono block mb-1">{tool.roi_metrics.hours_saved_monthly}h</span>
            <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider">Hours Saved / Month</span>
          </div>
          <div class="p-5 rounded-2xl bg-slate-950/80 border border-cyan-500/30 text-center shadow-inner-cyan">
            <span class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 to-fuchsia-400 font-mono block mb-1">{tool.roi_metrics.financial_lift_monthly}</span>
            <span class="text-[11px] font-mono text-cyan-300 uppercase tracking-wider">Recovered Capacity</span>
          </div>
          <div class="p-5 rounded-2xl bg-slate-950/80 border border-slate-800 text-center">
            <span class="text-3xl font-black text-emerald-400 font-mono block mb-1">{tool.roi_metrics.payback_period_weeks} wks</span>
            <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider">Payback Period</span>
          </div>
        </div>

        <!-- Interactive Calculator Slider -->
        <div class="p-6 rounded-2xl bg-slate-950/60 border border-slate-800">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <span class="text-xs font-mono text-slate-300 uppercase tracking-wider">Simulate for your team size:</span>
            <span class="text-xs font-mono text-cyan-300 font-bold"><span id="team-size-display">5</span> team members</span>
          </div>
          <input 
            id="team-size-slider"
            type="range" 
            min="1" 
            max="30" 
            value="5" 
            class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400 mb-4" 
          />
          <div class="flex items-center justify-between text-xs font-mono text-slate-400">
            <span>Estimated annual recovered value:</span>
            <span id="calculated-annual-roi" class="text-emerald-400 font-bold text-sm">$11,400 / year</span>
          </div>
        </div>
      </div>
    )}

    <!-- Pricing Tiers Grid -->
    <div class="mb-14">
      <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2">COMMERCIAL TIERS</span>
      <h2 class="text-2xl font-black text-white mb-6 tracking-tight">Verified Pricing Architecture</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {tool.pricing_tiers.map((tier: any) => (
          <div class={`rounded-3xl p-7 flex flex-col justify-between backdrop-blur-xl transition-all duration-300 ${
            tier.is_popular 
              ? 'bg-slate-900/90 border-2 border-cyan-500 shadow-glow-cyan relative scale-[1.02]' 
              : 'bg-slate-900/50 border border-slate-800'
          }`}>
            {tier.is_popular && (
              <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-3 py-1 bg-gradient-to-r from-cyan-500 to-fuchsia-500 text-slate-950 text-[10px] font-mono font-black rounded-full uppercase tracking-widest shadow-md">
                RECOMMENDED
              </span>
            )}
            <div>
              <h3 class="text-lg font-bold text-white mb-2">{tier.name}</h3>
              <div class="flex items-baseline gap-1.5 mb-6">
                <span class="text-3xl font-black text-white font-mono">{tier.price}</span>
                <span class="text-xs font-mono text-slate-500">/{tier.billing_period}</span>
              </div>
              <ul class="space-y-3 mb-8 border-t border-slate-800 pt-5">
                {tier.features.map((feat: string) => (
                  <li class="text-xs text-slate-300 flex items-start gap-2.5 font-light">
                    <span class="text-cyan-400">✓</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a 
              href={`/go/${slug}`} 
              target="_blank"
              rel="noopener noreferrer sponsored"
              class={`w-full py-3 px-4 rounded-xl text-center text-xs font-mono font-bold transition-all ${
                tier.is_popular 
                  ? 'bg-gradient-to-r from-cyan-500 to-fuchsia-500 hover:from-cyan-400 hover:to-fuchsia-400 text-slate-950 font-black shadow-lg' 
                  : 'bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700'
              }`}
            >
              Select Tier ↗
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Direct Head-to-Head Comparisons -->
    {tool.competitor_matches && tool.competitor_matches.length > 0 && (
      <div class="mb-14 rounded-3xl p-8 bg-slate-900/60 border border-slate-800 backdrop-blur-xl">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest block mb-2">COMPETITIVE MATRIX</span>
        <h2 class="text-2xl font-black text-white mb-6 tracking-tight">Direct Head-to-Head Comparisons</h2>
        <div class="space-y-4">
          {tool.competitor_matches.map((item: any) => (
            <div class="p-5 rounded-2xl bg-slate-950/70 border border-slate-800 hover:border-cyan-500/30 transition-all">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2.5">
                  <ToolIcon name={tool.name} websiteUrl={tool.website_url} slug={slug} size="xs" />
                  <span class="font-bold text-white text-base">{tool.name}</span>
                  <span class="text-xs font-mono text-slate-500 uppercase px-2 py-0.5 rounded bg-slate-800">VS</span>
                  <ToolIcon name={item.competitor} size="xs" />
                  <span class="font-bold text-slate-300 text-base">{item.competitor}</span>
                </div>
                <span class="text-[11px] font-mono text-cyan-300 uppercase tracking-wider">Helia Verdict</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-300 mb-2 font-light">
                <strong class="text-cyan-300 font-medium">Why choose {tool.name}:</strong> {item.key_advantage}
              </p>
              <p class="text-xs text-slate-400 font-light border-t border-slate-800/80 pt-2 mt-2">
                <strong class="text-slate-400 font-medium">When to choose {item.competitor}:</strong> {item.when_to_switch}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- FAQ Accordion -->
    <div class="mb-14">
      <h2 class="text-2xl font-black text-white mb-6 tracking-tight">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {tool.faqs.map((faq: any) => (
          <details class="group rounded-2xl p-5 bg-slate-900/60 border border-slate-800 hover:border-cyan-500/30 transition-colors cursor-pointer">
            <summary class="flex items-center justify-between text-sm sm:text-base font-semibold text-slate-200">
              <span>{faq.question}</span>
              <span class="text-cyan-400 transition-transform group-open:rotate-180">↓</span>
            </summary>
            <p class="mt-4 text-xs sm:text-sm text-slate-400 leading-relaxed border-t border-slate-800 pt-3 font-light">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>

  <script is:inline>
    const slider = document.getElementById('team-size-slider');
    const teamDisplay = document.getElementById('team-size-display');
    const roiDisplay = document.getElementById('calculated-annual-roi');

    if (slider && teamDisplay && roiDisplay) {
      slider.addEventListener('input', (e) => {
        const team = parseInt(e.target.value) || 1;
        teamDisplay.textContent = team.toString();
        // Calculate realistic annual recovered value (~$190/mo per member)
        const annualValue = team * 190 * 12;
        roiDisplay.textContent = `$${annualValue.toLocaleString()} / year`;
      });
    }
  </script>
</Layout>
