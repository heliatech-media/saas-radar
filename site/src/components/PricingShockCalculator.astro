---
import ToolIcon from './ToolIcon.astro';

interface Props {
  expensiveTool?: string;
  cheaperTool?: string;
  expensiveToolSlug?: string;
  cheaperToolSlug?: string;
}

const {
  expensiveTool = "Zapier",
  cheaperTool = "Make",
  expensiveToolSlug = "zapier",
  cheaperToolSlug = "make"
} = Astro.props;

const affiliateHop = `/go/${cheaperToolSlug}`;
---

<!-- Helia-Lupin: Pricing Shock & Overcharge Simulator -->
<div class="my-12 p-6 sm:p-8 rounded-2xl bg-obsidian-800 border border-white/[0.08] shadow-xl relative overflow-hidden">
  
  <div class="absolute -right-20 -top-20 w-64 h-64 bg-sky-500/[0.03] rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-6 border-b border-white/[0.08]">
    <div class="flex items-center gap-3">
      <ToolIcon name={cheaperTool} slug={cheaperToolSlug} size="md" />
      <div>
        <h3 class="text-lg font-bold text-white tracking-tight flex items-center gap-2 font-heading">
          <span>{expensiveTool} Overcharge & Markup Simulator</span>
          <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-amber-500/10 text-amber-400 font-bold border border-amber-500/25">FINANCIAL AUDIT</span>
        </h3>
        <p class="text-xs text-slate-400 font-mono">Calculate wasted annual capital on linear markups vs modern {cheaperTool} execution</p>
      </div>
    </div>
    <span class="text-xs font-mono text-slate-500 hidden sm:inline-block">Scale Mathematics 2026</span>
  </div>

  <!-- Controls Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
    
    <!-- Left: Operations Slider -->
    <div class="space-y-6">
      <div>
        <div class="flex justify-between items-center text-xs font-mono mb-2">
          <span class="text-slate-300">Monthly Tasks / Automated Operations</span>
          <span id="shock-volume-val" class="text-sky-400 font-bold">50,000 ops / mo</span>
        </div>
        <input 
          type="range" 
          id="shock-volume-slider" 
          min="5000" 
          max="250000" 
          step="5000" 
          value="50000"
          class="w-full h-2 bg-obsidian-950 rounded-lg appearance-none cursor-pointer accent-cobalt-600"
        />
        <div class="flex justify-between text-[10px] font-mono text-slate-500 mt-1">
          <span>5,000</span>
          <span>100,000</span>
          <span>250,000+</span>
        </div>
      </div>

      <!-- Cost Breakdown Cards -->
      <div class="grid grid-cols-2 gap-3 text-xs font-mono">
        <div class="p-3.5 rounded-xl bg-obsidian-950 border border-white/[0.06] flex items-center justify-between">
          <div>
            <span class="text-[10px] text-slate-400 uppercase block mb-1">Estimated {expensiveTool} Cost</span>
            <span id="expensive-cost" class="text-xl font-bold text-amber-400">$299 / mo</span>
          </div>
          <ToolIcon name={expensiveTool} slug={expensiveToolSlug} size="sm" />
        </div>
        <div class="p-3.5 rounded-xl bg-obsidian-950 border border-white/[0.06] flex items-center justify-between">
          <div>
            <span class="text-[10px] text-slate-400 uppercase block mb-1">TCO on {cheaperTool}</span>
            <span id="cheaper-cost" class="text-xl font-bold text-emerald-400">$29 / mo</span>
          </div>
          <ToolIcon name={cheaperTool} slug={cheaperToolSlug} size="sm" />
        </div>
      </div>
    </div>

    <!-- Right: Big Overcharge Counter & CTA -->
    <div class="p-6 rounded-xl bg-obsidian-950 border border-white/[0.06] text-center flex flex-col justify-between h-full">
      <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block mb-1">Recoverable Annual Overcharge</span>
      
      <div class="my-3">
        <span id="overcharge-val" class="text-4xl sm:text-5xl font-bold text-emerald-400 font-heading">
          $3,240
        </span>
        <span class="text-xs font-mono text-slate-500 block mt-1">/ year wasted on linear markups</span>
      </div>

      <a 
        href={affiliateHop}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="min-h-[44px] w-full py-3.5 px-6 rounded-xl font-medium font-mono text-xs uppercase tracking-wider text-white bg-cobalt-600 hover:bg-cobalt-500 transition-all flex items-center justify-center gap-2"
      >
        <ToolIcon name={cheaperTool} slug={cheaperToolSlug} size="xs" />
        <span>Stop Overpaying: Switch to {cheaperTool}</span>
        <span>↗</span>
      </a>
      <span class="text-[10px] font-mono text-slate-500 mt-2 block">Zero-downtime migration architecture</span>
    </div>

  </div>
</div>

<script is:inline>
  (function() {
    const slider = document.getElementById('shock-volume-slider');
    const volVal = document.getElementById('shock-volume-val');
    const expCost = document.getElementById('expensive-cost');
    const chpCost = document.getElementById('cheaper-cost');
    const overcharge = document.getElementById('overcharge-val');

    function calculate() {
      if (!slider) return;
      const vol = parseInt(slider.value, 10);
      if (volVal) volVal.textContent = vol.toLocaleString() + ' ops / mo';

      // Zapier pricing: ~$299 for 50k, ~$599 for 100k, ~$1,200 for 250k
      const zapCost = Math.round(vol * 0.0058);
      // Make pricing: ~$29 for 50k, ~$59 for 100k, ~$149 for 250k
      const makeCost = Math.round(vol * 0.00065);
      const diffAnnual = (zapCost - makeCost) * 12;

      if (expCost) expCost.textContent = '$' + zapCost + ' / mo';
      if (chpCost) chpCost.textContent = '$' + makeCost + ' / mo';
      if (overcharge) overcharge.textContent = '$' + diffAnnual.toLocaleString();
    }

    if (slider) slider.addEventListener('input', calculate);
    calculate();
  })();
</script>
