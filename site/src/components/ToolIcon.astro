}

if (!domain) {
  domain = 'heliatech.online';
}

const iconUrl = `https://www.google.com/s2/favicons?domain=${domain}&sz=128`;
const fallbackInitial = (name || slug || domain || 'H').charAt(0).toUpperCase();

const sizeClasses = {
  xs: 'w-5 h-5 rounded-md p-0.5 text-[9px]',
  sm: 'w-6 h-6 rounded-md p-1 text-[10px]',
  md: 'w-9 h-9 rounded-xl p-1.5 text-xs',
  lg: 'w-12 h-12 rounded-2xl p-2 text-base',
  xl: 'w-16 h-16 rounded-2xl p-3 text-xl',
};
---

<div class={`inline-flex items-center justify-center bg-obsidian-900 border border-white/[0.08] shadow-md shrink-0 group-hover:border-cobalt-500/40 transition-all duration-300 font-mono font-bold text-slate-300 ${sizeClasses[size]} ${className}`}>
  <img
    src={iconUrl}
    alt={`${name || slug || domain} brand icon`}
    data-domain={domain}
    class="w-full h-full object-contain rounded-md"
    loading="lazy"
    decoding="async"
    fetchpriority="low"
    width="64"
    height="64"
    onerror={`this.onerror=null; this.style.display='none'; this.nextElementSibling.style.display='flex';`}
  />
  <span style="display: none;" class="w-full h-full items-center justify-center bg-cobalt-950 text-cobalt-300 rounded-md">
    {fallbackInitial}
  </span>
</div>
