---
interface Props {
  name?: string;
  websiteUrl?: string;
  slug?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  className?: string;
}

const { name = '', websiteUrl, slug, size = 'md', className = '' } = Astro.props;

// Determine canonical domain for high-resolution 128x128 icon retrieval
let domain = '';

if (websiteUrl) {
  try {
    const parsed = new URL(websiteUrl);
    domain = parsed.hostname.replace(/^www\./, '');
  } catch (e) {
    domain = websiteUrl;
  }
}

