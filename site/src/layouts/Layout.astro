          <span>TCO Calculator & Audit</span>
          <span class="text-[10px] font-mono text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded-full border border-cyan-500/20">Free</span>
        </a>
        <a href="/blog" class="px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/[0.06] transition-colors">
          Editorial Guides
        </a>
      </div>
    </div>

    <!-- Main Dynamic Content -->
    <main class="relative z-10 flex-grow">
      <slot />
    </main>

    <!-- Ultra-Clean Cyber Dark Footer -->
    <footer class="relative z-10 border-t border-slate-800 bg-[#030303]/90 backdrop-blur-xl mt-32 text-xs text-slate-500 py-16">
      <div class="max-w-6xl mx-auto px-6 lg:px-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
        <div>
          <div class="flex items-center gap-2 mb-2">
