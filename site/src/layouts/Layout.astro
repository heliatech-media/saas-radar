        </div>
      </header>

      <!-- Mobile Glass Dropdown Drawer -->
      <div
        id="mobile-nav-drawer"
        class="hidden md:hidden mt-2 p-3 rounded-2xl backdrop-blur-2xl bg-[#08090d]/95 border border-white/[0.08] shadow-2xl flex flex-col gap-1 text-sm font-medium animate-in fade-in slide-in-from-top-2 duration-200"
      >
        <a href="/radar" class="px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/[0.06] transition-colors">
          SaaS Radar
        </a>
        <a href="/versus" class="px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/[0.06] transition-colors flex items-center justify-between">
          <span>Versus Arena</span>
          <span class="text-[10px] font-mono text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-full border border-amber-500/20">1v1</span>
        </a>
        <a href="/awards" class="px-3.5 py-2.5 rounded-xl text-slate-300 hover:text-white hover:bg-white/[0.06] transition-colors flex items-center justify-between">
