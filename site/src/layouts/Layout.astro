---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, any>;
}

const { 
  title, 
  description = "Moteur d'intelligence et média tech de référence : benchmarks indépendants, guides complets et enquêtes sur les meilleurs logiciels B2B et IA.",
  jsonLd
} = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth antialiased selection:bg-cyan-500/30 selection:text-cyan-100" style="background-color: #030303; color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name='impact-site-verification' value='76989799-5f87-4f11-87f0-cd18bcb2da56' />
    <meta name="impact-site-verification" content="76989799-5f87-4f11-87f0-cd18bcb2da56" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | HeliaTech</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | HeliaTech`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index, follow" />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
  </head>
  <body class="min-h-screen bg-[#030303] text-slate-200 font-sans relative overflow-x-hidden" style="background-color: #030303;">
    <!-- Ambient Cyber Glows (TechPulse Neon Aesthetics) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Top Ambient Cyan/Fuchsia Aurora -->
      <div class="absolute -top-[25%] left-1/2 -translate-x-1/2 w-[1000px] h-[650px] bg-gradient-to-b from-cyan-500/12 via-fuchsia-500/8 to-transparent blur-[160px] rounded-full"></div>
      <!-- Right Violet Flare -->
      <div class="absolute top-[25%] -right-[15%] w-[600px] h-[600px] bg-fuchsia-600/8 blur-[180px] rounded-full"></div>
      <!-- Left Cyber Cyan Flare -->
      <div class="absolute top-[50%] -left-[15%] w-[600px] h-[600px] bg-cyan-600/8 blur-[180px] rounded-full"></div>
      <!-- Geometric Cyber Grid Lines -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:4.5rem_4.5rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_75%,transparent_100%)]"></div>
    </div>

    <!-- Floating Capsule Navbar (Cyber Frosted Glass) -->
    <div class="sticky top-5 z-50 px-4 sm:px-6 max-w-5xl mx-auto">
      <header class="backdrop-blur-2xl bg-slate-900/75 border border-white/[0.08] shadow-glass-cyber rounded-full px-5 py-3 flex items-center justify-between transition-all duration-300 hover:border-cyan-500/40">
        <!-- Brand -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-cyan-500 via-sky-400 to-fuchsia-500 p-[1px] shadow-glow-cyan transition-transform duration-300 group-hover:scale-110">
            <div class="w-full h-full bg-[#030303] rounded-full flex items-center justify-center">
              <span class="text-xs font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-400">⚡</span>
            </div>
          </div>
          <span class="font-extrabold text-base tracking-tight text-white group-hover:text-cyan-300 transition-colors">
            HELIA<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-fuchsia-400">TECH</span>
          </span>
        </a>

        <!-- Links -->
        <nav class="hidden md:flex items-center gap-8 text-xs font-medium text-slate-300 tracking-wider">
          <a href="/" class="hover:text-cyan-400 transition-colors">RADAR SAAS</a>
          <a href="/blog" class="hover:text-fuchsia-400 transition-colors flex items-center gap-1.5">
            <span>BLOG & ENQUÊTES</span>
            <span class="px-1.5 py-0.2 rounded-full text-[9px] font-mono bg-fuchsia-500/20 text-fuchsia-300 border border-fuchsia-500/30">NOUVEAU</span>
          </a>
          <a href="/#categories" class="hover:text-cyan-400 transition-colors">TAXONOMIE</a>
        </nav>

        <!-- Live Telemetry Capsule -->
        <div class="flex items-center gap-2.5 bg-slate-800/60 border border-cyan-500/30 px-3.5 py-1.5 rounded-full shadow-inner-cyan">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
          </span>
          <span class="text-[11px] font-mono tracking-wider text-cyan-300 uppercase font-semibold">
            Helia Core 2026
          </span>
        </div>
      </header>
    </div>

    <!-- Main Dynamic Content -->
    <main class="relative z-10 flex-grow">
      <slot />
    </main>

    <!-- Ultra-Clean Cyber Dark Footer -->
    <footer class="relative z-10 border-t border-slate-800 bg-[#030303]/90 backdrop-blur-xl mt-32 text-xs text-slate-500 py-16">
      <div class="max-w-6xl mx-auto px-6 lg:px-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="font-black text-sm tracking-widest text-white">HELIA<span class="text-cyan-400">TECH</span></span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-cyan-500/10 text-cyan-300 border border-cyan-500/25">MÉDIA & BENCHMARKS</span>
          </div>
          <p class="max-w-md text-slate-400 text-xs leading-relaxed">
            Média d'investigation logicielle et moteur d'intelligence B2B évaluant en continu les outils SaaS, les agents IA et les architectures cloud.
          </p>
          <div class="flex items-center gap-4 mt-4">
            <a href="/" class="text-slate-400 hover:text-cyan-400 transition-colors">Radar</a>
            <span class="text-slate-700">•</span>
            <a href="/blog" class="text-slate-400 hover:text-fuchsia-400 transition-colors">Blog & Guides</a>
            <span class="text-slate-700">•</span>
            <a href="/#categories" class="text-slate-400 hover:text-cyan-400 transition-colors">Catégories</a>
          </div>
        </div>

        <div class="max-w-md text-xs text-slate-400 md:text-right border-l md:border-l-0 md:border-r border-slate-800 pl-4 md:pl-0 md:pr-4">
          <p class="font-mono text-cyan-300 text-[11px] mb-1 uppercase tracking-wider">Transparence & Indépendance</p>
          <p class="text-[11px] leading-relaxed">
            Nos benchmarks et guides techniques sont rédigés en toute indépendance éditoriale. Certains liens partenaires peuvent générer une commission de parrainage sans aucun surcoût pour l'utilisateur.
          </p>
        </div>
      </div>
      <div class="max-w-6xl mx-auto px-6 lg:px-8 mt-12 pt-6 border-t border-slate-800/80 flex justify-between items-center text-[11px] font-mono text-slate-500">
        <span>© 2026 HELIATECH.ONLINE — TOUS DROITS RÉSERVÉS</span>
        <span class="text-cyan-400/80">PROPULSÉ PAR HELIA CORE MULTI-AGENTS</span>
      </div>
    </footer>
  </body>
</html>
