---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, any>;
  image?: string;
  canonical?: string;
}

const { 
  title, 
  description = "Independent software intelligence and tech media: comprehensive benchmarks, exhaustive guides, and forensic teardowns of top B2B software and cloud systems.",
  jsonLd,
  image = "/images/blog/cursor.png",
  canonical
} = Astro.props;

// Determine clean canonical URL with trailing slash normalized
const currentPath = Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = canonical || (currentPath === '' ? 'https://heliatech.online/' : `https://heliatech.online${currentPath}/`);

// Social networks (LinkedIn, Twitter/X) do not support SVG for OpenGraph cards.
// Automatically route og:image to high-resolution 1200x630 PNG.
const socialImage = image.replace(/\.svg$/, '.png');
const ogImageUrl = socialImage.startsWith('http') ? socialImage : `https://heliatech.online${socialImage}`;
---

<!doctype html>
<html lang="en" class="scroll-smooth antialiased selection:bg-cyan-500/30 selection:text-cyan-100" style="background-color: #030303; color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests" />
    
    <!-- Strict HTTPS & Apex Domain Client Enforcement Guard -->
    <script is:inline>
      (function() {
        if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
          if (location.protocol === 'http:') {
            location.replace('https://' + location.hostname + location.pathname + location.search + location.hash);
          } else if (location.hostname.startsWith('www.')) {
            location.replace('https://' + location.hostname.replace(/^www\./, '') + location.pathname + location.search + location.hash);
          }
        }
      })();
    </script>
    <meta name='impact-site-verification' value='76989799-5f87-4f11-87f0-cd18bcb2da56' />
    <meta name="impact-site-verification" content="76989799-5f87-4f11-87f0-cd18bcb2da56" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Ultra-Fast Typography: Preconnect & Non-Blocking Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | HeliaTech</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | HeliaTech`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | HeliaTech`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="robots" content="index, follow" />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}



    <!-- Stealth Privacy-Preserving Telemetry Core (For Helia Sentinel) -->
    <!-- Excludes Admins, Internal Bots, Crawlers, and Headless Agents -->
    <script is:inline>
      (function() {
        try {
          const path = window.location.pathname;
          if (path.startsWith('/sentinel')) return;
          
          // 1. STRICT EXCLUSION: Admin & Internal Owners
          if (localStorage.getItem('_ht_admin_device') === 'true' || sessionStorage.getItem('_helia_sentinel_auth_token')) {
            return; // Completely bypass telemetry for site owners/admins
          }

          // 2. STRICT EXCLUSION: Automated Bots, Crawlers, Headless Browsers
          if (navigator.webdriver) return;
          const userAgent = (navigator.userAgent || '').toLowerCase();
          const botPatterns = ['bot', 'crawler', 'spider', 'googlebot', 'bingbot', 'slurp', 'duckduckbot', 'baiduspider', 'yandexbot', 'facebookexternalhit', 'headless', 'phantomjs', 'selenium', 'puppeteer'];
          if (botPatterns.some(bp => userAgent.includes(bp))) return;

          // 3. HUMAN VERIFICATION: Verify human presence before committing visit
          let visitRecorded = false;
          const startTime = Date.now();
          const storeKey = '_ht_telemetry_v1';

          function commitRealVisit() {
            if (visitRecorded) return;
            visitRecorded = true;

            let store = {};
            try {
              store = JSON.parse(localStorage.getItem(storeKey) || '{"total_visits":0,"total_hops":0,"pages":{},"recent_events":[]}');
            } catch(e) {
              store = { total_visits: 0, total_hops: 0, pages: {}, recent_events: [] };
            }

            store.total_visits = (store.total_visits || 0) + 1;
            if (!store.pages) store.pages = {};
            if (!store.pages[path]) {
              store.pages[path] = { views: 0, dwell_ms: 0, hops: 0 };
            }
            store.pages[path].views = (store.pages[path].views || 0) + 1;

            // Log event
            if (!store.recent_events) store.recent_events = [];
            store.recent_events.unshift({
              type: 'VISIT',
              path: path,
              title: document.title.replace(' | HeliaTech', ''),
              device: window.innerWidth < 768 ? 'Mobile' : (window.innerWidth < 1024 ? 'Tablet' : 'Desktop'),
              lang: (navigator.language || 'en').toUpperCase().split('-')[0],
              timestamp: new Date().toLocaleTimeString('en-US', { hour12: false })
            });
            if (store.recent_events.length > 50) store.recent_events.pop();

            localStorage.setItem(storeKey, JSON.stringify(store));
          }

          // Trigger on genuine human interaction (scroll, click, touch, mousemove) or 3s dwell
          ['scroll', 'mousemove', 'click', 'touchstart'].forEach(ev => {
            window.addEventListener(ev, commitRealVisit, { once: true, passive: true });
          });
          setTimeout(commitRealVisit, 3000);

          // Record dwell time when user leaves or switches tab
          function recordDwell() {
            const elapsed = Date.now() - startTime;
            if (elapsed > 1000) {
              try {
                const current = JSON.parse(localStorage.getItem(storeKey) || '{}');
                if (current.pages && current.pages[path]) {
                  current.pages[path].dwell_ms = (current.pages[path].dwell_ms || 0) + elapsed;
                  localStorage.setItem(storeKey, JSON.stringify(current));
                }
              } catch(e) {}
            }
          }

          window.addEventListener('visibilitychange', function() {
            if (document.visibilityState === 'hidden') recordDwell();
          });
          window.addEventListener('pagehide', recordDwell);

          // Track clicks on affiliate hops
          document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link && link.href && (link.href.includes('/go/') || (link.rel && link.rel.includes('sponsored')))) {
              try {
                const current = JSON.parse(localStorage.getItem(storeKey) || '{}');
                current.total_hops = (current.total_hops || 0) + 1;
                
                const toolSlug = link.href.split('/go/')[1] || path;
                if (!current.pages) current.pages = {};
                if (!current.pages[path]) current.pages[path] = { views: 1, dwell_ms: 0, hops: 0 };
                current.pages[path].hops = (current.pages[path].hops || 0) + 1;

                if (!current.recent_events) current.recent_events = [];
                current.recent_events.unshift({
                  type: 'HOP',
                  path: `/go/${toolSlug}`,
                  title: `Affiliate Hop: ${toolSlug.toUpperCase()}`,
                  device: window.innerWidth < 768 ? 'Mobile' : 'Desktop',
                  lang: (navigator.language || 'en').toUpperCase().split('-')[0],
                  timestamp: new Date().toLocaleTimeString('en-US', { hour12: false })
                });
                if (current.recent_events.length > 50) current.recent_events.pop();

                localStorage.setItem(storeKey, JSON.stringify(current));

                // Dispatch Global Edge Beacon for Centralized Real-Time Telemetry
                try {
                  const beaconData = JSON.stringify({
                    type: 'HOP',
                    tool: toolSlug,
                    path: path,
                    referrer: document.referrer || 'Direct'
                  });
                  if (navigator.sendBeacon) {
                    navigator.sendBeacon('/api/telemetry', beaconData);
                  } else {
                    fetch('/api/telemetry', { method: 'POST', body: beaconData, keepalive: true }).catch(() => {});
                  }
                } catch(bErr) {}
              } catch(e) {}
            }
          });
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[#030303] text-slate-200 font-sans relative overflow-x-hidden" style="background-color: #030303;">
