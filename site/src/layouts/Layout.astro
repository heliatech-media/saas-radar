---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, any>;
}

const { 
  title, 
  description = "Independent software intelligence and tech media: comprehensive benchmarks, exhaustive guides, and forensic teardowns of top B2B software and cloud systems.",
  jsonLd
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth antialiased selection:bg-cyan-500/30 selection:text-cyan-100" style="background-color: #030303; color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name='impact-site-verification' value='76989799-5f87-4f11-87f0-cd18bcb2da56' />
    <meta name="impact-site-verification" content="76989799-5f87-4f11-87f0-cd18bcb2da56" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | HeliaTech</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | HeliaTech`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="robots" content="index, follow" />

    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Netlify Badge & Drawer Shield (Aggressively strips injected Netlify badges) -->
    <script is:inline>
      (function() {
        function removeNetlifyBadge() {
          const selectors = [
            '[data-netlify-badge]',
            '[data-netlify-drawer]',
            '[data-test="feedback-drawer"]',
            '[data-testid="feedback-drawer"]',
            '#netlify-badge',
            '.netlify-badge',
            '#netlify-drawer',
            '.netlify-drawer',
            'iframe[src*="netlify"]',
            'iframe[id*="netlify"]'
          ];
          selectors.forEach(sel => {
            document.querySelectorAll(sel).forEach(el => el.remove());
          });
        }
        document.addEventListener('DOMContentLoaded', removeNetlifyBadge);
        const observer = new MutationObserver(removeNetlifyBadge);
        observer.observe(document.documentElement, { childList: true, subtree: true });
        window.addEventListener('load', removeNetlifyBadge);
      })();
    </script>

    <!-- Stealth Privacy-Preserving Telemetry Core (For Helia Sentinel) -->
    <!-- Excludes Admins, Internal Bots, Crawlers, and Headless Agents -->
    <script is:inline>
      (function() {
        try {
          const path = window.location.pathname;
          if (path.startsWith('/sentinel')) return;
          
          // 1. STRICT EXCLUSION: Admin & Internal Owners
          if (localStorage.getItem('_ht_admin_device') === 'true' || sessionStorage.getItem('_helia_sentinel_auth_token')) {
            return; // Completely bypass telemetry for site owners/admins
          }

          // 2. STRICT EXCLUSION: Automated Bots, Crawlers, Headless Browsers
          if (navigator.webdriver) return;
          const userAgent = (navigator.userAgent || '').toLowerCase();
          const botPatterns = ['bot', 'crawler', 'spider', 'googlebot', 'bingbot', 'slurp', 'duckduckbot', 'baiduspider', 'yandexbot', 'facebookexternalhit', 'headless', 'phantomjs', 'selenium', 'puppeteer'];
          if (botPatterns.some(bp => userAgent.includes(bp))) return;

          // 3. HUMAN VERIFICATION: Verify human presence before committing visit
          let visitRecorded = false;
          const startTime = Date.now();
          const storeKey = '_ht_telemetry_v1';

          function commitRealVisit() {
            if (visitRecorded) return;
            visitRecorded = true;

            let store = {};
            try {
              store = JSON.parse(localStorage.getItem(storeKey) || '{"total_visits":0,"total_hops":0,"pages":{},"recent_events":[]}');
            } catch(e) {
              store = { total_visits: 0, total_hops: 0, pages: {}, recent_events: [] };
            }

            store.total_visits = (store.total_visits || 0) + 1;
            if (!store.pages) store.pages = {};
            if (!store.pages[path]) {
              store.pages[path] = { views: 0, dwell_ms: 0, hops: 0 };
            }
            store.pages[path].views = (store.pages[path].views || 0) + 1;

            // Log event
            if (!store.recent_events) store.recent_events = [];
            store.recent_events.unshift({
              type: 'VISIT',
              path: path,
              title: document.title.replace(' | HeliaTech', ''),
              device: window.innerWidth < 768 ? 'Mobile' : (window.innerWidth < 1024 ? 'Tablet' : 'Desktop'),
              lang: (navigator.language || 'en').toUpperCase().split('-')[0],
              timestamp: new Date().toLocaleTimeString('en-US', { hour12: false })
            });
            if (store.recent_events.length > 50) store.recent_events.pop();

            localStorage.setItem(storeKey, JSON.stringify(store));
          }

          // Trigger on genuine human interaction (scroll, click, touch, mousemove) or 3s dwell
          ['scroll', 'mousemove', 'click', 'touchstart'].forEach(ev => {
            window.addEventListener(ev, commitRealVisit, { once: true, passive: true });
          });
          setTimeout(commitRealVisit, 3000);

          // Record dwell time when user leaves or switches tab
          function recordDwell() {
            const elapsed = Date.now() - startTime;
            if (elapsed > 1000) {
              try {
                const current = JSON.parse(localStorage.getItem(storeKey) || '{}');
                if (current.pages && current.pages[path]) {
                  current.pages[path].dwell_ms = (current.pages[path].dwell_ms || 0) + elapsed;
                  localStorage.setItem(storeKey, JSON.stringify(current));
                }
              } catch(e) {}
            }
          }

          window.addEventListener('visibilitychange', function() {
            if (document.visibilityState === 'hidden') recordDwell();
          });
          window.addEventListener('pagehide', recordDwell);

          // Track clicks on affiliate hops
          document.addEventListener('click', function(e) {
            const link = e.target.closest('a');
            if (link && link.href && (link.href.includes('/go/') || (link.rel && link.rel.includes('sponsored')))) {
              try {
                const current = JSON.parse(localStorage.getItem(storeKey) || '{}');
                current.total_hops = (current.total_hops || 0) + 1;
                
                const toolSlug = link.href.split('/go/')[1] || path;
                if (!current.pages) current.pages = {};
                if (!current.pages[path]) current.pages[path] = { views: 1, dwell_ms: 0, hops: 0 };
                current.pages[path].hops = (current.pages[path].hops || 0) + 1;

                if (!current.recent_events) current.recent_events = [];
                current.recent_events.unshift({
                  type: 'HOP',
                  path: `/go/${toolSlug}`,
                  title: `Affiliate Hop: ${toolSlug.toUpperCase()}`,
                  device: window.innerWidth < 768 ? 'Mobile' : 'Desktop',
                  lang: (navigator.language || 'en').toUpperCase().split('-')[0],
                  timestamp: new Date().toLocaleTimeString('en-US', { hour12: false })
                });
                if (current.recent_events.length > 50) current.recent_events.pop();

                localStorage.setItem(storeKey, JSON.stringify(current));
              } catch(e) {}
            }
          });
        } catch(e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-[#030303] text-slate-200 font-sans relative overflow-x-hidden" style="background-color: #030303;">
    <!-- Ambient Cyber Glows (TechPulse Neon Aesthetics) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
      <!-- Top Ambient Cyan/Fuchsia Aurora -->
      <div class="absolute -top-[25%] left-1/2 -translate-x-1/2 w-[1000px] h-[650px] bg-gradient-to-b from-cyan-500/12 via-fuchsia-500/8 to-transparent blur-[160px] rounded-full"></div>
      <!-- Right Violet Flare -->
      <div class="absolute top-[25%] -right-[15%] w-[600px] h-[600px] bg-fuchsia-600/8 blur-[180px] rounded-full"></div>
      <!-- Left Cyber Cyan Flare -->
      <div class="absolute top-[50%] -left-[15%] w-[600px] h-[600px] bg-cyan-600/8 blur-[180px] rounded-full"></div>
      <!-- Geometric Cyber Grid Lines -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:4.5rem_4.5rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_75%,transparent_100%)]"></div>
    </div>

    <!-- Floating Capsule Navbar (Cyber Frosted Glass) -->
    <div class="sticky top-5 z-50 px-4 sm:px-6 max-w-5xl mx-auto">
      <header class="backdrop-blur-2xl bg-slate-900/75 border border-white/[0.08] shadow-glass-cyber rounded-full px-5 py-3 flex items-center justify-between transition-all duration-300 hover:border-cyan-500/40">
        <!-- Brand -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-cyan-500 via-sky-400 to-fuchsia-500 p-[1px] shadow-glow-cyan transition-transform duration-300 group-hover:scale-110">
            <div class="w-full h-full bg-[#030303] rounded-full flex items-center justify-center">
              <span class="text-xs font-black text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-400">⚡</span>
            </div>
          </div>
          <span class="font-extrabold text-base tracking-tight text-white group-hover:text-cyan-300 transition-colors">
            HELIA<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-fuchsia-400">TECH</span>
          </span>
        </a>

        <!-- Links -->
        <nav class="hidden md:flex items-center gap-8 text-xs font-medium text-slate-300 tracking-wider">
          <a href="/" class="hover:text-cyan-400 transition-colors">SAAS RADAR</a>
          <a href="/blog" class="hover:text-fuchsia-400 transition-colors flex items-center gap-1.5">
            <span>BLOG & GUIDES</span>
            <span class="px-1.5 py-0.2 rounded-full text-[9px] font-mono bg-fuchsia-500/20 text-fuchsia-300 border border-fuchsia-500/30">NEW</span>
          </a>
          <a href="/#categories" class="hover:text-cyan-400 transition-colors">TAXONOMY</a>
          <a href="/#methodology" class="hover:text-cyan-400 transition-colors">METHODOLOGY</a>
        </nav>

        <!-- Live Intelligence Status Capsule -->
        <div class="flex items-center gap-2.5 bg-slate-800/60 border border-cyan-500/30 px-3.5 py-1.5 rounded-full shadow-inner-cyan">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-400"></span>
          </span>
          <span class="text-[11px] font-mono tracking-wider text-cyan-300 uppercase font-semibold">
            Directory Status: Verified
          </span>
        </div>
      </header>
    </div>

    <!-- Main Dynamic Content -->
    <main class="relative z-10 flex-grow">
      <slot />
    </main>

    <!-- Ultra-Clean Cyber Dark Footer -->
    <footer class="relative z-10 border-t border-slate-800 bg-[#030303]/90 backdrop-blur-xl mt-32 text-xs text-slate-500 py-16">
      <div class="max-w-6xl mx-auto px-6 lg:px-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="font-black text-sm tracking-widest text-white">HELIA<span class="text-cyan-400">TECH</span></span>
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-cyan-500/10 text-cyan-300 border border-cyan-500/25">INDEPENDENT BENCHMARKS</span>
          </div>
          <p class="max-w-md text-slate-400 text-xs leading-relaxed">
            Leading tech media and programmatic software observatory delivering rigorous benchmarks, hands-on masterclasses, and pricing forensics for modern enterprises.
          </p>
          <div class="flex items-center gap-4 mt-4">
            <a href="/" class="text-slate-400 hover:text-cyan-400 transition-colors">Radar</a>
            <span class="text-slate-700">•</span>
            <a href="/blog" class="text-slate-400 hover:text-fuchsia-400 transition-colors">Blog & Guides</a>
            <span class="text-slate-700">•</span>
            <a href="/#categories" class="text-slate-400 hover:text-cyan-400 transition-colors">Taxonomy</a>
            <span class="text-slate-700">•</span>
            <a href="/sitemap.xml" class="text-slate-400 hover:text-cyan-400 transition-colors">Sitemap</a>
          </div>
        </div>

        <div class="max-w-md text-xs text-slate-400 md:text-right border-l md:border-l-0 md:border-r border-slate-800 pl-4 md:pl-0 md:pr-4">
          <p class="font-mono text-cyan-300 text-[11px] mb-1 uppercase tracking-wider">Independent Disclosures</p>
          <p class="text-[11px] leading-relaxed">
            All benchmarks, technical teardowns, and performance assessments are independently evaluated by the HeliaTech research desk. Qualifying outbound partner links may yield performance-based royalties without altering user price.
          </p>
        </div>
      </div>
      <div class="max-w-6xl mx-auto px-6 lg:px-8 mt-12 pt-6 border-t border-slate-800/80 flex justify-between items-center text-[11px] font-mono text-slate-500">
        <span>© 2026 HELIATECH MEDIA — ALL RIGHTS RESERVED</span>
        <span class="text-slate-400 font-mono">GLOBAL SOFTWARE BENCHMARK OBSERVATORY</span>
      </div>
    </footer>
  </body>
</html>
