    <!-- Mobile Navigation Toggle Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const toggle = document.getElementById('mobile-nav-toggle');
        const drawer = document.getElementById('mobile-nav-drawer');
        const iconBars = document.getElementById('menu-icon-bars');
        const iconClose = document.getElementById('menu-icon-close');
        if (toggle && drawer) {
          toggle.addEventListener('click', () => {
            const isHidden = drawer.classList.contains('hidden');
            if (isHidden) {
              drawer.classList.remove('hidden');
              iconBars?.classList.add('hidden');
              iconClose?.classList.remove('hidden');
            } else {
              drawer.classList.add('hidden');
              iconBars?.classList.remove('hidden');
              iconClose?.classList.add('hidden');
            }
          });
        }
      });
    </script>

    <!-- Cloudflare Web Analytics (Official Zero-Cookie Privacy-Preserving Telemetry) -->
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c3360d131e3241459e695ed9dd51a825"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </body>
</html>
